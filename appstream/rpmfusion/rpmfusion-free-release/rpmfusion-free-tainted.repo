[rpmfusion-free-tainted]
name=RPM Fusion for Fedora $releasever - Free tainted
#baseurl=http://download1.rpmfusion.org/free/fedora/tainted/$releasever/$basearch/
metalink=https://mirrors.rpmfusion.org/metalink?repo=free-fedora-tainted-$releasever&arch=$basearch
enabled=1
metadata_expire=6h
type=rpm-md
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-rpmfusion-free-fedora-$releasever
exclude=ffmpeg ffmpeg-debuginfo ffmpeg-debugsource ffmpeg-devel ffmpeg-libs ffmpeg-libs-debuginfo gstreamer1-plugins-bad-freeworld gstreamer1-plugins-bad-freeworld-debuginfo gstreamer1-plugins-bad-freeworld-debugsource intel-media-driver intel-media-driver-debuginfo intel-media-driver-debugsource libavcodec-freeworld libavcodec-freeworld-debuginfo libavdevice libavdevice-debuginfo libde265 libde265-debuginfo libde265-debugsource libde265-devel libde265-examples libde265-examples-debuginfo libfreeaptx libfreeaptx-debuginfo libfreeaptx-debugsource libfreeaptx-devel libfreeaptx-tools libfreeaptx-tools-debuginfo libheif-freeworld libheif-freeworld-debuginfo libheif-freeworld-debugsource libndi-sdk librtmp librtmp-debuginfo librtmp-devel libva-intel-driver libva-intel-driver-debuginfo libva-intel-driver-debugsource mencoder mencoder-debuginfo mesa-freeworld-debugsource mesa-libgallium-freeworld mesa-libgallium-freeworld-debuginfo mesa-va-drivers-freeworld mesa-va-drivers-freeworld-debuginfo mesa-vdpau-drivers-freeworld mesa-vulkan-drivers-freeworld mesa-vulkan-drivers-freeworld-debuginfo mesa-vulkan-drivers-freeworld-debugsource mesa-vulkan-drivers-git-freeworld mesa-vulkan-drivers-git-freeworld-debuginfo mesa-vulkan-drivers-git-freeworld-debugsource mozilla-openh264 mozilla-openh264-debuginfo mplayer mplayer-common mplayer-debuginfo mplayer-debugsource mplayer-doc mplayer-tools ndi-sdk ndi-sdk-devel ndi-sdk-documentation obs-studio obs-studio-debuginfo obs-studio-debugsource obs-studio-devel obs-studio-freeworld-debugsource obs-studio-libs obs-studio-libs-debuginfo obs-studio-plugin-browser obs-studio-plugin-browser-debuginfo obs-studio-plugin-distroav obs-studio-plugin-distroav-debuginfo obs-studio-plugin-distroav-debugsource obs-studio-plugin-vlc-video obs-studio-plugin-vlc-video-debuginfo obs-studio-plugin-x264 obs-studio-plugin-x264-debuginfo openh264 openh264-debuginfo openh264-debugsource openh264-devel pipewire-codec-aptx pipewire-codec-aptx-debuginfo pipewire-codec-aptx-debugsource rtmpdump rtmpdump-debuginfo rtmpdump-debugsource svt-hevc svt-hevc-debuginfo svt-hevc-debugsource svt-hevc-devel svt-hevc-libs svt-hevc-libs-debuginfo vlc-plugins-freeworld vlc-plugins-freeworld-debuginfo vlc-plugins-freeworld-debugsource vvenc vvenc-debuginfo vvenc-debugsource vvenc-devel vvenc-libs vvenc-libs-debuginfo x264 x264-debuginfo x264-debugsource x264-devel x264-libs x264-libs-debuginfo x265 x265-debuginfo x265-debugsource x265-devel x265-libs x265-libs-debuginfo

[rpmfusion-free-tainted-debuginfo]
name=RPM Fusion for Fedora $releasever - Free tainted - Debug
#baseurl=http://download1.rpmfusion.org/free/fedora/tainted/$releasever/$basearch/debug/
metalink=https://mirrors.rpmfusion.org/metalink?repo=free-fedora-tainted-debug-$releasever&arch=$basearch
enabled=0
metadata_expire=6h
type=rpm-md
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-rpmfusion-free-fedora-$releasever

[rpmfusion-free-tainted-source]
name=RPM Fusion for Fedora $releasever - Free tainted - Source
#baseurl=http://download1.rpmfusion.org/free/fedora/tainted/$releasever/SRPMS/
metalink=https://mirrors.rpmfusion.org/metalink?repo=free-fedora-tainted-source-$releasever&arch=$basearch
enabled=0
metadata_expire=6h
type=rpm-md
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-rpmfusion-free-fedora-$releasever

