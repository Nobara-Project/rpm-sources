@@ -18,6 +18,13 @@
 # ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR
 # OTHER DEALINGS IN THE SOFTWARE.
 
+# The x86-only compiler options below are skipped on other architectures.
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|i[3-6]86|x86)$")
+    set(MEDIA_ARCH_IS_X86 TRUE)
+else()
+    set(MEDIA_ARCH_IS_X86 FALSE)
+endif()
+
 set(MEDIA_COMPILER_FLAGS_COMMON
     # Global setting for warnings
     -Wall
@@ -54,8 +61,6 @@
 
     # Enable c++14 features
     -std=c++14
-    # -m32 or -m64
-    -m${ARCH}
 
     # Global defines
     -DLINUX=1
@@ -66,6 +71,18 @@
     -g
 )
 
+if(MEDIA_ARCH_IS_X86)
+    set(MEDIA_COMPILER_FLAGS_COMMON
+        ${MEDIA_COMPILER_FLAGS_COMMON}
+        # -m32 or -m64
+        -m${ARCH})
+else()
+    set(MEDIA_COMPILER_FLAGS_COMMON
+        ${MEDIA_COMPILER_FLAGS_COMMON}
+        # The driver is developed on x86, where plain char is signed.
+        -fsigned-char)
+endif()
+
 if(MEDIA_BUILD_HARDENING)
     set(MEDIA_COMPILER_FLAGS_COMMON
         ${MEDIA_COMPILER_FLAGS_COMMON}
