@@ -25,9 +25,13 @@
 //!
 #pragma once
 
+// The SSE copy routines exist only on x86; other architectures use the C ones.
+#if defined(__i386__) || defined(__x86_64__) || defined(_M_IX86) || defined(_M_X64)
