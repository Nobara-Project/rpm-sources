 #include <mmintrin.h>
 #include <xmmintrin.h>
 #include <emmintrin.h>
+#endif
 #include "cm_debug.h"
 #include "mos_utilities.h"
 
@@ -43,7 +47,11 @@
     NUM_CPU_INSTRUCTION_LEVELS
 };
 
+#ifdef CM_MEM_X86
 typedef __m128              DQWORD;         // 128-bits,   16-bytes
+#else
+typedef struct { uint8_t b[16]; } __attribute__((aligned(16))) DQWORD; // 128-bits, 16-bytes
+#endif
 typedef uint32_t            PREFETCH[8];    //             32-bytes
 typedef uint32_t            CACHELINE[8];   //             32-bytes
 typedef uint16_t            DHWORD[32];     // 512-bits,   64-bytes
