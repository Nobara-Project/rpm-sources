diff --git a/src/vulkan/runtime/vk_acceleration_structure.c b/src/vulkan/runtime/vk_acceleration_structure.c
index d7575fcd8466d..af3cf34a10e47 100644
--- a/src/vulkan/runtime/vk_acceleration_structure.c
