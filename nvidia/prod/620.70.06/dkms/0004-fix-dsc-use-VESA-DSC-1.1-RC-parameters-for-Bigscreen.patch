From 77957d11eaa9bf4ba1c3c9a7137a9099e652fcb1 Mon Sep 17 00:00:00 2001
From: Simone Caronni <negativo17@gmail.com>
Date: Fri, 25 Sep 2026 16:17:59 +0200
Subject: [PATCH] fix(dsc): use VESA DSC 1.1 RC parameters for Bigscreen Beyond

The Bigscreen Beyond VR headset (DSC 1.1, 8bpc, 8.0 bpp, RGB 4:4:4,
3840x1920@90Hz) shows block-aligned "rainbow static" artifacts on
high-detail content with the RC range parameters generated by
nvt_dsc_pps.c. Using the values from VESA DSC 1.1 Table E-5 for that
operating point eliminates the artifacts.

The minqp444_*/maxqp444_* and ofs_und* tables are the VESA DSC C model
interpolated tables (identical to the ones used by i915 in
intel_qp_tables.c). They differ from the per-bpp Annex E tables of both
DSC 1.1 and DSC 1.2 at most operating points, and Table E-5 predates the
DSC 1.1 E1 SCR, so changing the tables would alter the RC parameters for
every DSC sink. ofs_und8 is also shared by all bpp in (6, 12]; changing
it for 8.0 bpp would change 10 bpp, where all references specify -10 for
range 11.

Keep the tables unchanged and add a DP EDID WAR flag instead:

- bForceDsc11RcParams is set for the Bigscreen Beyond (0x2709/0x1234)
  in the WAR database and passed per device to the DSC PPS calculation
  through WAR_DATA for both SST and MST.
- When set, DSC_PpsCalcRcParam() overrides range_min_qp, range_max_qp
  and range_bpg_offset with the DSC 1.1 Table E-5 values for RGB 8bpc
  at exactly 8.0 bpp (non-native 4:2:0/4:2:2):

    range_min_qp:     0, 0, 1, 1, 3, 3, 3, 3, 3,  3,  5,  5,  5,  7, 13
    range_max_qp:     4, 4, 5, 6, 7, 7, 7, 8, 9, 10, 11, 12, 13, 13, 15
    range_bpg_offset: 2, 0, 0,-2,-4,-6,-8,-8,-8,-10,-10,-12,-12,-12,-12

DSC_INPUT_PARAMS gains a field, so DSC_GENERATE_PPS_OPAQUE_WORKAREA
grows from 500 to 504 bytes.

Link: https://github.com/NVIDIA/open-gpu-kernel-modules/issues/1039
Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/common/displayport/inc/dp_deviceimpl.h    |  1 +
 src/common/displayport/inc/dp_edid.h          |  1 +
 .../displayport/src/dp_connectorimpl.cpp      |  2 ++
 src/common/displayport/src/dp_wardatabase.cpp |  7 +++++
 src/common/modeset/timing/nvt_dsc_pps.c       | 27 ++++++++++++++++++-
 src/common/modeset/timing/nvt_dsc_pps.h       |  3 ++-
 6 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/src/common/displayport/inc/dp_deviceimpl.h b/src/common/displayport/inc/dp_deviceimpl.h
index da7e16a809..cd073be742 100644
--- a/src/common/displayport/inc/dp_deviceimpl.h
+++ b/src/common/displayport/inc/dp_deviceimpl.h
@@ -427,6 +427,7 @@ namespace DisplayPort
         bool getStuffDummySymbolsFor128b132b() const { return processedEdid.WARData.bStuffDummySymbolsFor128b132b; }
         bool getStuffDummySymbolsFor8b10b() const { return processedEdid.WARData.bStuffDummySymbolsFor8b10b; }
         bool getApplyStuffDummySymbolsWAR() const { return processedEdid.WARFlags.bApplyStuffDummySymbolsWAR; }
+        bool getForceDsc11RcParams() const { return processedEdid.WARFlags.bForceDsc11RcParams; }
 
         virtual void queryGUID2();
 
diff --git a/src/common/displayport/inc/dp_edid.h b/src/common/displayport/inc/dp_edid.h
index 08926a045c..b24b90145e 100644
--- a/src/common/displayport/inc/dp_edid.h
+++ b/src/common/displayport/inc/dp_edid.h
@@ -174,6 +174,7 @@ namespace DisplayPort
             bool bDP2XPreferNonDSCForLowPClk;
             bool bSkipCableIdCheck;
             bool bAllocateManualTimeslots;
+            bool bForceDsc11RcParams;     // Use VESA DSC 1.1 Table E-5 RC parameters at 8bpc/8.0bpp
         }_WARFlags;
 
         _WARFlags WARFlags;
diff --git a/src/common/displayport/src/dp_connectorimpl.cpp b/src/common/displayport/src/dp_connectorimpl.cpp
index 1214bc94ca..2d18ec8481 100644
--- a/src/common/displayport/src/dp_connectorimpl.cpp
+++ b/src/common/displayport/src/dp_connectorimpl.cpp
@@ -2129,6 +2129,7 @@ bool ConnectorImpl::compoundQueryAttachMSTDsc(Group * target,
     warData.dpData.hBlank = modesetParams.modesetInfo.rasterWidth - modesetParams.modesetInfo.surfaceWidth;
     warData.connectorType = DSC_DP;
     warData.dpData.bDisableDscMaxBppLimit = bDisableDscMaxBppLimit;
+    warData.dpData.bForceDsc11RcParams = dev->getForceDsc11RcParams();
 
     //
     // Dplib needs to pass sliceCountMask to clients
@@ -2525,6 +2526,7 @@ bool ConnectorImpl::compoundQueryAttachSSTDsc
     warData.dpData.dpMode = DSC_DP_SST;
     warData.connectorType = DSC_DP;
     warData.dpData.bDisableDscMaxBppLimit = bDisableDscMaxBppLimit;
+    warData.dpData.bForceDsc11RcParams = nativeDev->getForceDsc11RcParams();
 
     if (main->isEDP())
     {
diff --git a/src/common/displayport/src/dp_wardatabase.cpp b/src/common/displayport/src/dp_wardatabase.cpp
index 91703ee352..fb79022177 100644
--- a/src/common/displayport/src/dp_wardatabase.cpp
+++ b/src/common/displayport/src/dp_wardatabase.cpp
@@ -577,6 +577,13 @@ void Edid::applyEdidWorkArounds(NvU32 warFlag, const DpMonitorDenylistData *pDen
                 //
                 this->WARFlags.forceMaxLinkConfig = true;
                 DP_PRINTF(DP_NOTICE, "DP-WAR> Force maximum link config for Bigscreen Beyond VR headset.");
+
+                //
+                // The DSC decoder shows block artifacts with the C model RC
+                // parameters at 8bpc/8.0bpp. Use VESA DSC 1.1 Table E-5 ones.
+                //
+                this->WARFlags.bForceDsc11RcParams = true;
+                DP_PRINTF(DP_NOTICE, "DP-WAR> Force DSC 1.1 RC parameters for Bigscreen Beyond VR headset.");
             }
             break;
 
diff --git a/src/common/modeset/timing/nvt_dsc_pps.c b/src/common/modeset/timing/nvt_dsc_pps.c
index 25f9c27e8b..e21400d3af 100644
--- a/src/common/modeset/timing/nvt_dsc_pps.c
+++ b/src/common/modeset/timing/nvt_dsc_pps.c
@@ -103,6 +103,7 @@ typedef struct
     NvU32  peak_throughput_mode0; // peak throughput supported by the sink for 444 and simple 422 modes. 
     NvU32  peak_throughput_mode1; // peak throughput supported by the sink for native 422 and 420 modes.
     NvU32  eDP;                   // 1 = connector type is eDP, 0 otherwise. 
+    NvU32  force_dsc11_rc_params; // 1 = use VESA DSC 1.1 Table E-5 RC parameters at 8bpc/8.0bpp
 } DSC_INPUT_PARAMS;
 
 //output pps parameters after calculation
@@ -781,6 +782,7 @@ DSC_PpsCalcScaleInterval
 /*
  * @brief Calculate RC parameters
  *
+ * @param[in]       in    DSC input parameter
  * @param[in/out]   out   DSC output parameter
  *
  * @returns NVT_STATUS_SUCCESS if successful;
@@ -789,6 +791,7 @@ DSC_PpsCalcScaleInterval
 static NvU32
 DSC_PpsCalcRcParam
 (
+    const DSC_INPUT_PARAMS *in,
     DSC_OUTPUT_PARAMS *out
 )
 {
@@ -975,6 +978,27 @@ DSC_PpsCalcRcParam
                 }
             }
         }
+
+        //
+        // Sink WAR for RGB 8bpc at 8.0bpp: use the RC range parameters from
+        // VESA DSC 1.1 Table E-5 (prior to the DSC 1.1 E1 SCR) instead of the
+        // C model values above. Some DSC decoders (e.g. Bigscreen Beyond) show
+        // block artifacts with the C model values.
+        //
+        if (in->force_dsc11_rc_params && out->convert_rgb && !out->native_420 &&
+            (bpcm8 == 0) && (bitsPerPixel == 8 * BPP_UNIT))
+        {
+            const NvU32 minqp_dsc11[] = { 0, 0, 1, 1, 3, 3, 3, 3, 3, 3, 5, 5, 5, 7, 13 };
+            const NvU32 maxqp_dsc11[] = { 4, 4, 5, 6, 7, 7, 7, 8, 9, 10, 11, 12, 13, 13, 15 };
+            const int ofs_dsc11[] = { 2, 0, 0, -2, -4, -6, -8, -8, -8, -10, -10, -12, -12, -12, -12 };
+
+            for (i = 0; i < NUM_BUF_RANGES; i++)
+            {
+                out->range_min_qp[i] = minqp_dsc11[i];
+                out->range_max_qp[i] = maxqp_dsc11[i];
+                out->range_bpg_offset[i] = ofs_dsc11[i];
+            }
+        }
     }
     return NVT_STATUS_SUCCESS;
 }
@@ -1886,7 +1910,7 @@ DSC_PpsCalc
     if (ret != NVT_STATUS_SUCCESS) return ret;
     ret = Dsc_PpsCalcHeight(in, out);
     if (ret != NVT_STATUS_SUCCESS) return ret;
-    ret = DSC_PpsCalcRcParam(out);
+    ret = DSC_PpsCalcRcParam(in, out);
     return ret;
 }
 
@@ -2785,6 +2809,7 @@ _DSC_GeneratePPS
             }
         }
         in->eDP = (pWARData->dpData.bIsEdp == NV_TRUE) ? 1 : 0;
+        in->force_dsc11_rc_params = (pWARData->dpData.bForceDsc11RcParams == NV_TRUE) ? 1 : 0;
     }
 
     if (in->native_422)
diff --git a/src/common/modeset/timing/nvt_dsc_pps.h b/src/common/modeset/timing/nvt_dsc_pps.h
index 1210b2f648..7a8c7a368c 100644
--- a/src/common/modeset/timing/nvt_dsc_pps.h
+++ b/src/common/modeset/timing/nvt_dsc_pps.h
@@ -259,11 +259,12 @@ typedef struct
         NvBool bDisableDscMaxBppLimit;
         NvBool bIs128b132bChannelCoding;
         NvBool bDisableEffBppSST8b10b;
+        NvBool bForceDsc11RcParams;
     }dpData;
 } WAR_DATA;
 
 typedef struct {
-    NvU8 data[500U]; // total size of DSC_IN/OUTPUT_PARAMS
+    NvU8 data[504U]; // total size of DSC_IN/OUTPUT_PARAMS
 } DSC_GENERATE_PPS_OPAQUE_WORKAREA;
 
 typedef struct
