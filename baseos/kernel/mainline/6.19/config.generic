CONFIG_CACHY=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_EFI_VARS=y
# CONFIG_EFI_DXE_MEM_ATTRIBUTES is not set
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NTSYNC=y
CONFIG_DM_SNAPSHOT=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_I2C_CHARDEV=y
CONFIG_BMI260_I2C=m
CONFIG_SECURITY_SELINUX=n
CONFIG_DEFAULT_SECURITY="apparmor"
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
# CONFIG_SECURITY_APPARMOR_KUNIT_TEST is not set
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# CONFIG_DEFAULT_SECURITY_DAC is not set
CONFIG_LSM="lockdown,yama,integrity,apparmor,bpf,landlock"

## xpadneo
CONFIG_HID_XPADNEO=y

# CONFIG_LOCALVERSION is not set

# Enable BORE Scheduler
CONFIG_SCHED_BORE=y

# Enable sched-ext
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_JIT=y
CONFIG_BPF_SYSCALL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_FTRACE=y
CONFIG_PAHOLE_HAS_SPLIT_BTF=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_SCHED_DEBUG=y

# Setting tick rate
CONFIG_HZ_300=n
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Set O3
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=n
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y

# Enable full ticks
CONFIG_HZ_PERIODIC=n
CONFIG_NO_HZ_IDLE=n
CONFIG_CONTEXT_TRACKING_FORCE=n
CONFIG_NO_HZ_FULL_NODEF=y
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ=y
CONFIG_NO_HZ_COMMON=y
CONFIG_CONTEXT_TRACKING=y

# Enable lazy preempt
CONFIG_PREEMPT_LAZY=y
CONFIG_PREEMPT_NONE=n
CONFIG_PREEMPT_VOLUNTARY=n
CONFIG_PREEMPT=n
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPTION=y
CONFIG_PREEMPT_DYNAMIC=y

# Unset hostname
# CONFIG_DEFAULT_HOSTNAME is not set