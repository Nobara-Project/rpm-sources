From 53ab1b105a4163005e0bddbfbd0ea625732eae55 Mon Sep 17 00:00:00 2001
From: Jens Glathe <jens.glathe@oldschoolsolutions.biz>
Date: Mon, 13 Oct 2025 22:28:08 +0200
Subject: [PATCH] arm64: dts: qcom: x1e78100-t14s: add second-source
 touchscreen @41

Signed-off-by: Jens Glathe <jens.glathe@oldschoolsolutions.biz>
---
 .../qcom/x1e78100-lenovo-thinkpad-t14s.dtsi   | 20 ++++++++++++++-----
 1 file changed, 15 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1e78100-lenovo-thinkpad-t14s.dtsi b/arch/arm64/boot/dts/qcom/x1e78100-lenovo-thinkpad-t14s.dtsi
index e8057dfed051..711474794465 100644
--- a/arch/arm64/boot/dts/qcom/x1e78100-lenovo-thinkpad-t14s.dtsi
+++ b/arch/arm64/boot/dts/qcom/x1e78100-lenovo-thinkpad-t14s.dtsi
@@ -1279,9 +1279,12 @@ retimer_ss1_con_sbu_out: endpoint {
 &i2c8 {
 	clock-frequency = <400000>;
 
+	pinctrl-0 = <&qup_i2c8_data_clk>, <&ts0_default>;
+	pinctrl-names = "default";
+
 	status = "okay";
 
-	/* ILIT2911 or GTCH1563 */
+	/* GTCH1563 */
 	touchscreen@10 {
 		compatible = "hid-over-i2c";
 		reg = <0x10>;
@@ -1291,12 +1294,19 @@ touchscreen@10 {
 
 		vdd-supply = <&vreg_misc_3p3>;
 		vddl-supply = <&vreg_l15b_1p8>;
-
-		pinctrl-0 = <&ts0_default>;
-		pinctrl-names = "default";
 	};
 
-	/* TODO: second-sourced touchscreen @ 0x41 */
+	/* ILIT2911 */
+	touchscreen@41 {
+		compatible = "hid-over-i2c";
+		reg = <0x41>;
+
+		hid-descr-addr = <0x1>;
+		interrupts-extended = <&tlmm 51 IRQ_TYPE_LEVEL_LOW>;
+
+		vdd-supply = <&vreg_misc_3p3>;
+		vddl-supply = <&vreg_l15b_1p8>;
+	};
 };
 
 &iris {
-- 
2.53.0

From 5b92842c9baa911422782ef00c2d7bbcc304d494 Mon Sep 17 00:00:00 2001
From: Jens Glathe <jens.glathe@oldschoolsolutions.biz>
Date: Sun, 15 Jun 2025 16:57:17 +0200
Subject: [PATCH] dt-bindings: display: panel: samsung,atna40ct01: document
 ATNA40CT01

The Samsung ATNA40CT01 panel is a 14" AMOLED eDP panel. It is
similar to the ATNA33XC20 except that it is larger and has a
different resolution. It is used in the Lenovo Ideapad Slim 5x
and the Ideapad 5 2-in-1, non-touch and touch variants.

It identifies as SDC 0x4187.

Signed-off-by: Jens Glathe <jens.glathe@oldschoolsolutions.biz>
---
 .../devicetree/bindings/display/panel/samsung,atna33xc20.yaml   | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml b/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml
index f1723e910252..82dd09b69664 100644
--- a/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml
+++ b/Documentation/devicetree/bindings/display/panel/samsung,atna33xc20.yaml
@@ -21,6 +21,8 @@ properties:
           - enum:
               # Samsung 13" 3K (2880×1920 pixels) eDP AMOLED panel
               - samsung,atna30dw01
+              # Samsung 14" WUXGA (1920×1200 pixels) eDP AMOLED panel
+              - samsung,atna40ct01
               # Samsung 14" FHD+ (1920x1200 pixels) eDP AMOLED panel
               - samsung,atna40ct06
               # Samsung 14" WQXGA+ (2880x1800 pixels) eDP AMOLED panel
-- 
