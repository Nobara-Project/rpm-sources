+			if (all_2way && uniform_stride > 0) {
+				sd->shared->poc_smt_shift =
+					(u8)uniform_stride;
+				sd->shared->poc_primary_mask = primary_mask;
+			} else {
+				static_branch_disable_cpuslocked(
+					&sched_poc_smt_consecutive);
+				static_branch_disable_cpuslocked(
+					&sched_poc_smt_uniform);
+			}
+		}
