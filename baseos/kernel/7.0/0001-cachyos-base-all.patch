+	for_each_possible_cpu(cpu)
+		memset(per_cpu_ptr(poc_debug_cnt, cpu), 0,
+		       sizeof(poc_debug_cnt));
+	return count;
+}
+
+static struct kobj_attribute poc_count_reset_attr = {
+	.attr = { .name = "reset", .mode = 0200 },
+	.store = poc_count_reset_store,
+};
