new file mode 100644
index 000000000000..2080f3969137
--- /dev/null
+++ b/fs/ntfs/index.c
@@ -0,0 +1,2117 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * NTFS kernel index handling.
