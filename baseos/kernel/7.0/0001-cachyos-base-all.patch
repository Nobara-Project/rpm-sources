+/* --- count: per-level hit counters (sysctl kernel.sched_poc_count) --- */
+
+static unsigned long poc_sum_level(enum poc_level lvl)
+{
+	unsigned long sum = 0;
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		sum += per_cpu(poc_debug_cnt[lvl], cpu);
+	return sum;
+}
