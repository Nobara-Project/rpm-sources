## Steam Deck
CONFIG_MFD_STEAMDECK=m
CONFIG_SENSORS_STEAMDECK=m
CONFIG_LEDS_STEAMDECK=m
CONFIG_EXTCON_STEAMDECK=m

## Microsoft Surface
CONFIG_HID_IPTS=m
CONFIG_HID_ITHC=m
CONFIG_SURFACE_BOOK1_DGPU_SWITCH=m
CONFIG_LEDS_TPS68470=m
CONFIG_RTC_DRV_SURFACE=m
CONFIG_HID_SURFACE=m

## Ally
CONFIG_HID_ASUS_ALLY=m

# Enable x86_64_v3
# Just to be sure, check:
# /lib/ld-linux-x86-64.so.2 --help | grep supported
# and make sure if your processor supports it:
# x86-64-v3 (supported, searched)
#CONFIG_X86_64_VERSION=3