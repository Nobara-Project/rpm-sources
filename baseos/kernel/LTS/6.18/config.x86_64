## Steam Deck
CONFIG_MFD_STEAMDECK=m
CONFIG_SENSORS_STEAMDECK=m
CONFIG_LEDS_STEAMDECK=m
CONFIG_EXTCON_STEAMDECK=m

## Microsoft Surface
CONFIG_HID_IPTS=m
CONFIG_HID_ITHC=m
CONFIG_SURFACE_BOOK1_DGPU_SWITCH=m
CONFIG_LEDS_TPS68470=m
CONFIG_RTC_DRV_SURFACE=m
CONFIG_HID_SURFACE=m

## Ally
CONFIG_HID_ASUS_ALLY=m

## AYANEO
CONFIG_SND_SOC_AW87XXX=m

## Apple T2: APPLE_BCE was split into separate drivers in CachyOS 6.18.52
CONFIG_T2BCE_CORE=m
CONFIG_T2BCE_VHCI=m
CONFIG_T2BCE_AUDIO=m
