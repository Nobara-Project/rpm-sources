+static bool has_decl_tag(struct btf2btf_context *ctx, u32 type_id,
+			 const char *name, s32 component_idx)
+{
+	struct btf *btf = ctx->btf;
+	const struct btf_type *t;
+	const char *tag_name;
+
+	for (u32 i = 0; i < ctx->nr_decl_tags; i++) {
+		t = btf__type_by_id(btf, ctx->decl_tags[i]);
+		if (btf_kflag(t) || t->type != type_id)
+			continue;
+		if (btf_decl_tag(t)->component_idx != component_idx)
+			continue;
