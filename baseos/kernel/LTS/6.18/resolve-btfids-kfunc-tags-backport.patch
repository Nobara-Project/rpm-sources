+	if (has_decl_tag(ctx, func_id, "bpf_kfunc", -1))
+		return 0;
+
+	tag_id = btf__add_decl_tag(ctx->btf, "bpf_kfunc", func_id, -1);
+	if (tag_id < 0) {
+		pr_err("ERROR: resolve_btfids: failed to add bpf_kfunc decl tag for %s\n",
+		       func_name);
+		return tag_id;
+	}
+
+	err = push_decl_tag_id(ctx, tag_id);
+	if (err)
