+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copy capture path. The card writes frames only into coherent DMA buffers
+ * the driver owns, and the IRQ thread copies each half into a vb2 buffer as
+ * it lands. The layouts come from the vendor drivers:
+ *
+ * - UHD family: four quarters, one per DMA buffer (and one address window),
+ *   used in pairs: buffers 0 and 1 make the top half, 2 and 3 the bottom.
+ * - Other cards: two halves, one after the other in the channel's DMA buffer.
+ *
+ * Either way the audio ring sits at the end of the channel's buffer, so video
+ * and audio always share the address window the card reaches them through.
+ */
+#include <linux/dma-mapping.h>
+#include <linux/ktime.h>
+#include <linux/math64.h>
+#include <linux/minmax.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+
+#include <media/videobuf2-v4l2.h>
+#include <media/videobuf2-vmalloc.h>
+
+#include "hws.h"
+#include "hws_audio.h"
+#include "hws_convert.h"
+#include "hws_copy.h"
+#include "hws_reg.h"
+#include "hws_scale.h"
+
+#define HWS_DMA_BLOCK		2048
+#define HWS_UHD_DMA_SIZE	0x480000	/* holds a 4096x2160 quarter and the reset register 9 limit */
+/* The driver writes this after reading a half; the card overwrites it when it refreshes the half. */
+#define HWS_HALF_MARK		0x55AAAA55
+
+unsigned int hws_num_dma_bufs(const struct hws_pcie_dev *hws)
+{
+	return hws->uhd ? 4 : hws->cur_max_video_ch;
+}
+
+static bool hws_crosses_window(dma_addr_t dma, size_t size)
+{
+	return ((u64)dma >> 29) != (((u64)dma + size - 1) >> 29);
+}
+
+static void hws_copy_free_bufs(struct hws_pcie_dev *hws)
+{
+	unsigned int i;
+
+	for (i = 0; i < MAX_VID_CHANNELS; i++) {
+		if (!hws->scratch_vid[i].cpu)
+			continue;
+		dma_free_coherent(&hws->pdev->dev, hws->scratch_vid[i].size,
+				  hws->scratch_vid[i].cpu,
+				  hws->scratch_vid[i].dma);
+		hws->scratch_vid[i].cpu = NULL;
+		hws->scratch_vid[i].size = 0;
+	}
+}
+
+static int hws_copy_alloc_bufs(struct hws_pcie_dev *hws, size_t size)
+{
+	unsigned int i;
+
+	for (i = 0; i < hws_num_dma_bufs(hws); i++) {
+		dma_addr_t dma;
+		void *cpu;
+
+		cpu = dma_alloc_coherent(&hws->pdev->dev, size, &dma,
+					 GFP_KERNEL | __GFP_NOWARN);
+		if (!cpu) {
+			hws_copy_free_bufs(hws);
+			return -ENOMEM;
+		}
+		hws->scratch_vid[i].cpu = cpu;
+		hws->scratch_vid[i].dma = dma;
+		hws->scratch_vid[i].size = size;
+		/* the card reaches a buffer through one 512 MiB window */
+		if (hws_crosses_window(dma, size)) {
+			hws_copy_free_bufs(hws);
+			return -ENOMEM;
+		}
+	}
+	hws->dma_buf_sz = size;
+	return 0;
+}
+
+int hws_copy_alloc(struct hws_pcie_dev *hws)
+{
+	/* the converters write a line or two past the frame */
+	size_t frame = (size_t)hws->max_w * (hws->max_h + 4) * 2;
+	unsigned int ch;
+	int ret;
+
+	if (hws->uhd) {
+		/* Larger than MAX_PAGE_ORDER: it needs IOMMU translation or CMA. */
+		ret = hws_copy_alloc_bufs(hws, HWS_UHD_DMA_SIZE);
+		if (!ret) {
+			hws->input_w_limit = hws->hw_ver ? 4096 : 3840;
+		} else {
+			ret = hws_copy_alloc_bufs(hws, MAX_MM_VIDEO_SIZE);
+			if (ret)
+				return ret;
+			hws->input_w_limit = 3840;
+			dev_warn(&hws->pdev->dev,
+				 "4.5 MiB DMA buffers unavailable; 4096-wide input is captured at 3840\n");
+			if (!hws->hw_ver)
+				dev_warn(&hws->pdev->dev,
+					 "keep the IOMMU on to contain an over-long DMA run\n");
+		}
+	} else {
+		/*
+		 * Version-0 cards never get register 9 programmed, and its reset
+		 * limit (4.25 MiB) is past the end of a 4 MiB buffer.
+		 */
+		ret = hws->hw_ver ? -ENOMEM : hws_copy_alloc_bufs(hws, HWS_UHD_DMA_SIZE);
+		if (ret) {
+			ret = hws_copy_alloc_bufs(hws, MAX_MM_VIDEO_SIZE);
+			if (ret)
+				return ret;
+			if (!hws->hw_ver)
+				dev_warn(&hws->pdev->dev,
+					 "4.5 MiB DMA buffers unavailable; keep the IOMMU on to contain an over-long DMA run\n");
+		}
+		hws->input_w_limit = hws->max_w;
+	}
+
+	for (ch = 0; ch < hws->cur_max_video_ch; ch++) {
+		struct hws_video *v = &hws->video[ch];
+
+		v->staging = vzalloc(frame);
+		if (hws->support_yv12)
+			v->conv = vzalloc(frame);
+		if (!v->staging || (hws->support_yv12 && !v->conv)) {
+			hws_copy_free(hws);
+			return -ENOMEM;
+		}
+	}
+	return 0;
+}
+
+void hws_copy_free(struct hws_pcie_dev *hws)
+{
+	unsigned int ch;
+
+	for (ch = 0; ch < MAX_VID_CHANNELS; ch++) {
+		vfree(hws->video[ch].staging);
+		hws->video[ch].staging = NULL;
+		vfree(hws->video[ch].conv);
+		hws->video[ch].conv = NULL;
+	}
+	hws_copy_free_bufs(hws);
+}
+
+static u32 hws_frame_bytes(const struct hws_pcie_dev *hws, u32 w, u32 h)
+{
+	switch (hws->support_yv12) {
+	case 0:
+		return w * h * 2;
+	case 1:
+		return w * h * 12 / 8;
+	default:
+		return w * h * 5 / 4;
+	}
+}
+
+/*
+ * Register 9 caps a run the card makes past a quarter's length (after a mode
+ * change, with old lengths): it ends with one 2 KiB block at this limit, whose
+ * reset value is past the end of a 4 MiB buffer.
+ */
+static void hws_copy_set_dma_max(struct hws_video *v)
+{
+	struct hws_pcie_dev *hws = v->parent;
+	u32 cap = hws->dma_buf_sz - HWS_AUDIO_RING_SIZE - HWS_DMA_BLOCK;
+	u32 max = max(v->len[0], v->len[3]);
+
+	if (!hws->hw_ver)
+		return;
+	if (!max || max > cap)
+		max = cap;
+	writel(max / 16, hws->bar0_base + HWS_REG_DMA_MAX_SIZE);
+}
+
+/* Set the card's lengths for the input in v->in_*. A size that doesn't fit is never programmed. */
+int hws_copy_program(struct hws_video *v)
+{
+	struct hws_pcie_dev *hws = v->parent;
+	u32 room = hws->dma_buf_sz - HWS_AUDIO_RING_SIZE;
+	u32 frame = hws_frame_bytes(hws, v->in_w, v->in_h);
+	unsigned int ch = v->channel_index;
+	unsigned int i;
+
+	v->lens_ok = false;
+	if (!frame || !hws->dma_buf_sz)
+		return -EINVAL;
+	/* never a size the staging and conversion buffers weren't made for */
+	if (v->in_w > hws->input_w_limit ||
+	    (v->in_il ? v->in_h * 2 : v->in_h) > hws->max_h)
+		return -ERANGE;
+
+	if (hws->uhd) {
+		u32 q = frame / (4 * HWS_DMA_BLOCK) * HWS_DMA_BLOCK;
+		u32 last = ((frame - q * 3) / HWS_DMA_BLOCK + 1) * HWS_DMA_BLOCK;
+
+		if (q > room || last > room)
+			return -ERANGE;
+		v->len[0] = q;
+		v->len[1] = q;
+		v->len[2] = q;
+		v->len[3] = last;
+		for (i = 0; i < 4; i++)
+			writel(v->len[i] / 16, hws->bar0_base + CVBS_IN_BUF_BASE2 +
+			       i * PCIE_BARADDROFSIZE);
+		hws_copy_set_dma_max(v);
+	} else {
+		u32 hf = frame / (2 * HWS_DMA_BLOCK) * HWS_DMA_BLOCK;
+
+		if (frame > room)
+			return -ERANGE;
+		v->len[0] = hf;
+		v->len[1] = frame - hf;
+		writel(hf / 16, hws->bar0_base + CVBS_IN_BUF_BASE2 +
+		       ch * PCIE_BARADDROFSIZE);
+	}
+	(void)readl(hws->bar0_base + HWS_REG_INT_STATUS);
+	v->frame_bytes = frame;
+	v->lens_ok = true;
+	return 0;
+}
+
+/* After the buffer addresses are (re)written: the rest the card needs. */
+void hws_copy_seed_tail(struct hws_pcie_dev *hws)
+{
+	unsigned int ch;
+
+	if (!hws->copy_mode || !hws->dma_buf_sz)
+		return;
+	for (ch = 0; ch < hws->cur_max_video_ch; ch++) {
+		dma_addr_t ring = hws->scratch_vid[ch].dma + hws->dma_buf_sz -
+				  HWS_AUDIO_RING_SIZE;
+
+		hws_copy_program(&hws->video[ch]);
+		writel((ch + 1) * PCIEBAR_AXI_BASE +
+		       (lower_32_bits(ring) & PCI_E_BAR_ADD_LOWMASK),
+		       hws->bar0_base + CVBS_IN_BUF_BASE +
+		       (8 + ch) * PCIE_BARADDROFSIZE);
+	}
+	(void)readl(hws->bar0_base + HWS_REG_INT_STATUS);
+}
+
+int hws_copy_start(struct hws_video *v)
+{
+	v->top_done = false;
+	v->frame_late = false;
+	v->last_half_ts = 0;
+	v->half_gap = 0;
+	v->fps_start_ns = 0;
+	return hws_copy_program(v);
+}
+
+bool hws_hdcp_active(struct hws_pcie_dev *hws, unsigned int ch)
+{
+	u32 reg;
+
+	/* the register is new with FPGA version 122 on the other families */
+	if (!hws->uhd && !hws->hw_ver)
+		return false;
+	reg = readl(hws->bar0_base + HWS_REG_HDCP_STATUS);
+	return reg != 0xFFFFFFFF && (reg & BIT(ch));
+}
+
+static struct hwsvideo_buffer *hws_copy_take_buffer(struct hws_video *v)
+{
+	struct hwsvideo_buffer *buf;
+	unsigned long flags;
+
+	for (;;) {
+		buf = NULL;
+		spin_lock_irqsave(&v->irq_lock, flags);
+		if (v->active) {
+			buf = v->active;	/* kept from a frame that was lost */
+			spin_unlock_irqrestore(&v->irq_lock, flags);
+			return buf;
+		}
+		if (!list_empty(&v->capture_queue)) {
+			buf = list_first_entry(&v->capture_queue, struct hwsvideo_buffer, list);
+			list_del_init(&buf->list);
+			if (v->queued_count)
+				v->queued_count--;
+			/* queued for an earlier, smaller input: it can't take this frame */
+			if (vb2_plane_size(&buf->vb.vb2_buf, 0) >= v->pix.sizeimage)
+				v->active = buf;
+		}
+		spin_unlock_irqrestore(&v->irq_lock, flags);
+		if (!buf || v->active == buf)
+			return buf;
+		vb2_buffer_done(&buf->vb.vb2_buf, VB2_BUF_STATE_ERROR);
+	}
+}
+
+static void hws_copy_complete(struct hws_video *v, struct hwsvideo_buffer *buf,
+			      u64 ts, enum vb2_buffer_state state)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&v->irq_lock, flags);
+	v->active = NULL;
+	spin_unlock_irqrestore(&v->irq_lock, flags);
+
+	buf->vb.field = V4L2_FIELD_NONE;
+	buf->vb.sequence = (u32)atomic_inc_return(&v->sequence_number);
+	buf->vb.vb2_buf.timestamp = ts;
+	vb2_set_plane_payload(&buf->vb.vb2_buf, 0, v->pix.sizeimage);
+	vb2_buffer_done(&buf->vb.vb2_buf, state);
+}
+
+/* Turn the frame assembled in staging into the output YUYV frame. */
+static void hws_copy_render(struct hws_video *v, u8 *dst)
+{
+	struct hws_pcie_dev *hws = v->parent;
+	u32 w = v->in_w, h = v->in_h, y;
+	u32 disp_h = v->in_il ? h * 2 : h;
+	bool same = w == v->pix.width && disp_h == v->pix.height;
+
+	if (!hws->support_yv12) {
+		const u8 *src = v->staging;
+
+		if (!same) {
+			hws_scale_yuyv(src, w, h, disp_h, dst, v->pix.width, v->pix.height);
+			return;
+		}
+		for (y = 0; y < h; y++) {	/* interlaced: double each field's lines */
+			memcpy(dst + y * 2 * w * 2, src, w * 2);
+			memcpy(dst + (y * 2 + 1) * w * 2, src, w * 2);
+			src += w * 2;
+		}
+		return;
+	}
+	if (hws->support_yv12 == 1)
+		FillYUU2(v->staging, v->conv, w, disp_h, v->in_il);
+	else
+		FillNV12ToYUY2(v->staging, v->conv, w, disp_h, v->in_il);
+	if (same)
+		memcpy(dst, v->conv, v->pix.sizeimage);
+	else
+		hws_scale_yuyv(v->conv, w, disp_h, disp_h, dst, v->pix.width, v->pix.height);
+}
+
+/*
+ * One half of a frame has landed: @half is 1 for the top half, 0 for the bottom
+ * one, which ends the frame. The top half takes a buffer and the bottom one
+ * completes it with the frame-end time @ts. A half the card didn't refresh, or
+ * a bottom half without its top half, loses the frame, and the buffer waits for
+ * the next one. Runs in the IRQ thread, which stop paths flush with
+ * synchronize_irq() before they change anything this reads.
+ */
+void hws_copy_half(struct hws_video *v, int half, u64 ts)
+{
+	struct hws_pcie_dev *hws = v->parent;
+	unsigned int ch = v->channel_index;
+	/* otherwise the frame is assembled in staging, and hws_copy_render() makes it fit */
+	bool direct = !hws->support_yv12 && !v->in_il &&
+		      v->in_w == v->pix.width && v->in_h == v->pix.height;
+	u32 pitch = hws->support_yv12 == 1 ? v->in_w * 12 / 8 : v->in_w * 2;
+	u8 *src[2] = { NULL, NULL };
+	u32 n[2] = { 0, 0 };
+	struct hwsvideo_buffer *buf;
+	unsigned long flags;
+	u32 *mark;
+	u8 *dst;
+	u32 markoff, marklen;
+
+	if (!READ_ONCE(v->cap_active) || !v->lens_ok || !pitch)
+		return;
+
+	if (hws->uhd) {
+		unsigned int b = half ? 0 : 2;
+
+		src[0] = hws->scratch_vid[b].cpu;
+		src[1] = hws->scratch_vid[b + 1].cpu;
+		n[0] = v->len[b];
+		n[1] = v->len[b + 1];
+		marklen = n[1];
+		if (marklen / pitch < 2)
+			return;
+		markoff = marklen - (marklen / pitch - 1) * pitch;
+		mark = (u32 *)(src[1] + markoff);
+	} else {
+		src[0] = (u8 *)hws->scratch_vid[ch].cpu + (half ? 0 : v->len[0]);
+		n[0] = half ? v->len[0] : v->len[1];
+		marklen = n[0];
+		if (marklen / pitch < 3)
+			return;
+		markoff = marklen - (marklen / pitch - 2) * pitch;
+		mark = (u32 *)(src[0] + markoff);
+	}
+
+	/* a half is safe to copy until the card starts the next frame's run into it */
+	v->half_gap = v->last_half_ts && ts > v->last_half_ts ? ts - v->last_half_ts : 0;
+	v->last_half_ts = ts;
+
+	dma_rmb();	/* coherent memory: no sync call, but order the reads after the interrupt */
+	if (READ_ONCE(*mark) == HWS_HALF_MARK) {
+		if (v->top_done) {
+			v->top_done = false;
+			v->frames_lost++;
+			atomic_inc(&v->sequence_number);
+		}
+		return;
+	}
+
+	if (half) {
+		if (v->top_done) {	/* the previous frame's bottom half never came */
+			v->frames_lost++;
+			atomic_inc(&v->sequence_number);
+		}
+		v->frame_hdcp = hws_hdcp_active(hws, ch);
+		buf = hws_copy_take_buffer(v);
+		v->top_bytes = n[0] + n[1];
+		if (buf && !v->frame_hdcp && v->top_bytes <= v->frame_bytes) {
+			dst = direct ? vb2_plane_vaddr(&buf->vb.vb2_buf, 0) : v->staging;
+			if (dst) {
+				memcpy(dst, src[0], n[0]);
+				if (n[1])
+					memcpy(dst + n[0], src[1], n[1]);
+			}
+		}
+		v->top_done = true;
+		v->frame_late = v->half_gap && ktime_get_ns() - ts > v->half_gap;
+	} else if (!v->top_done) {
+		v->frames_lost++;
+		atomic_inc(&v->sequence_number);
+	} else {
+		enum vb2_buffer_state state = VB2_BUF_STATE_DONE;
+		u32 rest = v->frame_bytes - min(v->top_bytes, v->frame_bytes);
+		u32 c0 = min(n[0], rest);
+		u32 c1 = min(n[1], rest - c0);
+		bool hdcp = v->frame_hdcp || hws_hdcp_active(hws, ch);
+		void *out;
+
+		v->top_done = false;
+		/* version-0 cards have no frame-rate register: measure it */
+		if (!v->fps_start_ns) {
+			v->fps_start_ns = ts;
+			v->frames_counted = 0;
+		} else if (++v->frames_counted, ts - v->fps_start_ns >= NSEC_PER_SEC) {
+			if (!hws->hw_ver)
+				WRITE_ONCE(v->current_fps,
+					   (u32)div64_u64((u64)v->frames_counted * NSEC_PER_SEC +
+							  (ts - v->fps_start_ns) / 2,
+							  ts - v->fps_start_ns));
+			v->fps_start_ns = ts;
+			v->frames_counted = 0;
+		}
+		spin_lock_irqsave(&v->irq_lock, flags);
+		buf = v->active;
+		spin_unlock_irqrestore(&v->irq_lock, flags);
+		if (!buf) {
+			atomic_inc(&v->sequence_number);
+			goto out;
+		}
+		out = vb2_plane_vaddr(&buf->vb.vb2_buf, 0);
+		if (!out || vb2_plane_size(&buf->vb.vb2_buf, 0) < v->pix.sizeimage) {
+			state = VB2_BUF_STATE_ERROR;
+		} else if (hdcp) {
+			/* like the vendor's Windows driver, never pass on protected video */
+			memset32(out, HWS_BLACK_YUYV, v->pix.sizeimage / 4);
+		} else {
+			dst = (direct ? (u8 *)out : (u8 *)v->staging) + v->top_bytes;
+			memcpy(dst, src[0], c0);
+			if (c1)
+				memcpy(dst + c0, src[1], c1);
+			if (v->frame_late || (v->half_gap && ktime_get_ns() - ts > v->half_gap)) {
+				/* the card may have started overwriting what was copied */
+				v->late_copies++;
+				state = VB2_BUF_STATE_ERROR;
+			} else if (!direct) {
+				hws_copy_render(v, out);
+			}
+		}
+		hws_copy_complete(v, buf, ts, state);
+	}
+out:
+	*mark = HWS_HALF_MARK;
+}
