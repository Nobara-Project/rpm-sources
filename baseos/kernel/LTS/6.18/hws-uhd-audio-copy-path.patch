Subject: [PATCH] media: hws: support the rest of the HWS family, with audio

Add what the out-of-tree vendor drivers do and this driver doesn't, for every
card they cover:

- The 4K family (8888:8581, 85A1, 8591, 1F33:8581): four DMA quarters, inputs up
  to 4096x2160, and register 9 following the input.
- Audio: one ALSA card per input, except on the AHD cards, which have none.
- A copy capture path, the default: the card writes only to the driver's own DMA
  buffers, and the IRQ thread copies each half into a vb2 buffer. The audio ring
  shares an address window with video, and the direct path moves that window and
  writes registers 26-29, which on these cards include audio ring addresses.
  direct_dma=1 keeps the direct path, without audio, for 1080p YUYV cards.
- YV12/NV12 cards, converted to YUYV with the vendor's code.
- Black frames while the source uses HDCP, on the copy path.
- Line-doubled interlaced input, and frame rates measured on version-0 cards.
- MSI, as the vendor drivers use, with INTx as the fallback.

- A capture that survives a mode change: its buffers keep their size, and a small
  scaler fits each frame to them with black bars, as programs like OBS don't
  recover from a queue error. Restarting capture gets the input's own size, with no
  scaling. S_DV_TIMINGS always accepts what the input is sending.
- VIDIOC_ENUM_FRAMESIZES, VIDIOC_ENUM_FRAMEINTERVALS and VIDIOC_S_PARM.
- Names that say what the card is: the PCI ID database's make and model where it
  has one (AVMatrix VC12-4K, AVMatrix VC42), otherwise the family, and the input
  number on multi-input cards, for the V4L2 card, node and input names and ALSA.

Tested on a VC12-4K with FPGA 121 (8888:8581), kernel 7.2.9, from an Intel Arc
A310: 1280x720, 1920x1080 and 2560x1440 at 60 Hz and 3840x2160 at 30 Hz with no
sequence gaps, and a 1 kHz tone over HDMI audio intact. 3840x2160 at 60 Hz, 2560x1440
at 144 Hz and 1920x1080 at 240 Hz need its PCIe link at 5 GT/s: at 2.5 GT/s, 3840x2160
at 60 Hz gives no frames, with the out-of-tree driver too. At 5 GT/s it runs at 59.7
fps, about one frame in 200 skipped, cause unknown. One capture ran through
1280x720, 1280x1024, 2560x1440, 3840x2160 at 30 Hz and 1920x1080 with no errors.

Tested on a VC42 with FPGA 121 (8888:8504), each of its four inputs in turn, at
1920x1080 at 60 Hz: picture, a 1 kHz tone with no sound on another input, loss and
return of the signal, and mode changes during a capture. Inputs 2 and 3 deliver
59.996 fps. With the same cable and source, inputs 1 and 4 miss about 3.5% and 0.5%
of frames: the driver gets no frame for them, and a VDONE with an unchanged toggle
in their place. Cause unknown; the driver accepts every frame it is given.

--- a/drivers/media/pci/hws/hws_audio.c
+++ b/drivers/media/pci/hws/hws_audio.c
@@ -0,0 +1,358 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Audio capture: one ALSA card per input, 48 kHz stereo 16-bit. The card fills
+ * two 4096-byte packets in the ring at the end of the channel's DMA buffer, in
+ * turn, and interrupts after each (21.3 ms). The sources don't offer anything
+ * else: these cards' EDID only advertises 48 kHz LPCM.
+ */
+#include <linux/delay.h>
+#include <linux/ktime.h>
+#include <linux/workqueue.h>
+
+#include <sound/core.h>
+#include <sound/initval.h>
+#include <sound/pcm.h>
+
+#include "hws.h"
+#include "hws_audio.h"
+#include "hws_reg.h"
+
+#define HWS_AUDIO_FRAMES	(HWS_AUDIO_PKT_SIZE / 4)
+/* no packet for this long means the source sends none: packets come every 21.3 ms */
+#define HWS_AUDIO_GAP_NS	(40 * NSEC_PER_MSEC)
+#define HWS_AUDIO_GAP_POLL_MS	5
+/* After an enable the card first sends packets it captured before the last disable. */
+#define HWS_AUDIO_STALE_PKTS	2
+
+static const u8 hws_audio_silence[HWS_AUDIO_PKT_SIZE];
+
+/*
+ * BATCH: the pointer only moves when a whole packet lands. Without it,
+ * PipeWire's timer scheduling reads the jumps as clock drift and resamples,
+ * which makes a low-latency loopback sound robotic.
+ */
+static const struct snd_pcm_hardware hws_pcm_hw = {
+	.info = SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_INTERLEAVED |
+		SNDRV_PCM_INFO_BLOCK_TRANSFER | SNDRV_PCM_INFO_BATCH |
+		SNDRV_PCM_INFO_MMAP_VALID,
+	.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	.rates = SNDRV_PCM_RATE_48000,
+	.rate_min = 48000,
+	.rate_max = 48000,
+	.channels_min = 2,
+	.channels_max = 2,
+	.buffer_bytes_max = 64 * 1024,
+	.period_bytes_min = HWS_AUDIO_PKT_SIZE,	/* a shorter period could never complete */
+	.period_bytes_max = 16 * 1024,
+	.periods_min = 2,
+	.periods_max = 16,
+};
+
+static void hws_audio_enable(struct hws_audio *a, bool on)
+{
+	struct hws_pcie_dev *hws = a->hws;
+	unsigned long flags;
+	u32 reg;
+
+	if (hws->pci_lost)
+		return;
+	spin_lock_irqsave(&hws->audio_en_lock, flags);
+	reg = readl(hws->bar0_base + HWS_REG_ACAP_ENABLE);
+	if (on)
+		reg |= BIT(a->ch);
+	else
+		reg &= ~BIT(a->ch);
+	writel(reg, hws->bar0_base + HWS_REG_ACAP_ENABLE);
+	(void)readl(hws->bar0_base + HWS_REG_ACAP_ENABLE);
+	spin_unlock_irqrestore(&hws->audio_en_lock, flags);
+}
+
+/*
+ * Put one packet in the stream's buffer. Only while running: trigger STOP clears
+ * that under the lock, before hw_free can drop the buffer. snd_pcm_period_elapsed()
+ * takes the stream lock, which trigger holds while taking a->lock, so it runs after
+ * a->lock is released.
+ */
+static void hws_audio_deliver(struct hws_audio *a, const void *data, bool from_card)
+{
+	struct snd_pcm_substream *ss = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&a->lock, flags);
+	if (a->running && a->substream && a->ring_frames) {
+		struct snd_pcm_runtime *rt = a->substream->runtime;
+		u32 first = min_t(u32, HWS_AUDIO_FRAMES, a->ring_frames - a->wpos);
+
+		memcpy(rt->dma_area + frames_to_bytes(rt, a->wpos), data, first * 4);
+		if (first < HWS_AUDIO_FRAMES)
+			memcpy(rt->dma_area, (const u8 *)data + first * 4,
+			       (HWS_AUDIO_FRAMES - first) * 4);
+		a->wpos = (a->wpos + HWS_AUDIO_FRAMES) % a->ring_frames;
+		a->period_used += HWS_AUDIO_FRAMES;
+		if (a->period_used >= a->period_frames) {
+			a->period_used %= a->period_frames;
+			ss = a->substream;
+		}
+		if (from_card) {
+			a->last_pkt_ns = ktime_get_ns();
+			a->silence_frames = 0;
+		}
+	}
+	spin_unlock_irqrestore(&a->lock, flags);
+	if (ss)
+		snd_pcm_period_elapsed(ss);
+}
+
+/* Called from the IRQ thread for each packet interrupt. */
+void hws_audio_packet(struct hws_pcie_dev *hws, unsigned int ch, u8 toggle)
+{
+	struct hws_audio *a = &hws->audio[ch];
+	const u8 *ring;
+
+	if (!READ_ONCE(a->running) || !hws->dma_buf_sz)
+		return;
+	if (a->skip) {
+		a->skip--;
+		return;
+	}
+	ring = (const u8 *)hws->scratch_vid[ch].cpu + hws->dma_buf_sz - HWS_AUDIO_RING_SIZE;
+	dma_rmb();	/* coherent memory: order the reads after the interrupt */
+	/* the toggle already points at the packet the card has moved on to */
+	hws_audio_deliver(a, toggle ? ring : ring + HWS_AUDIO_PKT_SIZE, true);
+}
+
+/*
+ * With no packets (a source changing mode, no source, a source with no audio),
+ * the pointer would stand still, and PipeWire would replay its last buffers as
+ * a buzz. Deliver silence at 48 kHz from the last packet's time instead.
+ */
+static void hws_audio_silence_work(struct work_struct *work)
+{
+	struct hws_audio *a = container_of(to_delayed_work(work), struct hws_audio, silence);
+	unsigned long next = msecs_to_jiffies(HWS_AUDIO_GAP_POLL_MS);
+	u64 gap, due;
+
+	if (!READ_ONCE(a->running))
+		return;
+	gap = ktime_get_ns() - READ_ONCE(a->last_pkt_ns);
+	if (gap > HWS_AUDIO_GAP_NS) {
+		due = div_u64(gap * 48, NSEC_PER_MSEC);
+		while (READ_ONCE(a->running) &&
+		       READ_ONCE(a->silence_frames) + HWS_AUDIO_FRAMES <= due) {
+			WRITE_ONCE(a->silence_frames, a->silence_frames + HWS_AUDIO_FRAMES);
+			hws_audio_deliver(a, hws_audio_silence, false);
+		}
+	} else {
+		next = msecs_to_jiffies(div_u64(HWS_AUDIO_GAP_NS - gap, NSEC_PER_MSEC) + 1);
+	}
+	queue_delayed_work(a->hws->auwq, &a->silence, max_t(unsigned long, 1, next));
+}
+
+static int hws_pcm_open(struct snd_pcm_substream *ss)
+{
+	struct hws_audio *a = snd_pcm_substream_chip(ss);
+	unsigned long flags;
+
+	ss->runtime->hw = hws_pcm_hw;
+	spin_lock_irqsave(&a->lock, flags);
+	a->substream = ss;
+	spin_unlock_irqrestore(&a->lock, flags);
+	/* whole packets, so periods end on packet boundaries */
+	return snd_pcm_hw_constraint_step(ss->runtime, 0, SNDRV_PCM_HW_PARAM_PERIOD_BYTES,
+					  HWS_AUDIO_PKT_SIZE);
+}
+
+static int hws_pcm_close(struct snd_pcm_substream *ss)
+{
+	struct hws_audio *a = snd_pcm_substream_chip(ss);
+	unsigned long flags;
+
+	spin_lock_irqsave(&a->lock, flags);
+	a->substream = NULL;
+	spin_unlock_irqrestore(&a->lock, flags);
+	return 0;
+}
+
+static int hws_pcm_hw_free(struct snd_pcm_substream *ss)
+{
+	struct hws_audio *a = snd_pcm_substream_chip(ss);
+
+	cancel_delayed_work_sync(&a->silence);
+	return 0;
+}
+
+static int hws_pcm_prepare(struct snd_pcm_substream *ss)
+{
+	struct hws_audio *a = snd_pcm_substream_chip(ss);
+	struct snd_pcm_runtime *rt = ss->runtime;
+	unsigned long flags;
+
+	spin_lock_irqsave(&a->lock, flags);
+	a->ring_frames = rt->buffer_size;
+	a->period_frames = rt->period_size;
+	a->wpos = 0;
+	a->period_used = 0;
+	spin_unlock_irqrestore(&a->lock, flags);
+	return 0;
+}
+
+static int hws_pcm_trigger(struct snd_pcm_substream *ss, int cmd)
+{
+	struct hws_audio *a = snd_pcm_substream_chip(ss);
+	unsigned long flags;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+		spin_lock_irqsave(&a->lock, flags);
+		a->wpos = 0;
+		a->period_used = 0;
+		a->skip = HWS_AUDIO_STALE_PKTS;
+		a->last_pkt_ns = ktime_get_ns();
+		a->silence_frames = 0;
+		WRITE_ONCE(a->running, true);
+		spin_unlock_irqrestore(&a->lock, flags);
+		queue_delayed_work(a->hws->auwq, &a->silence, 0);
+		hws_audio_enable(a, true);
+		return 0;
+	case SNDRV_PCM_TRIGGER_SUSPEND:	/* no RESUME: the app prepares and starts again */
+	case SNDRV_PCM_TRIGGER_STOP:
+		spin_lock_irqsave(&a->lock, flags);
+		WRITE_ONCE(a->running, false);
+		spin_unlock_irqrestore(&a->lock, flags);
+		cancel_delayed_work(&a->silence);
+		hws_audio_enable(a, false);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static snd_pcm_uframes_t hws_pcm_pointer(struct snd_pcm_substream *ss)
+{
+	struct hws_audio *a = snd_pcm_substream_chip(ss);
+	snd_pcm_uframes_t pos;
+	unsigned long flags;
+
+	spin_lock_irqsave(&a->lock, flags);
+	pos = a->wpos;
+	spin_unlock_irqrestore(&a->lock, flags);
+	return pos;
+}
+
+static const struct snd_pcm_ops hws_pcm_ops = {
+	.open = hws_pcm_open,
+	.close = hws_pcm_close,
+	.hw_free = hws_pcm_hw_free,
+	.prepare = hws_pcm_prepare,
+	.trigger = hws_pcm_trigger,
+	.pointer = hws_pcm_pointer,
+};
+
+int hws_audio_register(struct hws_pcie_dev *hws)
+{
+	struct device *dev = &hws->pdev->dev;
+	unsigned int ch;
+	int ret;
+
+	spin_lock_init(&hws->audio_en_lock);
+	hws->auwq = alloc_ordered_workqueue("hws-audio", 0);
+	if (!hws->auwq)
+		return -ENOMEM;
+
+	for (ch = 0; ch < hws->cur_max_video_ch; ch++) {
+		struct hws_audio *a = &hws->audio[ch];
+		struct snd_card *card;
+		struct snd_pcm *pcm;
+		char id[16], label[26];
+
+		a->hws = hws;
+		a->ch = ch;
+		spin_lock_init(&a->lock);
+		INIT_DELAYED_WORK(&a->silence, hws_audio_silence_work);
+
+		if (hws->cur_max_video_ch > 1)
+			snprintf(id, sizeof(id), "%sIn%u", hws->alsa_id, ch + 1);
+		else
+			strscpy(id, hws->alsa_id, sizeof(id));
+		ret = snd_card_new(dev, SNDRV_DEFAULT_IDX1, id, THIS_MODULE, 0, &card);
+		if (ret)
+			goto err;
+		a->card = card;
+		strscpy(card->driver, KBUILD_MODNAME, sizeof(card->driver));
+		hws_input_label(hws, ch, label, sizeof(label));
+		snprintf(card->shortname, sizeof(card->shortname), "%s Audio", label);
+		snprintf(card->longname, sizeof(card->longname), "%s at %s",
+			 card->shortname, pci_name(hws->pdev));
+
+		ret = snd_pcm_new(card, card->shortname, 0, 0, 1, &pcm);
+		if (ret)
+			goto err;
+		pcm->private_data = a;
+		strscpy(pcm->name, card->shortname, sizeof(pcm->name));
+		snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE, &hws_pcm_ops);
+		snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_CONTINUOUS, dev,
+					       hws_pcm_hw.buffer_bytes_max,
+					       hws_pcm_hw.buffer_bytes_max);
+		a->pcm = pcm;
+
+		ret = snd_card_register(card);
+		if (ret)
+			goto err;
+	}
+	return 0;
+
+err:
+	hws_audio_unregister(hws);
+	return ret;
+}
+
+/* Waits for open streams to close; disconnecting the cards makes them fail first. */
+void hws_audio_unregister(struct hws_pcie_dev *hws)
+{
+	unsigned int ch;
+
+	for (ch = 0; ch < hws->cur_max_video_ch; ch++) {
+		if (hws->audio[ch].card)
+			snd_card_disconnect(hws->audio[ch].card);
+	}
+	for (ch = 0; ch < hws->cur_max_video_ch; ch++) {
+		struct hws_audio *a = &hws->audio[ch];
+
+		if (!a->card)
+			continue;
+		WRITE_ONCE(a->running, false);
+		cancel_delayed_work_sync(&a->silence);
+		snd_card_free(a->card);
+		a->card = NULL;
+		a->pcm = NULL;
+	}
+	if (hws->auwq) {
+		destroy_workqueue(hws->auwq);
+		hws->auwq = NULL;
+	}
+}
+
+void hws_audio_suspend(struct hws_pcie_dev *hws)
+{
+	unsigned int ch;
+
+	for (ch = 0; ch < hws->cur_max_video_ch; ch++) {
+		if (!hws->audio[ch].card)
+			continue;
+		snd_power_change_state(hws->audio[ch].card, SNDRV_CTL_POWER_D3hot);
+		if (hws->audio[ch].pcm)
+			snd_pcm_suspend_all(hws->audio[ch].pcm);
+	}
+	if (hws->auwq)
+		flush_workqueue(hws->auwq);
+}
+
+void hws_audio_resume(struct hws_pcie_dev *hws)
+{
+	unsigned int ch;
+
+	for (ch = 0; ch < hws->cur_max_video_ch; ch++) {
+		if (hws->audio[ch].card)
+			snd_power_change_state(hws->audio[ch].card, SNDRV_CTL_POWER_D0);
+	}
+}
--- a/drivers/media/pci/hws/hws_audio.h
+++ b/drivers/media/pci/hws/hws_audio.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef HWS_AUDIO_H
+#define HWS_AUDIO_H
+
+#include <linux/types.h>
+
+/* The last 10 KiB of a channel's DMA buffer: two packets the card fills in turn. */
+#define HWS_AUDIO_RING_SIZE	(10 * 1024)
+#define HWS_AUDIO_PKT_SIZE	4096
+
+struct hws_pcie_dev;
+
+int hws_audio_register(struct hws_pcie_dev *hws);
+void hws_audio_unregister(struct hws_pcie_dev *hws);
+void hws_audio_suspend(struct hws_pcie_dev *hws);
+void hws_audio_resume(struct hws_pcie_dev *hws);
+void hws_audio_packet(struct hws_pcie_dev *hws, unsigned int ch, u8 toggle);
+
+#endif
--- a/drivers/media/pci/hws/hws_convert.c
+++ b/drivers/media/pci/hws/hws_convert.c
@@ -0,0 +1,563 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The vendor drivers' conversions for cards that capture in their own 4:2:0
+ * layouts (register 88's format field): those layouts match no V4L2 format, so
+ * they become YUYV on the CPU. Taken unchanged from those drivers.
+ */
+#include "hws_convert.h"
+
+void FillNV12ToYUY2(BYTE *pSrc,BYTE *pOut, int nw,int nh,int interlace)
+{
+	BYTE *pVideoMem = pOut ;// g_pD1TempBuffer;
+	//DWORD dwDstPitch = nw;
+	DWORD dwSrcPitch;
+	DWORD dwPacket;
+	BYTE *pSrc1;
+	BYTE *pDstYUV = (BYTE *)pVideoMem;
+	BYTE *pNextLineSrc1;
+	DWORD dwJ;
+	BYTE bLineSel=0;
+	BOOL bUVSel;
+	DWORD dwI;
+	dwSrcPitch = nw*12/8;
+	dwPacket = dwSrcPitch/24;
+
+	pSrc1  = (BYTE *)pSrc;
+	pDstYUV = (BYTE *)pVideoMem;
+
+	if(interlace ==0)
+	{
+		for(dwI=0; dwI <nh; dwI++)
+		{
+			switch(bLineSel)
+			{
+				case 0:
+				{
+					bUVSel =0;
+					pNextLineSrc1 = (BYTE *)pSrc1+dwSrcPitch+nw; //  line2
+					for( dwJ=0; dwJ<dwPacket; dwJ++)
+					{
+
+						//-----------y0 ~y3
+						pDstYUV[0] = pSrc1[0];
+						pDstYUV[2] = pSrc1[1];
+						pDstYUV[4] = pSrc1[2];
+						pDstYUV[6] = pSrc1[3];
+						//y4~y7
+						pDstYUV[8]  =  pSrc1[8];
+						pDstYUV[10] =  pSrc1[9];
+						pDstYUV[12] =  pSrc1[10];
+						pDstYUV[14] =  pSrc1[11];
+						//----y8~y11
+						pDstYUV[16]= pSrc1[12];
+						pDstYUV[18]= pSrc1[13];
+						pDstYUV[20] = pSrc1[14];
+						pDstYUV[22] = pSrc1[15];
+						//y12~y15
+						pDstYUV[24] =  pSrc1[20];
+						pDstYUV[26] =  pSrc1[21];
+						pDstYUV[28] =  pSrc1[22];
+						pDstYUV[30] =  pSrc1[23];
+
+						if(bUVSel)
+						{
+							pDstYUV[3] =pSrc1[4];
+							pDstYUV[7] =pSrc1[5];
+							pDstYUV[11] =pSrc1[6];
+							pDstYUV[15] =pSrc1[7];
+
+							pDstYUV[19] =pSrc1[16];
+							pDstYUV[23] =pSrc1[17];
+							pDstYUV[27] =pSrc1[18];
+							pDstYUV[31] =pSrc1[19];
+
+
+							pDstYUV[1] =pNextLineSrc1[4];
+							pDstYUV[5] =pNextLineSrc1[5];
+							pDstYUV[9] =pNextLineSrc1[6];
+							pDstYUV[13] =pNextLineSrc1[7];
+
+							pDstYUV[17] =pNextLineSrc1[16];
+							pDstYUV[21] =pNextLineSrc1[17];
+							pDstYUV[25] =pNextLineSrc1[18];
+							pDstYUV[29] =pNextLineSrc1[19];
+
+						}
+						else
+						{
+
+							pDstYUV[3]  = pNextLineSrc1[4];
+							pDstYUV[7]  = pNextLineSrc1[5];
+							pDstYUV[11]  = pNextLineSrc1[6];
+							pDstYUV[15] = pNextLineSrc1[7];
+
+							pDstYUV[19]  = pNextLineSrc1[16];
+							pDstYUV[23]  = pNextLineSrc1[17];
+							pDstYUV[27]  = pNextLineSrc1[18];
+							pDstYUV[31] =  pNextLineSrc1[19];
+
+
+							pDstYUV[1] =pSrc1[4];
+							pDstYUV[5] =pSrc1[5];
+							pDstYUV[9] =pSrc1[6];
+							pDstYUV[13] =pSrc1[7];
+
+							pDstYUV[17] =pSrc1[16];
+							pDstYUV[21] =pSrc1[17];
+							pDstYUV[25] =pSrc1[18];
+							pDstYUV[29] =pSrc1[19];
+
+						}
+						pSrc1+=24;
+						pNextLineSrc1 +=24;
+						pDstYUV+=32;
+					}
+					break;
+				}
+				case 1:
+				{
+					memcpy(pDstYUV,pDstYUV-(nw*2),nw*2); // copy up line
+					//-----modify the curr line
+					for( dwJ=0; dwJ<nw; dwJ++)
+					{
+						pDstYUV[0] = pSrc1[0];
+						pDstYUV +=2;
+						pSrc1 ++;
+					}
