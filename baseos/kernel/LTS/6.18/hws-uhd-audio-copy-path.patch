+	if (!v->parent->copy_mode || vb2_is_busy(&v->buffer_queue) ||
+	    (v->pix.width == v->in_w && v->pix.height == h))
+		return;
+	v->pix.width = v->in_w;
+	v->pix.height = h;
+	hws_calc_sizeimage(v, v->in_w, v->in_h, v->in_il);
+	if (!v->parent->uhd)
