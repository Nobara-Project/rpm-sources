@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Keeps a capture running when the source changes mode: the program's buffers
+ * keep the size it started with, and each frame is fitted to them. Nearest pixel,
+ * keeping the shape, with black bars. A program that restarts capture gets the
+ * input's own size and never comes through here.
+ */
+#include "hws_scale.h"
+
+#define HWS_BARS_Y	0x00	/* the cards deliver full-range video */
+#define HWS_BARS_C	0x80
+
+/*
+ * Fit the @sw x @sh YUYV frame into @dw x @dh. @disp_h is the height it shows at,
+ * which is twice @sh for an interlaced field. All sizes must be even and non-zero.
+ */
+void hws_scale_yuyv(const u8 *src, u32 sw, u32 sh, u32 disp_h,
+		    u8 *dst, u32 dw, u32 dh)
+{
+	u32 rw = dw, rh = (u32)((u64)dw * disp_h / sw);
+	u32 x0, y0, x, y, xstep, ystep, ypos = 0;
+
+	if (rh > dh) {
+		rh = dh;
+		rw = (u32)((u64)dh * sw / disp_h);
+	}
+	rw &= ~1U;
+	if (!rw)
+		rw = 2;
+	if (!rh)
+		rh = 1;
+	x0 = ((dw - rw) / 2) & ~1U;
+	y0 = (dh - rh) / 2;
+	/* 16.16 fixed point; the largest sizes here are 4096 and 2160 */
+	xstep = (sw << 16) / rw;
+	ystep = (sh << 16) / rh;
+
+	for (y = 0; y < dh; y++) {
+		u8 *d = dst + (u64)y * dw * 2;
+
+		if (y < y0 || y >= y0 + rh) {
+			for (x = 0; x < dw; x++) {
+				*d++ = HWS_BARS_Y;
+				*d++ = HWS_BARS_C;
+			}
+			continue;
+		}
+		for (x = 0; x < x0; x++) {
+			*d++ = HWS_BARS_Y;
+			*d++ = HWS_BARS_C;
+		}
+		{
+			const u8 *line = src + (u64)(ypos >> 16) * sw * 2;
+			u32 xpos = 0;
+
+			for (x = 0; x < rw; x += 2) {
+				u32 a = xpos >> 16;
+				u32 b = (xpos + xstep) >> 16;
+				u32 pair = a & ~1U;
+
+				d[0] = line[a * 2];
+				d[1] = line[pair * 2 + 1];
+				d[2] = line[b * 2];
+				d[3] = line[pair * 2 + 3];
+				d += 4;
+				xpos += 2 * xstep;
+			}
+		}
+		for (x = x0 + rw; x < dw; x++) {
+			*d++ = HWS_BARS_Y;
+			*d++ = HWS_BARS_C;
+		}
+		ypos += ystep;
+	}
+}
