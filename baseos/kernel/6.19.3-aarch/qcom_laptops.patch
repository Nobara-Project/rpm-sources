@@ -617,6 +659,10 @@ static int qcom_smp2p_probe(struct platform_device *pdev)
 		}
 	}
 
+	if (smp2p->in)
+		/* Ignore return status since we kick unconditionally below */
+		qcom_smp2p_scan(smp2p);
