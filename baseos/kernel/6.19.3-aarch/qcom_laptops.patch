 	.parse_fw = qcom_register_dump_segments,
 	.load = qcom_pas_load,
@@ -698,7 +734,7 @@ static int qcom_pas_probe(struct platform_device *pdev)
 	}
 
 	if (desc->auto_boot)
-		rproc->auto_boot = RPROC_AUTO_BOOT_ATTACH_OR_START;
