+import time
+from openrazer.client.device import RazerDeviceFactory
+d = RazerDeviceFactory.get_device('HYPERFLUXV2_RECEIVER001')
+assert d.receiver_info['pairing_control'] is True
+assert d.receiver_pairing_status['kernel']['ready'] is True
+job = d.scan_receiver_devices('keyboard')
