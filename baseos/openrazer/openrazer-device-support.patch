diff --git a/scripts/ci/test-hyperflux-auto.c b/scripts/ci/test-hyperflux-auto.c
new file mode 100644
index 00000000..34bff095
--- /dev/null
+++ b/scripts/ci/test-hyperflux-auto.c
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <assert.h>
+#include <stdio.h>
+#include "../../driver/razerhyperflux_pairing.h"
+
+int main(void)
+{
+    unsigned short slots[2] = {0xffff, 0xffff};
+    unsigned int mask, cursor, pid;
+    for (mask = 0; mask < 4; mask++) {
+        for (cursor = 0; cursor < 2; cursor++) {
+            int selected = hyperflux_auto_slot(mask, cursor, slots);
+            assert(selected == (mask == 0 ? -1 : mask == 1 ? 0 : mask == 2 ? 1 : (int)cursor));
+            assert(!hyperflux_auto_authorized(mask, selected, 12, 13)); /* Stop/re-enable generation */
+            assert(!hyperflux_auto_authorized(0, selected, 12, 12));
+            if (selected >= 0) assert(hyperflux_auto_authorized(mask, selected, 12, 12));
+        }
+    }
+    assert(!hyperflux_auto_authorized(3, -1, 0, 0));
+    assert(!hyperflux_auto_authorized(3, 2, 0, 0));
+    assert(hyperflux_auto_slot(4, 0, slots) == -1);
+    for (pid = 1; pid < 0xffff; pid++) {
+        slots[0] = pid; slots[1] = 0xffff;
+        assert(hyperflux_auto_slot(3, 0, slots) == 1);
+        assert(hyperflux_auto_slot(1, 0, slots) == -1);
+        slots[0] = 0xffff; slots[1] = pid;
+        assert(hyperflux_auto_slot(3, 1, slots) == 0);
+        assert(hyperflux_auto_slot(2, 1, slots) == -1);
+        slots[0] = pid;
+        assert(hyperflux_auto_slot(3, 0, slots) == -1);
+    }
+    slots[0] = 0; slots[1] = 0xffff;
+    assert(hyperflux_auto_slot(3, 0, slots) == -1);
+    for (cursor = 0; cursor < 2; cursor++) {
+        unsigned char start[16] = {cursor ? 9 : 5, 0x37, 1};
+        unsigned char empty[16] = {cursor ? 9 : 5, 0x37, 2};
+        unsigned char found[16] = {cursor ? 9 : 5, 0x37, 2, 1, 0, 0xe8, cursor ? 1 : 0};
+        struct hyperflux_event scan = {.report = start[0], .command = 0x37};
+        assert(!hyperflux_discovered(&scan, cursor));
+        hyperflux_event_feed(&scan, start, 16);
+        assert(!hyperflux_discovered(&scan, cursor));
+        hyperflux_event_feed(&scan, empty, 16);
+        assert(!hyperflux_discovered(&scan, cursor)); /* Never pair after empty discovery. */
+        scan = (struct hyperflux_event){.report = start[0], .command = 0x37};
+        hyperflux_event_feed(&scan, start, 16);
+        hyperflux_event_feed(&scan, found, 16);
+        assert(hyperflux_discovered(&scan, cursor));
+        assert(!hyperflux_discovered(&scan, !cursor)); /* Never cross slots. */
+        scan.error = 1;
+        assert(!hyperflux_discovered(&scan, cursor));
+        scan.error = 0; scan.command = 0x36;
+        assert(!hyperflux_discovered(&scan, cursor)); /* Pair completion isn't discovery. */
+        /* Multiple candidates must never become automatic authorization. */
+        unsigned char report[16] = {cursor ? 9 : 5, 0x37, 2, 2, 0, 0xe8};
+        struct hyperflux_event event = {.report = report[0], .command = 0x37, .started = 1};
+        assert(hyperflux_event_feed(&event, report, 16));
+        assert(event.done && event.error && !event.candidate);
+    }
+    puts("HyperFlux auto-pair policy: both slots, model-independent emptiness, generations, ambiguity passed");
+    return 0;
+}
