+    time.sleep(0.01)
+assert status['id'] == job and status['result'] == 'empty'
+try:
+    d.pair_receiver_device('ffff', '0123456789abcdef')
+except ValueError:
+    pass
+else:
+    raise AssertionError('Invalid PID accepted')
+job = d.pair_receiver_device('00e8', '0123456789abcdef')
+deadline = time.monotonic() + 3
+while time.monotonic() < deadline:
+    status = d.receiver_pairing_status['job']
+    if status['state'] != 'running': break
+    time.sleep(0.01)
+assert status['id'] == job and status['state'] == 'complete'
+"""
+                result = subprocess.run([sys.executable, '-c', query], capture_output=True, text=True, timeout=10)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual((self.nodes[4] / 'hyperflux_scan').read_text(), 'keyboard\n')
