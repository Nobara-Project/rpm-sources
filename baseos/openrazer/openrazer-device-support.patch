+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Keyboard registration and controls with fake sysfs; no hardware writes."""
+import configparser
+import logging
+import os
+import shutil
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import threading
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+import dbus.mainloop.glib
+from gi.repository import GLib
+from openrazer_daemon.daemon import RazerDaemon
+from openrazer_daemon.device import DeviceCollection
+from openrazer_daemon.hardware import get_device_classes
+from openrazer_daemon.hardware._hyperflux_keyboard import _HyperFluxKeyboard, keyboard_class
+
+
+class HyperFluxKeyboardTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.usb = Path(self.tmp.name) / '1-3'
+        self.interface = self.usb / '1-3:1.4'
+        self.hid = self.interface / '0003:1532:00CF.0004'
+        self.group = self.hid / 'hyperflux_keyboard'
+        self.group.mkdir(parents=True)
+        (self.usb / 'serial').write_text('RECEIVER001')
+        (self.interface / 'bInterfaceNumber').write_text('04')
+        for name, content in {
+                'paired_device_pid': '02d5', 'version': '3.12.4', 'firmware_version': 'v1.4',
+                'matrix_brightness': '76', 'charge_level': '153', 'charge_status': '0',
+                'game_led_state': '0', 'poll_rate': '1000', 'matrix_effect_static': '',
+                'matrix_effect_wave': '', 'matrix_effect_none': '', 'matrix_effect_custom': '',
+                'matrix_custom_frame': ''}.items():
+            (self.group / name).write_text(content)
+        (self.hid / 'matrix_brightness').write_text('111')  # Mouse, must stay untouched.
+        (self.hid / 'matrix_effect_static').write_text('mouse')
+        config = configparser.ConfigParser()
+        config.read_dict({'Startup': {'restore_persistence': 'true', 'persistence_dual_boot_quirk': 'true'},
+                          'Device:HYPERFLUXV2_RECEIVER001_KBD_02D5': {'driver_mode': 'true'}})
+        self.daemon = SimpleNamespace(
+            _razer_devices=DeviceCollection(), _config=config, _persistence=configparser.ConfigParser(),
+            _test_dir=None, _unknown_serial_counter={}, logger=logging.getLogger('test-keyboard'),
+            device_added=Mock(), device_removed=Mock(), write_persistence=Mock(), _persistence_file=None)
+        self.daemon._persistence.status = {'changed': False}
+
+    def test_only_management_group_is_a_keyboard_child(self):
+        self.assertEqual(_HyperFluxKeyboard.control_path(self.hid.name, self.hid), self.group)
+        (self.interface / 'bInterfaceNumber').write_text('01')
+        self.assertIsNone(_HyperFluxKeyboard.control_path(self.hid.name, self.hid))
+        self.assertIsNone(_HyperFluxKeyboard.control_path('0003:1532:02D5.0004', self.hid))
+
+    def test_keyboard_helpers_are_not_automatic_hid_classes(self):
+        self.assertFalse(any(issubclass(c, _HyperFluxKeyboard) for c in get_device_classes()))
+        self.assertIs(keyboard_class(0x02d5), keyboard_class(0x02d5))
+        self.assertIsNot(keyboard_class(0x02d5), keyboard_class(0x0296))
+
+    def test_identity_and_driver_paths_are_receiver_scoped(self):
+        keyboard = object.__new__(_HyperFluxKeyboard)
+        keyboard._is_closed = True
+        keyboard._serial = None
+        keyboard._device_path = str(self.group)
+        keyboard.USB_PID = 0x02d5
+        self.assertEqual(keyboard.get_serial(), 'HYPERFLUXV2_RECEIVER001_KBD_02D5')
+        self.assertEqual(keyboard.get_driver_path('matrix_brightness'), str(self.group / 'matrix_brightness'))
+        keyboard._serial = None
+        (self.usb / 'serial').write_text('RECEIVER002')
+        self.assertEqual(keyboard.get_serial(), 'HYPERFLUXV2_RECEIVER002_KBD_02D5')
+
+    def test_pid_specific_group_discovery_and_ambiguity(self):
+        moved = self.hid / 'hyperflux_keyboard_02d5'
+        self.group.rename(moved)
+        self.assertEqual(_HyperFluxKeyboard.control_path(self.hid.name, self.hid), moved)
+        (self.hid / 'hyperflux_keyboard_0296').mkdir()
+        self.assertIsNone(_HyperFluxKeyboard.control_path(self.hid.name, self.hid))
+
+    @unittest.skipUnless(os.environ.get('OPENRAZER_TEST_PRIVATE_BUS') == '1', 'Requires isolated test bus')
+    def test_change_event_adds_replaces_and_removes_keyboard_without_replug(self):
+        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
+        event = SimpleNamespace(sys_name=self.hid.name, sys_path=str(self.hid))
+        current = self.hid / 'hyperflux_keyboard_02d5'
+        self.group.rename(current)
+        try:
+            RazerDaemon._sync_hyperflux_keyboard(self.daemon, event)
+            self.daemon.device_added.assert_called_once()
+            old = next(iter(self.daemon._razer_devices)).dbus
+            self.assertEqual(old.USB_PID, 0x02d5)
+            self.assertEqual(old._device_path, str(current))
+            RazerDaemon._sync_hyperflux_keyboard(self.daemon, event)
+            self.daemon.device_added.assert_called_once()
+            replacement = self.hid / 'hyperflux_keyboard_0296'
+            current.rename(replacement)
+            (replacement / 'paired_device_pid').write_text('0296')
+            RazerDaemon._sync_hyperflux_keyboard(self.daemon, event)
+            self.assertTrue(old._is_closed)
+            new = next(iter(self.daemon._razer_devices)).dbus
+            self.assertEqual(new.USB_PID, 0x0296)
+            self.assertEqual(new.getDeviceName(), 'Razer DeathStalker V2 Pro TKL (HyperFlux V2)')
+            self.assertEqual(new.getMatrixDimensions(), [6, 17])
+            with self.assertRaises(OSError):
+                old.read_brightness()  # Old PID path cannot control the replacement.
+            shutil.rmtree(replacement)
+            RazerDaemon._sync_hyperflux_keyboard(self.daemon, event)
+            self.assertEqual(len(self.daemon._razer_devices), 0)
+            self.assertTrue(new._is_closed)
+            self.assertEqual(self.daemon.device_added.call_count, 2)
+            self.assertEqual(self.daemon.device_removed.call_count, 2)
+            self.assertEqual((self.hid / 'matrix_effect_static').read_text(), 'mouse')
+        finally:
+            RazerDaemon._remove_device(self.daemon, event)
+
+    @unittest.skipUnless(os.environ.get('OPENRAZER_TEST_PRIVATE_BUS') == '1', 'Requires isolated test bus')
+    def test_two_models_and_pads_have_separate_identity_capabilities_and_files(self):
+        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
+        other_usb = Path(self.tmp.name) / '2-5'
+        other_hid = other_usb / '2-5:1.4' / '0003:1532:00CF.0009'
+        other_group = other_hid / 'hyperflux_keyboard'
+        other_group.parent.mkdir(parents=True)
+        shutil.copytree(self.group, other_group)
+        (other_usb / 'serial').write_text('RECEIVER002')
+        (other_hid.parent / 'bInterfaceNumber').write_text('04')
+        (other_group / 'paired_device_pid').write_text('0296')
+        registered = []
+        try:
+            for hid in (self.hid, other_hid):
+                self.assertTrue(RazerDaemon._add_hyperflux_keyboard(self.daemon, hid.name, str(hid)))
+                registered.append(hid)
+            first, second = [d.dbus for d in self.daemon._razer_devices]
+            self.assertNotEqual(first.get_serial(), second.get_serial())
+            self.assertEqual(first.getMatrixDimensions(), [6, 18])
+            self.assertEqual(second.getMatrixDimensions(), [6, 17])
+            self.assertIn('BlackWidow', first.getDeviceName())
+            self.assertEqual(second.getDeviceName(), 'Razer DeathStalker V2 Pro TKL (HyperFlux V2)')
+            self.assertIn('set_poll_rate', first.METHODS)
+            self.assertNotIn('set_poll_rate', second.METHODS)
+            second.setBrightness(20)
+            self.assertEqual((self.group / 'matrix_brightness').read_text(), '76')
+            self.assertEqual((other_group / 'matrix_brightness').read_text(), '51')
+            RazerDaemon._remove_device(self.daemon, SimpleNamespace(sys_name=other_hid.name))
+            registered.remove(other_hid)
+            self.assertEqual(len(self.daemon._razer_devices), 1)
+            self.assertFalse(first._is_closed)
+        finally:
+            for hid in registered:
+                RazerDaemon._remove_device(self.daemon, SimpleNamespace(sys_name=hid.name))
+
+    @unittest.skipUnless(os.environ.get('OPENRAZER_TEST_PRIVATE_BUS') == '1', 'Requires isolated test bus')
+    def test_registration_client_controls_no_startup_writes_and_remove(self):
+        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
+        before = {p: p.read_bytes() for p in self.group.iterdir()}
+        self.assertTrue(RazerDaemon._add_hyperflux_keyboard(self.daemon, self.hid.name, str(self.hid)))
+        keyboard = next(iter(self.daemon._razer_devices)).dbus
+        try:
+            self.assertFalse(RazerDaemon._add_hyperflux_keyboard(self.daemon, self.hid.name, str(self.hid)))
+            self.assertEqual({p: p.read_bytes() for p in self.group.iterdir()}, before)
+            self.assertFalse(keyboard.DRIVER_MODE)
+            self.assertEqual(keyboard.getDeviceName(), 'Razer BlackWidow V4 Tenkeyless HyperSpeed (HyperFlux V2)')
+            self.assertEqual(keyboard.getDeviceType(), 'keyboard')
+            self.assertEqual(keyboard.getMatrixDimensions(), [6, 18])
+            self.assertAlmostEqual(keyboard.getBrightness(), 76 * 100 / 255)
+            # Exercise real client introspection/signatures on a private bus.
+            loop = GLib.MainLoop()
+            thread = threading.Thread(target=loop.run, daemon=True)
+            thread.start()
+            try:
+                query = """
+from openrazer.client.device import RazerDeviceFactory
+d = RazerDeviceFactory.get_device('HYPERFLUXV2_RECEIVER001_KBD_02D5')
+assert d.name.endswith(' (HyperFlux V2)')
+assert d.type == 'keyboard'
+assert d.has('brightness') and d.has('battery')
+assert d.has('lighting_led_matrix')
+assert not d.has('hyperflux_receiver')
+assert d.battery_level == 60
+d.brightness = 50
+d.fx.static(10, 20, 30)
+d.fx.wave(1)
+d.fx.none()
+d.poll_rate = 500
+"""
+                result = subprocess.run([sys.executable, '-c', query], capture_output=True, text=True, timeout=10)
+                self.assertEqual(result.returncode, 0, result.stderr)
+            finally:
+                loop.quit()
+                thread.join(timeout=3)
+            self.assertEqual((self.group / 'matrix_brightness').read_text(), str(int(round(50 * (255 / 100)))))
+            self.assertEqual((self.group / 'matrix_effect_static').read_bytes(), bytes([10, 20, 30]))
+            self.assertEqual((self.group / 'poll_rate').read_text(), '500')
+            self.assertEqual((self.hid / 'matrix_brightness').read_text(), '111')
+            self.assertEqual((self.hid / 'matrix_effect_static').read_text(), 'mouse')
+        finally:
+            RazerDaemon._remove_device(self.daemon, SimpleNamespace(sys_name=self.hid.name))
+        self.assertEqual(len(self.daemon._razer_devices), 0)
+        self.assertTrue(keyboard._is_closed)
+        self.daemon.device_removed.assert_called_once()
