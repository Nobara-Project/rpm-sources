+                result = subprocess.run([sys.executable, '-c', query], capture_output=True, text=True, timeout=10)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(auto_pair.read_text(), '0\n')
+                self.assertEqual(driver_auto_pair.read_text(), '0\n')
+                # Exercise new API registration and client signatures over the
+                # real private bus, but with ordinary files instead of sysfs.
+                kernel = {'ready': True, 'busy': False, 'blocked': False, 'error': 0,
+                          'protocol_version': 2, 'candidate_type': '',
+                          'candidate': 0, 'token': '0000000000000000'}
