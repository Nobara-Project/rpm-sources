+            self.assertFalse(device.disable_notify)
+            self.assertFalse(device.disable_persistence)
+
+    def test_mouse_membership_not_snapshot_or_awake_flag(self):
+        with tempfile.TemporaryDirectory() as root:
+            path = Path(root)
