+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Read-only receiver and daemon lifecycle tests; use an isolated session bus."""
+import configparser
+import json
+import logging
+import os
+import subprocess
+import sys
+import threading
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+
+import dbus.mainloop.glib
+from gi.repository import GLib
+from openrazer_daemon.daemon import RazerDaemon
+from openrazer_daemon.device import DeviceCollection
+from openrazer_daemon.hardware.hyperflux import RazerHyperFluxV2
+from openrazer_daemon.hardware.mouse import RazerNagaV2ProWired, RazerNagaV3ProWired, RazerHyperFluxV2NagaV3Pro
+
+
+class ReceiverTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.usb = Path(self.temp.name) / '1-1'
+        self.usb.mkdir()
+        (self.usb / 'serial').write_text('RECEIVER001')
+        self.nodes = []
+        for number in range(5):
+            interface = self.usb / f'1-1:1.{number}'
+            interface.mkdir()
+            (interface / 'bInterfaceNumber').write_text(f'{number:02x}')
+            node = interface / f'0003:1532:00CF.00A{number}'
+            node.mkdir()
+            self.nodes.append(node)
+        self.obj = object.__new__(RazerHyperFluxV2)
+        self.obj._is_closed = True
+        self.obj._serial = None
+        self.obj._device_path = str(self.nodes[0])
+
+    def test_single_parent_and_no_control_interface_required(self):
+        self.assertTrue(RazerHyperFluxV2.match(self.nodes[0].name, self.nodes[0]))
+        for node in self.nodes[1:]:
+            self.assertFalse(RazerHyperFluxV2.match(node.name, node))
+        self.assertFalse(RazerHyperFluxV2.match('0003:1532:00A8.00A0', self.nodes[0]))
+        self.assertEqual(self.obj.get_serial(), 'HYPERFLUXV2_RECEIVER001')
+
+    def test_unknown_mouse_is_not_reported_as_unpaired(self):
+        info = json.loads(self.obj.receiver_info())
+        self.assertIsNone(info['mouse_pid'])
+        self.assertFalse(info['pairing_control'])
+        self.assertFalse(info['charging_policy_control'])
+        self.assertEqual(info['keyboard_inventory'], 'unavailable')
+
+    def test_snapshot_is_from_same_physical_receiver(self):
+        attr = self.nodes[4] / 'paired_device_pid'
+        for raw, expected in [('00e8', '00e8'), ('00a8', '00a8'), ('ffff', None), ('garbage', None)]:
+            attr.write_text(raw)
+            info = json.loads(self.obj.receiver_info())
+            self.assertEqual(info['mouse_pid'], expected)
+            self.assertEqual(info['inventory_source'], 'driver-binding-snapshot')
+
+    def test_stable_safe_identity_without_serial(self):
+        (self.usb / 'serial').unlink()
+        serial = self.obj.get_serial()
+        self.assertRegex(serial, r'^HYPERFLUXV2_PORT_[0-9A-F]{16}$')
+        self.obj._serial = None
+        self.assertEqual(serial, self.obj.get_serial())
+
+    def test_live_inventory_and_failed_read_never_fallback_to_snapshot(self):
+        (self.nodes[4] / 'paired_device_pid').write_text('00e8')
+        attr = self.nodes[4] / 'hyperflux_inventory'
+        # Exact 80-byte args from Synapse trace 003, 00:bf SUCCESS reply.
+        raw = '020100a800ffff' + '00' * 73
+        attr.write_text(raw + '\n')
+        info = json.loads(self.obj.receiver_info())
+        self.assertEqual(info['mouse_pid'], '00a8')
+        self.assertEqual(info['inventory_source'], 'live-receiver-report')
+        self.assertEqual(info['keyboard_slot'], '00ffff')
+        self.assertEqual(info['keyboard_inventory'], 'live-receiver-report')
+        for invalid in ('garbage', raw[:-2], '03' + raw[2:], raw[:-2] + '01',
+                        '0202' + raw[4:], raw + '00'):
+            attr.write_text(invalid)
+            info = json.loads(self.obj.receiver_info())
+            self.assertIsNone(info['mouse_pid'])
+            self.assertEqual(info['inventory_source'], 'unavailable')
+            self.assertIn('inventory_error', info)
+
+    def test_management_uses_only_same_receiver_interface_four(self):
+        unrelated = self.nodes[1] / 'hyperflux_auto_pair'
+        unrelated.write_text('unchanged')
+        with self.assertRaises(NotImplementedError):
+            self.obj.set_auto_pair(True)
+        attr = self.nodes[4] / 'hyperflux_auto_pair'
+        attr.touch()
+        self.assertIsNone(json.loads(self.obj.receiver_info())['auto_pair_last_ack'])
+        for enabled in (True, False):
+            self.obj.set_auto_pair(enabled)
+            self.assertEqual(attr.read_text(), '1\n' if enabled else '0\n')
+            info = json.loads(self.obj.receiver_info())
+            self.assertIsNone(info['auto_pair'])
+            self.assertEqual(info['auto_pair_last_ack'], enabled)
+        self.assertEqual(unrelated.read_text(), 'unchanged')
+        for invalid in ('false', None, 2, -1, 1.0):
+            with self.assertRaises(ValueError):
+                self.obj.set_auto_pair(invalid)
+        with patch.object(Path, 'write_text', side_effect=OSError('unsupported')):
+            with self.assertRaises(OSError):
+                self.obj.set_auto_pair(True)
+        self.assertFalse(json.loads(self.obj.receiver_info())['auto_pair_last_ack'])
+
+    def test_membership_survives_presence_flag_changes(self):
+        for prefix in ('020100a80102d5', '020000a80102d5', '020100a80002d5'):
+            info = self.obj._decode_inventory(prefix + '00' * 73)
+            self.assertEqual(info['mouse_pid'], '00a8')
+            self.assertEqual(info['keyboard_pid'], '02d5')
+
+    def test_driver_auto_pair_is_configuration_only_and_both_slots_are_independent(self):
+        with self.assertRaises(NotImplementedError):
+            self.obj.set_driver_auto_pair(True, True)
+        node = self.nodes[4] / 'hyperflux_driver_auto_pair'
+        node.touch()
+        firmware = self.nodes[4] / 'hyperflux_auto_pair'
+        firmware.write_text('untouched')
+        for mouse, keyboard, mask in ((False, False, 0), (True, False, 1),
+                                      (False, True, 2), (True, True, 3)):
+            self.obj.set_driver_auto_pair(mouse, keyboard)
+            self.assertEqual(node.read_text(), f'{mask}\n')
