 /**
  * Function to send to device, get response, and actually check the response
  */
+/* The receiver routes lane 0x1f to its paired mouse on interface zero.
+ * Only interface four exposes controls; other interfaces pass input unchanged
+ * through the generic HID parser, with no OpenRazer input translation.
+ * Also use this checked exchange for the new standalone Naga V3 devices.
+ * Never retry a SET: a delayed reply must not cause a write to be repeated.
+ * Called with device->lock held.
+ */
+static int razer_checked_get_report(struct razer_mouse_device *device,
+                              unsigned int index,
+                              struct razer_report *request,
+                              struct razer_report *response)
+{
+    struct razer_report *reply;
+    unsigned int attempt;
+    int ret;
+
+    request->crc = razer_calculate_crc(request);
+    reply = kzalloc(sizeof(*reply), GFP_KERNEL);
+    if (!reply)
+        return -ENOMEM;
+    ret = razer_send_control_msg(device->usb_dev, request, index, 100000, 100100);
+    if (ret)
+        goto out;
+    for (attempt = 0; attempt < 5; attempt++) {
+        memset(reply, 0, sizeof(*reply));
+        ret = usb_control_msg(device->usb_dev,
+                              usb_rcvctrlpipe(device->usb_dev, 0),
+                              HID_REQ_GET_REPORT,
+                              USB_TYPE_CLASS | USB_RECIP_INTERFACE | USB_DIR_IN,
+                              0x300, index, reply, sizeof(*reply),
+                              USB_CTRL_GET_TIMEOUT);
+        if (ret < 0)
+            goto out;
+        if (ret != sizeof(*reply) ||
+            reply->crc != razer_calculate_crc(reply) ||
+            reply->data_size > sizeof(reply->arguments)) {
+            ret = -EIO;
+            goto out;
+        }
+        if (reply->transaction_id.id == request->transaction_id.id &&
+            reply->remaining_packets == request->remaining_packets &&
+            reply->command_class == request->command_class &&
+            reply->command_id.id == request->command_id.id &&
+            reply->status != RAZER_CMD_BUSY) {
+            if (reply->status != RAZER_CMD_SUCCESSFUL) {
+                ret = reply->status == RAZER_CMD_NOT_SUPPORTED ? -EOPNOTSUPP :
+                      reply->status == RAZER_CMD_TIMEOUT ? -ETIMEDOUT : -EIO;
+                goto out;
+            }
+            *response = *reply;
+            ret = 0;
+            goto out;
+        }
+        msleep(100);
+    }
+    ret = -ETIMEDOUT;
+out:
+    kfree(reply);
+    return ret;
+}
