+    if (!mutex_trylock(&device->lock))
+        return -EBUSY;
+    request.transaction_id.id = 0xf0 | (device->hyperflux_sequence++ & 0x0f);
+    ret = razer_checked_get_report(device, 0, &request, &response);
+    mutex_unlock(&device->lock);
+    if (ret)
+        return ret;
+    if (response.data_size != 0x50)
+        return -EPROTO;
