@@ -0,0 +1,115 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Receiver mouse lifecycle must not depend on an awake wireless device."""
+import hashlib
+import errno
+import os
+import re
+from pathlib import Path as _Path
+
+
+class _HyperFluxMouse:
+    # Mixin, not an independently discoverable hardware class.
+    EVENT_FILE_REGEX = None
+
+    @staticmethod
+    def receiver_path(device_path):
+        path = _Path(device_path)
+        return path.parent if re.fullmatch(r'hyperflux_mouse_[0-9a-f]{4}', path.name) else path
+
+    @classmethod
+    def control_path(cls, device_path):
+        path = _Path(device_path)
+        child = path / f'hyperflux_mouse_{cls.PAIRED_PID:04x}'
+        if child.is_dir():
+            return child
+        # Accept an already-resolved child and the older, root-level binding.
+        if (path / 'paired_device_pid').is_file() and (path / 'device_type').is_file():
+            return path
+        return None
+
+    @classmethod
+    def match(cls, device_id, dev_path):
+        try:
+            path = cls.control_path(dev_path)
+            if path is None or not super().match(device_id, str(path)):
+                return False
+            return (int((path / 'paired_device_pid').read_text().strip(), 16) == cls.PAIRED_PID and
+                    cls.paired_pid(path) == cls.PAIRED_PID)
+        except (OSError, ValueError):
+            return False
+
+    @staticmethod
+    def paired_pid(device_path):
+        """Membership, not the child feature binding or awake flag.
+
+        New drivers publish the observer's last confirmed PID without USB I/O.
+        On older drivers, use a validated live inventory when available. An I/O
+        failure means unknown, never empty, and must not remove an existing child.
+        """
+        path = _HyperFluxMouse.receiver_path(device_path)
+        membership = path / 'hyperflux_mouse_pid'
+        if membership.exists():
+            value = int(membership.read_text().strip(), 16)
+            if not 0 < value <= 0xffff:
+                raise ValueError('Unknown HyperFlux mouse membership')
+            return value
+        inventory = path / 'hyperflux_inventory'
+        if inventory.exists():
+            # Import lazily to avoid a hardware-class import cycle.
+            from openrazer_daemon.hardware.hyperflux import RazerHyperFluxV2
+            info = RazerHyperFluxV2._decode_inventory(inventory.read_text().strip())
+            return int(info['mouse_pid'], 16) if info['mouse_pid'] else 0xffff
+        return int((path / 'paired_device_pid').read_text().strip(), 16)
+
+    def __init__(self, device_path, *args, **kwargs):
+        self._is_closed = True
+        self._initializing = True
+        path = self.control_path(device_path)
+        if path is None:
+            raise OSError(errno.ENODEV, 'HyperFlux mouse controls are unavailable')
+        super().__init__(str(path), *args, **kwargs)
+        self._initializing = False
+
+    def get_serial(self):
+        if self._serial is None:
+            usb_path = self.receiver_path(self._device_path).resolve().parent.parent
+            try:
+                receiver = (usb_path / 'serial').read_text().strip()
+            except OSError:
+                receiver = ''
+            if not re.fullmatch('[A-Za-z0-9]+', receiver):
+                receiver = 'PORT_' + hashlib.sha256(os.fsencode(usb_path)).hexdigest()[:16].upper()
+            # Stable logical identity, not a fabricated hardware mouse serial.
+            self._serial = f'HYPERFLUXV2_{receiver}_MOUSE_{self.PAIRED_PID:04X}'
+        return self._serial
+
+    def load_methods(self):
+        self.methods_internal = [m for m in self.methods_internal if m != 'get_device_name']
+        super().load_methods()
+        self.add_dbus_method('razer.device.misc', 'getDeviceName', self.mouse_device_name, out_signature='s')
+        for method in ('getDeviceMode', 'setDeviceMode'):
+            self.del_dbus_method('razer.device.misc', method)
+
+    def mouse_device_name(self):
+        model = 'V3' if self.PAIRED_PID == 0x00e8 else 'V2'
+        return f'Razer Naga {model} Pro (HyperFlux V2)'
+
+    def set_device_mode(self, mode, param):
+        self.DRIVER_MODE = False  # Guard config overrides as well as the API.
+
+    def restore_dpi_poll_rate(self):
+        pass  # Never write defaults just because a stored pairing is discovered.
+
+    def restore_brightness(self):
+        if not self._initializing:
+            return super().restore_brightness()
+
+    def restore_effect(self):
+        if not self._initializing:
+            return super().restore_effect()
+
+    def close(self):
+        if not self._is_closed:
+            # No final DPI read or device-mode write to an asleep/unplugged child.
+            self._close()
+            self._is_closed = True
