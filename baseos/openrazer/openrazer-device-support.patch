+            self.assertNotIn('razer.device.lighting.brightness', interfaces)
+            self.assertIn('getReceiverInfo', interfaces['razer.device.hyperflux'])
+            self.assertIn('setAutoPair', interfaces['razer.device.hyperflux'])
+            self.assertIn('setDriverAutoPair', interfaces['razer.device.hyperflux'])
