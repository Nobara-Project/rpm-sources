+    def test_mouse_identity_is_per_receiver_and_model_without_wireless_serial(self):
+        with tempfile.TemporaryDirectory() as root:
+            ids = []
+            for receiver in ('ONE', 'TWO', 'invalid serial'):
+                usb = Path(root) / receiver
+                hid = usb / '1-3:1.4' / '0003:1532:00CF.000A'
