+# SPDX-License-Identifier: GPL-2.0-or-later
+import logging
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+from openrazer_daemon.hardware.mouse import (
+    RazerHyperFluxV2NagaV2Pro, RazerHyperFluxV2NagaV3Pro,
+    RazerNagaV2ProWireless, RazerNagaV3ProWired, RazerNagaV3ProWireless,
+)
+from openrazer_daemon.dbus_services.dbus_methods import mouse_scroll_wheel
+
+
+class HyperFluxTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.path = Path(self.temp.name)
+        (self.path / 'device_type').touch()
+
+    def test_v3_inventory_match(self):
+        (self.path / 'paired_device_pid').write_text('00e8\n')
+        self.assertTrue(RazerHyperFluxV2NagaV3Pro.match('0003:1532:00CF.000B', self.path))
+        self.assertFalse(RazerHyperFluxV2NagaV2Pro.match('0003:1532:00CF.000B', self.path))
+
+    def test_v2_inventory_match(self):
+        (self.path / 'paired_device_pid').write_text('00a8\n')
+        self.assertTrue(RazerHyperFluxV2NagaV2Pro.match('0003:1532:00CF.000B', self.path))
+        self.assertFalse(RazerHyperFluxV2NagaV3Pro.match('0003:1532:00CF.000B', self.path))
+
+    def test_missing_unknown_and_malformed_inventory(self):
+        for cls in (RazerHyperFluxV2NagaV2Pro, RazerHyperFluxV2NagaV3Pro):
+            self.assertFalse(cls.match('0003:1532:00CF.000B', self.path))
+        for value in ('0000', 'ffff', '00db', 'garbage'):
+            (self.path / 'paired_device_pid').write_text(value)
+            for cls in (RazerHyperFluxV2NagaV2Pro, RazerHyperFluxV2NagaV3Pro):
+                self.assertFalse(cls.match('0003:1532:00CF.000B', self.path))
+
+    def test_do_not_match_input_interface(self):
+        (self.path / 'device_type').unlink()
+        (self.path / 'paired_device_pid').write_text('00e8')
+        self.assertFalse(RazerHyperFluxV2NagaV3Pro.match('0003:1532:00CF.0008', self.path))
+
+    def test_direct_dongles(self):
+        self.assertTrue(RazerNagaV2ProWireless.match('0003:1532:00A8.009B', self.path))
+        self.assertTrue(RazerNagaV3ProWired.match('0003:1532:00E7.009B', self.path))
+        self.assertTrue(RazerNagaV3ProWireless.match('0003:1532:00E8.009B', self.path))
+        self.assertFalse(RazerNagaV3ProWireless.match('0003:1532:00DB.009B', self.path))
+
+    def test_receiver_capabilities(self):
+        self.assertEqual(RazerHyperFluxV2NagaV3Pro.DPI_MAX, 50000)
+        self.assertEqual(RazerHyperFluxV2NagaV3Pro.SCROLL_MODE_VERSION, 2)
+        self.assertFalse(RazerHyperFluxV2NagaV3Pro.DRIVER_MODE)
+        self.assertFalse(RazerHyperFluxV2NagaV3Pro.DEDICATED_MACRO_KEYS)
+        self.assertNotIn('set_charge_effect', RazerHyperFluxV2NagaV3Pro.METHODS)
+
+    def test_scroll_protocol_versions(self):
+        for version, maximum in ((1, 1), (2, 2)):
+            target = self.path / 'scroll_mode'
+            obj = SimpleNamespace(SCROLL_MODE_VERSION=version,
+                                  logger=logging.getLogger('test'),
+                                  get_driver_path=lambda name: self.path / name)
+            options = mouse_scroll_wheel.get_scroll_mode_options(obj)
+            self.assertEqual(len(options), maximum + 1)
+            mouse_scroll_wheel.set_scroll_mode(obj, maximum)
+            self.assertEqual(target.read_text(), str(maximum))
+            self.assertEqual(mouse_scroll_wheel.get_scroll_mode(obj), maximum)
+            for invalid in (-1, maximum + 1):
+                with self.assertRaises(ValueError):
+                    mouse_scroll_wheel.set_scroll_mode(obj, invalid)
+
+
+if __name__ == '__main__':
+    unittest.main()
