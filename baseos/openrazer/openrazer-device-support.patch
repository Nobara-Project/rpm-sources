+# SPDX-License-Identifier: GPL-2.0-or-later
+"""No device I/O: exercise asynchronous API, serialization and fail-closed paths."""
+import json
+import threading
+import unittest
+from unittest.mock import Mock
+from openrazer_daemon.hardware._hyperflux_pairing import _ReceiverPairing
+
+
+class PairingWorkerTest(unittest.TestCase):
+    def setUp(self):
+        self.kernel = {'ready': True, 'busy': False, 'blocked': False, 'error': 0,
+                       'protocol_version': 2, 'candidate_type': '',
+                       'candidate': 0, 'token': '0000000000000000'}
+        self.status_node = Mock()
+        self.status_node.read_text.side_effect = lambda: json.dumps(self.kernel)
+        self.write_node = Mock()
+        self.closed = False
+        self.runner = _ReceiverPairing(
+            lambda name: self.status_node if name == 'hyperflux_pairing_status' else self.write_node,
+            lambda: self.closed)
+
+    def finish(self):
+        self.runner.worker.join(timeout=2)
+        self.assertFalse(self.runner.worker.is_alive())
+        return self.runner.status()['job']
+
+    def test_read_only_status_never_starts_work(self):
+        self.assertIsNone(self.runner.status()['job'])
+        self.write_node.write_text.assert_not_called()
+        self.assertIsNone(self.runner.worker)
+
+    def test_nonblocking_and_serialized(self):
+        entered, release = threading.Event(), threading.Event()
+        def write(payload):
+            entered.set()
+            self.assertTrue(release.wait(2))
+            self.kernel.update(candidate=0x02d5, candidate_type='keyboard', token='0123456789abcdef')
+        self.write_node.write_text.side_effect = write
+        try:
+            job_id = self.runner.start('scan', 'keyboard')
+            self.assertTrue(entered.wait(1))
+            self.assertEqual(self.runner.status()['job']['state'], 'running')
+            with self.assertRaises(RuntimeError):
+                self.runner.start('unpair', '02d5')
+        finally:
+            release.set()
+        result = self.finish()
+        self.assertEqual(result['id'], job_id)
+        self.assertEqual((result['state'], result['result']), ('complete', 'found'))
+        self.write_node.write_text.assert_called_once_with('keyboard\n')
+
+    def test_explicit_writes_have_exact_payloads(self):
+        for op, value, token, payload in (
+                ('scan', 'mouse', None, 'mouse\n'),
+                ('pair', '00a8', '0123456789abcdef', '0123456789abcdef 00a8\n'),
+                ('unpair', '02d5', None, '02d5\n'),
+                ('pair', '00e8', '0123456789abcdef', '0123456789abcdef 00e8\n'),
+                ('unpair', '00e8', None, '00e8\n'),
+                ('pair', '02ba', '0123456789abcdef', '0123456789abcdef 02ba\n'),
+                ('unpair', 'abcd', None, 'abcd\n')):
+            self.write_node.write_text.reset_mock()
+            self.runner.start(op, value, token)
+            self.assertEqual(self.finish()['state'], 'complete')
+            self.write_node.write_text.assert_called_once_with(payload)
+
+    def test_invalid_pid_and_missing_token_never_write(self):
+        for args in (('pair', 'ffff', '0123456789abcdef'), ('unpair', '0000'),
+                     ('unpair', '12'), ('unpair', 'abcd\n'), ('unpair', 'zzzz'),
+                     ('scan', 'anything'), ('pair', '02d5', '0' * 16),
+                     ('pair', '02d5', 'x'), ('raw', '00a8')):
+            with self.assertRaises(ValueError):
+                self.runner.start(*args)
+        self.write_node.write_text.assert_not_called()
+
+    def test_candidate_type_comes_from_kernel_not_pid_range(self):
+        for target in ('mouse', 'keyboard'):
+            self.kernel.update(candidate=0x1234, candidate_type=target, token='0123456789abcdef')
+            self.assertEqual(self.runner.kernel_status()['candidate_type'], target)
+        for target in ('', 'guess', None):
+            self.kernel['candidate_type'] = target
+            self.assertFalse(self.runner.status()['kernel']['ready'])
+
+    def test_uncertain_or_unavailable_kernel_never_writes(self):
+        for field in ('blocked', 'busy'):
+            self.kernel[field] = True
+            with self.assertRaises(RuntimeError):
+                self.runner.start('scan', 'keyboard')
+            self.kernel[field] = False
+        self.kernel['ready'] = False
+        with self.assertRaises(RuntimeError):
+            self.runner.start('scan', 'keyboard')
+        self.write_node.write_text.assert_not_called()
+
+    def test_error_not_retried_or_reported_complete(self):
+        self.write_node.write_text.side_effect = OSError('stale discovery token')
+        self.runner.start('pair', '02d5', '0123456789abcdef')
+        self.assertEqual(self.finish()['state'], 'error')
+        self.write_node.write_text.assert_called_once()
+
+    def test_ack_without_kernel_completion_is_error(self):
+        self.write_node.write_text.side_effect = lambda payload: self.kernel.update(blocked=True, error=-110)
+        self.runner.start('pair', '02d5', '0123456789abcdef')
+        self.assertEqual(self.finish()['state'], 'error')
+
+    def test_disconnect_prevents_future_writes(self):
+        self.closed = True
+        with self.assertRaises(RuntimeError):
+            self.runner.start('scan', 'keyboard')
+        self.write_node.write_text.assert_not_called()
+
+    def test_bad_status_fails_closed(self):
+        self.kernel['token'] = 'garbage'
+        self.assertFalse(self.runner.status()['kernel']['ready'])
+        with self.assertRaises(ValueError):
+            self.runner.start('scan', 'keyboard')
+        self.write_node.write_text.assert_not_called()
+
+    def test_driver_auto_pair_prevents_manual_writes_without_userspace_worker(self):
+        self.kernel.update(protocol_version=3, driver_auto_pair={
+            'mouse': False, 'keyboard': True, 'phase': 'idle', 'target': '',
+            'error': 0, 'revision': 0, 'interval_seconds': 15})
+        self.assertTrue(self.runner.status()['kernel']['driver_auto_pair']['keyboard'])
+        for args in (('scan', 'mouse'), ('scan', 'keyboard'), ('unpair', '00e8')):
+            with self.assertRaisesRegex(RuntimeError, 'Disable driver'):
+                self.runner.start(*args)
+        self.assertIsNone(self.runner.worker)
+        self.write_node.write_text.assert_not_called()
+        self.kernel['driver_auto_pair']['keyboard'] = False
+        self.runner.start('scan', 'keyboard')
+        self.assertEqual(self.finish()['state'], 'complete')
+
+    def test_invalid_driver_status_cannot_enable_manual_controls(self):
+        self.kernel.update(protocol_version=3)
+        self.assertFalse(self.runner.status()['kernel']['ready'])
+        self.kernel['driver_auto_pair'] = {'mouse': 'false', 'keyboard': False,
+            'phase': 'idle', 'target': '', 'error': 0, 'revision': 0}
+        self.assertFalse(self.runner.status()['kernel']['ready'])
+
+
+if __name__ == '__main__':
+    unittest.main()
