+            (path / 'hyperflux_mouse_pid').write_text('00a8')
+            self.assertEqual(_HyperFluxMouse.paired_pid(path), 0x00a8)
+            (path / 'hyperflux_mouse_pid').write_text('0000')
+            with self.assertRaises(ValueError):
+                _HyperFluxMouse.paired_pid(path)
+
+    def test_unpair_only_removes_child_on_its_own_pad(self):
