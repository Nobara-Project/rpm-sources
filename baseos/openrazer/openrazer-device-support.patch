+static ssize_t hyperflux_driver_auto_pair_store(struct device *device,
+                struct device_attribute *attr, const char *buf, size_t count)
+{
+    struct razer_mouse_device *dev = dev_get_drvdata(device);
+    struct hyperflux_context *ctx = dev->hyperflux_context;
+    unsigned int mask;
+    unsigned long flags;
+    int ret = 0;
+    if (kstrtouint(buf, 10, &mask) || mask > 3) return -EINVAL;
+    if (!ctx) return -EOPNOTSUPP;
+    spin_lock_irqsave(&ctx->lock, flags);
+    if (dev->hyperflux_disconnecting || !ctx->ready) ret = -ENODEV;
+    else if (mask && (ctx->blocked || ctx->busy)) ret = -EBUSY;
+    if (!ret) {
+        ctx->auto_epoch++;
+        ctx->auto_mask = mask;
+        ctx->auto_error = 0;
+        ctx->token = 0;
+        if (mask)
+            mod_delayed_work(system_freezable_wq, &dev->hyperflux_auto_work, 0);
+        else
+            cancel_delayed_work(&dev->hyperflux_auto_work); /* In-flight command may finish. */
+    }
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    return ret ? ret : count;
+}
