index 00000000..429dd97e
--- /dev/null
+++ b/daemon/openrazer_daemon/hardware/_hyperflux_pairing.py
@@ -0,0 +1,134 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Bounded kernel operations in one worker, never in the DBus main loop.
+
+No retry, persistence, raw reports, automatic pair, or hardware cancellation.
+The kernel owns candidate freshness and the final completion checks.
+"""
+import json
+import re
+import threading
+import uuid
+
+
+class _ReceiverPairing:
+    # Capture coverage, not a device allowlist. The receiver authorizes targets.
+    TESTED_PIDS = ('00a8', '00e8', '02d5')
+
+    def __init__(self, attribute, closed):
+        self.attribute = attribute
+        self.closed = closed
+        self.lock = threading.Lock()
+        self.job = None
+        self.worker = None
+
+    def kernel_status(self):
+        path = self.attribute('hyperflux_pairing_status')
+        if path is None:
+            return {'ready': False}
+        data = json.loads(path.read_text())
+        if not isinstance(data, dict) or type(data.get('ready')) is not bool:
+            raise ValueError('Malformed kernel pairing status')
+        if type(data.get('protocol_version', 1)) is not int:
+            raise ValueError('Malformed kernel pairing protocol version')
+        if data.get('protocol_version', 1) >= 3:
+            auto = data.get('driver_auto_pair')
+            if (not isinstance(auto, dict) or
+                    any(type(auto.get(k)) is not bool for k in ('mouse', 'keyboard')) or
+                    auto.get('phase') not in ('idle', 'checking', 'scanning', 'pairing') or
+                    auto.get('target') not in ('', 'mouse', 'keyboard') or
+                    type(auto.get('error')) is not int or type(auto.get('revision')) is not int or
+                    auto['revision'] < 0):
+                raise ValueError('Malformed driver auto-pair status')
+        if data['ready']:
+            if (any(type(data.get(k)) is not bool for k in ('busy', 'blocked')) or
+                    type(data.get('error')) is not int or
+                    type(data.get('candidate')) is not int or
+                    not 0 <= data['candidate'] < 0xffff or
+                    not isinstance(data.get('token'), str) or
+                    not re.fullmatch('[0-9a-f]{16}', data['token'])):
+                raise ValueError('Malformed kernel pairing status')
+            if data.get('protocol_version', 1) >= 2:
+                target = data.get('candidate_type')
+                if (target not in ('', 'mouse', 'keyboard') or
+                        bool(data['candidate']) != bool(target)):
+                    raise ValueError('Malformed kernel candidate type')
+        return data
+
+    def status(self):
+        with self.lock:
+            job = dict(self.job) if self.job else None
+        try:
+            kernel = self.kernel_status()
+        except (OSError, ValueError) as error:
+            kernel = {'ready': False, 'error_message': str(error)}
+        return {'job': job, 'kernel': kernel}
+
+    def busy(self):
+        with self.lock:
+            return self.job is not None and self.job['state'] == 'running'
+
+    def start(self, action, value, token=None):
+        if self.closed():
+            raise RuntimeError('Receiver disconnected')
+        if action == 'scan':
+            if value not in ('mouse', 'keyboard'):
+                raise ValueError('Select mouse or keyboard')
+            payload = value
+        elif action in ('pair', 'unpair'):
+            if (not isinstance(value, str) or not re.fullmatch('[0-9a-f]{4}', value) or
+                    int(value, 16) in (0, 0xffff)):
+                raise ValueError('Device PID must be four hexadecimal digits, excluding 0000/ffff')
+            payload = value
+            if action == 'pair':
+                if not isinstance(token, str) or not re.fullmatch('[0-9a-f]{16}', token) or int(token, 16) == 0:
+                    raise ValueError('A fresh discovery token is required')
+                payload = token + ' ' + value
+        else:
+            raise ValueError('Unknown pairing operation')
+        path = self.attribute('hyperflux_' + action)
+        if path is None:
+            raise NotImplementedError('Install and load the HyperFlux pairing kernel module')
+        kernel = self.kernel_status()
+        if not kernel.get('ready'):
+            raise RuntimeError('Pairing notification interface is unavailable')
+        if kernel.get('blocked'):
+            raise RuntimeError('Previous operation was uncertain; reconnect the mat before retrying')
+        if kernel.get('busy'):
+            raise RuntimeError('A receiver operation is already running')
+        auto = kernel.get('driver_auto_pair', {})
+        if auto.get('mouse') or auto.get('keyboard'):
+            raise RuntimeError('Disable driver auto-pairing before a manual pairing operation')
+        with self.lock:
+            if self.job is not None and self.job['state'] == 'running':
+                raise RuntimeError('A receiver operation is already running')
+            job_id = uuid.uuid4().hex
+            self.job = {'id': job_id, 'action': action, 'target': value, 'state': 'running'}
+            # Capture the exact HID instance path. Never rediscover a replacement
+            # receiver and resend a write if this instance disappears.
+            self.worker = threading.Thread(target=self._run, args=(job_id, action, path, payload),
+                                           name='HyperFlux-pairing', daemon=True)
+            try:
+                self.worker.start()
+            except Exception as error:
+                self.job.update(state='error', error=str(error))
+                raise
+        return job_id
+
+    def _run(self, job_id, action, path, payload):
+        try:
+            if self.closed():
+                raise RuntimeError('Receiver disconnected')
+            path.write_text(payload + '\n')
+            if self.closed():
+                raise RuntimeError('Receiver disconnected during operation')
+            kernel = self.kernel_status()
+            if not kernel.get('ready') or kernel.get('blocked') or kernel.get('busy') or kernel.get('error'):
+                raise RuntimeError('Kernel could not confirm completion; reconnect the mat if marked blocked')
+            result = {'state': 'complete', 'result': {'pair': 'paired', 'unpair': 'unpaired'}.get(action)}
+            if action == 'scan':
+                result['result'] = 'found' if kernel.get('candidate') else 'empty'
+        except Exception as error:
+            result = {'state': 'error', 'error': str(error)}
+        with self.lock:
+            if self.job and self.job['id'] == job_id:
+                self.job.update(result)
