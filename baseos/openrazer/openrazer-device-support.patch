diff --git a/daemon/openrazer_daemon/hardware/hyperflux.py b/daemon/openrazer_daemon/hardware/hyperflux.py
new file mode 100644
index 00000000..8e9692e9
--- /dev/null
+++ b/daemon/openrazer_daemon/hardware/hyperflux.py
@@ -0,0 +1,197 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Physical HyperFlux receiver, independent of its routed mouse.
+
+Verified receiver commands use the kernel's serialized management endpoint.
+No driver/input mode changes, raw HID claims, or startup setting writes.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path as _Path
+import re
+
+from openrazer_daemon.hardware.device_base import RazerDevice as _RazerDevice
+from openrazer_daemon.hardware._hyperflux_pairing import _ReceiverPairing
+from openrazer_daemon.hardware._hyperflux_keyboard import keyboard_name as _keyboard_name
+
+
+class RazerHyperFluxV2(_RazerDevice):
+    USB_VID = 0x1532
+    USB_PID = 0x00CF
+    DEVICE_IMAGE = "https://medias-p1.phoenix.razer.com/sys-master-phoenix-images-container/h63/h2a/9916957327390/hyperflux-v2-hard-500x500.png"
+    METHODS = ['get_device_type_mousemat']
+    DRIVER_MODE = False
+
+    @classmethod
+    def match(cls, device_id, dev_path):
+        if not re.fullmatch(r'0003:1532:00CF\.[0-9A-Fa-f]+', device_id):
+            return False
+        try:
+            # Exactly one parent per USB receiver, even without a paired mouse.
+            return (_Path(dev_path).resolve().parent / 'bInterfaceNumber').read_text().strip() == '00'
+        except OSError:
+            return False
+
+    def get_serial(self):
+        if self._serial is None:
+            usb_path = _Path(self._device_path).resolve().parent.parent
+            try:
+                serial = (usb_path / 'serial').read_text().strip()
+            except OSError:
+                serial = ''
+            if not re.fullmatch(r'[A-Za-z0-9]+', serial):
+                # Port-derived identifier, not a fabricated hardware serial.
+                serial = 'PORT_' + hashlib.sha256(os.fsencode(usb_path)).hexdigest()[:16].upper()
+            self._serial = 'HYPERFLUXV2_' + serial
+        return self._serial
+
+    def load_methods(self):
+        # Neither the child's name nor its firmware describe the receiver.
+        self.methods_internal = [m for m in self.methods_internal
+                                 if m not in ('get_device_name', 'get_firmware')]
+        super().load_methods()
+        self.add_dbus_method('razer.device.misc', 'getDeviceName', self.receiver_name, out_signature='s')
+        self.add_dbus_method('razer.device.misc', 'getFirmware', self.receiver_firmware, out_signature='s')
+        self.add_dbus_method('razer.device.hyperflux', 'getReceiverInfo', self.receiver_info, out_signature='s')
+        # Interface zero can enumerate before the control endpoint. Keep the
+        # API stable and check capability/path at call time, not discovery time.
+        self.add_dbus_method('razer.device.hyperflux', 'setAutoPair', self.set_auto_pair, in_signature='b')
+        self.add_dbus_method('razer.device.hyperflux', 'setDriverAutoPair', self.set_driver_auto_pair, in_signature='bb')
+        self.add_dbus_method('razer.device.hyperflux', 'getPairingStatus', self.pairing_status, out_signature='s')
+        self.add_dbus_method('razer.device.hyperflux', 'startScan', self.start_scan, in_signature='s', out_signature='s')
+        self.add_dbus_method('razer.device.hyperflux', 'pairDevice', self.pair_device, in_signature='ss', out_signature='s')
+        self.add_dbus_method('razer.device.hyperflux', 'unpairDevice', self.unpair_device, in_signature='s', out_signature='s')
+        for method in ('getDeviceMode', 'setDeviceMode'):
+            self.del_dbus_method('razer.device.misc', method)
+
+    def set_device_mode(self, mode, param):
+        # Also guard startup configuration overrides, not just the DBus API.
+        self.DRIVER_MODE = False
+
+    def receiver_name(self):
+        return 'Razer HyperFlux V2'
+
+    def receiver_firmware(self):
+        return 'Not reported'
+
+    def _receiver_attribute(self, name):
+        if not _Path(self._device_path).is_dir():
+            return None  # Never route an old object into a replugged receiver.
+        usb_path = _Path(self._device_path).resolve().parent.parent
+        for path in usb_path.glob('*/0003:1532:00CF.*/' + name):
+            try:
+                if (path.parent.parent / 'bInterfaceNumber').read_text().strip() == '04':
+                    return path
+            except OSError:
+                continue
+        return None
+
+    def set_auto_pair(self, enabled):
+        if not isinstance(enabled, int) or enabled not in (0, 1):
+            raise ValueError('Auto-pair must be a boolean')
+        if self._pairing().busy():
+            raise RuntimeError('Wait for the receiver operation to finish')
+        path = self._receiver_attribute('hyperflux_auto_pair')
+        if path is None:
+            raise NotImplementedError('Install and load the HyperFlux management kernel module')
+        # Completion means a matching, checksummed SUCCESS reply, not just USB
+        # transfer success. No persistence/restore writes and no automatic retry.
+        path.write_text('1\n' if enabled else '0\n')
+        self._last_auto_pair_ack = bool(enabled)
+
+    def set_driver_auto_pair(self, mouse, keyboard):
+        if any(not isinstance(value, int) or value not in (0, 1) for value in (mouse, keyboard)):
+            raise ValueError('Mouse and keyboard auto-pair settings must be booleans')
+        path = self._receiver_attribute('hyperflux_driver_auto_pair')
+        if path is None:
+            raise NotImplementedError('Install and load the driver-managed auto-pairing kernel module')
+        # Only configure kernel policy. No userspace timer, scan or pair loop;
+        # disabling stays nonblocking while a previously dispatched command ends.
+        path.write_text(str(int(mouse) | (int(keyboard) << 1)) + '\n')
+
+    def _pairing(self):
+        if not hasattr(self, '_pairing_worker'):
+            self._pairing_worker = _ReceiverPairing(self._receiver_attribute, lambda: self._is_closed)
+        return self._pairing_worker
+
+    def pairing_status(self):
+        return json.dumps(self._pairing().status())
+
+    def start_scan(self, target):
+        return self._pairing().start('scan', str(target))
+
+    def pair_device(self, pid, token):
+        return self._pairing().start('pair', str(pid).lower(), str(token))
+
+    def unpair_device(self, pid):
+        return self._pairing().start('unpair', str(pid).lower())
+
+    @staticmethod
+    def _decode_inventory(raw):
+        # Observed 00:bf layout: count, two {flag, PID big-endian} slots.
+        # Captured with both mouse and keyboard. Flags can change during scans
+        # without unpairing: preserve membership separately from those flags.
+        if not re.fullmatch(r'[0-9a-fA-F]{160}', raw):
+            raise ValueError('Malformed HyperFlux inventory')
+        data = bytes.fromhex(raw)
+        if data[0] != 2 or data[1] not in (0, 1) or data[4] not in (0, 1) or any(data[7:]):
+            raise ValueError('Unrecognized HyperFlux inventory layout')
+        mouse_pid = int.from_bytes(data[2:4], 'big')
+        keyboard_pid = int.from_bytes(data[5:7], 'big')
+        if not mouse_pid or not keyboard_pid:
+            raise ValueError('Unknown HyperFlux slot identity')
+        return {
+            'mouse_pid': f'{mouse_pid:04x}' if mouse_pid not in (0, 0xffff) else None,
+            'keyboard_pid': f'{keyboard_pid:04x}' if keyboard_pid not in (0, 0xffff) else None,
+            'keyboard_name': _keyboard_name(keyboard_pid) if keyboard_pid not in (0, 0xffff) else None,
+            'mouse_flag': data[1],
+            'keyboard_flag': data[4],
+            'inventory_source': 'live-receiver-report',
+            'mouse_slot': data[1:4].hex(),
+            'keyboard_slot': data[4:7].hex(),
+            'keyboard_inventory': 'live-receiver-report',
+        }
+
+    def receiver_info(self):
+        usb_path = _Path(self._device_path).resolve().parent.parent
+        mouse_pid = None
+        for attr in usb_path.glob('*/0003:1532:00CF.*/paired_device_pid'):
+            try:
+                value = int(attr.read_text().strip(), 16)
+                if value in (0x00A8, 0x00E8):
+                    mouse_pid = '{:04x}'.format(value)
+            except (OSError, ValueError):
+                continue
+        info = {
+            'mouse_pid': mouse_pid,
+            'keyboard_pid': None,
+            'inventory_source': 'driver-binding-snapshot',
+            'keyboard_inventory': 'unavailable',
+            'pairing_control': False,
+            'charging_policy_control': False,
+            'auto_pair_control': self._receiver_attribute('hyperflux_auto_pair') is not None,
+            'auto_pair': None,  # No verified hardware getter; never invent state.
+            'auto_pair_last_ack': getattr(self, '_last_auto_pair_ack', None),
+        }
+        status = self._pairing().status()
+        info['pairing_status'] = status
+        info['pairing_control'] = (status['kernel'].get('ready', False) and
+                                   all(self._receiver_attribute('hyperflux_' + op) is not None
+                                       for op in ('scan', 'pair', 'unpair')))
+        info['pairing_tested_pids'] = list(_ReceiverPairing.TESTED_PIDS)
+        info['driver_auto_pair_control'] = self._receiver_attribute('hyperflux_driver_auto_pair') is not None
+        info['pairing_scope'] = ('receiver-slots' if status['kernel'].get('protocol_version', 1) >= 2
+                                 else 'legacy-two-models')
+        if self._pairing().busy() or status['kernel'].get('busy'):
+            # A pairing operation holds the serialized feature endpoint. Do not
+            # block DBus on inventory or pretend a cached snapshot is live.
+            info.update(mouse_pid=None, inventory_source='operation-in-progress')
+            return json.dumps(info)
+        inventory = self._receiver_attribute('hyperflux_inventory')
+        if inventory is not None:
+            try:
+                info.update(self._decode_inventory(inventory.read_text().strip()))
+            except (OSError, ValueError) as error:
+                # A failed live read must not silently become a stale snapshot.
+                info.update(mouse_pid=None, inventory_source='unavailable', inventory_error=str(error))
+        return json.dumps(info)
diff --git a/daemon/openrazer_daemon/hardware/mouse.py b/daemon/openrazer_daemon/hardware/mouse.py
