+from openrazer_daemon.misc.battery_notifier import BatteryNotifier
+from openrazer_daemon.hardware.device_base import RazerDevice
+
+
+class _Registry(dbus.service.Object):
+    """Real DeviceManager entrypoint on the isolated test bus."""
+    def __init__(self, devices):
+        self.devices = devices
+        self.bus_name = dbus.service.BusName('org.razer', dbus.SessionBus())
+        super().__init__(self.bus_name, '/org/razer')
+
+    @dbus.service.method('razer.devices', out_signature='as')
+    def getDevices(self):
+        return self.devices.serials()
+
+    @dbus.service.method('razer.daemon', out_signature='s')
+    def version(self):
+        return '3.12.4'
+
+
+class HyperFluxStartupTest(unittest.TestCase):
+    def test_helper_is_not_discovered(self):
+        self.assertNotIn(_HyperFluxMouse, get_device_classes())
+
+    def test_battery_failure_is_bounded_and_recovers_without_false_notification(self):
+        parent = SimpleNamespace(getBattery=Mock(side_effect=[
+            OSError(errno.EBUSY, 'busy'), TimeoutError(errno.ETIMEDOUT, 'asleep'), 60.0]))
+        notifier = BatteryNotifier(parent, 0, 'HyperFlux child')
+        notifier.frequency = 600
+        notifier.percent = 33
+        notifier.show_notification = Mock()
+        with patch('openrazer_daemon.misc.battery_notifier.time.monotonic') as clock:
+            clock.return_value = 100
+            notifier.notify_battery()
+            clock.return_value = 105
+            notifier.notify_battery()
+            self.assertEqual(parent.getBattery.call_count, 1)
+            clock.return_value = 111
+            notifier.notify_battery()
+            clock.return_value = 122
+            notifier.notify_battery()
+            self.assertEqual(parent.getBattery.call_count, 3)
+            notifier.notify_battery()
+            self.assertEqual(parent.getBattery.call_count, 3)
+        notifier.show_notification.assert_not_called()
+
+    @unittest.skipUnless(os.environ.get('OPENRAZER_TEST_PRIVATE_BUS') == '1', 'Requires isolated test bus')
+    def test_full_startup_and_remove_with_unresponsive_mouse_and_keyboard(self):
+        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
+        for cls in (RazerHyperFluxV2NagaV2Pro, RazerHyperFluxV2NagaV3Pro):
+            with self.subTest(model=cls.__name__), tempfile.TemporaryDirectory() as root:
+                usb = Path(root) / '1-3'
+                parent = usb / '1-3:1.0' / '0003:1532:00CF.0007'
+                mouse = usb / '1-3:1.4' / '0003:1532:00CF.000A'
+                keyboard = mouse / 'hyperflux_keyboard_02d5'
+                parent.mkdir(parents=True)
+                keyboard.mkdir(parents=True)
+                (usb / 'serial').write_text('RECEIVERBOOT')
+                (parent.parent / 'bInterfaceNumber').write_text('00')
+                (mouse.parent / 'bInterfaceNumber').write_text('04')
+                (mouse / 'device_type').write_text('Naga')
+                (mouse / 'paired_device_pid').write_text(f'{cls.PAIRED_PID:04x}')
+                (keyboard / 'paired_device_pid').write_text('02d5')
+                for path in (mouse, keyboard):
+                    (path / 'version').write_text('3.12.4')
+                serial = f'HYPERFLUXV2_RECEIVERBOOT_MOUSE_{cls.PAIRED_PID:04X}'
+                config = configparser.ConfigParser()
+                config.read_dict({'Startup': {'restore_persistence': 'true',
+                                              'persistence_dual_boot_quirk': 'true',
+                                              'battery_notifier': 'true'},
+                                  f'Device:{serial}': {'driver_mode': 'true'}})
+                events = [SimpleNamespace(sys_name=p.name, sys_path=str(p)) for p in (parent, mouse)]
+                daemon = SimpleNamespace(_razer_devices=DeviceCollection(), _config=config,
+                    _persistence=configparser.ConfigParser(), _test_dir=None,
+                    _device_classes=[RazerHyperFluxV2NagaV2Pro, RazerHyperFluxV2NagaV3Pro],
+                    _unknown_serial_counter={}, _persistence_file=None,
+                    logger=logging.getLogger('boot-test'), device_added=Mock(), device_removed=Mock(),
+                    write_persistence=Mock(), _udev_context=SimpleNamespace(list_devices=lambda **kw: events))
+                daemon._persistence.status = {'changed': False}
+                daemon._add_hyperflux_receiver = lambda *a: RazerDaemon._add_hyperflux_receiver(daemon, *a)
+                real_open = open
+                writes = []
+
+                def unavailable(path, mode='r', *args, **kwargs):
+                    path = Path(path)
+                    if path.is_relative_to(mouse) and path.name not in ('paired_device_pid', 'device_type', 'version'):
+                        if path.name == 'firmware_version' and path.exists() and mode == 'r':
+                            return real_open(path, mode, *args, **kwargs)
+                        if any(flag in mode for flag in 'wa+'):
+                            writes.append(path)
+                        raise TimeoutError(errno.ETIMEDOUT, 'wireless feature request timed out')
+                    return real_open(path, mode, *args, **kwargs)
+
+                with patch('builtins.open', side_effect=unavailable):
+                    try:
+                        RazerDaemon._load_devices(daemon, first_run=True)
+                        self.assertEqual(len(daemon._razer_devices), 3)
+                        child = daemon._razer_devices[mouse.name].dbus
+                        self.assertEqual(child.get_serial(), serial)
+                        self.assertTrue(child.getDeviceName().endswith('(HyperFlux V2)'))
+                        self.assertFalse(child.DRIVER_MODE)
+                        self.assertEqual(writes, [])
+                        methods = child._dbus_class_table[child.__class__.__module__ + '.' + child.__class__.__name__]
+                        self.assertNotIn('setDeviceMode', methods['razer.device.misc'])
+                        self.assertIn('setDPI', methods['razer.device.dpi'])
+                        registry = _Registry(daemon._razer_devices)
+                        loop = GLib.MainLoop()
+                        thread = threading.Thread(target=loop.run, daemon=True)
+                        thread.start()
+                        try:
+                            # Exercise the complete client constructor, not just
+                            # daemon registration or a mocked backend device.
+                            query = """
+import sys
+from pathlib import Path
+import dbus
+from openrazer.client import DeviceManager
+manager = DeviceManager()
+assert len(manager.devices) == 3
+children = [d for d in manager.devices if d.name.endswith(' (HyperFlux V2)')]
+assert len(children) == 2
+for child in children:
+    assert child._fw is None
+    try:
+        child.firmware_version
+    except dbus.DBusException:
+        pass
+    else:
+        raise AssertionError('Missing firmware must expose the error')
+    assert child._fw is None  # Failed reads must not poison the cache.
+target = next(d for d in children if d.type == 'mouse')
+path = Path(sys.argv[1]) / 'firmware_version'
+path.write_text('v1.2')
+assert target.firmware_version == 'v1.2'
+path.write_text('v9.9')
+assert target.firmware_version == 'v1.2'  # Cache only after success.
+"""
+                            result = subprocess.run([sys.executable, '-c', query, str(mouse)],
+                                                    capture_output=True, text=True, timeout=10)
+                            self.assertEqual(result.returncode, 0, result.stderr)
+                        finally:
+                            loop.quit()
+                            thread.join(timeout=3)
+                            registry.remove_from_connection()
+                        # Explicit user commands still expose failures honestly.
+                        with self.assertRaises(TimeoutError):
+                            child.setDPI(800, 800)
+                        self.assertEqual(writes, [mouse / 'dpi'])
+                        # Membership notifications remove only the mouse, not
+                        # the still-connected USB pad/keyboard or HID inputs.
+                        membership = mouse / 'hyperflux_mouse_pid'
+                        membership.write_text(f'{cls.PAIRED_PID:04x}')
+                        RazerDaemon._sync_hyperflux_mouse(daemon, events[1])
+                        self.assertEqual(len(daemon._razer_devices), 3)
+                        # A failed read must not look like unpairing.
+                        with patch.object(_HyperFluxMouse, 'paired_pid', side_effect=OSError(errno.EBUSY, 'scan')):
+                            RazerDaemon._sync_hyperflux_mouse(daemon, events[1])
+                        self.assertEqual(len(daemon._razer_devices), 3)
+                        membership.write_text('ffff')
+                        RazerDaemon._sync_hyperflux_mouse(daemon, events[1])
+                        self.assertEqual(len(daemon._razer_devices), 2)
+                        self.assertNotIn(serial, daemon._razer_devices.serials())
+                        self.assertTrue(child._is_closed)
+                        daemon.device_removed.assert_called_once()
+                        RazerDaemon._sync_hyperflux_mouse(daemon, events[1])
+                        daemon.device_removed.assert_called_once()
+                        # Re-pairing the bound model restores it, with no
+                        # startup settings writes even while it is asleep.
+                        membership.write_text(f'{cls.PAIRED_PID:04x}')
+                        RazerDaemon._sync_hyperflux_mouse(daemon, events[1])
+                        self.assertEqual(len(daemon._razer_devices), 3)
+                        self.assertIn(serial, daemon._razer_devices.serials())
+                        daemon.device_added.assert_called_once()
+                        self.assertEqual(writes, [mouse / 'dpi'])
+                    finally:
+                        for event in reversed(events):
+                            RazerDaemon._remove_device(daemon, event)
+                self.assertEqual(len(daemon._razer_devices), 0)
+
+    def test_lifecycle_failure_does_not_leave_notification_or_persistence_disabled(self):
+        device = SimpleNamespace(logger=Mock(), DRIVER_MODE=False, disable_notify=False,
+            disable_persistence=False, disable_brightness=Mock(side_effect=OSError('asleep')),
+            restore_brightness=Mock(side_effect=OSError('asleep')),
+            _suspend_device=Mock(), _resume_device=Mock())
+        for method in (RazerDevice.suspend_device, RazerDevice.resume_device):
+            with self.assertRaises(OSError):
