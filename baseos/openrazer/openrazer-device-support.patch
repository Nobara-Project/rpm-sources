+
+class MouseHotplugTest(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        usb = Path(temporary.name) / '1-3'
+        self.parent = usb / '1-3:1.0' / '0003:1532:00CF.0007'
+        self.mouse = usb / '1-3:1.4' / '0003:1532:00CF.000A'
+        self.parent.mkdir(parents=True)
+        self.mouse.mkdir(parents=True)
+        (usb / 'serial').write_text('MOUSEHOTPLUG')
+        (self.parent.parent / 'bInterfaceNumber').write_text('00')
+        (self.mouse.parent / 'bInterfaceNumber').write_text('04')
+        (self.mouse / 'hyperflux_mouse_pid').write_text('ffff')
+        self.event = SimpleNamespace(sys_name=self.mouse.name, sys_path=str(self.mouse))
+
+    def group(self, pid):
+        path = self.mouse / f'hyperflux_mouse_{pid:04x}'
+        path.mkdir()
+        (path / 'paired_device_pid').write_text(f'{pid:04x}')
+        (path / 'device_type').write_text('Razer Naga')
+        (path / 'version').write_text('3.12.4')
+        (self.mouse / 'hyperflux_mouse_pid').write_text(f'{pid:04x}')
+        return path
+
+    def daemon(self):
+        config = configparser.ConfigParser()
+        config.read_dict({'Startup': {'restore_persistence': 'true', 'battery_notifier': 'false',
+                                     'persistence_dual_boot_quirk': 'true'}})
+        daemon = SimpleNamespace(_razer_devices=DeviceCollection(), _config=config,
+            _persistence=configparser.ConfigParser(), _test_dir=None,
+            _device_classes=[RazerHyperFluxV2NagaV2Pro, RazerHyperFluxV2NagaV3Pro],
+            _unknown_serial_counter={}, _persistence_file=None,
+            logger=logging.getLogger('mouse-hotplug-test'), device_added=Mock(), device_removed=Mock(),
+            write_persistence=Mock())
+        daemon._persistence.status = {'changed': False}
+        return daemon
+
+    def test_dynamic_group_matching_and_identity(self):
+        for cls in (RazerHyperFluxV2NagaV2Pro, RazerHyperFluxV2NagaV3Pro):
+            path = self.group(cls.PAIRED_PID)
+            self.assertTrue(cls.match(self.mouse.name, self.mouse))
+            self.assertTrue(cls.match(self.mouse.name, path))
+            self.assertEqual(cls.control_path(self.mouse), path)
+            child = object.__new__(cls)
+            child._is_closed = True
+            child._device_path = str(path)
+            child._serial = None
+            self.assertEqual(child.get_serial(), f'HYPERFLUXV2_MOUSEHOTPLUG_MOUSE_{cls.PAIRED_PID:04X}')
+            (self.mouse / 'hyperflux_mouse_pid').write_text('ffff')
+            self.assertFalse(cls.match(self.mouse.name, self.mouse))
+            self.assertFalse(cls.match(self.mouse.name, path))
+
+    def test_permissions_or_missing_group_retry_is_bounded_and_read_only(self):
+        daemon = self.daemon()
+        (self.mouse / 'hyperflux_mouse_pid').write_text('00e8')
+        with patch('openrazer_daemon.daemon.GLib.timeout_add') as retry:
+            for attempt in range(6):
+                RazerDaemon._sync_hyperflux_mouse(daemon, self.event, attempt)
+            self.assertEqual(retry.call_count, 5)
+            self.assertEqual(retry.call_args.args, (1000, RazerDaemon._sync_hyperflux_mouse,
+                                                  daemon, self.event, 5))
+        self.assertEqual(len(daemon._razer_devices), 0)
+        daemon.device_added.assert_not_called()
+        self.assertEqual((self.mouse / 'hyperflux_mouse_pid').read_text(), '00e8')
+
+    def test_disappearing_group_is_not_an_uncaught_matching_error(self):
+        self.group(0x00e8)
+        with patch('openrazer_daemon.hardware.device_base.os.listdir', side_effect=FileNotFoundError('unpaired')):
+            self.assertFalse(RazerHyperFluxV2NagaV3Pro.match(self.mouse.name, self.mouse))
+
+    def test_unsupported_or_empty_slot_does_not_register_or_retry(self):
+        daemon = self.daemon()
+        with patch('openrazer_daemon.daemon.GLib.timeout_add') as retry:
+            for pid in ('ffff', '1234'):
+                (self.mouse / 'hyperflux_mouse_pid').write_text(pid)
+                RazerDaemon._sync_hyperflux_mouse(daemon, self.event)
+            retry.assert_not_called()
+        self.assertEqual(len(daemon._razer_devices), 0)
+
+    @unittest.skipUnless(os.environ.get('OPENRAZER_TEST_PRIVATE_BUS') == '1', 'Requires isolated test bus')
+    def test_startup_finds_dynamic_mice_on_two_independent_pads(self):
+        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
+        daemon = self.daemon()
+        path = self.group(0x00e8)
+        events = [SimpleNamespace(sys_name=self.parent.name, sys_path=str(self.parent)), self.event]
+        usb2 = self.parent.parents[2] / '1-4'
+        parent2 = usb2 / '1-4:1.0' / '0003:1532:00CF.000C'
+        mouse2 = usb2 / '1-4:1.4' / '0003:1532:00CF.000F'
+        child2 = mouse2 / 'hyperflux_mouse_00e8'
+        parent2.mkdir(parents=True)
+        child2.mkdir(parents=True)
+        (usb2 / 'serial').write_text('SECONDRECEIVER')
+        (parent2.parent / 'bInterfaceNumber').write_text('00')
+        (mouse2.parent / 'bInterfaceNumber').write_text('04')
+        (mouse2 / 'hyperflux_mouse_pid').write_text('00e8')
+        for name, value in (('paired_device_pid', '00e8'), ('device_type', 'Naga'), ('version', '3.12.4')):
+            (child2 / name).write_text(value)
+        events.extend(SimpleNamespace(sys_name=p.name, sys_path=str(p)) for p in (parent2, mouse2))
+        daemon._udev_context = SimpleNamespace(list_devices=lambda **kwargs: events)
+        daemon._add_hyperflux_receiver = lambda *args: RazerDaemon._add_hyperflux_receiver(daemon, *args)
+        try:
+            RazerDaemon._load_devices(daemon, first_run=True)
+            self.assertEqual(len(daemon._razer_devices), 4)
+            self.assertEqual(daemon._razer_devices[self.mouse.name].dbus._device_path, str(path))
+            self.assertEqual(daemon._razer_devices[mouse2.name].dbus._device_path, str(child2))
+            self.assertEqual(daemon._razer_devices[self.mouse.name].dbus.additional_interfaces, [])
+            self.assertEqual(daemon._razer_devices[mouse2.name].dbus.additional_interfaces, [])
+            self.assertEqual(len(set(daemon._razer_devices.serials())), 4)
+        finally:
+            for entry in list(daemon._razer_devices):
+                entry.dbus.close()
+                entry.dbus.remove_from_connection()
+
+    @unittest.skipUnless(os.environ.get('OPENRAZER_TEST_PRIVATE_BUS') == '1', 'Requires isolated test bus')
+    def test_empty_boot_pair_model_change_unpair_and_repair_without_setting_writes(self):
+        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
+        daemon = self.daemon()
+        real_open = open
+        writes = []
+
+        def no_setting_writes(path, mode='r', *args, **kwargs):
+            if Path(path).is_relative_to(self.mouse) and any(flag in mode for flag in 'wa+'):
+                writes.append(str(path))
+                raise AssertionError('Discovery must not restore device settings')
+            return real_open(path, mode, *args, **kwargs)
+
+        try:
+            RazerDaemon._add_hyperflux_receiver(daemon, self.parent.name, str(self.parent))
+            RazerDaemon._sync_hyperflux_mouse(daemon, self.event)
+            self.assertEqual(len(daemon._razer_devices), 1)
+            for cls in (RazerHyperFluxV2NagaV3Pro, RazerHyperFluxV2NagaV2Pro):
+                path = self.group(cls.PAIRED_PID)
+                with patch('builtins.open', side_effect=no_setting_writes):
+                    RazerDaemon._sync_hyperflux_mouse(daemon, self.event)
+                self.assertEqual(len(daemon._razer_devices), 2)
+                child = daemon._razer_devices[self.mouse.name].dbus
+                self.assertIsInstance(child, cls)
+                self.assertEqual(child._device_path, str(path))
+                self.assertEqual(Path(child.get_driver_path('dpi')), path / 'dpi')
+                self.assertTrue(child.getDeviceName().endswith('(HyperFlux V2)'))
+                # No firmware/battery feature files: sleeping does not remove it.
+                RazerDaemon._sync_hyperflux_mouse(daemon, self.event)
+                self.assertIs(daemon._razer_devices[self.mouse.name].dbus, child)
+                for attribute in path.iterdir():
+                    attribute.unlink()
+                path.rmdir()
+            self.assertEqual(daemon.device_added.call_count, 2)
+            self.assertEqual(daemon.device_removed.call_count, 1)
+            (self.mouse / 'hyperflux_mouse_pid').write_text('ffff')
+            RazerDaemon._sync_hyperflux_mouse(daemon, self.event)
+            self.assertEqual(len(daemon._razer_devices), 1)
+            self.assertTrue(child._is_closed)
+            self.group(0x00e8)
+            with patch('builtins.open', side_effect=no_setting_writes):
+                RazerDaemon._sync_hyperflux_mouse(daemon, self.event)
+            self.assertEqual(len(daemon._razer_devices), 2)
+            self.assertEqual(daemon.device_added.call_count, 3)
+            self.assertEqual(writes, [])
+        finally:
+            for entry in list(daemon._razer_devices):
+                entry.dbus.close()
+                entry.dbus.remove_from_connection()
