diff --git a/daemon/openrazer_daemon/hardware/_hyperflux_keyboard.py b/daemon/openrazer_daemon/hardware/_hyperflux_keyboard.py
new file mode 100644
index 00000000..074122ce
--- /dev/null
+++ b/daemon/openrazer_daemon/hardware/_hyperflux_keyboard.py
@@ -0,0 +1,135 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Logical keyboard child; its sysfs group is isolated from the mouse's files."""
+import hashlib
+import os
+import re
+from pathlib import Path as _Path
+from openrazer_daemon.hardware.device_base import RazerDevice as _RazerDevice
+from openrazer_daemon.hardware import keyboards as _keyboards
+
+
+_PROFILES = {
+    0x025c: ('Razer BlackWidow V3 Pro', 'RazerBlackWidowV3ProWireless'),
+    0x0271: ('Razer BlackWidow V3 Mini HyperSpeed', 'RazerBlackWidowV3MiniHyperSpeedWireless'),
+    0x02ba: ('Razer BlackWidow V4 Mini HyperSpeed', 'RazerBlackWidowV4MiniHyperSpeedWireless'),
+    0x0290: ('Razer DeathStalker V2 Pro', 'RazerDeathStalkerV2ProWireless'),
+    0x0296: ('Razer DeathStalker V2 Pro TKL', 'RazerDeathStalkerV2ProTKLWireless'),
+    0x02d5: ('Razer BlackWidow V4 Tenkeyless HyperSpeed', 'RazerBlackWidowV4TenkeylessHyperSpeedWireless'),
+}
+_CLASSES = {}
+
+
+def keyboard_class(pid):
+    # DBusService stores methods per class. Different keyboard models must not
+    # gain/lose each other's matrix or polling capabilities on registration.
+    if pid not in _CLASSES:
+        _CLASSES[pid] = type(f'_HyperFluxKeyboard{pid:04X}', (_HyperFluxKeyboard,), {'__module__': __name__})
+    return _CLASSES[pid]
+
+
+def keyboard_name(pid):
+    return _PROFILES.get(pid, (f'Razer Keyboard (1532:{pid:04x})', None))[0]
+
+
+class _HyperFluxKeyboard(_RazerDevice):
+    USB_VID = 0x1532
+    USB_PID = 0x00cf
+    DRIVER_MODE = False
+    EVENT_FILE_REGEX = None  # No generic input capture/macro translation.
+    DEDICATED_MACRO_KEYS = False
+
+    @staticmethod
+    def control_path(device_id, device_path):
+        if not re.fullmatch(r'0003:1532:00CF\.[0-9A-Fa-f]+', device_id):
+            return None
+        path = _Path(device_path).resolve()
+        try:
+            if (path.parent / 'bInterfaceNumber').read_text().strip() == '04':
+                group = path / 'hyperflux_keyboard'
+                if group.is_dir():
+                    return group
+                groups = [p for p in path.glob('hyperflux_keyboard_*')
+                          if re.fullmatch('hyperflux_keyboard_[0-9a-f]{4}', p.name) and p.is_dir()]
+                if len(groups) == 1:
+                    return groups[0]
+        except OSError:
+            pass
+        return None
+
+    def __init__(self, *args, **kwargs):
+        self._is_closed = True  # Safe cleanup if a disappearing sysfs group aborts initialization.
+        path = _Path(kwargs['device_path'])
+        self.USB_PID = int((path / 'paired_device_pid').read_text().strip(), 16)
+        if not 0 < self.USB_PID < 0xffff:
+            raise ValueError('Invalid keyboard slot identity')
+        if path.name != 'hyperflux_keyboard' and path.name != f'hyperflux_keyboard_{self.USB_PID:04x}':
+            raise ValueError('Keyboard path and slot identity disagree')
+        self._keyboard_name = keyboard_name(self.USB_PID) + ' (HyperFlux V2)'
+        profile = _PROFILES.get(self.USB_PID)
+        model = getattr(_keyboards, profile[1]) if profile else None
+        self.HAS_MATRIX = bool(model and model.HAS_MATRIX)
+        self.MATRIX_DIMS = list(model.MATRIX_DIMS) if self.HAS_MATRIX else None
+        self.DEVICE_IMAGE = model.DEVICE_IMAGE if model else ''
+        self.WAVE_DIRS = model.WAVE_DIRS if model else (1, 2)
+        self.METHODS = [
+            'get_device_type_keyboard', 'get_brightness', 'set_brightness',
+            'get_battery', 'is_charging', 'get_game_mode', 'set_game_mode',
+            'set_none_effect', 'set_static_effect', 'set_spectrum_effect', 'set_wave_effect',
+            'set_reactive_effect', 'set_breath_random_effect', 'set_breath_single_effect',
+            'set_breath_dual_effect', 'set_starlight_random_effect',
+            'set_starlight_single_effect', 'set_starlight_dual_effect',
+        ]
+        if self.HAS_MATRIX:
+            self.METHODS.extend(('set_custom_effect', 'set_key_row'))
+        if self.USB_PID == 0x02d5:
+            self.POLL_RATES = [125, 250, 500, 1000]
+            self.METHODS.extend(('get_poll_rate', 'set_poll_rate', 'get_supported_poll_rates'))
+        self._initializing = True
+        super().__init__(*args, **kwargs)
+        self._initializing = False
+
+    def get_serial(self):
+        if self._serial is None:
+            usb_path = _Path(self._device_path).resolve().parents[2]
+            try:
+                receiver = (usb_path / 'serial').read_text().strip()
+            except OSError:
+                receiver = ''
+            if not re.fullmatch('[A-Za-z0-9]+', receiver):
+                receiver = 'PORT_' + hashlib.sha256(os.fsencode(usb_path)).hexdigest()[:16].upper()
+            self._serial = f'HYPERFLUXV2_{receiver}_KBD_{self.USB_PID:04X}'
+        return self._serial
+
+    def get_driver_path(self, attribute):
+        # Never search mouse attributes or another receiver's interfaces.
+        return os.path.join(self._device_path, attribute)
+
+    def load_methods(self):
+        self.methods_internal = [m for m in self.methods_internal if m != 'get_device_name']
+        super().load_methods()
+        self.add_dbus_method('razer.device.misc', 'getDeviceName', self.keyboard_device_name, out_signature='s')
+        self.add_dbus_method('razer.device.lighting.brightness', 'getBrightness', self.read_brightness, out_signature='d')
+        for method in ('getDeviceMode', 'setDeviceMode'):
+            self.del_dbus_method('razer.device.misc', method)
+
+    def keyboard_device_name(self):
+        return self._keyboard_name
+
+    def read_brightness(self):
+        value = int(_Path(self.get_driver_path('matrix_brightness')).read_text().strip())
+        if not 0 <= value <= 255:
+            raise ValueError('Invalid keyboard brightness')
+        return value * 100.0 / 255
+
+    def set_device_mode(self, mode, param):
+        self.DRIVER_MODE = False
+
+    def restore_dpi_poll_rate(self):
+        pass  # Do not write a default rate just because a child was discovered.
+
+    def restore_brightness(self):
+        pass  # Use actual readback; do not overwrite it at startup/resume.
+
+    def restore_effect(self):
+        if not self._initializing:
+            return super().restore_effect()
