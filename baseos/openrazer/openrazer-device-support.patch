+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Hot-pair mouse children after an empty-slot boot; fake sysfs/private bus."""
+import configparser
+import logging
+import os
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+
+import dbus.mainloop.glib
+from openrazer_daemon.daemon import RazerDaemon
+from openrazer_daemon.device import DeviceCollection
+from openrazer_daemon.hardware.mouse import RazerHyperFluxV2NagaV2Pro, RazerHyperFluxV2NagaV3Pro
