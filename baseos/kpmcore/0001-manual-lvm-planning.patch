 }
 
+LvmDevice::LvmDevice(const QString& vgName, qint64 peSize, qint64 totalPE, const QString& iconName)
+    : VolumeManagerDevice(std::make_shared<LvmDevicePrivate>(),
+                          vgName,
+                          (QStringLiteral("/dev/") + vgName),
+                          peSize,
+                          totalPE,
+                          iconName,
+                          Device::Type::LVM_Device)
+{
+    // Nothing is queried from the system: the volume group is not created yet.
+    d_ptr->m_peSize  = peSize;
+    d_ptr->m_totalPE = totalPE;
+    d_ptr->m_freePE  = totalPE;
+    d_ptr->m_allocPE = 0;
+    d_ptr->m_LVSizeMap  = std::make_unique<QHash<QString, qint64>>();
+
+    initPartitions();
+}
+
