@@ -0,0 +1,135 @@
+"""An unresponsive wireless child must not take out the receiver page/list."""
+from types import SimpleNamespace
+import errno
+import unittest
+from unittest.mock import Mock
+from PyQt6.QtTest import QTest
+from PyQt6.QtWidgets import QApplication, QLabel, QPushButton, QVBoxLayout, QWidget
+from polychromatic.backends._backend import Backend
+from polychromatic.backends.openrazer import OpenRazerBackend
+from polychromatic.controller.devices import DevicesTab
+
+
+class HyperFluxUnavailableTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def setUp(self):
+        self.backend = object.__new__(OpenRazerBackend)
+        self.backend._get_form_factor = lambda d: {'id': 'mouse', 'icon': ''}
+        self.backend._get_device_image = lambda d: ''
+        self.backend._get_device_vid_pid = lambda d: {'vid': '1532', 'pid': '00cf'}
+        self.backend.is_device_connected = lambda d: True
+        self.backend._reload_device_manager = Mock()
+        self.child = SimpleNamespace(serial='HYPERFLUXV2_BOOT_MOUSE_00A8', name='Razer Naga V2 Pro (HyperFlux V2)')
+        self.receiver = SimpleNamespace(serial='HYPERFLUXV2_BOOT', name='Razer HyperFlux V2')
+
+    def test_failed_child_does_not_discard_other_devices_and_can_recover(self):
+        healthy = Backend.DeviceItem()
+        healthy.name, healthy.serial = self.receiver.name, self.receiver.serial
+        self.backend._get_device = Mock(side_effect=[TimeoutError('timed out'), healthy])
+        self.backend.devman = SimpleNamespace(devices=[self.child, self.receiver])
+        devices = self.backend.get_devices()
+        self.assertEqual(len(devices), 2)
+        missing = devices[0]
+        self.assertEqual(missing.name, self.child.name)
+        self.assertEqual(missing.access_error, 'timed out')
+        self.assertEqual(missing.zones, [])
+        self.assertIsNone(missing.battery)
+        self.assertIs(devices[1], healthy)
+        self.backend._get_device = Mock(side_effect=OSError('busy'))
+        missing.refresh()
+        self.assertEqual(missing.access_error, 'busy')
+        restored = Backend.DeviceItem()
+        restored.name, restored.serial = missing.name, missing.serial
+        restored.zones = ['restored controls']
+        self.backend._get_device = Mock(return_value=restored)
+        owner = object()
+        missing.backend = owner
+        missing.refresh()
+        self.assertEqual(missing.access_error, '')
+        self.assertEqual(missing.zones, ['restored controls'])
+        self.assertIs(missing.backend, owner)
+
+    def test_keyboard_is_also_isolated(self):
+        self.child.name = 'Razer BlackWidow V4 Tenkeyless HyperSpeed (HyperFlux V2)'
+        self.backend._get_device = Mock(side_effect=TimeoutError('keyboard sleeping'))
+        device = self.backend._get_device_or_unavailable(self.child)
+        self.assertEqual(device.name, self.child.name)
+        self.assertEqual(device.access_error, 'keyboard sleeping')
+
+    def test_no_placeholder_for_removed_child_or_unrelated_errors(self):
+        self.backend._get_device = Mock(side_effect=TimeoutError('timed out'))
+        self.backend.is_device_connected = lambda d: False
+        self.backend.devman = SimpleNamespace(devices=[self.child])
+        self.assertEqual(self.backend.get_devices(), [])
+        self.backend.is_device_connected = lambda d: True
+        with self.assertRaises(TimeoutError):
+            self.backend._get_device_or_unavailable(self.receiver)
+
+    def test_offline_page_explains_failure_and_retry_does_not_write(self):
+        self.backend._get_device = Mock(side_effect=TimeoutError('error <110>'))
+        missing = self.backend._get_device_or_unavailable(self.child)
+        page = QWidget()
+        layout = QVBoxLayout(page)
+        retry = Mock()
+        tab = SimpleNamespace(_=lambda s: s, reload_device=retry)
+        DevicesTab._show_unavailable_device(tab, layout, missing)
+        text = '\n'.join(label.text() for label in page.findChildren(QLabel))
+        self.assertIn('Connected through HyperFlux V2', text)
+        self.assertIn('may have fallen asleep', text)
+        self.assertIn('Wake the device', text)
+        self.assertIn('error <110>', text)
+        technical = next(label for label in page.findChildren(QLabel) if label.text() == 'error <110>')
+        self.assertTrue(technical.isHidden())
+        retry.assert_not_called()
+        buttons = page.findChildren(QPushButton)
+        buttons[1].click()
+        self.assertFalse(technical.isHidden())
+        retry.assert_not_called()
+        buttons[0].click()
+        retry.assert_called_once()
+
+    def test_dbus_timeout_busy_missing_and_real_failure_are_distinct(self):
+        for error, state in ((RuntimeError('Traceback... TimeoutError: [Errno 110] Connection timed out'), 'asleep'),
+                             (OSError(errno.EBUSY, 'busy'), 'busy'),
+                             (OSError(errno.ENODEV, 'not paired'), 'unavailable'),
+                             (ValueError('bad protocol'), 'error')):
+            self.backend._get_device = Mock(side_effect=error)
+            device = self.backend._get_device_or_unavailable(self.child)
+            self.assertEqual(device.access_state, state)
+
+    def test_sleep_during_controls_refresh_recovers_without_replaying_a_write(self):
+        self.backend._is_device_monochromatic = lambda d: False
+        raw = SimpleNamespace(name=self.child.name, serial=self.child.serial,
+                              has=lambda cap: cap == 'serial', _available_features={})
+        zone = SimpleNamespace(options=[], _persistence=Mock())
+        self.backend._get_zone_objects = lambda d: [zone]
+        self.backend._map_zone_id_to_rzone = lambda *a: None
+        self.backend._get_persistence = lambda *a: zone._persistence
+        self.backend._get_brightness_option = lambda *a: None
+        self.backend._get_effect_options = lambda *a: []
+        # Keep the real refresh method, skipping unrelated capability builders.
+        device = self.backend._get_device(raw)
+        zone._persistence.refresh.side_effect = TimeoutError('asleep')
+        device.refresh()
+        self.assertEqual(device.access_state, 'asleep')
+        self.assertFalse(device.zones)
+        restored = Backend.DeviceItem()
+        restored.name, restored.serial = device.name, device.serial
+        restored.zones = ['awake controls']
+        self.backend._get_device = Mock(return_value=restored)
+        device.refresh()
+        self.assertEqual(device.access_error, '')
+        self.assertEqual(device.zones, ['awake controls'])
+
+    def test_sleep_during_setting_shows_wake_page_without_repeating_command(self):
+        device = Backend.DeviceItem()
+        device.name, device.backend = self.child.name, self.backend
+        tab = SimpleNamespace(reload_device=Mock(), widgets=Mock())
+        self.assertTrue(DevicesTab._catch_command_error(tab, device, TimeoutError('asleep')))
+        QTest.qWait(10)
+        tab.reload_device.assert_called_once()
+        tab.widgets.open_dialog.assert_not_called()
+        self.assertEqual(device.access_state, 'asleep')
