+"""Standalone, hardware-free test for the Nobara scroll-mode backport."""
+import unittest
+from types import SimpleNamespace
+
+from polychromatic.backends.openrazer import OpenRazerBackend
+
+
+class ScrollModeTest(unittest.TestCase):
+    def test_legacy_and_v3_options(self):
+        for modes in (None, ['tactile', 'free_spin', 'precision_tactile']):
+            backend = SimpleNamespace(_=lambda text: text, get_icon=lambda *args: '')
+            device = SimpleNamespace(
+                has=lambda name: name == 'scroll_mode' or (name == 'scroll_mode_options' and modes is not None),
+                scroll_mode=0, scroll_mode_options=modes,
+            )
+            option, = OpenRazerBackend._get_scroll_options(backend, device)
+            self.assertEqual(len(option.parameters), 3 if modes else 2)
+            self.assertTrue(option.parameters[0].active)
+            option.apply(2 if modes else 1)
+            option.refresh()
+            self.assertEqual(device.scroll_mode, 2 if modes else 1)
+            self.assertTrue(option.parameters[-1].active)
+            self.assertFalse(option.parameters[0].active)
+            if modes:
+                self.assertEqual(option.parameters[-1].label, 'Precision Tactile')
+
+
+if __name__ == '__main__':
+    unittest.main()
