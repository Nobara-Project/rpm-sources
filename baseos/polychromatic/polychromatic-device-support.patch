@@ -0,0 +1,363 @@
+# Polychromatic is licensed under the GPLv3.
+"""Explicit HyperFlux pairing actions; long work runs in the OpenRazer daemon."""
+from PyQt6.QtCore import QTimer, Qt
+from PyQt6.QtWidgets import QApplication, QCheckBox, QLabel, QMessageBox, QPushButton, QVBoxLayout, QWidget
+from .shared import PolychromaticWidgets
+
+
+class ReceiverPanel(QWidget):
+    """Use the same rows and themed, default-No dialogs as other devices."""
+    def row(self, title, *controls):
+        return PolychromaticWidgets.create_row_widget(self.widgets, title, list(controls))
+
+    def confirm(self, title, text):
+        if self.widgets is None:
+            return False  # No unthemed/implicit confirmation in headless clients.
+        accepted = []
+        self.widgets.open_dialog(self.widgets.dialog_warning, title, text,
+            buttons=[QMessageBox.StandardButton.Yes, QMessageBox.StandardButton.No],
+            default_button=QMessageBox.StandardButton.No,
+            actions={QMessageBox.StandardButton.Yes: lambda: accepted.append(True)})
+        return bool(accepted)
+
+    def label(self, text=''):
+        label = QLabel(text)
+        label.setWordWrap(True)
+        label.setTextFormat(Qt.TextFormat.PlainText)
+        return label
+
+    def refresh_allowed(self):
+        # Do not destroy a page while its modal confirmation is still open.
+        return QApplication.activeModalWidget() is None
+
+
+class ReceiverOverview(ReceiverPanel):
+    def __init__(self, device, info, translate, completed, widgets, parent=None):
+        super().__init__(parent)
+        self.device, self.info, self._ = device, info, translate
+        self.widgets, self.completed = widgets, completed
+        self.auto_panel = self.manual_panel = None
+        layout = QVBoxLayout(self)
+        layout.setContentsMargins(0, 0, 0, 0)
+        layout.setSpacing(4)
+        layout.addWidget(self.row(self._('Connection'), self.label(self._('USB · Wireless receiver and charging pad'))))
+        actions = device.receiver_actions
+        if 'driver_auto_pair' in actions:
+            self.auto_panel = DriverAutoPairPanel(device, info, translate, completed, widgets=widgets)
+            layout.addWidget(self.auto_panel)
+        if info.get('pairing_control') and all(k in actions for k in ('scan', 'pair', 'unpair', 'pairing_status')):
+            self.manual_panel = ReceiverPairingPanel(device, info, translate, completed, widgets=widgets)
+            layout.addWidget(self.manual_panel)
+        else:
+            live = info.get('inventory_source') == 'live-receiver-report'
+            for target in ('mouse', 'keyboard'):
+                pid = info.get(target + '_pid')
+                name = (info.get(target + '_name') or ReceiverPairingPanel.NAMES.get(pid, pid)) if pid and live else None
+                value = name or (self._('Not paired') if live else self._('Unavailable'))
+                layout.addWidget(self.row(self._('Mouse' if target == 'mouse' else 'Keyboard'), self.label(value)))
+            layout.addWidget(self.row(self._('Pairing'), self.label(self._('Unavailable · Check OpenRazer setup'))))
+
+        refresh = QPushButton(self._('Refresh'))
+        refresh.clicked.connect(completed)
+        layout.addWidget(self.row('', refresh))
+
+
+class DriverAutoPairPanel(ReceiverPanel):
+    """Read-only polling; only explicit Apply/Stop changes kernel policy."""
+    def __init__(self, device, info, translate, completed, parent=None, widgets=None):
+        super().__init__(parent)
+        self.widgets = widgets
+        self.actions, self._, self.completed = device.receiver_actions, translate, completed
+        self.status = info.get('pairing_status', {})
+        self.dirty = False
+        self.revision = self.status.get('kernel', {}).get('driver_auto_pair', {}).get('revision')
+        layout = QVBoxLayout(self)
+        layout.setContentsMargins(0, 0, 0, 0)
+        layout.setSpacing(4)
+        self.message = self.label()
+        self.slots = {}
+        for target, label in (('mouse', 'Mouse'), ('keyboard', 'Keyboard')):
+            box = QCheckBox(self._(label))
+            box.clicked.connect(self.mark_dirty)
+            self.slots[target] = box
+        self.apply_button = QPushButton(self._('Apply'))
+        self.apply_button.clicked.connect(self.apply)
+        self.stop_button = QPushButton(self._('Stop'))
+        self.stop_button.clicked.connect(lambda: self.configure(False, False))
+        layout.addWidget(self.row(self._('Auto-pair'), *self.slots.values(), self.apply_button, self.stop_button))
+        layout.addWidget(self.row(self._('Status'), self.message))
+        self.timer = QTimer(self)
+        self.timer.setInterval(1000)
+        self.timer.timeout.connect(self.poll)
+        self.render()
+        self.timer.start()
+
+    def mark_dirty(self):
+        self.dirty = True
+
+    def render(self):
+        kernel = self.status.get('kernel', {})
+        auto = kernel.get('driver_auto_pair', {})
+        self.message.setToolTip('')
+        available = bool(kernel.get('ready') and kernel.get('protocol_version', 1) >= 3 and auto)
+        if not self.dirty:
+            for target, box in self.slots.items():
+                box.setChecked(bool(auto.get(target)))
+        for box in self.slots.values():
+            box.setEnabled(available and not kernel.get('busy'))
+        self.apply_button.setEnabled(available and not kernel.get('busy') and not kernel.get('blocked'))
+        self.stop_button.setEnabled(bool(auto.get('mouse') or auto.get('keyboard') or
+                                         (auto.get('phase', 'idle') != 'idle')))
+        if not available:
+            message = self._('Unavailable · Check OpenRazer setup')
+        elif auto.get('error'):
+            message = self._('Stopped · Receiver error: ') + str(auto['error'])
+        elif auto.get('phase', 'idle') != 'idle':
+            keyboard = auto.get('target') == 'keyboard'
+            if auto['phase'] == 'scanning':
+                message = self._('Searching for a keyboard…' if keyboard else 'Searching for a mouse…')
+            elif auto['phase'] == 'pairing':
+                message = self._('Pairing discovered keyboard…' if keyboard else 'Pairing discovered mouse…')
+            else:
+                message = self._('Checking receiver…')
+            if not auto.get('mouse') and not auto.get('keyboard'):
+                message += self._(' · Stopping')
+        else:
+            enabled = [self._(target) for target in ('mouse', 'keyboard') if auto.get(target)]
+            message = self._('On · Waiting for a device') if enabled else self._('Off')
+            if enabled and 'empty_slots' in auto:
+                selected = (1 if auto.get('mouse') else 0) | (2 if auto.get('keyboard') else 0)
+                if not auto['empty_slots'] & selected:
+                    message = self._('On · Waiting for an empty slot')
+                elif auto.get('scans') and not auto.get('last_scan_candidate'):
+                    message = self._('No keyboard found · Will search again' if auto.get('last_scan_target') == 'keyboard'
+                                     else 'No mouse found · Will search again')
+        if 'scans' in auto and 'pair_attempts' in auto:
+            self.message.setToolTip(self._('Discovery scans: ') + str(auto['scans']) +
+                                    self._(' · Pairing attempts: ') + str(auto['pair_attempts']))
+        if kernel.get('blocked'):
+            message = self._('Stopped · Reconnect the mat to retry')
+        self.message.setText(message)
+
+    def poll(self):
+        try:
+            self.status = self.actions['pairing_status']()
+        except Exception as error:
+            self.status = {'error': str(error)}
+            self.render()
+            self.message.setText(self._('Receiver unavailable · Refresh to retry'))
+            self.message.setToolTip(str(error))
+            self.timer.stop()
+            return
+        self.render()
+        revision = self.status.get('kernel', {}).get('driver_auto_pair', {}).get('revision')
+        if self.revision is not None and revision is not None and revision != self.revision:
+            if not self.refresh_allowed():
+                return
+            self.timer.stop()
+            self.completed()
+        self.revision = revision
+
+    def apply(self):
+        self.render()
+        if not self.apply_button.isEnabled():
+            return
+        mouse, keyboard = (self.slots[t].isChecked() for t in ('mouse', 'keyboard'))
+        if mouse or keyboard:
+            if not self.confirm(self._('Enable auto-pairing?'), self._(
+                'Pair nearby devices into the selected empty slots?\n\n'
+                'This continues after closing the app and may replace a device’s previous dongle connection. '
+                'Keep other unpaired devices off.')):
+                return
+        self.configure(mouse, keyboard)
+
+    def configure(self, mouse, keyboard):
+        try:
+            self.actions['driver_auto_pair'](mouse, keyboard)
+            self.dirty = False
+            self.poll()
+        except Exception as error:
+            self.last_error = str(error)
+            self.status['setting_error'] = str(error)
+            self.message.setText(self._('Setting not changed'))
+            self.message.setToolTip(str(error))
+
+
+class ReceiverPairingPanel(ReceiverPanel):
+    NAMES = {'00a8': 'Razer Naga V2 Pro', '00e8': 'Razer Naga V3 Pro',
+             '02d5': 'Razer BlackWidow V4 Tenkeyless HyperSpeed'}
+    TESTED_PIDS = ('00a8', '00e8', '02d5')  # Capture coverage, never an allowlist.
+
+    def __init__(self, device, info, translate, completed, parent=None, widgets=None):
+        super().__init__(parent)
+        self.widgets = widgets
+        self.device, self.info, self._, self.completed = device, info, translate, completed
+        self.actions = device.receiver_actions
+        self.active_job = None
+        self.status = info.get('pairing_status', {})
+        layout = QVBoxLayout(self)
+        layout.setContentsMargins(0, 0, 0, 0)
+        layout.setSpacing(4)
+        self.message = self.label()
+        self.scan_buttons, self.unpair_buttons = {}, {}
+        # This page is recreated when receiver inventory is refreshed. Build
+        # controls from this receiver's live slots, never from the model list.
+        if self._live_inventory():
+            for target in ('mouse', 'keyboard'):
+                pid = self.info.get(target + '_pid')
+                if pid is None:
+                    scan = QPushButton(self._('Discover'))
+                    scan.setToolTip(self._('Discover mouse') if target == 'mouse' else self._('Discover keyboard'))
+                    scan.clicked.connect(lambda checked=False, target=target: self.start('scan', target))
+                    layout.addWidget(self.row(self._('Mouse' if target == 'mouse' else 'Keyboard'),
+                                             self.label(self._('Not paired')), scan))
+                    self.scan_buttons[target] = scan
+                elif self._valid_pid(pid):
+                    unpair = QPushButton(self._('Unpair'))
+                    unpair.setToolTip(self._('Unpair ') + self._device_name(pid, target))
+                    unpair.clicked.connect(lambda checked=False, pid=pid: self.confirm_unpair(pid))
+                    layout.addWidget(self.row(self._('Mouse' if target == 'mouse' else 'Keyboard'),
+                                             self.label(self._device_name(pid, target)), unpair))
+                    self.unpair_buttons[pid] = unpair
+                else:
+                    layout.addWidget(self.row(self._(target.title()), self.label(self._('Unknown · Refresh receiver'))))
+        else:
+            for target in ('Mouse', 'Keyboard'):
+                layout.addWidget(self.row(self._(target), self.label(self._('Status unavailable'))))
+        self.pair_button = QPushButton(self._('Pair'))
+        self.pair_button.clicked.connect(self.confirm_pair)
+        self.candidate_label = self.label()
+        self.candidate_row = self.row(self._('Discovered'), self.candidate_label, self.pair_button)
+        layout.addWidget(self.candidate_row)
+        layout.addWidget(self.row(self._('Manual pairing'), self.message))
+        self.timer = QTimer(self)
+        self.timer.setInterval(1000)
+        self.timer.timeout.connect(self.poll)
+        self.render()
+        self.timer.start()  # Status queries only; never a write on opening.
+
+    def _live_inventory(self):
+        # A failed query/snapshot is not evidence that either slot is empty.
+        return (self.info.get('inventory_source') == 'live-receiver-report' and
+                all(target + '_pid' in self.info for target in ('mouse', 'keyboard')))
+
+    @staticmethod
+    def _valid_pid(pid):
+        return (isinstance(pid, str) and len(pid) == 4 and
+                all(c in '0123456789abcdef' for c in pid) and pid not in ('0000', 'ffff'))
+
+    def _device_name(self, pid, target):
+        if (target == 'keyboard' and self.info.get('keyboard_pid') == pid and
+                self.info.get('keyboard_name')):
+            return self.info['keyboard_name']
+        return self.NAMES.get(pid, self._('Razer keyboard' if target == 'keyboard' else 'Razer mouse') +
+                              ' (1532:' + pid + ')')
+
+    def _candidate_target(self, kernel):
+        return kernel.get('candidate_type', '')
+
+    def _test_notice(self, pid):
+        if pid in self.TESTED_PIDS:
+            return ''
+        return '\n\n' + self._('This model has not been individually tested. The shared receiver-slot protocol will be used.')
+
+    def render(self):
+        kernel = self.status.get('kernel', {})
+        job = self.status.get('job') or {}
+        self.message.setToolTip(str(job.get('error') or kernel.get('error_message') or ''))
+        busy = bool(kernel.get('busy') or job.get('state') == 'running')
+        auto = kernel.get('driver_auto_pair', {})
+        auto_enabled = auto.get('mouse') or auto.get('keyboard')
+        current_protocol = kernel.get('protocol_version', 1) >= 2
+        enabled = (kernel.get('ready') and current_protocol and not kernel.get('blocked') and
+                   not busy and not auto_enabled and self._live_inventory())
+        if busy:
+            self.active_job = job.get('id') or self.active_job
+            message = self._('Receiver busy · Keep the device awake')
+        elif kernel.get('blocked'):
+            message = self._('Reconnect the mat to retry')
+        elif auto_enabled:
+            message = self._('Stop auto-pairing to use manual controls')
+        elif not kernel.get('ready'):
+            message = self._('Unavailable · Check OpenRazer setup')
+        elif job.get('state') == 'error':
+            message = self._('Operation failed')
+        elif not current_protocol:
+            message = self._('Unavailable · Update the OpenRazer kernel module')
+        elif not self._live_inventory():
+            message = self._('Pairing status unavailable · Refresh receiver')
+        elif job.get('result') == 'empty':
+            message = self._('Nothing found · Wake the device and retry')
+        elif job.get('result') in ('paired', 'unpaired'):
+            message = self._('Paired' if job['result'] == 'paired' else 'Unpaired')
+        else:
+            message = self._('Discover a device, then select Pair')
+        candidate = '{:04x}'.format(kernel.get('candidate', 0))
+        target = self._candidate_target(kernel)
+        valid = (self._valid_pid(candidate) and target in ('mouse', 'keyboard') and
+                 kernel.get('token', '0' * 16) != '0' * 16)
+        self.candidate_row.setVisible(valid)
+        self.candidate_label.setText(self._device_name(candidate, target) if valid else '')
+        self.message.setText(message)
+        for target, button in self.scan_buttons.items():
+            # Do not offer an unqualified replacement of an occupied slot.
+            button.setEnabled(bool(enabled and not self.info.get(target + '_pid')))
+        for pid, button in self.unpair_buttons.items():
+            matches = sum(self.info.get(slot + '_pid') == pid for slot in ('mouse', 'keyboard'))
+            button.setEnabled(bool(enabled and matches == 1))
+        target = self._candidate_target(kernel)
+        self.pair_button.setEnabled(bool(enabled and valid and not self.info.get(target + '_pid')))
+
+    def poll(self):
+        try:
+            self.status = self.actions['pairing_status']()
+        except Exception as error:
+            self.status = {'kernel': {'ready': False, 'error_message': str(error)}}
+            self.timer.stop()
+        self.render()
+        job = self.status.get('job') or {}
+        if self.active_job and job.get('id') == self.active_job and job.get('state') != 'running':
+            if not self.refresh_allowed():
+                return
+            self.active_job = None
+            self.timer.stop()
+            self.completed()  # Reload inventory through the normal device-load worker.
+        elif (not self._live_inventory() and self.info.get('inventory_source') == 'operation-in-progress'
+              and self.status.get('kernel', {}).get('ready') and not self.status['kernel'].get('busy')
+              and self.refresh_allowed() and self.timer.isActive()):
+            self.timer.stop()
+            self.completed()  # Recover the slot rows after opening during a scan.
+
+    def start(self, operation, *args):
+        try:
+            self.active_job = self.actions[operation](*args)
+            self.poll()
+        except Exception as error:
+            self.last_error = str(error)
+            self.status['start_error'] = str(error)
+            self.message.setText(self._('Operation not started'))
+            self.message.setToolTip(str(error))
+
+    def confirm_pair(self):
+        self.render()
+        if not self.pair_button.isEnabled():
+            return
+        kernel = self.status.get('kernel', {})
+        pid = '{:04x}'.format(kernel.get('candidate', 0))
+        target = self._candidate_target(kernel)
+        if not self._valid_pid(pid) or target not in ('mouse', 'keyboard'):
+            return
+        token = kernel.get('token', '')
+        if self.confirm(self._('Pair device?'), self._device_name(pid, target) + '\n\n' +
+            self._('Its previous dongle connection will be replaced.') + self._test_notice(pid)):
+            self.start('pair', pid, token)  # Kernel rejects expired/stale candidates.
+
+    def confirm_unpair(self, pid):
+        self.render()
+        button = self.unpair_buttons.get(pid)
+        if button is None or not button.isEnabled():
+            return
+        target = 'keyboard' if self.info.get('keyboard_pid') == pid else 'mouse'
+        if self.confirm(self._('Unpair device?'), self._device_name(pid, target) + '\n\n' +
+            self._('Input through this mat will stop. Have another input device available.') + self._test_notice(pid)):
+            self.start('unpair', pid)
