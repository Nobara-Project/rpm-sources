@@ -0,0 +1,117 @@
+"""Hardware-free checks for the receiver's explicit, acknowledged commands."""
+import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+from PyQt6.QtGui import QPalette
+from PyQt6.QtWidgets import QApplication, QLabel, QMessageBox, QPushButton, QVBoxLayout, QWidget
+from polychromatic.controller.devices import DevicesTab
+from polychromatic.controller.receiver import ReceiverOverview, ReceiverPanel
+from polychromatic.controller.shared import PolychromaticWidgets
+
+
+class ReceiverControlsTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def make_page(self, action, info):
+        page = QWidget()
+        layout = QVBoxLayout(page)
+        def row(title, children):
+            widget = QWidget()
+            row_layout = QVBoxLayout(widget)
+            row_layout.addWidget(QLabel(title))
+            for child in children:
+                row_layout.addWidget(child)
+            return widget
+        device = SimpleNamespace(receiver_actions={'auto_pair': action} if action else {})
+        tab = SimpleNamespace(_=lambda s: s, current_device=device, reload_device=Mock(),
+                              widgets=SimpleNamespace(create_row_widget=row, open_dialog=Mock(),
+                                                      dialog_error=QMessageBox.Icon.Critical))
+        DevicesTab._show_receiver_status(tab, layout, info)
+        return page, tab
+
+    def test_firmware_controls_are_absent_regardless_of_last_command(self):
+        for last_ack in (None, True, False):
+            with self.subTest(last_ack=last_ack):
+                action = Mock()
+                page, tab = self.make_page(action, {'auto_pair_control': True, 'auto_pair_last_ack': last_ack})
+                self.addCleanup(page.deleteLater)
+                buttons = {b.text(): b for b in page.findChildren(QPushButton)}
+                self.assertEqual(set(buttons), {'Refresh'})
+                labels = ' '.join(label.text() for label in page.findChildren(QLabel))
+                self.assertNotIn('Firmware', labels)
+                self.assertNotIn('Last command', labels)
+                buttons['Refresh'].click()
+                action.assert_not_called()
+                tab.reload_device.assert_called_once()
+
+    def test_removed_firmware_action_is_never_called_even_if_it_would_fail(self):
+        action = Mock(side_effect=OSError('Operation not supported'))
+        page, tab = self.make_page(action, {'auto_pair_control': True})
+        self.addCleanup(page.deleteLater)
+        next(b for b in page.findChildren(QPushButton) if b.text() == 'Refresh').click()
+        action.assert_not_called()
+        tab.widgets.open_dialog.assert_not_called()
+        tab.reload_device.assert_called_once()
+
+    def test_old_kernel_and_missing_client_method_have_only_refresh(self):
+        for action, info in ((Mock(), {}), (None, {'auto_pair_control': True})):
+            page, tab = self.make_page(action, info)
+            self.addCleanup(page.deleteLater)
+            self.assertEqual([b.text() for b in page.findChildren(QPushButton)], ['Refresh'])
+
+    def test_overview_has_only_pairing_controls_and_refresh_without_writes(self):
+        status = {'kernel': {'ready': True, 'protocol_version': 3, 'busy': False,
+            'blocked': False, 'candidate': 0, 'token': '0' * 16,
+            'driver_auto_pair': {'mouse': True, 'keyboard': True, 'phase': 'idle', 'target': '',
+                'error': 0, 'revision': 0, 'scans': 10, 'pair_attempts': 0,
+                'empty_slots': 1, 'last_scan_target': 'mouse', 'last_scan_candidate': 0}}}
+        info = {'pairing_status': status, 'mouse_pid': None, 'keyboard_pid': '02d5',
+                'inventory_source': 'live-receiver-report', 'pairing_control': True}
+        actions = {name: Mock() for name in ('auto_pair', 'driver_auto_pair', 'scan', 'pair', 'unpair')}
+        actions['pairing_status'] = Mock(return_value=status)
+        page = ReceiverOverview(SimpleNamespace(receiver_actions=actions), info, lambda s: s, Mock(), Mock())
+        self.addCleanup(page.deleteLater)
+        page.resize(580, 440)
+        page.show()
+        self.app.processEvents()
+        text = ' '.join(label.text() for label in page.findChildren(QLabel) if label.isVisibleTo(page))
+        self.assertLess(len(text), 450, text)
+        self.assertLess(page.minimumSizeHint().width(), 580)
+        self.assertLess(page.sizeHint().height(), 400)
+        self.assertFalse(hasattr(page, 'advanced'))
+        self.assertFalse(hasattr(page, 'set_firmware_auto'))
+        self.assertEqual({b.text() for b in page.findChildren(QPushButton)},
+                         {'Apply', 'Stop', 'Discover', 'Unpair', 'Pair', 'Refresh'})
+        self.assertNotIn('Firmware', text)
+        for name in ('auto_pair', 'driver_auto_pair', 'scan', 'pair', 'unpair'):
+            actions[name].assert_not_called()
+        page.widgets.open_dialog.assert_not_called()
+        page.auto_panel.timer.stop()
+        page.manual_panel.timer.stop()
+        page.close()
+
+    def test_real_confirmation_uses_application_theme_and_defaults_to_no(self):
+        appdata = SimpleNamespace(system_qt_theme=False, dbg=Mock(),
+            normal_colour='#DED9CB', disabled_colour='#828282', active_colour='#00FF00',
+            selected_colour='#FFFFFF', secondary_colour_active='#008000', secondary_colour_inactive='#323232')
+        widget = ReceiverPanel()
+        widget.widgets = PolychromaticWidgets(appdata)
+        self.addCleanup(widget.deleteLater)
+        def reject(dialog):
+            self.assertTrue(dialog.styleSheet())
+            self.assertEqual(dialog.defaultButton(), dialog.button(QMessageBox.StandardButton.No))
+            self.assertLess(dialog.palette().color(QPalette.ColorRole.Window).lightness(), 80)
+            self.assertGreater(dialog.palette().color(QPalette.ColorRole.WindowText).lightness(), 180)
+            dialog.button(QMessageBox.StandardButton.No).click()
+        with patch.object(QMessageBox, 'exec', reject):
+            self.assertFalse(widget.confirm('Enable auto-pairing?', 'Pair nearby devices?'))
+        def accept(dialog):
+            dialog.button(QMessageBox.StandardButton.Yes).click()
+        with patch.object(QMessageBox, 'exec', accept):
+            self.assertTrue(widget.confirm('Pair device?', 'A test device'))
+
+
+if __name__ == '__main__':
+    unittest.main()
