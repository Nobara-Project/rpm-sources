+        backend.is_device_connected = lambda d: True
+        with self.assertRaises(RuntimeError):
+            OpenRazerBackend.get_devices(backend)
+
+    def test_receiver_status_does_not_advertise_mouse_controls(self):
+        backend = object.__new__(OpenRazerBackend)
+        backend._get_form_factor = lambda d: {'icon': '', 'id': 'mousemat'}
+        backend._get_device_image = lambda d: ''
+        backend._is_device_monochromatic = lambda d: False
+        backend._get_device_vid_pid = lambda d: {'vid': '1532', 'pid': '00cf'}
+        raw = SimpleNamespace(
+            has=lambda cap: cap in ('serial', 'firmware_version', 'hyperflux_receiver'),
