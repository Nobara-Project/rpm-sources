+"""No hardware I/O: explicit opt-in, real kernel state and manual exclusion."""
+import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+from PyQt6.QtWidgets import QApplication, QMessageBox
+from polychromatic.controller.receiver import DriverAutoPairPanel, ReceiverPairingPanel
+
+
+class DriverAutoPanelTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def panel(self):
+        kernel = {'ready': True, 'busy': False, 'blocked': False, 'protocol_version': 3,
+                  'candidate': 0, 'candidate_type': '', 'token': '0' * 16,
+                  'driver_auto_pair': {'mouse': False, 'keyboard': False, 'phase': 'idle',
+                                       'target': '', 'error': 0, 'revision': 0}}
+        status = {'kernel': kernel, 'job': None}
+        actions = {'driver_auto_pair': Mock(), 'pairing_status': Mock(return_value=status)}
+        info = {'pairing_status': status, 'inventory_source': 'live-receiver-report',
+                'mouse_pid': None, 'keyboard_pid': None}
+        widget = DriverAutoPairPanel(SimpleNamespace(receiver_actions=actions), info, lambda s: s, Mock())
+        widget.timer.stop()
+        self.addCleanup(widget.deleteLater)
+        return widget, actions, kernel
+
+    def test_open_poll_and_select_do_not_enable(self):
+        widget, actions, kernel = self.panel()
+        widget.poll()
+        widget.slots['keyboard'].click()
+        widget.poll()
+        self.assertTrue(widget.slots['keyboard'].isChecked())  # Poll cannot discard edits.
+        actions['driver_auto_pair'].assert_not_called()
+        with patch.object(widget, 'confirm', return_value=False):
+            widget.apply()
+        actions['driver_auto_pair'].assert_not_called()
+
+    def test_mouse_keyboard_and_both_require_explicit_confirmation(self):
+        for mouse, keyboard in ((True, False), (False, True), (True, True)):
+            widget, actions, kernel = self.panel()
+            for target, enabled in (('mouse', mouse), ('keyboard', keyboard)):
+                if enabled:
+                    widget.slots[target].click()
+            with patch.object(widget, 'confirm', return_value=True):
+                widget.apply()
+            actions['driver_auto_pair'].assert_called_once_with(mouse, keyboard)
+            # Mock has not acknowledged new state: do not invent enabled state.
+            self.assertFalse(widget.slots['mouse'].isChecked())
+            self.assertFalse(widget.slots['keyboard'].isChecked())
+
+    def test_stop_remains_available_during_scan(self):
+        widget, actions, kernel = self.panel()
+        kernel['driver_auto_pair'].update(keyboard=True, phase='scanning', target='keyboard')
+        kernel['busy'] = True
+        widget.poll()
+        self.assertFalse(widget.apply_button.isEnabled())
+        self.assertTrue(widget.stop_button.isEnabled())
+        widget.stop_button.click()
+        actions['driver_auto_pair'].assert_called_once_with(False, False)
+
+    def test_error_and_disconnect_do_not_retry_or_claim_success(self):
+        widget, actions, kernel = self.panel()
+        actions['driver_auto_pair'].side_effect = OSError('busy')
+        widget.configure(True, True)
+        actions['driver_auto_pair'].assert_called_once_with(True, True)
+        self.assertIn('not changed', widget.message.text())
+        self.assertNotIn('Diagnostics', widget.message.text())
+        self.assertEqual(widget.message.toolTip(), 'busy')
+        actions['pairing_status'].side_effect = OSError('disconnected')
+        widget.poll()
+        self.assertEqual(widget.message.text(), 'Receiver unavailable · Refresh to retry')
+        self.assertEqual(widget.message.toolTip(), 'disconnected')
+        self.assertFalse(widget.timer.isActive())
+        self.assertFalse(widget.apply_button.isEnabled())
+        self.assertFalse(widget.stop_button.isEnabled())
+
+    def test_successful_poll_clears_obsolete_error_tooltip(self):
+        widget, actions, kernel = self.panel()
+        actions['driver_auto_pair'].side_effect = OSError('busy')
+        widget.configure(True, False)
+        self.assertEqual(widget.message.toolTip(), 'busy')
+        widget.poll()
+        self.assertEqual(widget.message.toolTip(), '')
+        self.assertEqual(widget.message.text(), 'Off')
+
+    def test_completed_driver_pair_refreshes_inventory(self):
+        widget, actions, kernel = self.panel()
+        kernel['driver_auto_pair']['revision'] = 1
+        widget.poll()
+        widget.poll()
+        widget.completed.assert_called_once()
+        actions['driver_auto_pair'].assert_not_called()
+
+    def test_manual_pairing_is_disabled_while_either_auto_slot_is_on(self):
+        for target in ('mouse', 'keyboard'):
+            widget, actions, kernel = self.panel()
+            kernel['driver_auto_pair'][target] = True
+            actions.update({k: Mock() for k in ('scan', 'pair', 'unpair')})
+            info = {'pairing_status': {'kernel': kernel, 'job': None},
+                    'mouse_pid': None, 'keyboard_pid': None, 'inventory_source': 'live-receiver-report'}
+            manual = ReceiverPairingPanel(SimpleNamespace(receiver_actions=actions), info, lambda s: s, Mock())
+            manual.timer.stop()
+            self.addCleanup(manual.deleteLater)
+            self.assertTrue(all(not b.isEnabled() for b in manual.scan_buttons.values()))
+            self.assertIn('Stop auto-pairing', manual.message.text())
+            self.assertFalse(manual.pair_button.isEnabled())
+
+    def test_two_pads_do_not_share_mode(self):
+        first, first_actions, first_kernel = self.panel()
+        second, second_actions, second_kernel = self.panel()
+        first_kernel['driver_auto_pair'].update(mouse=True, keyboard=True)
+        first.poll()
+        second.poll()
+        self.assertTrue(first.slots['keyboard'].isChecked())
+        self.assertFalse(second.slots['keyboard'].isChecked())
+        first.stop_button.click()
+        first_actions['driver_auto_pair'].assert_called_once_with(False, False)
+        second_actions['driver_auto_pair'].assert_not_called()
+
+    def test_empty_scans_are_not_labelled_pairing(self):
+        widget, actions, kernel = self.panel()
+        auto = kernel['driver_auto_pair']
+        auto.update(mouse=True, keyboard=True, phase='scanning', target='mouse',
+                    scans=2, pair_attempts=0, empty_slots=1,
+                    last_scan_target='mouse', last_scan_candidate=0)
+        widget.poll()
+        self.assertEqual('Searching for a mouse…', widget.message.text())
+        auto.update(phase='idle', target='')
+        widget.poll()
+        self.assertIn('No mouse found', widget.message.text())
+        self.assertIn('Pairing attempts: 0', widget.message.toolTip())
+        auto.update(phase='pairing', target='mouse', pair_attempts=1)
+        widget.poll()
+        self.assertEqual('Pairing discovered mouse…', widget.message.text())
+        auto.update(phase='idle', target='', empty_slots=0)
+        widget.poll()
+        self.assertIn('Waiting for an empty slot', widget.message.text())
+        actions['driver_auto_pair'].assert_not_called()
+
+    def test_confirmation_dialog_defers_page_replacement(self):
+        widget, actions, kernel = self.panel()
+        kernel['driver_auto_pair']['revision'] = 1
+        with patch.object(QApplication, 'activeModalWidget', return_value=object()):
+            widget.poll()
+        widget.completed.assert_not_called()
+        widget.poll()
+        widget.completed.assert_called_once()
+
+
+if __name__ == '__main__':
+    unittest.main()
