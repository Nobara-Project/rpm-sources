@@ -0,0 +1,214 @@
+"""No device I/O: explicit consent, nonblocking jobs, stale/disconnected UI."""
+import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+from PyQt6.QtWidgets import QApplication, QLabel, QMessageBox, QPushButton
+from polychromatic.controller.receiver import ReceiverPairingPanel
+
+
+class PairingPanelTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def panel(self, pid=None, mouse_pid='00a8', inventory_source='live-receiver-report'):
+        kernel = {'ready': True, 'busy': False, 'blocked': False, 'candidate': 0x02d5,
+                  'protocol_version': 2, 'candidate_type': 'keyboard',
+                  'token': '0123456789abcdef', 'error': 0}
+        status = {'kernel': kernel, 'job': None}
+        actions = {key: Mock(return_value='job1') for key in ('scan', 'pair', 'unpair')}
+        actions['pairing_status'] = Mock(return_value=status)
+        info = {'pairing_status': status, 'mouse_pid': mouse_pid, 'keyboard_pid': pid,
+                'inventory_source': inventory_source}
+        widget = ReceiverPairingPanel(SimpleNamespace(receiver_actions=actions), info, lambda s: s, Mock())
+        self.addCleanup(widget.deleteLater)
+        widget.timer.stop()
+        return widget, actions, status
+
+    def test_open_and_poll_do_not_write(self):
+        widget, actions, status = self.panel()
+        widget.poll()
+        for action in ('scan', 'pair', 'unpair'):
+            actions[action].assert_not_called()
+        self.assertTrue(widget.pair_button.isEnabled())
+        self.assertNotIn('mouse', widget.scan_buttons)
+
+    def test_pair_requires_confirmation_and_exact_candidate(self):
+        widget, actions, status = self.panel()
+        with patch.object(widget, 'confirm', return_value=False):
+            widget.confirm_pair()
+        actions['pair'].assert_not_called()
+        with patch.object(widget, 'confirm', return_value=True):
+            widget.confirm_pair()
+        actions['pair'].assert_called_once_with('02d5', '0123456789abcdef')
+
+    def test_unpair_requires_confirmation_and_does_not_target_mouse(self):
+        widget, actions, status = self.panel('02d5')
+        with patch.object(widget, 'confirm', return_value=False):
+            widget.confirm_unpair('02d5')
+        actions['unpair'].assert_not_called()
+        with patch.object(widget, 'confirm', return_value=True):
+            widget.confirm_unpair('02d5')
+        actions['unpair'].assert_called_once_with('02d5')
+
+    def test_busy_then_completed_reloads_once(self):
+        widget, actions, status = self.panel()
+        status['job'] = {'id': 'job1', 'state': 'running'}
+        widget.start('scan', 'keyboard')
+        self.assertFalse(widget.pair_button.isEnabled())
+        self.assertFalse(widget.scan_buttons['keyboard'].isEnabled())
+        widget.completed.assert_not_called()
+        status['job'].update(state='complete', result='found')
+        widget.poll()
+        widget.poll()
+        widget.completed.assert_called_once()
+
+    def test_expired_candidate_blocked_and_disconnect_disable_controls(self):
+        widget, actions, status = self.panel()
+        status['kernel'].update(candidate=0, token='0' * 16)
+        widget.poll()
+        self.assertFalse(widget.pair_button.isEnabled())
+        status['kernel']['blocked'] = True
+        widget.poll()
+        self.assertFalse(widget.scan_buttons['keyboard'].isEnabled())
+        actions['pairing_status'].side_effect = OSError('disconnected')
+        widget.poll()
+        self.assertFalse(widget.timer.isActive())
+        self.assertFalse(widget.unpair_buttons['00a8'].isEnabled())
+
+    def test_v3_only_pad_has_no_unpair_buttons_for_test_lab_devices(self):
+        widget, actions, status = self.panel(mouse_pid='00e8')
+        self.assertEqual(set(widget.unpair_buttons), {'00e8'})
+        self.assertTrue(widget.unpair_buttons['00e8'].isEnabled())
+        self.assertEqual(set(widget.scan_buttons), {'keyboard'})
+        self.assertTrue(widget.scan_buttons['keyboard'].isEnabled())
+        self.assertEqual([b.toolTip() for b in widget.findChildren(QPushButton) if b.text() == 'Unpair'],
+                         ['Unpair Razer Naga V3 Pro'])
+        widget.poll()
+        for action in ('scan', 'pair', 'unpair'):
+            actions[action].assert_not_called()
+
+    def test_only_present_supported_devices_have_unpair_controls(self):
+        for mouse, keyboard, expected in (('00a8', None, {'00a8'}),
+                                          (None, '02d5', {'02d5'}),
+                                          ('00a8', '02d5', {'00a8', '02d5'}),
+                                          (None, None, set())):
+            with self.subTest(mouse=mouse, keyboard=keyboard):
+                widget, actions, status = self.panel(keyboard, mouse_pid=mouse)
+                self.assertEqual(set(widget.unpair_buttons), expected)
+                self.assertTrue(all(b.isEnabled() for b in widget.unpair_buttons.values()))
+                self.assertEqual(set(widget.scan_buttons),
+                                 {slot for slot, pid in (('mouse', mouse), ('keyboard', keyboard)) if pid is None})
+
+    def test_model_independent_slots_have_unpair_controls(self):
+        for mouse, keyboard in (('abcd', '1234'), ('02d5', '00a8')):
+            with self.subTest(mouse=mouse, keyboard=keyboard):
+                widget, actions, status = self.panel(keyboard, mouse_pid=mouse)
+                self.assertEqual(set(widget.unpair_buttons), {mouse, keyboard})
+                self.assertTrue(all(b.isEnabled() for b in widget.unpair_buttons.values()))
+                self.assertEqual(widget.scan_buttons, {})
+
+    def test_failed_inventory_is_not_an_empty_or_paired_slot(self):
+        for source in ('unavailable', 'driver-binding-snapshot', 'operation-in-progress', None):
+            for mouse in (None, '00a8'):
+                with self.subTest(source=source, mouse=mouse):
+                    widget, actions, status = self.panel(mouse_pid=mouse, inventory_source=source)
+                    self.assertEqual(widget.unpair_buttons, {})
+                    self.assertEqual(widget.scan_buttons, {})
+                    self.assertFalse(widget.pair_button.isEnabled())
+                    self.assertIn('Pairing status unavailable', widget.message.text())
+
+    def test_unpair_absent_device_cannot_prompt_or_write(self):
+        widget, actions, status = self.panel(mouse_pid='00e8')
+        with patch.object(widget, 'confirm') as question:
+            for pid in ('00a8', '02d5', 'abcd'):
+                widget.confirm_unpair(pid)
+        question.assert_not_called()
+        actions['unpair'].assert_not_called()
+
+    def test_v3_candidate_can_pair_using_mouse_slot(self):
+        widget, actions, status = self.panel(mouse_pid=None)
+        status['kernel'].update(candidate=0x00e8, candidate_type='mouse')
+        widget.poll()
+        self.assertTrue(widget.pair_button.isEnabled())
+        with patch.object(widget, 'confirm', return_value=True) as question:
+            widget.confirm_pair()
+        self.assertNotIn('not been individually tested', question.call_args.args[1])
+        actions['pair'].assert_called_once_with('00e8', '0123456789abcdef')
+
+    def test_two_receiver_pages_do_not_share_devices_or_actions(self):
+        lab, lab_actions, lab_status = self.panel('02d5')
+        local, local_actions, local_status = self.panel(mouse_pid='00e8')
+        self.assertEqual(set(lab.unpair_buttons), {'00a8', '02d5'})
+        self.assertEqual(set(local.unpair_buttons), {'00e8'})
+        local.scan_buttons['keyboard'].click()
+        local_actions['scan'].assert_called_once_with('keyboard')
+        lab_actions['scan'].assert_not_called()
+        # A newly refreshed empty page must not inherit the old page's buttons.
+        refreshed, actions, status = self.panel(mouse_pid=None)
+        self.assertEqual(refreshed.unpair_buttons, {})
+        self.assertEqual(set(refreshed.scan_buttons), {'mouse', 'keyboard'})
+
+    def test_other_keyboard_uses_keyboard_slot_and_warns_without_blocking(self):
+        widget, actions, status = self.panel('02ba', mouse_pid='00e8')
+        with patch.object(widget, 'confirm', return_value=True) as question:
+            widget.confirm_unpair('02ba')
+        self.assertIn('not been individually tested', question.call_args.args[1])
+        actions['unpair'].assert_called_once_with('02ba')
+        fresh, actions, status = self.panel(mouse_pid='00e8')
+        status['kernel'].update(candidate=0x02ba, candidate_type='keyboard')
+        fresh.poll()
+        self.assertTrue(fresh.pair_button.isEnabled())
+        status['kernel']['candidate_type'] = 'mouse'
+        fresh.poll()
+        self.assertFalse(fresh.pair_button.isEnabled())  # Existing mouse, not PID heuristic.
+
+    def test_old_kernel_and_ambiguous_inventory_fail_closed(self):
+        widget, actions, status = self.panel('00e8', mouse_pid='00e8')
+        self.assertFalse(widget.unpair_buttons['00e8'].isEnabled())
+        status['kernel'].pop('protocol_version')
+        widget.poll()
+        self.assertIn('Update the OpenRazer kernel module', widget.message.text())
+        self.assertFalse(widget.pair_button.isEnabled())
+
+    def test_open_during_scan_recovers_slot_rows_when_idle(self):
+        widget, actions, status = self.panel(inventory_source='operation-in-progress')
+        widget.timer.start()
+        status['kernel']['busy'] = True
+        widget.poll()
+        widget.completed.assert_not_called()
+        status['kernel']['busy'] = False
+        widget.poll()
+        widget.poll()
+        widget.completed.assert_called_once()
+        for key in ('scan', 'pair', 'unpair'):
+            actions[key].assert_not_called()
+
+    def test_errors_use_status_tooltips_without_removed_diagnostics_link(self):
+        widget, actions, status = self.panel()
+        status['job'] = {'id': 'old', 'state': 'error', 'error': 'Receiver rejected discovery'}
+        widget.poll()
+        self.assertEqual(widget.message.text(), 'Operation failed')
+        self.assertEqual(widget.message.toolTip(), 'Receiver rejected discovery')
+        status['job'] = None
+        widget.poll()
+        self.assertEqual(widget.message.toolTip(), '')
+        actions['pairing_status'].side_effect = OSError('disconnected')
+        widget.poll()
+        self.assertEqual(widget.message.text(), 'Unavailable · Check OpenRazer setup')
+        self.assertEqual(widget.message.toolTip(), 'disconnected')
+        self.assertFalse(widget.timer.isActive())
+
+    def test_failed_start_keeps_error_details_without_extra_buttons(self):
+        widget, actions, status = self.panel()
+        actions['scan'].side_effect = OSError('Receiver busy')
+        widget.start('scan', 'keyboard')
+        self.assertEqual(widget.message.text(), 'Operation not started')
+        self.assertEqual(widget.message.toolTip(), 'Receiver busy')
+        actions['scan'].assert_called_once_with('keyboard')
+        actions['pair'].assert_not_called()
+        actions['unpair'].assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
