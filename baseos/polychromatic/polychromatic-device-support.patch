+"""Model-specific artwork selection; no hardware, DBus or downloads."""
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from polychromatic.backends.openrazer import OpenRazerBackend
+
+
+class ArtworkTest(unittest.TestCase):
+    def setUp(self):
+        self.data = Path(__file__).resolve().parents[1] / 'data'
+        self.backend = SimpleNamespace(_base=SimpleNamespace(paths=SimpleNamespace(data_dir=str(self.data))))
+
+    def test_all_v3_transports_use_bundled_image(self):
+        for transport in ('Wired', 'Wireless', 'HyperFlux V2'):
+            with self.subTest(transport=transport):
+                device = SimpleNamespace(name=f'Razer Naga V3 Pro ({transport})', device_image='remote')
+                path = OpenRazerBackend._get_device_image(self.backend, device)
+                self.assertEqual(path, str(self.data / 'devices/naga-v3-pro-with-side-plates.png'))
+                self.assertTrue(Path(path).is_file())
+
+    def test_v2_and_hyperflux_parent_are_unchanged(self):
+        for name in ('Razer Naga V2 Pro (Wired)', 'Razer Naga V2 Pro (Wireless)',
+                     'Razer Naga V2 Pro (HyperFlux V2)', 'Razer HyperFlux V2'):
+            with self.subTest(name=name):
+                device = SimpleNamespace(name=name, device_image='original-image')
+                self.assertEqual(OpenRazerBackend._get_device_image(self.backend, device), 'original-image')
+
+    def test_missing_asset_falls_back_to_daemon(self):
+        device = SimpleNamespace(name='Razer Naga V3 Pro (Wired)', device_image='original-image')
+        with patch('polychromatic.backends.openrazer.os.path.isfile', return_value=False):
+            self.assertEqual(OpenRazerBackend._get_device_image(self.backend, device), 'original-image')
+
+
+if __name__ == '__main__':
+    unittest.main()
