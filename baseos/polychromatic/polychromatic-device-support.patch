index 0000000..b80dd53
--- /dev/null
+++ b/polychromatic/controller/devicewatcher.py
@@ -0,0 +1,41 @@
+# Polychromatic is licensed under the GPLv3.
+"""Deliver OpenRazer hotplug notifications on the Qt event loop."""
+from PyQt6.QtCore import QObject, QTimer, pyqtSignal, pyqtSlot
+from PyQt6.QtDBus import QDBusConnection, QDBusServiceWatcher
+from PyQt6.QtWidgets import QApplication
+
+
+class DeviceWatcher(QObject):
+    devices_changed = pyqtSignal()
+
+    def __init__(self, parent=None, bus=None):
+        super().__init__(parent)
+        self.timer = QTimer(self)
+        self.timer.setSingleShot(True)
+        self.timer.setInterval(200)
+        self.timer.timeout.connect(self._deliver)
+        self.bus = bus if bus is not None else QDBusConnection.sessionBus()
+        for event in ('device_added', 'device_removed'):
+            self.bus.connect('org.razer', '/org/razer', 'razer.devices',
+                             event, self.schedule)
+        self.service_watcher = QDBusServiceWatcher(
+            'org.razer', self.bus,
+            QDBusServiceWatcher.WatchModeFlag.WatchForOwnerChange, self)
+        self.service_watcher.serviceOwnerChanged.connect(self._owner_changed)
+
+    @pyqtSlot()
+    def schedule(self):
+        self.timer.start()
+
+    @pyqtSlot(str, str, str)
+    def _owner_changed(self, service, old_owner, new_owner):
+        self.schedule()
+
+    @pyqtSlot()
+    def _deliver(self):
+        # Dialogs run nested event loops. Do not destroy controls while their
+        # colour picker/error dialog still has callbacks on the stack.
+        if QApplication.activeModalWidget() is not None:
+            self.timer.start()
+            return
+        self.devices_changed.emit()
