+def _wireless_access_state(error):
+    # dbus-python embeds the daemon's OSError and errno in its traceback.
+    code = getattr(error, 'errno', None)
+    matches = re.findall(r'\[Errno (\d+)\]', str(error))
+    if matches:
+        code = int(matches[-1])
+    if code == errno.EBUSY:
+        return 'busy'
+    if code == errno.ETIMEDOUT or isinstance(error, TimeoutError):
+        return 'asleep'
+    if code == errno.ENODEV:
+        return 'unavailable'  # A stale binding is not proof of sleep.
+    return 'error'
+
