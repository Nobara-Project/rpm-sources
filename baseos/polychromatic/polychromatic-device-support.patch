+            create_row_widget=lambda title, labels: QLabel(title + ': ' + labels[0].text())))
+        DevicesTab._show_receiver_status(tab, layout, device.receiver_info)
+        text = '\n'.join(widget.text() for widget in container.findChildren(QLabel))
+        self.assertIn('Razer Naga V3 Pro', text)
+        self.assertIn('Check OpenRazer setup', text)
