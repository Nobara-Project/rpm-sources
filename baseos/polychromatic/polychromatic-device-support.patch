+            receiver_info={'mouse_pid': '00e8', 'pairing_control': False,
+                           'inventory_source': 'live-receiver-report'})
+        device = backend._get_device(raw)
+        device.refresh()
+        self.assertEqual(device.zones, [])
+        self.assertIsNone(device.dpi)
+        self.assertIsNone(device.battery)
+        container = QWidget()
