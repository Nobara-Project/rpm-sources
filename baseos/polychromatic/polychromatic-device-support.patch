@@ -0,0 +1,160 @@
+"""Hardware-free regression tests. Run under dbus-run-session with offscreen Qt."""
+import os
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+
+from PyQt6.QtDBus import QDBusConnection, QDBusMessage
+from PyQt6.QtTest import QTest
+from PyQt6.QtWidgets import QApplication, QDialog, QTreeWidget, QTreeWidgetItem, QWidget
+from PyQt6.QtWidgets import QLabel, QVBoxLayout
+
+from polychromatic.backends._backend import Backend
+from polychromatic.backends.openrazer import OpenRazerBackend
+from polychromatic.controller.devices import DevicesTab
+from polychromatic.controller.devicewatcher import DeviceWatcher
+
+
+class HotplugTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    @unittest.skipUnless(os.environ.get('POLY_TEST_PRIVATE_BUS') == '1', 'Requires isolated test bus')
+    def test_real_dbus_signals_and_restart(self):
+        # The explicit guard prevents this test claiming the user's live service.
+        self.assertEqual(os.environ.get('POLY_TEST_PRIVATE_BUS'), '1')
+        bus = QDBusConnection.sessionBus()
+        self.assertTrue(bus.registerService('org.razer'))
+        self.addCleanup(bus.unregisterService, 'org.razer')
+        watcher = DeviceWatcher(bus=bus)
+        received = Mock()
+        watcher.devices_changed.connect(received)
+        for name in ('device_removed', 'device_added'):
+            self.assertTrue(bus.send(QDBusMessage.createSignal('/org/razer', 'razer.devices', name)))
+        QTest.qWait(450)
+        self.assertEqual(received.call_count, 1)  # coalesced
+        bus.unregisterService('org.razer')
+        QTest.qWait(450)
+        self.assertEqual(received.call_count, 2)
+        self.assertTrue(bus.registerService('org.razer'))
+        QTest.qWait(450)
+        self.assertEqual(received.call_count, 3)
+        watcher.deleteLater()
+        self.app.processEvents()
+
+    def test_dialog_defers_refresh(self):
+        watcher = DeviceWatcher()
+        received = Mock()
+        watcher.devices_changed.connect(received)
+        dialog = QDialog()
+        dialog.setModal(True)
+        dialog.show()
+        watcher.schedule()
+        QTest.qWait(400)
+        received.assert_not_called()
+        dialog.close()
+        QTest.qWait(400)
+        received.assert_called_once()
+        watcher.deleteLater()
+
+    def test_presence_uses_live_registry_not_cached_devices(self):
+        backend = SimpleNamespace(devman=SimpleNamespace(
+            devices=[SimpleNamespace(serial='V2')],
+            _dbus_devices=SimpleNamespace(getDevices=Mock(return_value=['V3']))))
+        self.assertFalse(OpenRazerBackend.is_device_connected(backend, SimpleNamespace(serial='V2')))
+        self.assertTrue(OpenRazerBackend.is_device_connected(backend, SimpleNamespace(serial='V3')))
+        backend.devman._dbus_devices.getDevices.side_effect = RuntimeError('bus unavailable')
+        self.assertIsNone(OpenRazerBackend.is_device_connected(backend, SimpleNamespace(serial='V3')))
+
+    def test_removed_device_error_refreshes_without_dialog(self):
+        tab = SimpleNamespace(middleman=Mock(), _refresh_after_disconnect=Mock(), widgets=Mock())
+        device = SimpleNamespace(backend=SimpleNamespace(is_device_connected=lambda d: False))
+        self.assertTrue(DevicesTab._catch_command_error(tab, device, RuntimeError('UnknownMethod')))
+        QTest.qWait(10)
+        tab._refresh_after_disconnect.assert_called_once()
+        tab.widgets.open_dialog.assert_not_called()
+
+    def test_connected_device_error_is_not_suppressed(self):
+        tab = SimpleNamespace(widgets=Mock(), dbg=Mock(), _=lambda s: s)
