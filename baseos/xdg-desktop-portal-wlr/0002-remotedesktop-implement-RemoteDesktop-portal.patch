+/*
+ * seat keymap
+ */
+
+static bool set_keymap_string(struct xdpw_remotedesktop_context *ctx, const char *string) {
+	struct xkb_keymap *keymap = xkb_keymap_new_from_string(ctx->xkb_context, string,
+		XKB_KEYMAP_FORMAT_TEXT_V1, XKB_KEYMAP_COMPILE_NO_FLAGS);
+	if (!keymap) {
+		logprint(ERROR, "remotedesktop: failed to compile keymap");
+		return false;
+	}
+	char *keymap_string = xkb_keymap_get_as_string(keymap, XKB_KEYMAP_FORMAT_TEXT_V1);
+	if (!keymap_string) {
+		logprint(ERROR, "remotedesktop: failed to serialize keymap");
+		xkb_keymap_unref(keymap);
+		return false;
+	}
+
+	xkb_keymap_unref(ctx->keymap);
+	free(ctx->keymap_string);
+	ctx->keymap = keymap;
+	ctx->keymap_string = keymap_string;
+	ctx->keymap_size = strlen(keymap_string) + 1;
+	return true;
+}
+
+static bool ensure_keymap(struct xdpw_remotedesktop_context *ctx) {
+	if (ctx->keymap) {
+		return true;
+	}
+
+	logprint(INFO, "remotedesktop: no seat keymap received, using the default keymap");
+	struct xkb_keymap *keymap = xkb_keymap_new_from_names(ctx->xkb_context, NULL,
+		XKB_KEYMAP_COMPILE_NO_FLAGS);
+	if (!keymap) {
+		logprint(ERROR, "remotedesktop: failed to compile the default keymap");
+		return false;
+	}
+	char *keymap_string = xkb_keymap_get_as_string(keymap, XKB_KEYMAP_FORMAT_TEXT_V1);
+	xkb_keymap_unref(keymap);
+	if (!keymap_string) {
+		return false;
+	}
+	bool ret = set_keymap_string(ctx, keymap_string);
+	free(keymap_string);
+	return ret;
+}
+
+static void keyboard_handle_keymap(void *data, struct wl_keyboard *keyboard,
+		uint32_t format, int32_t fd, uint32_t size) {
+	struct xdpw_remotedesktop_context *ctx = data;
+
+	if (format != WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1) {
+		logprint(WARN, "remotedesktop: unsupported seat keymap format %u", format);
+		close(fd);
+		return;
+	}
+
+	char *map = mmap(NULL, size, PROT_READ, MAP_PRIVATE, fd, 0);
+	close(fd);
+	if (map == MAP_FAILED) {
+		logprint(ERROR, "remotedesktop: failed to map seat keymap: %s", strerror(errno));
+		return;
+	}
+	char *string = strndup(map, size);
+	munmap(map, size);
+	if (!string) {
+		return;
+	}
+
+	if (set_keymap_string(ctx, string)) {
+		logprint(DEBUG, "remotedesktop: received seat keymap");
+	}
+	free(string);
+}
