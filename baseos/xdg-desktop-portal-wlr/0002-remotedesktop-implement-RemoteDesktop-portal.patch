diff --git a/include/remotedesktop_common.h b/include/remotedesktop_common.h
new file mode 100644
index 0000000..d705cf6
--- /dev/null
+++ b/include/remotedesktop_common.h
@@ -0,0 +1,62 @@
+#ifndef REMOTEDESKTOP_COMMON_H
+#define REMOTEDESKTOP_COMMON_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <wayland-client-protocol.h>
+
+#define XDP_REMOTE_PROTO_VER 2
+#define XDP_REMOTE_DATA_VER 1
+
+enum device_types {
+	KEYBOARD = 1,
+	POINTER = 2,
+	TOUCHSCREEN = 4,
+};
+
+struct xkb_context;
+struct xkb_keymap;
+struct xkb_state;
+
+struct xdpw_remotedesktop_context {
+	// xdpw
+	struct xdpw_state *state;
+
+	// wlroots
+	struct wl_registry *registry;
+	struct zwlr_virtual_pointer_manager_v1 *virtual_pointer_manager;
+	struct zwp_virtual_keyboard_manager_v1 *virtual_keyboard_manager;
+	struct wl_seat *seat;
+	struct wl_keyboard *keyboard;
+
+	// seat keymap, shared with every virtual keyboard
+	struct xkb_context *xkb_context;
+	struct xkb_keymap *keymap;
+	char *keymap_string;
+	uint32_t keymap_size;
+};
+
+struct xdpw_remotedesktop_keysym_press {
+	int32_t keysym;
+	uint32_t keycode;
+};
+
+struct xdpw_remotedesktop_session_data {
+	bool is_remotedesktop;
+	bool started;
+	uint32_t devices;
+	uint32_t persist_mode;
+	char *restore_output_name;
+
+	struct zwlr_virtual_pointer_v1 *virtual_pointer;
+	struct zwp_virtual_keyboard_v1 *virtual_keyboard;
+	struct xkb_keymap *keymap;
+	struct xkb_state *xkb_state;
+
+	// pressed input, released when the session ends
+	struct wl_array pressed_keys; // uint32_t evdev keycodes
+	struct wl_array pressed_buttons; // uint32_t evdev button codes
+	struct wl_array keysym_presses; // struct xdpw_remotedesktop_keysym_press
+};
+
+#endif /* REMOTEDESKTOP_COMMON_H */
