+/*
+ * virtual devices
+ */
+
+static void keyboard_send_modifiers(struct xdpw_remotedesktop_session_data *rd) {
+	zwp_virtual_keyboard_v1_modifiers(rd->virtual_keyboard,
+		xkb_state_serialize_mods(rd->xkb_state, XKB_STATE_MODS_DEPRESSED),
+		xkb_state_serialize_mods(rd->xkb_state, XKB_STATE_MODS_LATCHED),
+		xkb_state_serialize_mods(rd->xkb_state, XKB_STATE_MODS_LOCKED),
+		xkb_state_serialize_layout(rd->xkb_state, XKB_STATE_LAYOUT_EFFECTIVE));
+}
+
+static bool keyboard_send_key(struct xdpw_remotedesktop_session_data *rd,
+		uint32_t keycode, bool pressed) {
+	zwp_virtual_keyboard_v1_key(rd->virtual_keyboard, timestamp_ms(), keycode,
+		pressed ? WL_KEYBOARD_KEY_STATE_PRESSED : WL_KEYBOARD_KEY_STATE_RELEASED);
+	if (pressed) {
+		array_add_u32(&rd->pressed_keys, keycode);
+	} else {
+		array_remove_u32(&rd->pressed_keys, keycode);
+	}
+	// xkb keycodes are offset by 8 from evdev keycodes
+	return xkb_state_update_key(rd->xkb_state, keycode + 8,
+		pressed ? XKB_KEY_DOWN : XKB_KEY_UP) != 0;
+}
+
+static bool keymap_find_keysym(struct xkb_keymap *keymap, xkb_layout_index_t layout,
+		xkb_keysym_t keysym, xkb_keycode_t *out_keycode, xkb_mod_mask_t *out_mask) {
+	bool found = false;
+	xkb_keycode_t min = xkb_keymap_min_keycode(keymap);
+	xkb_keycode_t max = xkb_keymap_max_keycode(keymap);
+
+	for (xkb_keycode_t keycode = min; keycode <= max; keycode++) {
+		xkb_level_index_t levels = xkb_keymap_num_levels_for_key(keymap, keycode, layout);
+		for (xkb_level_index_t level = 0; level < levels; level++) {
+			const xkb_keysym_t *syms;
+			int nsyms = xkb_keymap_key_get_syms_by_level(keymap, keycode, layout, level, &syms);
+			if (nsyms != 1 || syms[0] != keysym) {
+				continue;
+			}
+
+			xkb_mod_mask_t masks[16];
+			size_t nmasks = xkb_keymap_key_get_mods_for_level(keymap, keycode, layout,
+				level, masks, sizeof(masks) / sizeof(masks[0]));
+			if (nmasks == 0) {
+				continue;
+			}
+			// prefer a key that produces the keysym without any modifiers
+			for (size_t i = 0; i < nmasks; i++) {
+				if (masks[i] == 0) {
+					*out_keycode = keycode;
+					*out_mask = 0;
+					return true;
+				}
+			}
+			if (!found) {
+				*out_keycode = keycode;
+				*out_mask = masks[0];
+				found = true;
+			}
+		}
+	}
+	return found;
+}
+
+static void keyboard_notify_keysym(struct xdpw_remotedesktop_session_data *rd,
+		int32_t keysym, bool pressed) {
+	struct xdpw_remotedesktop_keysym_press *press;
+
+	if (!pressed) {
+		wl_array_for_each(press, &rd->keysym_presses) {
+			if (press->keysym == keysym) {
+				uint32_t keycode = press->keycode;
+				struct xdpw_remotedesktop_keysym_press *last =
+					(struct xdpw_remotedesktop_keysym_press *)
+					((char *)rd->keysym_presses.data + rd->keysym_presses.size) - 1;
+				*press = *last;
+				rd->keysym_presses.size -= sizeof(*press);
+
+				keyboard_send_key(rd, keycode, false);
+				// restore the real modifier state after a forced level
+				keyboard_send_modifiers(rd);
+				return;
+			}
+		}
+		logprint(DEBUG, "remotedesktop: release of unpressed keysym 0x%x ignored", keysym);
+		return;
+	}
+
+	xkb_layout_index_t layout =
+		xkb_state_serialize_layout(rd->xkb_state, XKB_STATE_LAYOUT_EFFECTIVE);
+	xkb_keycode_t xkb_keycode;
+	xkb_mod_mask_t mask;
+	if (!keymap_find_keysym(rd->keymap, layout, keysym, &xkb_keycode, &mask)) {
+		logprint(WARN, "remotedesktop: keysym 0x%x is not in the keymap", keysym);
+		return;
+	}
+	uint32_t keycode = xkb_keycode - 8;
+
+	press = wl_array_add(&rd->keysym_presses, sizeof(*press));
+	if (!press) {
+		return;
+	}
+	press->keysym = keysym;
+	press->keycode = keycode;
+
+	if (mask != 0) {
+		// select the shift level that produces the keysym, ignoring locks
+		zwp_virtual_keyboard_v1_modifiers(rd->virtual_keyboard, mask, 0, 0, layout);
+		keyboard_send_key(rd, keycode, true);
+	} else if (keyboard_send_key(rd, keycode, true)) {
+		keyboard_send_modifiers(rd);
+	}
+}
+
+static void pointer_release_buttons(struct xdpw_remotedesktop_session_data *rd) {
+	uint32_t *button;
+	wl_array_for_each(button, &rd->pressed_buttons) {
+		zwlr_virtual_pointer_v1_button(rd->virtual_pointer, timestamp_ms(), *button,
+			WL_POINTER_BUTTON_STATE_RELEASED);
+		zwlr_virtual_pointer_v1_frame(rd->virtual_pointer);
+	}
+	rd->pressed_buttons.size = 0;
+}
+
+static void keyboard_release_keys(struct xdpw_remotedesktop_session_data *rd) {
+	while (rd->pressed_keys.size > 0) {
+		uint32_t keycode = ((uint32_t *)rd->pressed_keys.data)[0];
+		keyboard_send_key(rd, keycode, false);
+	}
+	rd->keysym_presses.size = 0;
+	keyboard_send_modifiers(rd);
+}
+
+static struct wl_output *session_output(struct xdpw_session *sess) {
+	struct xdpw_screencast_instance *cast = sess->screencast_data.screencast_instance;
+	if (cast && cast->target && cast->target->output) {
+		return cast->target->output->output;
+	}
+	return NULL;
+}
+
+static bool create_virtual_devices(struct xdpw_state *state, struct xdpw_session *sess) {
+	struct xdpw_remotedesktop_context *ctx = &state->remotedesktop;
+	struct xdpw_remotedesktop_session_data *rd = &sess->remotedesktop_data;
+
+	if ((rd->devices & POINTER) && !rd->virtual_pointer) {
+		struct wl_output *output = session_output(sess);
+		if (output && zwlr_virtual_pointer_manager_v1_get_version(ctx->virtual_pointer_manager) >=
+				ZWLR_VIRTUAL_POINTER_MANAGER_V1_CREATE_VIRTUAL_POINTER_WITH_OUTPUT_SINCE_VERSION) {
+			rd->virtual_pointer = zwlr_virtual_pointer_manager_v1_create_virtual_pointer_with_output(
+				ctx->virtual_pointer_manager, ctx->seat, output);
+		} else {
+			rd->virtual_pointer = zwlr_virtual_pointer_manager_v1_create_virtual_pointer(
+				ctx->virtual_pointer_manager, ctx->seat);
+		}
+		if (!rd->virtual_pointer) {
+			logprint(ERROR, "remotedesktop: failed to create virtual pointer");
+			return false;
+		}
+	}
+
+	if ((rd->devices & KEYBOARD) && !rd->virtual_keyboard) {
+		if (!ctx->seat) {
+			logprint(ERROR, "remotedesktop: no seat available for the virtual keyboard");
+			return false;
+		}
+		if (!ensure_keymap(ctx)) {
+			return false;
+		}
+
+		int fd = memfd_create("xdpw-keymap", MFD_CLOEXEC);
+		if (fd < 0) {
+			logprint(ERROR, "remotedesktop: memfd_create failed: %s", strerror(errno));
+			return false;
+		}
+		size_t written = 0;
+		while (written < ctx->keymap_size) {
+			ssize_t n = write(fd, ctx->keymap_string + written, ctx->keymap_size - written);
+			if (n < 0) {
+				if (errno == EINTR) {
+					continue;
+				}
+				logprint(ERROR, "remotedesktop: failed to write keymap: %s", strerror(errno));
+				close(fd);
+				return false;
+			}
+			written += n;
+		}
+
+		rd->virtual_keyboard = zwp_virtual_keyboard_manager_v1_create_virtual_keyboard(
+			ctx->virtual_keyboard_manager, ctx->seat);
+		zwp_virtual_keyboard_v1_keymap(rd->virtual_keyboard,
+			WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1, fd, ctx->keymap_size);
+		close(fd);
+
+		rd->keymap = xkb_keymap_ref(ctx->keymap);
+		rd->xkb_state = xkb_state_new(rd->keymap);
+		if (!rd->xkb_state) {
+			logprint(ERROR, "remotedesktop: failed to create keyboard state");
+			return false;
+		}
+	}
+
+	wl_display_flush(state->wl_display);
+	return true;
+}
+
+void xdpw_remotedesktop_session_init(struct xdpw_session *sess) {
+	struct xdpw_remotedesktop_session_data *rd = &sess->remotedesktop_data;
+	wl_array_init(&rd->pressed_keys);
+	wl_array_init(&rd->pressed_buttons);
+	wl_array_init(&rd->keysym_presses);
+}
+
+void xdpw_remotedesktop_session_finish(struct xdpw_session *sess) {
+	struct xdpw_remotedesktop_session_data *rd = &sess->remotedesktop_data;
+
+	if (rd->virtual_keyboard) {
+		if (rd->xkb_state) {
+			keyboard_release_keys(rd);
+		}
+		zwp_virtual_keyboard_v1_destroy(rd->virtual_keyboard);
+		rd->virtual_keyboard = NULL;
+	}
+	if (rd->virtual_pointer) {
+		pointer_release_buttons(rd);
+		zwlr_virtual_pointer_v1_destroy(rd->virtual_pointer);
+		rd->virtual_pointer = NULL;
+	}
+	xkb_state_unref(rd->xkb_state);
+	rd->xkb_state = NULL;
+	xkb_keymap_unref(rd->keymap);
+	rd->keymap = NULL;
+	free(rd->restore_output_name);
+	rd->restore_output_name = NULL;
+	wl_array_release(&rd->pressed_keys);
+	wl_array_release(&rd->pressed_buttons);
+	wl_array_release(&rd->keysym_presses);
+}
