+int xdpw_remotedesktop_init(struct xdpw_state *state) {
+	struct xdpw_remotedesktop_context *ctx = &state->remotedesktop;
+	sd_bus_slot *slot = NULL;
+
+	*ctx = (struct xdpw_remotedesktop_context) { 0 };
+	ctx->state = state;
+
+	ctx->xkb_context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+	if (!ctx->xkb_context) {
+		logprint(ERROR, "remotedesktop: failed to create xkb context");
+		return -1;
+	}
+
+	ctx->registry = wl_display_get_registry(state->wl_display);
+	wl_registry_add_listener(ctx->registry, &registry_listener, ctx);
+	// globals, then seat capabilities, then the keyboard keymap
+	wl_display_roundtrip(state->wl_display);
+	wl_display_roundtrip(state->wl_display);
+	wl_display_roundtrip(state->wl_display);
+
+	state->remotedesktop_device_types = 0;
+	if (ctx->virtual_pointer_manager) {
+		state->remotedesktop_device_types |= POINTER;
+	}
+	if (ctx->virtual_keyboard_manager && ctx->seat) {
+		state->remotedesktop_device_types |= KEYBOARD;
+	}
+	if (state->remotedesktop_device_types == 0) {
+		logprint(WARN, "remotedesktop: compositor supports neither %s nor %s, "
+			"remote desktop is unavailable",
+			zwlr_virtual_pointer_manager_v1_interface.name,
+			zwp_virtual_keyboard_manager_v1_interface.name);
+		return 0;
+	}
+	logprint(DEBUG, "remotedesktop: available device types %x",
+		state->remotedesktop_device_types);
+
+	return sd_bus_add_object_vtable(state->bus, &slot, object_path, interface_name,
+		remotedesktop_vtable, state);
+}
