+/*
+ * dbus
+ */
+
+static int reply_response(sd_bus_message *msg, uint32_t response) {
+	sd_bus_message *reply = NULL;
+	int ret = sd_bus_message_new_method_return(msg, &reply);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = sd_bus_message_append(reply, "ua{sv}", response, 0);
+	if (ret < 0) {
+		sd_bus_message_unref(reply);
+		return ret;
+	}
+	ret = sd_bus_send(NULL, reply, NULL);
+	sd_bus_message_unref(reply);
+	return ret;
+}
+
+static int skip_options(sd_bus_message *msg) {
+	return sd_bus_message_skip(msg, "a{sv}");
+}
+
+static int method_remotedesktop_create_session(sd_bus_message *msg, void *data,
+		sd_bus_error *ret_error) {
+	struct xdpw_state *state = data;
+	int ret = 0;
+
+	logprint(INFO, "dbus: remote desktop create session method invoked");
+
+	char *request_handle, *session_handle, *app_id;
+	ret = sd_bus_message_read(msg, "oos", &request_handle, &session_handle, &app_id);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = skip_options(msg);
+	if (ret < 0) {
+		return ret;
+	}
+
+	logprint(INFO, "dbus: request_handle: %s", request_handle);
+	logprint(INFO, "dbus: session_handle: %s", session_handle);
+	logprint(INFO, "dbus: app_id: %s", app_id);
+
+	struct xdpw_request *req =
+		xdpw_request_create(sd_bus_message_get_bus(msg), request_handle);
+	if (req == NULL) {
+		return -ENOMEM;
+	}
+
+	struct xdpw_session *sess =
+		xdpw_session_create(state, sd_bus_message_get_bus(msg), strdup(session_handle));
+	if (sess == NULL) {
+		xdpw_request_destroy(req);
+		return -ENOMEM;
+	}
+	sess->remotedesktop_data.is_remotedesktop = true;
+	sess->remotedesktop_data.devices = state->remotedesktop_device_types;
+
+	ret = reply_response(msg, PORTAL_RESPONSE_SUCCESS);
+	xdpw_request_destroy(req);
+	return ret < 0 ? ret : 0;
+}
+
+static int read_restore_data(sd_bus_message *msg, struct xdpw_remotedesktop_session_data *rd) {
+	int ret;
+	char *vendor;
+	uint32_t version;
+
+	ret = sd_bus_message_enter_container(msg, 'v', "(suv)");
+	if (ret < 0) {
+		return ret;
+	}
+	ret = sd_bus_message_enter_container(msg, 'r', "suv");
+	if (ret < 0) {
+		return ret;
+	}
+	ret = sd_bus_message_read(msg, "su", &vendor, &version);
+	if (ret < 0) {
+		return ret;
+	}
+
+	if (strcmp(vendor, "wlroots") != 0 || version != XDP_REMOTE_DATA_VER) {
+		logprint(INFO, "dbus: skipping restore_data %s version %u", vendor, version);
+		ret = sd_bus_message_skip(msg, "v");
+		if (ret < 0) {
+			return ret;
+		}
+	} else {
+		ret = sd_bus_message_enter_container(msg, 'v', "a{sv}");
+		if (ret < 0) {
+			return ret;
+		}
+		ret = sd_bus_message_enter_container(msg, 'a', "{sv}");
+		if (ret < 0) {
+			return ret;
+		}
+		while ((ret = sd_bus_message_enter_container(msg, 'e', "sv")) > 0) {
+			char *key;
+			ret = sd_bus_message_read(msg, "s", &key);
+			if (ret < 0) {
+				return ret;
+			}
+			if (strcmp(key, "output_name") == 0) {
+				char *output_name;
+				ret = sd_bus_message_read(msg, "v", "s", &output_name);
+				if (ret < 0) {
+					return ret;
+				}
+				free(rd->restore_output_name);
+				rd->restore_output_name = strdup(output_name);
+				logprint(INFO, "dbus: option restore_data.output_name: %s", output_name);
+			} else {
+				ret = sd_bus_message_skip(msg, "v");
+				if (ret < 0) {
+					return ret;
+				}
+			}
+			ret = sd_bus_message_exit_container(msg);
+			if (ret < 0) {
+				return ret;
+			}
+		}
+		if (ret < 0) {
+			return ret;
+		}
+		ret = sd_bus_message_exit_container(msg); // array
+		if (ret < 0) {
+			return ret;
+		}
+		ret = sd_bus_message_exit_container(msg); // variant
+		if (ret < 0) {
+			return ret;
+		}
+	}
+
+	ret = sd_bus_message_exit_container(msg); // struct
+	if (ret < 0) {
+		return ret;
+	}
+	return sd_bus_message_exit_container(msg); // variant
+}
+
+static int method_remotedesktop_select_devices(sd_bus_message *msg, void *data,
+		sd_bus_error *ret_error) {
+	struct xdpw_state *state = data;
+	int ret = 0;
+
+	logprint(INFO, "dbus: remote desktop select devices method invoked");
+
+	char *request_handle, *session_handle, *app_id;
+	ret = sd_bus_message_read(msg, "oos", &request_handle, &session_handle, &app_id);
+	if (ret < 0) {
+		return ret;
+	}
+
+	struct xdpw_session *sess = find_session(state, session_handle);
+	if (!sess || !sess->remotedesktop_data.is_remotedesktop) {
+		logprint(WARN, "dbus: select devices: no matching session %s found", session_handle);
+		ret = skip_options(msg);
+		if (ret < 0) {
+			return ret;
+		}
+		return reply_response(msg, PORTAL_RESPONSE_CANCELLED);
+	}
+	struct xdpw_remotedesktop_session_data *rd = &sess->remotedesktop_data;
+
+	ret = sd_bus_message_enter_container(msg, 'a', "{sv}");
+	if (ret < 0) {
+		return ret;
+	}
+	while ((ret = sd_bus_message_enter_container(msg, 'e', "sv")) > 0) {
+		char *key;
+		ret = sd_bus_message_read(msg, "s", &key);
+		if (ret < 0) {
+			return ret;
+		}
+
+		if (strcmp(key, "types") == 0) {
+			uint32_t types;
+			ret = sd_bus_message_read(msg, "v", "u", &types);
+			if (ret < 0) {
+				return ret;
+			}
+			rd->devices = types & state->remotedesktop_device_types;
+			logprint(INFO, "dbus: option types: %x (using %x)", types, rd->devices);
+		} else if (strcmp(key, "persist_mode") == 0) {
+			ret = sd_bus_message_read(msg, "v", "u", &rd->persist_mode);
+			if (ret < 0) {
+				return ret;
+			}
+			logprint(INFO, "dbus: option persist_mode: %u", rd->persist_mode);
+		} else if (strcmp(key, "restore_data") == 0) {
+			ret = read_restore_data(msg, rd);
+			if (ret < 0) {
+				return ret;
+			}
+		} else {
+			logprint(WARN, "dbus: unknown option %s", key);
+			ret = sd_bus_message_skip(msg, "v");
+			if (ret < 0) {
+				return ret;
+			}
+		}
+
+		ret = sd_bus_message_exit_container(msg);
+		if (ret < 0) {
+			return ret;
+		}
+	}
+	if (ret < 0) {
+		return ret;
+	}
+	ret = sd_bus_message_exit_container(msg);
+	if (ret < 0) {
+		return ret;
+	}
+
+	return reply_response(msg, PORTAL_RESPONSE_SUCCESS);
+}
+
+static int method_remotedesktop_start(sd_bus_message *msg, void *data,
+		sd_bus_error *ret_error) {
+	struct xdpw_state *state = data;
+	int ret = 0;
+
+	logprint(INFO, "dbus: remote desktop start method invoked");
+
+	char *request_handle, *session_handle, *app_id, *parent_window;
+	ret = sd_bus_message_read(msg, "ooss", &request_handle, &session_handle, &app_id, &parent_window);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = skip_options(msg);
+	if (ret < 0) {
+		return ret;
+	}
+
+	logprint(INFO, "dbus: request_handle: %s", request_handle);
+	logprint(INFO, "dbus: session_handle: %s", session_handle);
+	logprint(INFO, "dbus: app_id: %s", app_id);
+
+	struct xdpw_session *sess = find_session(state, session_handle);
+	if (!sess || !sess->remotedesktop_data.is_remotedesktop) {
+		logprint(WARN, "dbus: start: no matching session %s found", session_handle);
+		return reply_response(msg, PORTAL_RESPONSE_CANCELLED);
+	}
+	struct xdpw_remotedesktop_session_data *rd = &sess->remotedesktop_data;
+
+	struct xdpw_screencast_instance *cast = sess->screencast_data.screencast_instance;
+	if (cast) {
+		ret = xdpw_screencast_start_instance(state, cast);
+		if (ret < 0) {
+			return ret;
+		}
+	}
+
+	if (!create_virtual_devices(state, sess)) {
+		return reply_response(msg, PORTAL_RESPONSE_CANCELLED);
+	}
+	rd->started = true;
+
+	logprint(INFO, "remotedesktop: started session with devices %x", rd->devices);
+
+	sd_bus_message *reply = NULL;
+	ret = sd_bus_message_new_method_return(msg, &reply);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = sd_bus_message_append(reply, "u", PORTAL_RESPONSE_SUCCESS);
+	if (ret < 0) {
+		goto out;
+	}
+	ret = sd_bus_message_open_container(reply, 'a', "{sv}");
+	if (ret < 0) {
+		goto out;
+	}
+	ret = sd_bus_message_append(reply, "{sv}", "devices", "u", rd->devices);
+	if (ret < 0) {
+		goto out;
+	}
+
+	uint32_t persist_mode = PERSIST_NONE;
+	if (cast) {
+		ret = xdpw_screencast_append_streams(reply, cast);
+		if (ret < 0) {
+			goto out;
+		}
+		// persistence follows the screencast policy, which only keeps
+		// restored or explicitly allowed (XDPW_PERSIST_MODE) selections
+		persist_mode = sess->screencast_data.persist_mode;
+	}
+	ret = sd_bus_message_append(reply, "{sv}", "persist_mode", "u", persist_mode);
+	if (ret < 0) {
+		goto out;
+	}
+	if (persist_mode != PERSIST_NONE && cast->target->output) {
+		ret = sd_bus_message_append(reply, "{sv}",
+			"restore_data", "(suv)",
+			"wlroots", XDP_REMOTE_DATA_VER,
+			"a{sv}", 1, "output_name", "s", cast->target->output->name);
+		if (ret < 0) {
+			goto out;
+		}
+	}
+
+	ret = sd_bus_message_close_container(reply);
+	if (ret < 0) {
+		goto out;
+	}
+	ret = sd_bus_send(NULL, reply, NULL);
+
+out:
+	sd_bus_message_unref(reply);
+	return ret < 0 ? ret : 0;
+}
+
+static int read_notify_options(sd_bus_message *msg, bool *finish) {
+	int ret = sd_bus_message_enter_container(msg, 'a', "{sv}");
+	if (ret < 0) {
+		return ret;
+	}
+	while ((ret = sd_bus_message_enter_container(msg, 'e', "sv")) > 0) {
+		char *key;
+		ret = sd_bus_message_read(msg, "s", &key);
+		if (ret < 0) {
+			return ret;
+		}
+		if (finish && strcmp(key, "finish") == 0) {
+			int value;
+			ret = sd_bus_message_read(msg, "v", "b", &value);
+			if (ret < 0) {
+				return ret;
+			}
+			*finish = value;
+		} else {
+			ret = sd_bus_message_skip(msg, "v");
+			if (ret < 0) {
+				return ret;
+			}
+		}
+		ret = sd_bus_message_exit_container(msg);
+		if (ret < 0) {
+			return ret;
+		}
+	}
+	if (ret < 0) {
+		return ret;
+	}
+	return sd_bus_message_exit_container(msg);
+}
+
+static struct xdpw_session *notify_session(struct xdpw_state *state, const char *session_handle,
+		uint32_t device, sd_bus_error *ret_error) {
+	struct xdpw_session *sess = find_session(state, session_handle);
+	if (!sess || !sess->remotedesktop_data.is_remotedesktop || !sess->remotedesktop_data.started) {
+		sd_bus_error_set_const(ret_error, SD_BUS_ERROR_FAILED, "Invalid session");
+		return NULL;
+	}
+	if (!(sess->remotedesktop_data.devices & device) ||
+			(device == POINTER && !sess->remotedesktop_data.virtual_pointer) ||
+			(device == KEYBOARD && !sess->remotedesktop_data.virtual_keyboard)) {
+		sd_bus_error_set_const(ret_error, SD_BUS_ERROR_FAILED, "Device not available");
+		return NULL;
+	}
+	return sess;
+}
+
+static int notify_done(struct xdpw_state *state, sd_bus_message *msg) {
+	wl_display_flush(state->wl_display);
+	return sd_bus_reply_method_return(msg, "");
+}
+
+static int method_remotedesktop_notify_pointer_motion(sd_bus_message *msg, void *data,
+		sd_bus_error *ret_error) {
+	struct xdpw_state *state = data;
+	char *session_handle;
+	double dx, dy;
+
+	int ret = sd_bus_message_read(msg, "o", &session_handle);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = read_notify_options(msg, NULL);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = sd_bus_message_read(msg, "dd", &dx, &dy);
+	if (ret < 0) {
+		return ret;
+	}
+
+	struct xdpw_session *sess = notify_session(state, session_handle, POINTER, ret_error);
+	if (!sess) {
+		return -EINVAL;
+	}
+	struct zwlr_virtual_pointer_v1 *pointer = sess->remotedesktop_data.virtual_pointer;
+	zwlr_virtual_pointer_v1_motion(pointer, timestamp_ms(),
+		wl_fixed_from_double(dx), wl_fixed_from_double(dy));
+	zwlr_virtual_pointer_v1_frame(pointer);
+
+	return notify_done(state, msg);
+}
+
+static double clamp_coordinate(double value, int extent) {
+	if (value < 0) {
+		return 0;
+	}
+	if (value > extent - 1) {
+		return extent - 1;
+	}
+	return value;
+}
+
+static int method_remotedesktop_notify_pointer_motion_absolute(sd_bus_message *msg, void *data,
+		sd_bus_error *ret_error) {
+	struct xdpw_state *state = data;
+	char *session_handle;
+	uint32_t stream;
+	double x, y;
+
+	int ret = sd_bus_message_read(msg, "o", &session_handle);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = read_notify_options(msg, NULL);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = sd_bus_message_read(msg, "udd", &stream, &x, &y);
+	if (ret < 0) {
+		return ret;
+	}
+
+	struct xdpw_session *sess = notify_session(state, session_handle, POINTER, ret_error);
+	if (!sess) {
+		return -EINVAL;
+	}
+
+	struct xdpw_screencast_instance *cast = sess->screencast_data.screencast_instance;
+	if (!cast || cast->node_id != stream || !cast->target->output) {
+		sd_bus_error_set_const(ret_error, SD_BUS_ERROR_INVALID_ARGS, "Invalid stream");
+		return -EINVAL;
+	}
+	struct xdpw_wlr_output *output = cast->target->output;
+	if (output->width <= 0 || output->height <= 0) {
+		sd_bus_error_set_const(ret_error, SD_BUS_ERROR_FAILED, "Output size unknown");
+		return -EINVAL;
+	}
+
+	struct zwlr_virtual_pointer_v1 *pointer = sess->remotedesktop_data.virtual_pointer;
+	x = clamp_coordinate(x, output->width);
+	y = clamp_coordinate(y, output->height);
+	int extent_width = output->width;
+	int extent_height = output->height;
+
+	if (zwlr_virtual_pointer_v1_get_version(pointer) <
+			ZWLR_VIRTUAL_POINTER_MANAGER_V1_CREATE_VIRTUAL_POINTER_WITH_OUTPUT_SINCE_VERSION) {
+		// the pointer is not mapped to the output, map into the whole layout
+		int min_x = output->x, min_y = output->y;
+		int max_x = output->x + output->width, max_y = output->y + output->height;
+		struct xdpw_wlr_output *other;
+		wl_list_for_each(other, &cast->ctx->output_list, link) {
+			if (other->x < min_x) min_x = other->x;
+			if (other->y < min_y) min_y = other->y;
+			if (other->x + other->width > max_x) max_x = other->x + other->width;
+			if (other->y + other->height > max_y) max_y = other->y + other->height;
+		}
+		x += output->x - min_x;
+		y += output->y - min_y;
+		extent_width = max_x - min_x;
+		extent_height = max_y - min_y;
+	}
+
+	zwlr_virtual_pointer_v1_motion_absolute(pointer, timestamp_ms(),
+		(uint32_t)(x * ABSOLUTE_MOTION_SCALE), (uint32_t)(y * ABSOLUTE_MOTION_SCALE),
+		(uint32_t)extent_width * ABSOLUTE_MOTION_SCALE,
+		(uint32_t)extent_height * ABSOLUTE_MOTION_SCALE);
+	zwlr_virtual_pointer_v1_frame(pointer);
+
+	return notify_done(state, msg);
+}
+
+static int method_remotedesktop_notify_pointer_button(sd_bus_message *msg, void *data,
+		sd_bus_error *ret_error) {
+	struct xdpw_state *state = data;
+	char *session_handle;
+	int32_t button;
+	uint32_t button_state;
+
+	int ret = sd_bus_message_read(msg, "o", &session_handle);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = read_notify_options(msg, NULL);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = sd_bus_message_read(msg, "iu", &button, &button_state);
+	if (ret < 0) {
+		return ret;
+	}
+
+	struct xdpw_session *sess = notify_session(state, session_handle, POINTER, ret_error);
+	if (!sess) {
+		return -EINVAL;
+	}
+	struct xdpw_remotedesktop_session_data *rd = &sess->remotedesktop_data;
+	bool pressed = button_state != 0;
+	zwlr_virtual_pointer_v1_button(rd->virtual_pointer, timestamp_ms(), button,
+		pressed ? WL_POINTER_BUTTON_STATE_PRESSED : WL_POINTER_BUTTON_STATE_RELEASED);
+	zwlr_virtual_pointer_v1_frame(rd->virtual_pointer);
+	if (pressed) {
+		array_add_u32(&rd->pressed_buttons, button);
+	} else {
+		array_remove_u32(&rd->pressed_buttons, button);
+	}
+
+	return notify_done(state, msg);
+}
