diff --git a/src/remotedesktop/remotedesktop.c b/src/remotedesktop/remotedesktop.c
new file mode 100644
index 0000000..0dcf5eb
--- /dev/null
+++ b/src/remotedesktop/remotedesktop.c
@@ -0,0 +1,1216 @@
+#define _GNU_SOURCE
+#include "remotedesktop.h"
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/mman.h>
+#include <xkbcommon/xkbcommon.h>
+
+#include "screencast.h"
+#include "xdpw.h"
+#include "logger.h"
+#include "virtual-keyboard-unstable-v1-client-protocol.h"
+#include "wlr-virtual-pointer-unstable-v1-client-protocol.h"
+
+#define VIRTUAL_POINTER_VERSION 2
+#define VIRTUAL_KEYBOARD_VERSION 1
+#define SEAT_VERSION 5
+
+// match mutter, which scales continuous scroll deltas by its axis step distance
+#define AXIS_CONTINUOUS_STEP 10.0
+// libinput reports 15 degrees per wheel detent
+#define AXIS_DISCRETE_STEP 15.0
+// sub-pixel precision for absolute pointer motion
+#define ABSOLUTE_MOTION_SCALE 256
+
+static const char object_path[] = "/org/freedesktop/portal/desktop";
+static const char interface_name[] = "org.freedesktop.impl.portal.RemoteDesktop";
+
+static uint32_t timestamp_ms(void) {
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint32_t)(ts.tv_sec * 1000 + ts.tv_nsec / 1000000);
+}
+
+static struct xdpw_session *find_session(struct xdpw_state *state, const char *session_handle) {
+	struct xdpw_session *sess;
+	wl_list_for_each(sess, &state->xdpw_sessions, link) {
+		if (strcmp(sess->session_handle, session_handle) == 0) {
+			return sess;
+		}
+	}
+	return NULL;
+}
+
+static void array_add_u32(struct wl_array *array, uint32_t value) {
+	uint32_t *entry;
+	wl_array_for_each(entry, array) {
+		if (*entry == value) {
+			return;
+		}
+	}
+	entry = wl_array_add(array, sizeof(*entry));
+	if (entry) {
+		*entry = value;
+	}
+}
+
+static void array_remove_u32(struct wl_array *array, uint32_t value) {
+	uint32_t *entry;
+	wl_array_for_each(entry, array) {
+		if (*entry == value) {
+			uint32_t *last = (uint32_t *)((char *)array->data + array->size) - 1;
+			*entry = *last;
+			array->size -= sizeof(*entry);
+			return;
+		}
+	}
+}
