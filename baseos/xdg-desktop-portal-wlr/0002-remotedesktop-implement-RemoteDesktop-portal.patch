+static int method_remotedesktop_notify_pointer_axis(sd_bus_message *msg, void *data,
+		sd_bus_error *ret_error) {
+	struct xdpw_state *state = data;
+	char *session_handle;
+	double dx, dy;
+	bool finish = false;
+
+	int ret = sd_bus_message_read(msg, "o", &session_handle);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = read_notify_options(msg, &finish);
+	if (ret < 0) {
+		return ret;
+	}
+	ret = sd_bus_message_read(msg, "dd", &dx, &dy);
+	if (ret < 0) {
+		return ret;
+	}
+
+	struct xdpw_session *sess = notify_session(state, session_handle, POINTER, ret_error);
+	if (!sess) {
+		return -EINVAL;
+	}
+	struct zwlr_virtual_pointer_v1 *pointer = sess->remotedesktop_data.virtual_pointer;
+	uint32_t time = timestamp_ms();
+
+	zwlr_virtual_pointer_v1_axis_source(pointer, WL_POINTER_AXIS_SOURCE_CONTINUOUS);
+	if (dx != 0) {
+		zwlr_virtual_pointer_v1_axis(pointer, time, WL_POINTER_AXIS_HORIZONTAL_SCROLL,
+			wl_fixed_from_double(dx * AXIS_CONTINUOUS_STEP));
+	}
+	if (dy != 0) {
+		zwlr_virtual_pointer_v1_axis(pointer, time, WL_POINTER_AXIS_VERTICAL_SCROLL,
+			wl_fixed_from_double(dy * AXIS_CONTINUOUS_STEP));
+	}
+	if (finish) {
+		zwlr_virtual_pointer_v1_axis_stop(pointer, time, WL_POINTER_AXIS_HORIZONTAL_SCROLL);
+		zwlr_virtual_pointer_v1_axis_stop(pointer, time, WL_POINTER_AXIS_VERTICAL_SCROLL);
+	}
+	zwlr_virtual_pointer_v1_frame(pointer);
+
+	return notify_done(state, msg);
+}
