+
+	// The compositor has no 8-bit shm format when it renders the output in
+	// 10 bits (HDR, 10-bit SDR). Consumers that take neither dmabufs nor
+	// 10-bit RGB would find nothing to agree on, so offer them 8 bits, which
+	// we convert to. Listed last: whoever can use the above keeps getting it.
+	if (xdpw_shm_convert_source(&cast->current_constraints) != NULL) {
+		add_pod(params, build_format(builder, cast, SPA_VIDEO_FORMAT_BGRx,
+					cast->current_constraints.width, cast->current_constraints.height,
+					cast->framerate, NULL, 0, true));
+	}
+}
+
+// Brings the consumer's copy of a converted buffer up to date with the frame
+// that was just captured. Each buffer only gets the regions that changed
+// since it was last filled.
+static void convert_current_frame(struct xdpw_screencast_instance *cast) {
+	struct xdpw_buffer *current = cast->current_frame.xdpw_buffer;
+	bool damage_known = cast->current_frame.damage.size > 0;
+
+	struct xdpw_buffer *buffer;
+	wl_list_for_each(buffer, &cast->buffer_list, link) {
+		if (!buffer->convert || !buffer->converted) {
+			continue;
+		}
+		if (!damage_known) {
+			buffer->converted = false;
+			continue;
+		}
+		struct xdpw_frame_damage *damage;
+		wl_array_for_each(damage, &cast->current_frame.damage) {
+			struct xdpw_frame_damage *pending =
+				wl_array_add(&buffer->convert_damage, sizeof(*pending));
+			if (pending == NULL) {
+				buffer->converted = false;
+				break;
+			}
+			*pending = *damage;
 		}
+		if (buffer->convert_damage.size > CONVERT_DAMAGE_MAX * sizeof(*damage)) {
+			buffer->converted = false;
+		}
+	}
+
+	struct xdpw_shm_convert_params params =
+		convert_params(cast, current->capture_format);
+	if (!current->converted) {
+		xdpw_shm_convert(&params, current->capture_data, current->capture_stride,
+			current->data, current->stride[0], 0, 0, current->width, current->height);
+	} else {
+		struct xdpw_frame_damage *damage;
+		wl_array_for_each(damage, &current->convert_damage) {
+			if (damage->x >= current->width || damage->y >= current->height) {
+				continue;
+			}
+			uint32_t width = SPA_MIN(damage->width, current->width - damage->x);
+			uint32_t height = SPA_MIN(damage->height, current->height - damage->y);
+			xdpw_shm_convert(&params, current->capture_data, current->capture_stride,
+				current->data, current->stride[0], damage->x, damage->y, width, height);
+		}
+	}
+	current->converted = true;
+	current->convert_damage.size = 0;
+}
+
+// A frame that was not captured leaves every converted buffer behind by an
+// unknown region
+static void convert_invalidate(struct xdpw_screencast_instance *cast) {
+	struct xdpw_buffer *buffer;
+	wl_list_for_each(buffer, &cast->buffer_list, link) {
+		buffer->converted = false;
+		buffer->convert_damage.size = 0;
 	}
 }
 
