index 0000000..eca7945
--- /dev/null
+++ b/src/screencast/shm_convert.c
@@ -0,0 +1,336 @@
+#include "shm_convert.h"
+
+#include <libdrm/drm_fourcc.h>
+#include <math.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+/* Rectangles below this many pixels are converted on the calling thread. */
+#define PARALLEL_MIN_PIXELS (512 * 512)
+#define MAX_WORKERS 6
+
+/*
+ * Gamma 2.2 encoding table, indexed by the upper bits of a float in
+ * [2^-GAMMA_OCTAVES, 1): GAMMA_STEPS entries per octave keep the error far
+ * below one 8-bit code, also in the darks where a linear table would not.
+ * Anything below 2^-GAMMA_OCTAVES encodes to 0.
+ */
+#define GAMMA_OCTAVES 20
+#define GAMMA_STEP_BITS 10
+#define GAMMA_STEPS (1 << GAMMA_STEP_BITS)
+#define GAMMA_SIZE (GAMMA_OCTAVES * GAMMA_STEPS)
+#define GAMMA_SHIFT (23 - GAMMA_STEP_BITS)
+#define GAMMA_BASE ((uint32_t)(127 - GAMMA_OCTAVES) << GAMMA_STEP_BITS)
+
+/* Linear BT.2020 to linear sRGB primaries, both D65. */
+static const float bt2020_to_srgb[9] = {
+	 1.6604910f, -0.5876411f, -0.0728499f,
+	-0.1245505f,  1.1328999f, -0.0083494f,
+	-0.0181508f, -0.1005789f,  1.1187297f,
+};
+
+struct shifts {
+	unsigned r, g, b;
+};
+
+static bool format_shifts(uint32_t format, struct shifts *shifts) {
+	switch (format) {
+	case DRM_FORMAT_XRGB2101010:
+	case DRM_FORMAT_ARGB2101010:
+		*shifts = (struct shifts){ .r = 20, .g = 10, .b = 0 };
+		return true;
+	case DRM_FORMAT_XBGR2101010:
+	case DRM_FORMAT_ABGR2101010:
+		*shifts = (struct shifts){ .r = 0, .g = 10, .b = 20 };
+		return true;
+	case DRM_FORMAT_RGBX1010102:
+	case DRM_FORMAT_RGBA1010102:
+		*shifts = (struct shifts){ .r = 22, .g = 12, .b = 2 };
+		return true;
+	case DRM_FORMAT_BGRX1010102:
+	case DRM_FORMAT_BGRA1010102:
+		*shifts = (struct shifts){ .r = 2, .g = 12, .b = 22 };
+		return true;
+	default:
+		return false;
+	}
+}
+
+bool xdpw_shm_convert_supported(uint32_t drm_format) {
+	struct shifts shifts;
+	return format_shifts(drm_format, &shifts);
+}
+
+/* Tables. depth_lut never changes; the PQ table depends on reference white. */
+static pthread_once_t tables_once = PTHREAD_ONCE_INIT;
+static uint8_t depth_lut[1024];
+static uint8_t gamma_lut[GAMMA_SIZE];
+
+static pthread_mutex_t pq_lock = PTHREAD_MUTEX_INITIALIZER;
+static float pq_lut[1024];
+static float pq_lut_reference;
+
+static void init_tables(void) {
+	for (int i = 0; i < 1024; i++) {
+		depth_lut[i] = (uint8_t)((i * 255 + 511) / 1023);
+	}
+	for (int i = 0; i < GAMMA_SIZE; i++) {
+		union { uint32_t u; float f; } lo, hi;
+		lo.u = (GAMMA_BASE + (uint32_t)i) << GAMMA_SHIFT;
+		hi.u = (GAMMA_BASE + (uint32_t)i + 1) << GAMMA_SHIFT;
+		double mid = ((double)lo.f + (double)hi.f) / 2;
+		long code = lround(255.0 * pow(mid, 1 / 2.2));
+		gamma_lut[i] = (uint8_t)(code > 255 ? 255 : code);
+	}
+}
+
+static double pq_eotf(double signal) {
+	const double m1 = 2610.0 / 16384;
+	const double m2 = 2523.0 / 4096 * 128;
+	const double c1 = 3424.0 / 4096;
+	const double c2 = 2413.0 / 4096 * 32;
+	const double c3 = 2392.0 / 4096 * 32;
+	double p = pow(signal, 1 / m2);
+	double num = p - c1;
+	if (num < 0) {
+		num = 0;
+	}
+	return 10000.0 * pow(num / (c2 - c3 * p), 1 / m1);
+}
+
+/* Fills dst with linear light, 1.0 being SDR reference white. */
+static void get_pq_table(float reference, float dst[static 1024]) {
+	pthread_mutex_lock(&pq_lock);
+	if (pq_lut_reference != reference) {
+		for (int i = 0; i < 1024; i++) {
+			pq_lut[i] = (float)(pq_eotf(i / 1023.0) / reference);
+		}
+		pq_lut_reference = reference;
+	}
+	memcpy(dst, pq_lut, sizeof(pq_lut));
+	pthread_mutex_unlock(&pq_lock);
+}
+
+static inline uint8_t encode_gamma(float value) {
+	if (!(value > 0)) {
+		return 0;
+	}
+	if (value >= 1) {
+		return 255;
+	}
+	union { float f; uint32_t u; } bits = { .f = value };
+	uint32_t index = bits.u >> GAMMA_SHIFT;
+	if (index < GAMMA_BASE) {
+		return 0;
+	}
+	return gamma_lut[index - GAMMA_BASE];
+}
+
+struct job {
+	struct shifts shifts;
+	bool pq, bt2020;
+	const float *pq_table;
+	const uint8_t *src;
+	uint8_t *dst;
+	uint32_t src_stride, dst_stride;
+	uint32_t x, width;
+};
+
+static void convert_rows(const struct job *job, uint32_t y0, uint32_t y1) {
+	const struct shifts s = job->shifts;
+	const float *pq = job->pq_table;
+	const float *m = bt2020_to_srgb;
+
+	for (uint32_t y = y0; y < y1; y++) {
+		const uint32_t *src = (const uint32_t *)(const void *)
+			(job->src + (size_t)y * job->src_stride) + job->x;
+		uint32_t *dst = (uint32_t *)(void *)
+			(job->dst + (size_t)y * job->dst_stride) + job->x;
+		/* Desktop content repeats pixels a lot: remember the last one. */
+		uint32_t last_in = ~src[0];
+		uint32_t last_out = 0;
+
+		for (uint32_t i = 0; i < job->width; i++) {
+			uint32_t in = src[i];
+			if (in == last_in) {
+				dst[i] = last_out;
+				continue;
+			}
+			uint32_t r10 = (in >> s.r) & 0x3ff;
+			uint32_t g10 = (in >> s.g) & 0x3ff;
+			uint32_t b10 = (in >> s.b) & 0x3ff;
+			uint32_t r8, g8, b8;
+			if (job->pq) {
+				float r = pq[r10], g = pq[g10], b = pq[b10];
+				if (job->bt2020) {
+					float lr = m[0] * r + m[1] * g + m[2] * b;
+					float lg = m[3] * r + m[4] * g + m[5] * b;
+					float lb = m[6] * r + m[7] * g + m[8] * b;
+					r = lr;
+					g = lg;
+					b = lb;
+				}
+				r8 = encode_gamma(r);
+				g8 = encode_gamma(g);
+				b8 = encode_gamma(b);
+			} else {
+				r8 = depth_lut[r10];
+				g8 = depth_lut[g10];
+				b8 = depth_lut[b10];
+			}
+			last_in = in;
+			last_out = 0xff000000u | (r8 << 16) | (g8 << 8) | b8;
+			dst[i] = last_out;
+		}
+	}
+}
+
+/*
+ * Worker pool. One conversion runs at a time (it is called from the main
+ * loop); the rows are handed out in bands and the caller converts bands too.
+ */
+static struct {
+	pthread_mutex_t lock;
+	pthread_cond_t work, done;
+	pthread_t threads[MAX_WORKERS];
+	int count;
+	bool started, stop;
+
+	const struct job *job;
+	uint64_t generation;
+	uint32_t next_row, end_row, band;
+	int busy;
+} pool = {
+	.lock = PTHREAD_MUTEX_INITIALIZER,
+	.work = PTHREAD_COND_INITIALIZER,
+	.done = PTHREAD_COND_INITIALIZER,
+};
+
+/* Called with the lock held; returns with it held. */
+static void run_bands(const struct job *job) {
+	while (pool.job == job && pool.next_row < pool.end_row) {
+		uint32_t y0 = pool.next_row;
+		uint32_t y1 = y0 + pool.band;
+		if (y1 > pool.end_row) {
+			y1 = pool.end_row;
+		}
+		pool.next_row = y1;
+		pool.busy++;
+		pthread_mutex_unlock(&pool.lock);
+		convert_rows(job, y0, y1);
+		pthread_mutex_lock(&pool.lock);
+		pool.busy--;
+	}
+}
+
+static void *worker(void *data) {
+	(void)data;
+	uint64_t seen = 0;
+	pthread_mutex_lock(&pool.lock);
+	while (!pool.stop) {
+		if (pool.job == NULL || pool.generation == seen) {
+			pthread_cond_wait(&pool.work, &pool.lock);
+			continue;
+		}
+		seen = pool.generation;
+		run_bands(pool.job);
+		if (pool.busy == 0) {
+			pthread_cond_signal(&pool.done);
+		}
+	}
+	pthread_mutex_unlock(&pool.lock);
+	return NULL;
+}
+
+/* Called with the lock held. */
+static void start_pool(void) {
+	pool.started = true;
+	long cpus = sysconf(_SC_NPROCESSORS_ONLN);
+	/* The caller converts too, so one thread less than the share we take. */
+	long want = cpus / 2 - 1;
+	if (want > MAX_WORKERS) {
+		want = MAX_WORKERS;
+	}
+	for (long i = 0; i < want; i++) {
+		if (pthread_create(&pool.threads[pool.count], NULL, worker, NULL) != 0) {
+			break;
+		}
+		pool.count++;
+	}
+}
+
+void xdpw_shm_convert_finish(void) {
+	pthread_mutex_lock(&pool.lock);
+	pool.stop = true;
+	pthread_cond_broadcast(&pool.work);
+	int count = pool.count;
+	pthread_mutex_unlock(&pool.lock);
+	for (int i = 0; i < count; i++) {
+		pthread_join(pool.threads[i], NULL);
+	}
+	pthread_mutex_lock(&pool.lock);
+	pool.count = 0;
+	pool.started = false;
+	pool.stop = false;
+	pthread_mutex_unlock(&pool.lock);
+}
+
+void xdpw_shm_convert(const struct xdpw_shm_convert_params *params,
+		const void *src, uint32_t src_stride, void *dst, uint32_t dst_stride,
+		uint32_t x, uint32_t y, uint32_t width, uint32_t height) {
+	struct job job = {
+		.pq = params->pq,
+		.bt2020 = params->pq && params->bt2020,
+		.src = src,
+		.dst = dst,
+		.src_stride = src_stride,
+		.dst_stride = dst_stride,
+		.x = x,
+		.width = width,
+	};
+	if (width == 0 || height == 0 || !format_shifts(params->src_format, &job.shifts)) {
+		return;
+	}
+
+	pthread_once(&tables_once, init_tables);
+	float pq_table[1024];
+	if (job.pq) {
+		float reference = params->reference_luminance > 0 ?
+			params->reference_luminance : XDPW_SHM_CONVERT_DEFAULT_REFERENCE;
+		get_pq_table(reference, pq_table);
+		job.pq_table = pq_table;
+	}
+
+	if ((uint64_t)width * height < PARALLEL_MIN_PIXELS) {
+		convert_rows(&job, y, y + height);
+		return;
+	}
+
+	pthread_mutex_lock(&pool.lock);
+	if (!pool.started) {
+		start_pool();
+	}
+	if (pool.count == 0) {
+		pthread_mutex_unlock(&pool.lock);
+		convert_rows(&job, y, y + height);
+		return;
+	}
+	pool.job = &job;
+	pool.generation++;
+	pool.next_row = y;
+	pool.end_row = y + height;
+	/* Several bands per thread, so a slow thread does not hold the rest up. */
+	pool.band = height / ((uint32_t)(pool.count + 1) * 4);
+	if (pool.band < 16) {
+		pool.band = 16;
+	}
+	pthread_cond_broadcast(&pool.work);
+	run_bands(&job);
+	while (pool.busy > 0) {
+		pthread_cond_wait(&pool.done, &pool.lock);
+	}
+	pool.job = NULL;
+	pthread_mutex_unlock(&pool.lock);
+}
