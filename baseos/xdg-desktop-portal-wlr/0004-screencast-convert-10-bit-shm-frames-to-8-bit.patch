diff --git a/include/shm_convert.h b/include/shm_convert.h
new file mode 100644
index 0000000..a2aef1e
--- /dev/null
+++ b/include/shm_convert.h
@@ -0,0 +1,49 @@
+#ifndef SHM_CONVERT_H
+#define SHM_CONVERT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/*
+ * CPU conversion of 10-bit shm captures to 8-bit XRGB8888 (PipeWire BGRx).
+ *
+ * A compositor that renders an output in 10 bits (HDR, or 10-bit SDR) only
+ * offers a 10-bit wl_shm capture format. Consumers which can neither import
+ * dmabufs nor read 10-bit packed RGB (GStreamer's pipewiresrc, and with it
+ * RustDesk) then have no format in common with us. For them the frame is
+ * captured into a private 10-bit buffer and converted into the buffer the
+ * consumer sees.
+ */
+
+/* SDR reference white assumed for PQ when the compositor does not say. */
+#define XDPW_SHM_CONVERT_DEFAULT_REFERENCE 203.0f
+
+struct xdpw_shm_convert_params {
+	uint32_t src_format; /* drm fourcc of the captured buffer */
+	/* The capture is PQ (SMPTE ST 2084) encoded: decode it, put SDR
+	 * reference white at 1.0 and encode with gamma 2.2. Values above
+	 * reference white clip. Without this only the bit depth changes. */
+	bool pq;
+	/* The capture uses BT.2020 primaries: convert to sRGB primaries.
+	 * Only honoured together with pq. */
+	bool bt2020;
+	/* SDR reference white in nits, <= 0 for the default. */
+	float reference_luminance;
+};
+
+/* Whether src_format is a 10-bit packed RGB format this module converts. */
+bool xdpw_shm_convert_supported(uint32_t drm_format);
+
+/*
+ * Convert the rectangle (x, y, width, height) of src into dst. Both buffers
+ * are 32 bits per pixel; strides are in bytes. The rectangle must lie inside
+ * both buffers.
+ */
+void xdpw_shm_convert(const struct xdpw_shm_convert_params *params,
+	const void *src, uint32_t src_stride, void *dst, uint32_t dst_stride,
+	uint32_t x, uint32_t y, uint32_t width, uint32_t height);
+
+/* Stop the worker threads. Safe to call when none were started. */
+void xdpw_shm_convert_finish(void);
+
+#endif /* SHM_CONVERT_H */
