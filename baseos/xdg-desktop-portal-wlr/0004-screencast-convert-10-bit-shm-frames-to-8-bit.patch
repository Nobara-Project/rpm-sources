+
+uint32_t xdpw_buffer_capture_format(const struct xdpw_buffer *buffer) {
+	return buffer->convert ? buffer->capture_format : buffer->format;
+}
+
+uint32_t xdpw_buffer_capture_stride(const struct xdpw_buffer *buffer) {
+	return buffer->convert ? buffer->capture_stride : buffer->stride[0];
+}
