+static uint32_t pack(uint32_t format, uint32_t r, uint32_t g, uint32_t b) {
+	switch (format) {
+	case DRM_FORMAT_XRGB2101010:
+		return (r << 20) | (g << 10) | b;
+	case DRM_FORMAT_ARGB2101010:
+		return (3u << 30) | (r << 20) | (g << 10) | b;
+	case DRM_FORMAT_XBGR2101010:
+		return (b << 20) | (g << 10) | r;
+	case DRM_FORMAT_ABGR2101010:
+		return (3u << 30) | (b << 20) | (g << 10) | r;
+	case DRM_FORMAT_RGBX1010102:
+		return (r << 22) | (g << 12) | (b << 2);
+	case DRM_FORMAT_RGBA1010102:
+		return (r << 22) | (g << 12) | (b << 2) | 3;
+	case DRM_FORMAT_BGRX1010102:
+		return (b << 22) | (g << 12) | (r << 2);
+	case DRM_FORMAT_BGRA1010102:
+		return (b << 22) | (g << 12) | (r << 2) | 3;
+	}
+	abort();
+}
+
+static uint32_t convert_one(const struct xdpw_shm_convert_params *params, uint32_t pixel) {
+	uint32_t out = 0;
+	xdpw_shm_convert(params, &pixel, 4, &out, 4, 0, 0, 1, 1);
+	return out;
+}
+
+static const uint32_t formats[] = {
+	DRM_FORMAT_XRGB2101010, DRM_FORMAT_ARGB2101010,
+	DRM_FORMAT_XBGR2101010, DRM_FORMAT_ABGR2101010,
+	DRM_FORMAT_RGBX1010102, DRM_FORMAT_RGBA1010102,
+	DRM_FORMAT_BGRX1010102, DRM_FORMAT_BGRA1010102,
+};
+#define FORMATS (sizeof(formats) / sizeof(formats[0]))
+
+static void test_supported(void) {
+	for (size_t i = 0; i < FORMATS; i++) {
+		CHECK(xdpw_shm_convert_supported(formats[i]), "format %zu", i);
+	}
+	CHECK(!xdpw_shm_convert_supported(DRM_FORMAT_XRGB8888), "XRGB8888");
+	CHECK(!xdpw_shm_convert_supported(DRM_FORMAT_NV12), "NV12");
+}
+
+/* Without PQ only the depth changes: 10 bits scale to 8 with rounding. */
+static void test_depth(void) {
+	for (size_t i = 0; i < FORMATS; i++) {
+		struct xdpw_shm_convert_params params = { .src_format = formats[i] };
+		CHECK(convert_one(&params, pack(formats[i], 1023, 0, 512)) == 0xffff0080,
+			"format %zu: %08x", i, convert_one(&params, pack(formats[i], 1023, 0, 512)));
+		CHECK(convert_one(&params, pack(formats[i], 0, 1023, 4)) == 0xff00ff01,
+			"format %zu: %08x", i, convert_one(&params, pack(formats[i], 0, 1023, 4)));
+		/* bt2020 alone must not change colours */
+		params.bt2020 = true;
+		CHECK(convert_one(&params, pack(formats[i], 1023, 0, 512)) == 0xffff0080,
+			"format %zu with bt2020", i);
+	}
+	struct xdpw_shm_convert_params params = { .src_format = DRM_FORMAT_XRGB2101010 };
+	for (uint32_t v = 0; v < 1024; v++) {
+		uint32_t expect = (uint32_t)lround(v * 255.0 / 1023);
+		uint32_t out = convert_one(&params, pack(params.src_format, v, v, v));
+		CHECK(out == (0xff000000 | expect << 16 | expect << 8 | expect),
+			"depth %u: %08x", v, out);
+	}
+}
+
+/* What the compositor does to an sRGB pixel on a PQ BT.2020 output. */
+static double pq_oetf(double nits) {
+	const double m1 = 2610.0 / 16384, m2 = 2523.0 / 4096 * 128;
+	const double c1 = 3424.0 / 4096, c2 = 2413.0 / 4096 * 32, c3 = 2392.0 / 4096 * 32;
+	double y = pow(nits / 10000, m1);
+	return pow((c1 + c2 * y) / (1 + c3 * y), m2);
+}
+
+static uint32_t compose(uint32_t format, double reference, bool bt2020,
+		uint32_t r8, uint32_t g8, uint32_t b8) {
+	static const double to2020[9] = {
+		0.6274039, 0.3292830, 0.0433131,
+		0.0690973, 0.9195404, 0.0113623,
+		0.0163914, 0.0880133, 0.8955953,
+	};
+	double r = pow(r8 / 255.0, 2.2), g = pow(g8 / 255.0, 2.2), b = pow(b8 / 255.0, 2.2);
+	if (bt2020) {
+		double x = to2020[0] * r + to2020[1] * g + to2020[2] * b;
+		double y = to2020[3] * r + to2020[4] * g + to2020[5] * b;
+		double z = to2020[6] * r + to2020[7] * g + to2020[8] * b;
+		r = x; g = y; b = z;
+	}
+	return pack(format,
+		(uint32_t)lround(1023 * pq_oetf(r * reference)),
+		(uint32_t)lround(1023 * pq_oetf(g * reference)),
+		(uint32_t)lround(1023 * pq_oetf(b * reference)));
+}
+
+/* Largest channel difference in linear light, 1.0 being SDR white. */
+static double linear_error(uint32_t out, uint32_t r, uint32_t g, uint32_t b) {
+	double er = fabs(pow(((out >> 16) & 0xff) / 255.0, 2.2) - pow(r / 255.0, 2.2));
+	double eg = fabs(pow(((out >> 8) & 0xff) / 255.0, 2.2) - pow(g / 255.0, 2.2));
+	double eb = fabs(pow((out & 0xff) / 255.0, 2.2) - pow(b / 255.0, 2.2));
+	double e = er > eg ? er : eg;
+	return e > eb ? e : eb;
+}
+
+static int channel_error(uint32_t out, uint32_t r, uint32_t g, uint32_t b) {
+	int er = abs((int)((out >> 16) & 0xff) - (int)r);
+	int eg = abs((int)((out >> 8) & 0xff) - (int)g);
+	int eb = abs((int)(out & 0xff) - (int)b);
+	int e = er > eg ? er : eg;
+	return e > eb ? e : eb;
+}
+
+/* SDR content shown on an HDR output comes back as it went in. */
+static void test_pq(void) {
+	static const float references[] = { 0, 203, 100, 80, 400 };
+	for (size_t ri = 0; ri < sizeof(references) / sizeof(references[0]); ri++) {
+		double reference = references[ri] > 0 ? references[ri] : 203;
+		for (int bt2020 = 0; bt2020 <= 1; bt2020++) {
+			struct xdpw_shm_convert_params params = {
+				.src_format = DRM_FORMAT_XRGB2101010,
+				.pq = true,
+				.bt2020 = bt2020,
+				.reference_luminance = references[ri],
+			};
+			int worst_grey = 0, worst_colour = 0;
+			double worst_linear = 0;
+			for (uint32_t v = 0; v < 256; v++) {
+				uint32_t out = convert_one(&params,
+					compose(params.src_format, reference, bt2020, v, v, v));
+				int e = channel_error(out, v, v, v);
+				worst_grey = e > worst_grey ? e : worst_grey;
+				CHECK((out >> 24) == 0xff, "alpha %08x", out);
+			}
+			for (uint32_t r = 0; r < 256; r += 15) {
+				for (uint32_t g = 0; g < 256; g += 15) {
+					for (uint32_t b = 0; b < 256; b += 15) {
+						uint32_t out = convert_one(&params,
+							compose(params.src_format, reference, bt2020, r, g, b));
+						int e = channel_error(out, r, g, b);
+						worst_colour = e > worst_colour ? e : worst_colour;
+						double le = linear_error(out, r, g, b);
+						worst_linear = le > worst_linear ? le : worst_linear;
+					}
+				}
+			}
+			printf("pq reference=%g bt2020=%d: worst grey error %d, worst colour error %d"
+				" (%.4f of white in linear light)\n",
+				reference, bt2020, worst_grey, worst_colour, worst_linear);
+			/* The 10-bit PQ signal itself is the limit. One of its steps
+			 * is about one 8-bit step near white, so greys can be off by
+			 * one. With BT.2020 the gamut matrix spreads the rounding of
+			 * a bright channel into the others. In light that stays
+			 * around 1% of white (one 8-bit step at white is 0.9%), but
+			 * it is many 8-bit steps where a channel is near zero next
+			 * to a bright one (pure green: red up to ~23). */
+			CHECK(worst_grey <= 1, "grey error %d", worst_grey);
+			if (bt2020) {
+				CHECK(worst_linear <= 0.012, "linear error %.4f", worst_linear);
+				CHECK(worst_colour <= 26, "colour error %d", worst_colour);
+			} else {
+				CHECK(worst_colour <= 1, "colour error %d", worst_colour);
+			}
+			CHECK(convert_one(&params, compose(params.src_format, reference, bt2020, 255, 255, 255))
+				== 0xffffffff, "white");
+			CHECK(convert_one(&params, compose(params.src_format, reference, bt2020, 0, 0, 0))
+				== 0xff000000, "black");
+		}
+	}
+
+	/* Brighter than SDR white clips; nothing wraps around. */
+	struct xdpw_shm_convert_params params = {
+		.src_format = DRM_FORMAT_XRGB2101010, .pq = true, .bt2020 = true,
+	};
+	CHECK(convert_one(&params, pack(params.src_format, 1023, 1023, 1023)) == 0xffffffff, "peak");
+	CHECK(convert_one(&params, pack(params.src_format, 1023, 0, 0)) == 0xffff0000,
+		"peak red %08x", convert_one(&params, pack(params.src_format, 1023, 0, 0)));
+	/* A saturated BT.2020 green lies outside sRGB: negative channels clip to 0 */
+	CHECK(convert_one(&params, pack(params.src_format, 0, 500, 0)) >> 16 == 0xff00,
+		"wide green %08x", convert_one(&params, pack(params.src_format, 0, 500, 0)));
+}
+
+static uint32_t rng_state = 12345;
+static uint32_t rng(void) {
+	rng_state ^= rng_state << 13;
+	rng_state ^= rng_state >> 17;
+	rng_state ^= rng_state << 5;
+	return rng_state;
+}
+
+/* Large frames run on several threads and give the same result; a rectangle
+ * leaves the rest alone, also with strides wider than the image. */
+static void test_frames(void) {
+	const uint32_t width = 1921, height = 1083;
+	const uint32_t src_stride = (width + 5) * 4, dst_stride = (width + 2) * 4;
+	uint32_t *src = malloc((size_t)src_stride * height);
+	uint32_t *whole = malloc((size_t)dst_stride * height);
+	uint32_t *rows = malloc((size_t)dst_stride * height);
+	for (size_t i = 0; i < (size_t)src_stride / 4 * height; i++) {
+		/* runs of equal pixels and noise, like a desktop */
+		src[i] = (i / 97) % 3 == 0 ? rng() : 0x2ff7fdff;
+	}
+	struct xdpw_shm_convert_params params = {
+		.src_format = DRM_FORMAT_XBGR2101010, .pq = true, .bt2020 = true,
+		.reference_luminance = 203,
+	};
+	memset(whole, 0x55, (size_t)dst_stride * height);
+	memset(rows, 0x55, (size_t)dst_stride * height);
+	for (int round = 0; round < 3; round++) {
+		xdpw_shm_convert(&params, src, src_stride, whole, dst_stride, 0, 0, width, height);
+	}
+	for (uint32_t y = 0; y < height; y++) {
+		xdpw_shm_convert(&params, src, src_stride, rows, dst_stride, 0, y, width, 1);
+	}
+	CHECK(memcmp(whole, rows, (size_t)dst_stride * height) == 0, "threaded result differs");
+	CHECK(whole[width] == 0x55555555, "wrote past the row");
+
+	memset(rows, 0x55, (size_t)dst_stride * height);
+	xdpw_shm_convert(&params, src, src_stride, rows, dst_stride, 700, 200, 900, 700);
+	size_t wrong = 0;
+	for (uint32_t y = 0; y < height; y++) {
+		for (uint32_t x = 0; x < dst_stride / 4; x++) {
+			bool inside = x >= 700 && x < 1600 && y >= 200 && y < 900;
+			uint32_t got = rows[(size_t)y * (dst_stride / 4) + x];
+			uint32_t want = inside ? whole[(size_t)y * (dst_stride / 4) + x] : 0x55555555;
+			wrong += got != want;
+		}
+	}
+	CHECK(wrong == 0, "%zu pixels wrong around a rectangle", wrong);
+
+	/* empty and unsupported input do nothing */
+	xdpw_shm_convert(&params, src, src_stride, rows, dst_stride, 0, 0, 0, 10);
+	struct xdpw_shm_convert_params bad = { .src_format = DRM_FORMAT_XRGB8888 };
+	rows[0] = 0x12345678;
+	xdpw_shm_convert(&bad, src, src_stride, rows, dst_stride, 0, 0, 10, 10);
+	CHECK(rows[0] == 0x12345678, "unsupported format wrote");
+
+	free(src);
+	free(whole);
+	free(rows);
+}
+
+static double now_ms(void) {
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+static void bench(void) {
+	const uint32_t width = 3840, height = 2160;
+	uint32_t *src = malloc((size_t)width * height * 4);
+	uint32_t *dst = malloc((size_t)width * height * 4);
+	struct xdpw_shm_convert_params params = {
+		.src_format = DRM_FORMAT_XRGB2101010, .pq = true, .bt2020 = true,
+	};
+	const char *names[] = { "noise", "desktop-like", "flat" };
+	for (int kind = 0; kind < 3; kind++) {
+		for (size_t i = 0; i < (size_t)width * height; i++) {
+			src[i] = kind == 0 ? rng() : kind == 1 ? ((i / 61) % 4 == 0 ? rng() : 0x2ff7fdff) : 0x2ff7fdff;
+		}
+		xdpw_shm_convert(&params, src, width * 4, dst, width * 4, 0, 0, width, height);
+		double start = now_ms();
+		for (int i = 0; i < 20; i++) {
+			xdpw_shm_convert(&params, src, width * 4, dst, width * 4, 0, 0, width, height);
+		}
+		printf("%-12s 3840x2160: %.1f ms per frame\n", names[kind], (now_ms() - start) / 20);
+	}
+	free(src);
+	free(dst);
+}
+
+int main(int argc, char **argv) {
+	if (argc > 1 && strcmp(argv[1], "bench") == 0) {
+		bench();
+		xdpw_shm_convert_finish();
+		return 0;
+	}
+	test_supported();
+	test_depth();
+	test_pq();
+	test_frames();
+	xdpw_shm_convert_finish();
+	/* the pool can be started again after it was stopped */
+	test_frames();
+	xdpw_shm_convert_finish();
+	if (failures > 0) {
+		fprintf(stderr, "%d checks failed\n", failures);
+		return 1;
+	}
+	printf("all checks passed\n");
+	return 0;
+}
