-		SPA_POD_Id(colorimetry->transfer_function), 0);
+		SPA_POD_Id(transfer), 0);
 	spa_pod_builder_add(b, SPA_FORMAT_VIDEO_colorPrimaries,
-		SPA_POD_Id(colorimetry->color_primaries), 0);
