 		return;
 	}
 
+	if (cast->current_frame.xdpw_buffer != NULL && cast->current_frame.xdpw_buffer->convert) {
+		if (buffer_corrupt) {
+			convert_invalidate(cast);
+		} else {
+			convert_current_frame(cast);
+		}
+	}
+
 	logprint(TRACE, "********************");
 	struct spa_meta_header *h;
 	if ((h = spa_buffer_find_meta_data(spa_buf, SPA_META_Header, sizeof(*h)))) {
@@ -753,6 +862,16 @@ void xdpw_pwr_stream_destroy(struct xdpw_screencast_instance *cast) {
 }
 
 static void on_core_error(void *data, uint32_t id, int seq, int res, const char* message) {
+	// The core also relays errors of single objects here, for example of a
+	// stream whose consumer found no format in common with us. That stream
+	// is in its error state then; it is no reason to take every other
+	// screencast and remote desktop session down with it.
+	if (id != PW_ID_CORE || res != -EPIPE) {
+		logprint(WARN, "pipewire: error on object %u: %s (%s)", id,
+			message ? message : "", spa_strerror(res));
+		return;
+	}
+
 	// If our pipewire connection drops then we won't be able to actually
 	// do a screencast.  Exit the process so someone restarts us and the
 	// new xdpw can reconnect to pipewire.
@@ -800,6 +919,8 @@ void xdpw_pwr_context_destroy(struct xdpw_state *state) {
 
 	logprint(DEBUG, "pipewire: disconnecting fom core");
 
+	xdpw_shm_convert_finish();
+
 	if (ctx->core) {
 		pw_core_disconnect(ctx->core);
 		ctx->core = NULL;
