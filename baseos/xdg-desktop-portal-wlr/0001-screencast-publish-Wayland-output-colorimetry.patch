From cb296421c9f88a3af9cad989c60957945be1634b Mon Sep 17 00:00:00 2001
From: Nobara Project <noreply@nobaraproject.org>
Date: Tue, 1 Sep 2026 09:38:03 -0600
Subject: [PATCH] screencast: publish Wayland output colorimetry

The monitor capture protocols copy the compositor output buffer but do not describe its color encoding. Query the selected wl_output through color-management-v1 and map supported primaries and transfer functions to fixed SPA raw-video format fields.

Refresh active PipeWire stream parameters when the output image description changes. Window captures and compositors without usable color-management metadata continue to advertise unknown colorimetry.
---
 include/screencast_common.h          |  20 ++
 meson.build                          |   2 +-
 protocols/meson.build                |   1 +
 src/screencast/pipewire_screencast.c |  46 +++-
 src/screencast/wlr_screencast.c      | 384 ++++++++++++++++++++++++++-
 5 files changed, 437 insertions(+), 16 deletions(-)

diff --git a/include/screencast_common.h b/include/screencast_common.h
index 113c44f..eda97ad 100644
--- a/include/screencast_common.h
+++ b/include/screencast_common.h
@@ -9,6 +9,11 @@
 
 #include "fps_limit.h"
 
+struct wp_color_manager_v1;
+struct wp_color_management_output_v1;
+struct wp_image_description_v1;
+struct wp_image_description_info_v1;
+
 // this seems to be right based on
 // https://github.com/flatpak/xdg-desktop-portal/blob/309a1fc0cf2fb32cceb91dbc666d20cf0a3202c2/src/screen-cast.c#L955
 #define XDP_CAST_PROTO_VER 4
@@ -93,6 +98,14 @@ struct xdpw_dmabuf_feedback_data {
 	bool device_used;
 };
 
+struct xdpw_output_colorimetry {
+	bool valid;
+	enum spa_video_color_range range;
+	enum spa_video_color_matrix matrix;
+	enum spa_video_transfer_function transfer_function;
+	enum spa_video_color_primaries color_primaries;
+};
+
 
 struct xdpw_toplevel {
 	struct wl_list link;
@@ -122,6 +135,7 @@ struct xdpw_screencast_context {
 	struct zwp_linux_dmabuf_v1 *linux_dmabuf;
 	struct zwp_linux_dmabuf_feedback_v1 *linux_dmabuf_feedback;
 	struct zxdg_output_manager_v1 *xdg_output_manager;
+	struct wp_color_manager_v1 *color_manager;
 	struct xdpw_dmabuf_feedback_data feedback_data;
 	struct wl_array format_modifier_pairs;
 
@@ -225,9 +239,15 @@ struct xdpw_screencast_session_data {
 
 struct xdpw_wlr_output {
 	struct wl_list link;
+	struct xdpw_screencast_context *ctx;
 	uint32_t id;
 	struct wl_output *output;
 	struct zxdg_output_v1 *xdg_output;
+	struct wp_color_management_output_v1 *color_output;
+	struct wp_image_description_v1 *image_description;
+	struct wp_image_description_info_v1 *image_description_info;
+	struct xdpw_output_colorimetry colorimetry;
+	struct xdpw_output_colorimetry pending_colorimetry;
 	char *name;
 	char *description;
 	int x;
