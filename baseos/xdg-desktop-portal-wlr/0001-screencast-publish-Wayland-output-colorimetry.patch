diff --git a/src/screencast/pipewire_screencast.c b/src/screencast/pipewire_screencast.c
index 1f24760..04f61e8 100644
--- a/src/screencast/pipewire_screencast.c
+++ b/src/screencast/pipewire_screencast.c
@@ -19,6 +19,35 @@
 
 #define DAMAGE_REGION_COUNT 16
 
+static const struct xdpw_output_colorimetry *get_output_colorimetry(
+		struct xdpw_screencast_instance *cast) {
+	if (cast->target == NULL || cast->target->type != MONITOR ||
+			cast->target->output == NULL ||
+			!cast->target->output->colorimetry.valid) {
+		return NULL;
+	}
+
+	return &cast->target->output->colorimetry;
+}
+
+static void add_colorimetry(struct spa_pod_builder *b,
+		struct xdpw_screencast_instance *cast) {
+	const struct xdpw_output_colorimetry *colorimetry =
+		get_output_colorimetry(cast);
+	if (colorimetry == NULL) {
+		return;
+	}
+
+	spa_pod_builder_add(b, SPA_FORMAT_VIDEO_colorRange,
+		SPA_POD_Id(colorimetry->range), 0);
+	spa_pod_builder_add(b, SPA_FORMAT_VIDEO_colorMatrix,
+		SPA_POD_Id(colorimetry->matrix), 0);
+	spa_pod_builder_add(b, SPA_FORMAT_VIDEO_transferFunction,
+		SPA_POD_Id(colorimetry->transfer_function), 0);
+	spa_pod_builder_add(b, SPA_FORMAT_VIDEO_colorPrimaries,
+		SPA_POD_Id(colorimetry->color_primaries), 0);
+}
+
 static struct spa_pod *build_buffer(struct spa_pod_builder *b, uint32_t blocks, uint32_t size,
 		uint32_t stride, uint32_t datatype) {
 	assert(blocks > 0);
@@ -40,7 +69,8 @@ static struct spa_pod *build_buffer(struct spa_pod_builder *b, uint32_t blocks,
 	return spa_pod_builder_pop(b, &f[0]);
 }
 
-static struct spa_pod *fixate_format(struct spa_pod_builder *b, enum spa_video_format format,
+static struct spa_pod *fixate_format(struct spa_pod_builder *b,
+		struct xdpw_screencast_instance *cast, enum spa_video_format format,
 		uint32_t width, uint32_t height, uint32_t framerate, uint64_t *modifier)
 {
 	struct spa_pod_frame f[1];
@@ -77,10 +107,12 @@ static struct spa_pod *fixate_format(struct spa_pod_builder *b, enum spa_video_f
 				&SPA_FRACTION(framerate, 1)),
 			0);
 	}
+	add_colorimetry(b, cast);
 	return spa_pod_builder_pop(b, &f[0]);
 }
 
-static struct spa_pod *build_format(struct spa_pod_builder *b, enum spa_video_format format,
+static struct spa_pod *build_format(struct spa_pod_builder *b,
+		struct xdpw_screencast_instance *cast, enum spa_video_format format,
 		uint32_t width, uint32_t height, uint32_t framerate,
 		uint64_t *modifiers, int modifier_count) {
 	struct spa_pod_frame f[2];
@@ -127,6 +159,7 @@ static struct spa_pod *build_format(struct spa_pod_builder *b, enum spa_video_fo
 				&SPA_FRACTION(framerate, 1)),
 			0);
 	}
+	add_colorimetry(b, cast);
 	return spa_pod_builder_pop(b, &f[0]);
 }
 
@@ -171,7 +204,7 @@ static void build_formats(struct spa_pod_builder *builder, struct xdpw_screencas
 			uint64_t *modifiers = NULL;
 			build_modifierlist(cast, fm_pair->fourcc, &modifiers, &modifier_count);
 			if (modifier_count > 0) {
-				add_pod(params, build_format(builder, pw_format,
+				add_pod(params, build_format(builder, cast, pw_format,
 						cast->current_constraints.width, cast->current_constraints.height,
 						cast->framerate, modifiers, modifier_count));
 			}
@@ -183,7 +216,7 @@ static void build_formats(struct spa_pod_builder *builder, struct xdpw_screencas
 	wl_array_for_each(format, &cast->current_constraints.shm_formats) {
 		enum spa_video_format pw_format = xdpw_format_pw_from_drm_fourcc(*format);
 		if (pw_format != SPA_VIDEO_FORMAT_UNKNOWN) {
-			add_pod(params, build_format(builder, pw_format,
+			add_pod(params, build_format(builder, cast, pw_format,
 						cast->current_constraints.width, cast->current_constraints.height,
 						cast->framerate, NULL, 0));
 		}
@@ -464,7 +497,7 @@ static void pwr_handle_stream_param_changed(void *data, uint32_t id,
 
 fixate_format:
 
-			add_pod(&params, fixate_format(&builder.b, cast->pwr_format.format,
+			add_pod(&params, fixate_format(&builder.b, cast, cast->pwr_format.format,
 						cast->current_constraints.width, cast->current_constraints.height, cast->framerate, &modifier));
 
 			build_formats(&builder.b, cast, &params);
@@ -493,6 +526,9 @@ fixate_format:
 	logprint(DEBUG, "pipewire: modifier: %lu", cast->pwr_format.modifier);
 	logprint(DEBUG, "pipewire: size: (%u, %u)", cast->pwr_format.size.width, cast->pwr_format.size.height);
 	logprint(DEBUG, "pipewire: max_framerate: (%u / %u)", cast->pwr_format.max_framerate.num, cast->pwr_format.max_framerate.denom);
+	logprint(DEBUG, "pipewire: colorimetry: range=%u matrix=%u transfer=%u primaries=%u",
+		cast->pwr_format.color_range, cast->pwr_format.color_matrix,
+		cast->pwr_format.transfer_function, cast->pwr_format.color_primaries);
 
 	add_pod(&params, build_buffer(&builder.b, blocks, 0, 0, data_type));
 
diff --git a/src/screencast/wlr_screencast.c b/src/screencast/wlr_screencast.c
index 0c8aad7..f764c2c 100644
--- a/src/screencast/wlr_screencast.c
+++ b/src/screencast/wlr_screencast.c
@@ -1,6 +1,7 @@
 #include "wlr_screencast.h"
 
 #include "linux-dmabuf-unstable-v1-client-protocol.h"
+#include "color-management-v1-client-protocol.h"
 #include "wlr-screencopy-unstable-v1-client-protocol.h"
 #include "xdg-output-unstable-v1-client-protocol.h"
 #include "ext-image-capture-source-v1-client-protocol.h"
@@ -25,6 +26,7 @@
 #include "xdpw.h"
 #include "logger.h"
 #include "fps_limit.h"
+#include "pipewire_screencast.h"
 
 static void wlr_frame_capture_start(struct xdpw_screencast_instance *cast) {
 	fps_limit_measure_start(&cast->fps_limit, cast->framerate);
@@ -150,6 +152,336 @@ static const struct zxdg_output_v1_listener xdg_output_listener = {
 	.description = xdg_output_handle_description,
 };
 
+static enum spa_video_color_primaries color_primaries_from_wayland(
+		uint32_t primaries) {
+	switch (primaries) {
+	case WP_COLOR_MANAGER_V1_PRIMARIES_SRGB:
+		return SPA_VIDEO_COLOR_PRIMARIES_BT709;
+	case WP_COLOR_MANAGER_V1_PRIMARIES_PAL_M:
+		return SPA_VIDEO_COLOR_PRIMARIES_BT470M;
+	case WP_COLOR_MANAGER_V1_PRIMARIES_PAL:
+		return SPA_VIDEO_COLOR_PRIMARIES_BT470BG;
+	case WP_COLOR_MANAGER_V1_PRIMARIES_NTSC:
+		return SPA_VIDEO_COLOR_PRIMARIES_SMPTE170M;
+	case WP_COLOR_MANAGER_V1_PRIMARIES_GENERIC_FILM:
+		return SPA_VIDEO_COLOR_PRIMARIES_FILM;
+	case WP_COLOR_MANAGER_V1_PRIMARIES_BT2020:
+		return SPA_VIDEO_COLOR_PRIMARIES_BT2020;
+	case WP_COLOR_MANAGER_V1_PRIMARIES_CIE1931_XYZ:
+		return SPA_VIDEO_COLOR_PRIMARIES_SMPTEST428;
+	case WP_COLOR_MANAGER_V1_PRIMARIES_DCI_P3:
+		return SPA_VIDEO_COLOR_PRIMARIES_SMPTERP431;
+	case WP_COLOR_MANAGER_V1_PRIMARIES_DISPLAY_P3:
+		return SPA_VIDEO_COLOR_PRIMARIES_SMPTEEG432;
+	case WP_COLOR_MANAGER_V1_PRIMARIES_ADOBE_RGB:
+		return SPA_VIDEO_COLOR_PRIMARIES_ADOBERGB;
+	default:
+		return SPA_VIDEO_COLOR_PRIMARIES_UNKNOWN;
+	}
+}
+
+static enum spa_video_transfer_function color_transfer_from_wayland(uint32_t tf) {
+	switch (tf) {
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_GAMMA22:
+		return SPA_VIDEO_TRANSFER_GAMMA22;
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_GAMMA28:
+		return SPA_VIDEO_TRANSFER_GAMMA28;
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST240:
+		return SPA_VIDEO_TRANSFER_SMPTE240M;
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_EXT_LINEAR:
+		return SPA_VIDEO_TRANSFER_GAMMA10;
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_LOG_100:
+		return SPA_VIDEO_TRANSFER_LOG100;
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_LOG_316:
+		return SPA_VIDEO_TRANSFER_LOG316;
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_SRGB:
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_EXT_SRGB:
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_XVYCC:
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_COMPOUND_POWER_2_4:
+		return SPA_VIDEO_TRANSFER_SRGB;
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ:
+		return SPA_VIDEO_TRANSFER_SMPTE2084;
+	case WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_HLG:
+		return SPA_VIDEO_TRANSFER_ARIB_STD_B67;
+	default:
+		return SPA_VIDEO_TRANSFER_UNKNOWN;
+	}
+}
+
+static bool colorimetry_equal(const struct xdpw_output_colorimetry *a,
+		const struct xdpw_output_colorimetry *b) {
+	return a->valid == b->valid && a->range == b->range &&
+		a->matrix == b->matrix &&
+		a->transfer_function == b->transfer_function &&
+		a->color_primaries == b->color_primaries;
+}
+
+static void output_colorimetry_commit(struct xdpw_wlr_output *output,
+		const struct xdpw_output_colorimetry *colorimetry) {
+	if (colorimetry_equal(&output->colorimetry, colorimetry)) {
+		return;
+	}
+
+	output->colorimetry = *colorimetry;
+	if (colorimetry->valid) {
+		logprint(INFO, "wayland: output %s colorimetry: range=%u matrix=%u transfer=%u primaries=%u",
+			output->name ? output->name : "(unknown)", colorimetry->range,
+			colorimetry->matrix, colorimetry->transfer_function,
+			colorimetry->color_primaries);
+	} else {
+		logprint(DEBUG, "wayland: output %s colorimetry is unavailable",
+			output->name ? output->name : "(unknown)");
+	}
+
+	struct xdpw_screencast_instance *cast;
+	wl_list_for_each(cast, &output->ctx->screencast_instances, link) {
+		if (cast->target != NULL && cast->target->type == MONITOR &&
+				cast->target->output == output && cast->stream != NULL) {
+			pwr_update_stream_param(cast);
+		}
+	}
+}
+
+static void image_description_info_handle_done(void *data,
+		struct wp_image_description_info_v1 *info) {
+	struct xdpw_wlr_output *output = data;
+	if (output->image_description_info != info) {
+		return;
+	}
+
+	output->image_description_info = NULL;
+	wp_image_description_info_v1_destroy(info);
+	output->pending_colorimetry.valid =
+		output->pending_colorimetry.transfer_function != SPA_VIDEO_TRANSFER_UNKNOWN &&
+		output->pending_colorimetry.color_primaries != SPA_VIDEO_COLOR_PRIMARIES_UNKNOWN;
+	if (output->pending_colorimetry.valid) {
+		output->pending_colorimetry.range = SPA_VIDEO_COLOR_RANGE_0_255;
+		output->pending_colorimetry.matrix = SPA_VIDEO_COLOR_MATRIX_RGB;
+	}
+	output_colorimetry_commit(output, &output->pending_colorimetry);
+
+	if (output->image_description != NULL) {
+		wp_image_description_v1_destroy(output->image_description);
+		output->image_description = NULL;
+	}
+}
+
+static void image_description_info_handle_icc_file(void *data,
+		struct wp_image_description_info_v1 *info, int32_t icc, uint32_t icc_size) {
+	close(icc);
+}
+
+static void image_description_info_handle_primaries(void *data,
+		struct wp_image_description_info_v1 *info, int32_t r_x, int32_t r_y,
+		int32_t g_x, int32_t g_y, int32_t b_x, int32_t b_y,
+		int32_t w_x, int32_t w_y) {
+}
+
+static void image_description_info_handle_primaries_named(void *data,
+		struct wp_image_description_info_v1 *info, uint32_t primaries) {
+	struct xdpw_wlr_output *output = data;
+	output->pending_colorimetry.color_primaries =
+		color_primaries_from_wayland(primaries);
+}
+
+static void image_description_info_handle_tf_power(void *data,
+		struct wp_image_description_info_v1 *info, uint32_t eexp) {
+	struct xdpw_wlr_output *output = data;
+	switch (eexp) {
+	case 10000:
+		output->pending_colorimetry.transfer_function = SPA_VIDEO_TRANSFER_GAMMA10;
+		break;
+	case 18000:
+		output->pending_colorimetry.transfer_function = SPA_VIDEO_TRANSFER_GAMMA18;
+		break;
+	case 20000:
+		output->pending_colorimetry.transfer_function = SPA_VIDEO_TRANSFER_GAMMA20;
+		break;
+	case 22000:
+		output->pending_colorimetry.transfer_function = SPA_VIDEO_TRANSFER_GAMMA22;
+		break;
+	case 28000:
+		output->pending_colorimetry.transfer_function = SPA_VIDEO_TRANSFER_GAMMA28;
+		break;
+	default:
+		output->pending_colorimetry.transfer_function = SPA_VIDEO_TRANSFER_UNKNOWN;
+		break;
+	}
+}
+
+static void image_description_info_handle_tf_named(void *data,
+		struct wp_image_description_info_v1 *info, uint32_t tf) {
+	struct xdpw_wlr_output *output = data;
+	output->pending_colorimetry.transfer_function = color_transfer_from_wayland(tf);
+}
+
+static void image_description_info_handle_luminances(void *data,
+		struct wp_image_description_info_v1 *info, uint32_t min_lum,
+		uint32_t max_lum, uint32_t reference_lum) {
+}
+
+static void image_description_info_handle_target_primaries(void *data,
+		struct wp_image_description_info_v1 *info, int32_t r_x, int32_t r_y,
+		int32_t g_x, int32_t g_y, int32_t b_x, int32_t b_y,
+		int32_t w_x, int32_t w_y) {
+}
+
+static void image_description_info_handle_target_luminance(void *data,
+		struct wp_image_description_info_v1 *info, uint32_t min_lum,
+		uint32_t max_lum) {
+}
+
+static void image_description_info_handle_target_max_cll(void *data,
+		struct wp_image_description_info_v1 *info, uint32_t max_cll) {
+}
+
+static void image_description_info_handle_target_max_fall(void *data,
+		struct wp_image_description_info_v1 *info, uint32_t max_fall) {
+}
+
+static const struct wp_image_description_info_v1_listener image_description_info_listener = {
+	.done = image_description_info_handle_done,
+	.icc_file = image_description_info_handle_icc_file,
+	.primaries = image_description_info_handle_primaries,
+	.primaries_named = image_description_info_handle_primaries_named,
+	.tf_power = image_description_info_handle_tf_power,
+	.tf_named = image_description_info_handle_tf_named,
+	.luminances = image_description_info_handle_luminances,
+	.target_primaries = image_description_info_handle_target_primaries,
+	.target_luminance = image_description_info_handle_target_luminance,
+	.target_max_cll = image_description_info_handle_target_max_cll,
+	.target_max_fall = image_description_info_handle_target_max_fall,
+};
+
+static void image_description_ready(struct xdpw_wlr_output *output,
+		struct wp_image_description_v1 *image_description) {
+	if (output->image_description != image_description) {
+		return;
+	}
+
+	output->image_description_info =
+		wp_image_description_v1_get_information(image_description);
+	if (output->image_description_info == NULL ||
+			wp_image_description_info_v1_add_listener(
+				output->image_description_info,
+				&image_description_info_listener, output) < 0) {
+		logprint(WARN, "wayland: failed to query output colorimetry");
+		if (output->image_description_info != NULL) {
+			wp_image_description_info_v1_destroy(output->image_description_info);
+			output->image_description_info = NULL;
+		}
+		wp_image_description_v1_destroy(output->image_description);
+		output->image_description = NULL;
+		struct xdpw_output_colorimetry unknown = {0};
+		output_colorimetry_commit(output, &unknown);
+	}
+}
+
+static void image_description_handle_failed(void *data,
+		struct wp_image_description_v1 *image_description, uint32_t cause,
+		const char *msg) {
+	struct xdpw_wlr_output *output = data;
+	if (output->image_description != image_description) {
+		return;
+	}
+
+	logprint(WARN, "wayland: output colorimetry query failed: %s (cause %u)",
+		msg, cause);
+	wp_image_description_v1_destroy(image_description);
+	output->image_description = NULL;
+	struct xdpw_output_colorimetry unknown = {0};
+	output_colorimetry_commit(output, &unknown);
+}
+
+static void image_description_handle_ready(void *data,
+		struct wp_image_description_v1 *image_description, uint32_t identity) {
+	image_description_ready(data, image_description);
+}
+
+static void image_description_handle_ready2(void *data,
+		struct wp_image_description_v1 *image_description, uint32_t identity_hi,
+		uint32_t identity_lo) {
+	image_description_ready(data, image_description);
+}
+
+static const struct wp_image_description_v1_listener image_description_listener = {
+	.failed = image_description_handle_failed,
+	.ready = image_description_handle_ready,
+	.ready2 = image_description_handle_ready2,
+};
+
+static void output_request_colorimetry(struct xdpw_wlr_output *output) {
+	if (output->image_description_info != NULL) {
+		wp_image_description_info_v1_destroy(output->image_description_info);
+		output->image_description_info = NULL;
+	}
+	if (output->image_description != NULL) {
+		wp_image_description_v1_destroy(output->image_description);
+		output->image_description = NULL;
+	}
+	memset(&output->pending_colorimetry, 0, sizeof(output->pending_colorimetry));
+
+	output->image_description =
