-
-	int result;
-
-	char addr_s[3], val_s[3];
-	result = sscanf(buf, "%2s=%2s", addr_s, val_s);
-	if (result != 2)
-		return -EINVAL;
-
-	u8 addr, val;
-
-	// convert addr
-	result = kstrtou8(addr_s, 16, &addr);
