Fix the state file error paths when saving.

filp_open() returns an error pointer, never NULL. When /etc/predator_state
or /etc/four_zone_kb_state could not be opened for writing while the driver
was removed (for example at shutdown with a read-only or full /etc), the
save path passed the error pointer to kernel_write() and the kernel oopsed.
Check it with IS_ERR(), as the load paths already do.

When kernel_write() failed, the save path also closed the file twice,
dropping its reference twice. Close it once.

--- a/src/linuwu_sense.c
+++ b/src/linuwu_sense.c
@@ -4124,15 +4124,14 @@
      }
  
      file = filp_open(STATE_FILE, O_WRONLY | O_CREAT | O_TRUNC, 0644);
-     if(!file) {
-         pr_info("state_access - Error opening file\n");
+     if (IS_ERR(file)) {
+         pr_info("state_access - Error opening file: %ld\n", PTR_ERR(file));
          return -1;
      }
  
      len = kernel_write(file, (char *)&current_states, sizeof(current_states), &file->f_pos);
      if(len < 0) {
          pr_info("state_access - Error writing to file: %ld\n", len);
-         filp_close(file, NULL);
      }
  
      filp_close(file, NULL);
@@ -4988,15 +4987,14 @@
      four_zone_kb_state_update();
  
      file = filp_open(KB_STATE_FILE, O_WRONLY | O_CREAT | O_TRUNC, 0644);
-     if(!file) {
-         pr_err("kb_state_access - Error opening file\n");
+     if (IS_ERR(file)) {
+         pr_err("kb_state_access - Error opening file: %ld\n", PTR_ERR(file));
          return -1;
      }
  
      len = kernel_write(file, (char *)&current_kb_state, sizeof(current_kb_state), &file->f_pos);
      if(len < 0) {
          pr_err("kb_state_access - Error writing to file: %ld\n", len);
-         filp_close(file, NULL);
      }
      
      filp_close(file, NULL);
