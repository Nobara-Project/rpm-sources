[nobara]
name=nobara
mirrorlist=https://mirrors.nobaraproject.org/rolling/$basearch/nobara
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-42-primary
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-43-primary
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-44-primary
repo_gpgcheck=0
enabled=1
enabled_metadata=1

[nobara-updates]
name=nobara-updates
mirrorlist=https://mirrors.nobaraproject.org/rolling/$basearch/baseos
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-nobara-baseos-pubkey-42
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-nobara-baseos-pubkey-43
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-nobara-baseos-pubkey-44
repo_gpgcheck=0
enabled=1
enabled_metadata=1
exclude=kernel*
priority=50
