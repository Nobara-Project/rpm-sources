[terra]
name=Terra $releasever
#baseurl=https://repos.fyralabs.com/terra$releasever
metalink=https://tetsudou.fyralabs.com/metalink?repo=terra$releasever&arch=$basearch
metadata_expire=6h
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever
repo_gpgcheck=1
enabled=1
enabled_metadata=1
countme=1
exclude=akmod-xone akmod-xpad-noone gamescope gamescope-session gamescope-session-steam flatpost inputplumber kmod-xone kmod-xpad-noone umu-launcher umu-launcher-debuginfo umu-launcher-debugsource v4l2loopback xone xpad-noone apparmor-debuginfo apparmor-debugsource apparmor-devel apparmor-libs apparmor-libs-debuginfo apparmor-parser apparmor-parser-debuginfo apparmor-profiles apparmor-utils apparmor-utils-debuginfo mod_apparmor mod_apparmor-debuginfo pam_apparmor pam_apparmor-debuginfo python3-apparmor python3-LibAppArmor python3-LibAppArmor-debuginfo xone-firmware powerbuttond
