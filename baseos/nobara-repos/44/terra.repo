[terra]
name=Terra $releasever
mirrorlist=https://mirrors.nobaraproject.org/rolling/$basearch/terra
metadata_expire=6h
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-nobara-pubkey
       file:///etc/pki/rpm-gpg/RPM-GPG-KEY-nobara-rolling-pubkey
repo_gpgcheck=0
enabled=1
enabled_metadata=1
exclude=kernel* akmod-xone akmod-xpad-noone gamescope gamescope-session gamescope-session-steam flatpost inputplumber kmod-xone kmod-xpad-noone umu-launcher umu-launcher-debuginfo umu-launcher-debugsource v4l2loopback xone xpad-noone apparmor-debuginfo apparmor-debugsource apparmor-devel apparmor-libs apparmor-libs-debuginfo apparmor-parser apparmor-parser-debuginfo apparmor-profiles apparmor-utils apparmor-utils-debuginfo mod_apparmor mod_apparmor-debuginfo pam_apparmor pam_apparmor-debuginfo python3-apparmor python3-LibAppArmor python3-LibAppArmor-debuginfo xone-firmware powerbuttond
