From a70360f920e4441315b692891e6f524416559c37 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Thu, 2 Oct 2025 00:25:28 -0600
Subject: [PATCH 2/3] don't enable auto-scale by default

---
 inc/enum.h                           | 2 +-
 tst/cfg-file/load-invalid-file.log   | 2 +-
 tst/cfg-file/load-no-file.log        | 2 +-
 tst/cfg-file/load-valid-file.log     | 2 +-
 tst/cfg-file/reload-invalid-file.log | 2 +-
 tst/cfg-file/reload-valid-file.log   | 2 +-
 tst/info/print-cfg-all.log           | 2 +-
 tst/info/print-cfg-default.log       | 2 +-
 tst/yaml/cfg-default.yaml            | 2 +-
 tst/yaml/cfg-invalid.log             | 2 +-
 tst/yaml/cfg-mistyped.log            | 2 +-
 tst/yaml/ipc-request-cfg-invalid.log | 2 +-
 12 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/inc/enum.h b/inc/enum.h
index 8244c87..69d08ef 100644
--- a/inc/enum.h
+++ b/inc/enum.h
@@ -59,7 +59,7 @@ enum OnOff {
 	ON = 1,
 	OFF,
 	SCALING_DEFAULT = ON,
-	AUTO_SCALE_DEFAULT = ON,
+	AUTO_SCALE_DEFAULT = OFF,
 	LAPTOP_LID_MONITOR_DEFAULT = ON,
 };
 enum OnOff on_off_val(const char *name);
diff --git a/tst/cfg-file/load-invalid-file.log b/tst/cfg-file/load-invalid-file.log
index 35168cf..58cfd74 100644
--- a/tst/cfg-file/load-invalid-file.log
+++ b/tst/cfg-file/load-invalid-file.log
@@ -6,7 +6,7 @@ Using default configuration:
 Active configuration:
   Arrange in a ROW aligned at the TOP
   Scaling: ON
-  Auto scale: ON (dpi: 96, min: 1.000)
+  Auto scale: OFF (dpi: 96, min: 1.000)
   Round scales to: 0.125, NEAREST
   Disabled:
     !^eDP-[0-9]
diff --git a/tst/cfg-file/load-no-file.log b/tst/cfg-file/load-no-file.log
index c3a0b4e..9fb2c04 100644
--- a/tst/cfg-file/load-no-file.log
+++ b/tst/cfg-file/load-no-file.log
@@ -4,7 +4,7 @@ No configuration file found, using defaults:
 Active configuration:
   Arrange in a ROW aligned at the TOP
   Scaling: ON
-  Auto scale: ON (dpi: 96, min: 1.000)
+  Auto scale: OFF (dpi: 96, min: 1.000)
   Round scales to: 0.125, NEAREST
   Disabled:
     !^eDP-[0-9]
diff --git a/tst/cfg-file/load-valid-file.log b/tst/cfg-file/load-valid-file.log
index cc2cf29..50a985d 100644
