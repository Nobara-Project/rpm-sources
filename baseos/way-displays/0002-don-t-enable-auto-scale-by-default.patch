+++ b/tst/info/print-cfg-all.log
@@ -3,7 +3,7 @@
     first
     last
   Scaling: ON
-  Auto scale: ON (dpi: 96, min: 1.000)
+  Auto scale: OFF (dpi: 96, min: 1.000)
   Round scales to: 0.5, DOWN
   Scale:
     three: 3.000
diff --git a/tst/info/print-cfg-default.log b/tst/info/print-cfg-default.log
index 94a99c6..ae1d393 100644
--- a/tst/info/print-cfg-default.log
+++ b/tst/info/print-cfg-default.log
@@ -1,5 +1,5 @@
   Arrange in a ROW aligned at the TOP
   Scaling: ON
-  Auto scale: ON (min: 1.000)
+  Auto scale: OFF (min: 1.000)
   Callback command:
     notify-send "way-displays ${CALLBACK_LEVEL}" "${CALLBACK_MSG}"
diff --git a/tst/yaml/cfg-default.yaml b/tst/yaml/cfg-default.yaml
index 7ba6da0..edba92c 100644
--- a/tst/yaml/cfg-default.yaml
+++ b/tst/yaml/cfg-default.yaml
@@ -5,7 +5,7 @@ ORDER:
 SCALING: TRUE
 SCALE_ROUND_TO: 0.125
 SCALE_ROUND_STRATEGY: NEAREST
-AUTO_SCALE: TRUE
+AUTO_SCALE: FALSE
 AUTO_SCALE_DPI: 96
 AUTO_SCALE_MIN: 1
 AUTO_SCALE_MAX: -1
