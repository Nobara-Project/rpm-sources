 cfg-invalid.yaml: invalid SCALING BAD_SCALING, expected boolean, using default true
 cfg-invalid.yaml: invalid SCALE_ROUND_TO BAD_SCALE_ROUND_TO, expected number 0.125|0.25|0.5|1, using default 0.125
 cfg-invalid.yaml: invalid SCALE_ROUND_STRATEGY BAD_SCALE_ROUND_STRATEGY, expected enum NEAREST|UP|DOWN, using default NEAREST
-cfg-invalid.yaml: invalid AUTO_SCALE BAD_AUTO_SCALE, expected boolean, using default true
+cfg-invalid.yaml: invalid AUTO_SCALE BAD_AUTO_SCALE, expected boolean, using default false
 cfg-invalid.yaml: invalid AUTO_SCALE_DPI BAD_AUTO_SCALE_DPI, expected integer, using default 96
 cfg-invalid.yaml: invalid AUTO_SCALE_MIN BAD_AUTO_SCALE_MIN, expected number, using default 1.0
 cfg-invalid.yaml: invalid AUTO_SCALE_MAX BAD_AUTO_SCALE_MAX, expected number, using default -1.0
