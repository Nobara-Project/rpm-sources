From 1e90281c0dbc62ba3932548ea6a4cce60b52c4e0 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Thu, 2 Oct 2025 00:22:21 -0600
Subject: [PATCH 1/3] don't put XDG_VTNR in socket name

---
 src/sockets.c | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/src/sockets.c b/src/sockets.c
index 6506785..4fee04c 100644
--- a/src/sockets.c
+++ b/src/sockets.c
@@ -95,11 +95,7 @@ void socket_path(struct sockaddr_un *addr) {
 	size_t sun_path_size = sizeof(addr->sun_path);
 
 	char name[sun_path_size - 4];
-	if (getenv("XDG_VTNR")) {
-		snprintf(name, sizeof(name), "/way-displays.%s.sock", getenv("XDG_VTNR"));
-	} else {
 		snprintf(name, sizeof(name), "/way-displays.sock");
-	}
 
 	if (!getenv("XDG_RUNTIME_DIR") || strlen(name) + strlen(getenv("XDG_RUNTIME_DIR")) > sun_path_size) {
 		snprintf(addr->sun_path, sun_path_size, "/tmp%s", name);
-- 
2.55.0

