#!/usr/bin/bash
#
# Installed by nobara-eac as /etc/kernel/install.d/40-dkms.install, which kernel-install
# runs instead of /usr/lib/kernel/install.d/40-dkms.install (from dkms).
#
# The Easy Anti-Cheat kernel (kernel-eac) has no development files and loads
# only Nobara-signed modules (the kmod-*-signed-<kernel> packages), so dkms
# has nothing to build for it: skip it there instead of failing. Every
# other kernel runs dkms's own plugin, unchanged.

[[ "$2" == *.eac.* ]] && exit 0
plugin=/usr/lib/kernel/install.d/40-dkms.install
[[ -x "$plugin" ]] || exit 0
exec "$plugin" "$@"
