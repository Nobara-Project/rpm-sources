[Unit]
Description=Update the Easy Anti-Cheat boot entries and default
Documentation=file:///etc/sysconfig/nobara-eac
# Secure Boot, the enrolled MOKs and the signed modules can change between
# boots. The Nobara updater confirms its update first and sets the default
# itself; this only changes it afterwards.
After=local-fs.target nobara-updater-confirm.service
ConditionPathIsDirectory=/boot/loader/entries

[Service]
Type=oneshot
ExecStart=/usr/lib/kernel/install.d/95-nobara-eac.install apply-all

[Install]
WantedBy=multi-user.target
