# Easy Anti-Cheat Linux v2 boot entries
#
# Every kernel gets two GRUB entries: one with the kernel command line
# Easy Anti-Cheat Linux v2 requires and one without it. EAC_DEFAULT selects
# which one is the default:
#   auto - EAC when Secure Boot is enabled (EAC cannot pass without it)
#   yes  - always EAC
#   no   - never EAC
#
# Apply a change to the installed kernels with:
#   sudo /usr/lib/kernel/install.d/95-nobara-eac.install apply-all
EAC_DEFAULT=auto
