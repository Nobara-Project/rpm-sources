+/* The split whose divider is this tile's left/top (before) or right/bottom
+ * (after) edge. */
+static struct tile *edge_split(struct tile *t, bool vertical, bool after) {
+    for (; t->parent; t = t->parent) {
+        struct tile *p = t->parent;
+        if (p->vertical == vertical && (after ? p->a : p->b) == t && count(p->a) && count(p->b)) return p;
+    }
+    return NULL;
+}
+static void move_divider(struct tile *p, int edge, bool after) {
+    int start = p->vertical ? p->box.y : p->box.x;
+    int total = p->vertical ? p->box.height : p->box.width;
+    int gap = fmin(rc.gap, fmax(0, total - 2));
+    int extent = total - gap;
+    if (extent <= 0) return;
+    int first = after ? edge - start : edge - start - gap;
+    p->ratio = fmax(.05, fmin(.95, (double)first / extent));
+}
+/* Mouse resize of a tile moves the divider under the dragged edge, and the
+ * neighbouring tiles follow while the pointer moves. */
+bool tiling_resize_motion(struct view *v, double dx, double dy) {
+    struct record *r = initialized ? tile_owner(record_for(v)) : NULL;
+    if (!enabled || !r || !r->tile || special(v) || r->tile->layout->scrolling) return false;
+    struct border margin = ssd_get_margin(v->ssd);
+    struct wlr_box grab = server.grab_box;
+    enum lab_edge edges = server.resize_edges;
+    struct tile *p;
+    if ((edges & LAB_EDGE_LEFT) && (p = edge_split(r->tile, false, false)))
+        move_divider(p, grab.x - margin.left + (int)dx, false);
+    else if ((edges & LAB_EDGE_RIGHT) && (p = edge_split(r->tile, false, true)))
+        move_divider(p, grab.x + grab.width + margin.right + (int)dx, true);
+    if ((edges & LAB_EDGE_TOP) && (p = edge_split(r->tile, true, false)))
+        move_divider(p, grab.y - margin.top + (int)dy, false);
+    else if ((edges & LAB_EDGE_BOTTOM) && (p = edge_split(r->tile, true, true)))
+        move_divider(p, grab.y + grab.height + margin.bottom + (int)dy, true);
+    struct layout *l = r->tile->layout;
+    struct wlr_box area;
+    if (layout_area(l, &area)) split_layout(l->root, area, true);
+    return true;
+}
+/* The split whose gap between its two halves contains (x, y). */
+static struct tile *divider_in(struct tile *t, double x, double y) {
+    if (!t || t->view || !count(t)) return NULL;
+    if (!count(t->a)) return divider_in(t->b, x, y);
+    if (!count(t->b)) return divider_in(t->a, x, y);
+    struct wlr_box a = t->a->box, b = t->b->box, gap = t->box;
+    if (t->vertical) { gap.y = a.y + a.height; gap.height = b.y - gap.y; }
+    else { gap.x = a.x + a.width; gap.width = b.x - gap.x; }
+    if (!wlr_box_empty(&gap) && wlr_box_contains_point(&gap, x, y)) return t;
+    struct tile *inner = divider_in(t->a, x, y);
+    return inner ? inner : divider_in(t->b, x, y);
+}
+static struct tile *divider_at(double x, double y) {
+    if (!initialized || !enabled || rc.gap <= 0
+        || (server.session_lock_manager && server.session_lock_manager->locked)) return NULL;
+    struct layout *l;
+    wl_list_for_each(l, &layouts, link) {
+        if (l->scrolling || l->workspace != server.workspaces.current || !output_is_usable(l->output)) continue;
+        struct wlr_box area = output_usable_area_in_layout_coords(l->output);
+        if (!wlr_box_contains_point(&area, x, y)) continue;
+        return divider_in(l->root, x, y);
+    }
+    return NULL;
+}
+static struct tile *leaf_at(struct tile *t, double x, double y) {
+    if (!t || !count(t)) return NULL;
+    if (t->view) return wlr_box_contains_point(&t->box, x, y) ? t : NULL;
+    struct tile *a = leaf_at(t->a, x, y);
+    return a ? a : leaf_at(t->b, x, y);
+}
+/* The gap between two tiles is a handle for the divider there. */
+enum lab_edge tiling_divider_edge(double x, double y) {
+    struct tile *p = divider_at(x, y);
+    return !p ? LAB_EDGE_NONE : p->vertical ? LAB_EDGE_BOTTOM : LAB_EDGE_RIGHT;
+}
+bool tiling_begin_divider_drag(double x, double y) {
+    if (server.input_mode != LAB_INPUT_STATE_PASSTHROUGH) return false;
+    struct tile *p = divider_at(x, y);
+    if (!p) return false;
+    struct wlr_box a = p->a->box;
+    struct tile *leaf = p->vertical ? leaf_at(p->a, x, a.y + a.height - 1) : leaf_at(p->a, a.x + a.width - 1, y);
+    struct record *r = leaf ? group_visible(record_for(leaf->view)) : NULL;
+    if (!r) return false;
+    struct view *v = r->view;
+    enum lab_edge edges = p->vertical ? LAB_EDGE_BOTTOM : LAB_EDGE_RIGHT;
+    server.grabbed_view = v;
+    server.grabbed_view_snap_to_output = false;
+    server.grab_x = x; server.grab_y = y;
+    server.grab_box = v->current;
+    server.resize_edges = edges;
+    interactive_begin(v, LAB_INPUT_STATE_RESIZE, edges);
+    if (server.input_mode == LAB_INPUT_STATE_RESIZE) return true;
+    server.grabbed_view = NULL;
+    return false;
+}
 bool tiling_drag_finish(struct view *v) {
     struct record *r = initialized ? record_for(v) : NULL;
     if (!enabled || !r || !r->tile || special(v)) return false;
     if (server.input_mode == LAB_INPUT_STATE_RESIZE) {
-        resize_tile(r, false, v->pending.width - server.grab_box.width);
-        resize_tile(r, true, v->pending.height - server.grab_box.height);
+        /* Split tiles were resized live (tiling_resize_motion). */
+        if (r->tile->layout->scrolling)
+            resize_tile(r, false, v->pending.width - server.grab_box.width);
     } else {
         struct output *output = output_nearest_to_cursor();
         if (output_is_usable(output) && output != v->output) { detach(r); view_set_output(v, output); }
