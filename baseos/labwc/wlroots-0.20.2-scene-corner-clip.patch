+// Pixel regression for wlr_scene_tree_set_corner_clip().
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wlr/backend/headless.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/drm_format_set.h>
+#include <wlr/render/pixman.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/util/log.h>
+#include "render/allocator/shm.h"
+
+#define WIDTH 96
+#define HEIGHT 96
+#define RED 0xff0000
+#define GREEN 0x00ff00
+
+static uint32_t pixels[WIDTH * HEIGHT];
+
+static struct wlr_buffer *opaque_red(struct wlr_allocator *allocator, int width, int height) {
+	uint64_t modifier = DRM_FORMAT_MOD_LINEAR;
+	struct wlr_drm_format format = {
+		.format = DRM_FORMAT_XRGB8888, .len = 1, .modifiers = &modifier,
+	};
+	struct wlr_buffer *buffer = wlr_allocator_create_buffer(allocator, width, height, &format);
+	assert(buffer);
+	void *data;
+	uint32_t fourcc;
+	size_t stride;
+	assert(wlr_buffer_begin_data_ptr_access(buffer, WLR_BUFFER_DATA_PTR_ACCESS_WRITE,
+		&data, &fourcc, &stride));
+	for (int y = 0; y < height; y++) {
+		uint32_t *row = (uint32_t *)((char *)data + stride * y);
+		for (int x = 0; x < width; x++) {
+			row[x] = 0xffff0000;
+		}
+	}
+	wlr_buffer_end_data_ptr_access(buffer);
+	return buffer;
+}
+
+static void render(struct wlr_scene_output *scene_output) {
+	struct wlr_output_state state;
+	wlr_output_state_init(&state);
+	assert(wlr_scene_output_build_state(scene_output, &state, NULL));
+	struct wlr_texture *texture = wlr_texture_from_buffer(scene_output->output->renderer,
+		state.buffer);
+	assert(texture);
+	assert(wlr_texture_read_pixels(texture, &(struct wlr_texture_read_pixels_options){
+		.data = pixels, .format = DRM_FORMAT_ARGB8888, .stride = WIDTH * 4,
+	}));
+	wlr_texture_destroy(texture);
+	assert(wlr_output_commit_state(scene_output->output, &state));
+	wlr_output_state_finish(&state);
+}
+
+static uint32_t rgb(int x, int y) {
+	return pixels[y * WIDTH + x] & 0xffffff;
+}
+
+// A blend of the window over the backdrop, not either color alone.
+static bool blended(int x, int y) {
+	uint32_t color = rgb(x, y);
+	uint32_t red = color >> 16 & 0xff, green = color >> 8 & 0xff;
+	return red > 0 && green > 0 && (color & 0xff) == 0;
+}
+
+int main(void) {
+	wlr_log_init(WLR_ERROR, NULL);
+	struct wl_display *display = wl_display_create();
+	struct wlr_backend *backend = wlr_headless_backend_create(wl_display_get_event_loop(display));
+	assert(backend);
+	struct wlr_renderer *renderer = getenv("WLR_RENDERER") ?
+		wlr_renderer_autocreate(backend) : wlr_pixman_renderer_create();
+	assert(renderer);
+	struct wlr_allocator *allocator = wlr_allocator_autocreate(backend, renderer);
+	struct wlr_allocator *source_allocator = wlr_shm_allocator_create();
+	assert(allocator && source_allocator);
+	struct wlr_output *output = wlr_headless_add_output(backend, WIDTH, HEIGHT);
+	assert(output && wlr_output_init_render(output, allocator, renderer));
+	assert(wlr_backend_start(backend));
+	struct wlr_output_state initial;
+	wlr_output_state_init(&initial);
+	wlr_output_state_set_enabled(&initial, true);
+	assert(wlr_output_commit_state(output, &initial));
+	wlr_output_state_finish(&initial);
+
+	struct wlr_scene *scene = wlr_scene_create();
+	struct wlr_scene_output *scene_output = wlr_scene_output_create(scene, output);
+	const float green[] = {0, 1, 0, 1};
+	wlr_scene_rect_create(&scene->tree, WIDTH, HEIGHT, green);
+
+	struct wlr_scene_tree *window = wlr_scene_tree_create(&scene->tree);
+	wlr_scene_node_set_position(&window->node, 16, 16);
+	struct wlr_buffer *image = opaque_red(source_allocator, 64, 64);
+	struct wlr_scene_buffer *content = wlr_scene_buffer_create(window, image);
+
+	// Without a clip: a plain opaque square.
+	render(scene_output);
+	assert(rgb(16, 16) == RED && rgb(79, 79) == RED && rgb(15, 16) == GREEN);
+
+	// All corners: cut, with what lies below showing through. The opaque
+	// window must not have culled it.
+	struct wlr_box box = {0, 0, 64, 64};
+	wlr_scene_tree_set_corner_clip(window, &box, 12, WLR_SCENE_CORNER_ALL);
+	render(scene_output);
+	int corners[4][2] = {{16, 16}, {79, 16}, {16, 79}, {79, 79}};
+	for (int i = 0; i < 4; i++) {
+		assert(rgb(corners[i][0], corners[i][1]) == GREEN);
+	}
+	// Edges and interior stay; only corners change.
+	assert(rgb(48, 16) == RED && rgb(16, 48) == RED && rgb(79, 48) == RED && rgb(48, 79) == RED);
+	assert(rgb(48, 48) == RED);
+	// Just inside the arc is whole, the arc itself antialiased, on every corner.
+	int blends = 0;
+	for (int i = 0; i < 12; i++) {
+		blends += blended(16 + i, 16 + i) + blended(79 - i, 16 + i)
+			+ blended(16 + i, 79 - i) + blended(79 - i, 79 - i);
+	}
+	assert(blends >= 4);
+	assert(rgb(16 + 8, 16 + 8) == RED);
+
+	// The opaque shortcut of a later frame must not bring corners back.
+	wlr_scene_node_set_position(&content->node, 0, 0);
+	wlr_scene_buffer_set_opacity(content, 1);
+	render(scene_output);
+	assert(rgb(16, 16) == GREEN);
+
+	// The clip moves with its tree, and what it revealed goes with it.
+	wlr_scene_node_set_position(&window->node, 20, 20);
+	render(scene_output);
+	assert(rgb(20, 20) == GREEN && rgb(16, 16) == GREEN && rgb(48, 20) == RED);
+	wlr_scene_node_set_position(&window->node, 16, 16);
+
+	// Only the requested corners change.
+	wlr_scene_tree_set_corner_clip(window, &box,
+		12, WLR_SCENE_CORNER_BOTTOM_LEFT | WLR_SCENE_CORNER_BOTTOM_RIGHT);
+	render(scene_output);
+	assert(rgb(16, 16) == RED && rgb(79, 16) == RED);
+	assert(rgb(16, 79) == GREEN && rgb(79, 79) == GREEN);
+
+	// Rectangles below the tree are cut too, a box larger than the content is
+	// respected, and content outside it is left alone.
+	const float red[] = {1, 0, 0, 1};
+	struct wlr_scene_rect *border = wlr_scene_rect_create(window, 4, 4, red);
+	wlr_scene_node_set_position(&border->node, 0, 60);
+	struct wlr_box outer = {-1, -1, 66, 66};
+	wlr_scene_tree_set_corner_clip(window, &outer, 13, WLR_SCENE_CORNER_ALL);
+	render(scene_output);
+	assert(rgb(16, 79) == GREEN && rgb(48, 16) == RED);
+	wlr_scene_node_destroy(&border->node);
+
+	// Disabling restores the square, with damage over the old corners.
+	wlr_scene_tree_set_corner_clip(window, NULL, 0, 0);
+	render(scene_output);
+	assert(rgb(16, 16) == RED && rgb(79, 79) == RED);
+
+	wlr_scene_output_destroy(scene_output);
+	wlr_buffer_drop(image);
+	puts("corner clip: cut, blend, move, select, rect and restore checks passed");
+	return 0;
+}
