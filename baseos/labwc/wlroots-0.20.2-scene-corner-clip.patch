+#define SCENE_CORNER_LEVELS 8
+
+/**
+ * The part of a node's render region inside clipped corners, in buffer
+ * coordinates: inner is drawn as usual, levels[k] at (k + 1) / LEVELS alpha,
+ * and everything else in the corners not at all.
+ */
+struct scene_corner_mask {
+	bool active;
+	pixman_region32_t inner;
+	pixman_region32_t levels[SCENE_CORNER_LEVELS];
+};
+
+/**
+ * Coverage of each pixel of a top-left corner of the given radius, in
+ * SCENE_CORNER_LEVELS steps. Outputs share a scale in nearly all setups, so
+ * one cached table is enough.
+ */
+static const uint8_t *scene_corner_coverage(int radius) {
+	static uint8_t *table = NULL;
+	static int table_radius = 0;
+	if (table_radius == radius) {
+		return table;
+	}
+	uint8_t *resized = realloc(table, (size_t)radius * radius);
+	if (resized == NULL) {
+		return NULL;
+	}
+	table = resized;
+	table_radius = radius;
+
+	const int samples = 4;
+	int limit = radius * samples * 2;
+	for (int py = 0; py < radius; py++) {
+		for (int px = 0; px < radius; px++) {
+			int inside = 0;
+			for (int sy = 0; sy < samples; sy++) {
+				for (int sx = 0; sx < samples; sx++) {
+					// Doubled sample positions keep this in integers.
+					int dx = limit - (px * samples * 2 + sx * 2 + 1);
+					int dy = limit - (py * samples * 2 + sy * 2 + 1);
+					inside += dx * dx + dy * dy <= limit * limit;
+				}
+			}
+			table[py * radius + px] = (inside * SCENE_CORNER_LEVELS +
+				samples * samples / 2) / (samples * samples);
+		}
+	}
+	return table;
+}
+
+static void scene_corner_mask_add(struct scene_corner_mask *mask, const uint8_t *coverage,
+		int radius, int origin_x, int origin_y, bool mirror_x, bool mirror_y) {
+	for (int py = 0; py < radius; py++) {
+		int row = mirror_y ? origin_y - py - 1 : origin_y + py;
+		int run_start = 0;
+		for (int px = 1; px <= radius; px++) {
+			uint8_t level = coverage[py * radius + run_start];
+			if (px < radius && coverage[py * radius + px] == level) {
+				continue;
+			}
+			if (level > 0) {
+				int run = px - run_start;
+				int column = mirror_x ? origin_x - px : origin_x + run_start;
+				pixman_region32_union_rect(&mask->levels[level - 1],
+					&mask->levels[level - 1], column, row, run, 1);
+			}
+			run_start = px;
+		}
+	}
+}
+
+static void scene_corner_mask_init(struct scene_corner_mask *mask,
+		const struct wlr_scene_node *node, int x, int y,
+		const pixman_region32_t *render_region, const struct render_data *data) {
+	mask->active = false;
+
+	struct wlr_box box;
+	int logical_radius;
+	uint32_t corners;
+	if (!scene_node_corner_clip(node, &box, &logical_radius, &corners)) {
+		return;
+	}
+
+	int left = round((x + box.x) * data->scale);
+	int top = round((y + box.y) * data->scale);
+	int right = round((x + box.x + box.width) * data->scale);
+	int bottom = round((y + box.y + box.height) * data->scale);
+	int radius = MIN(round(logical_radius * data->scale),
+		MIN(right - left, bottom - top) / 2);
+	const uint8_t *coverage = radius > 0 ? scene_corner_coverage(radius) : NULL;
+	if (coverage == NULL) {
+		return;
+	}
+
+	enum wl_output_transform transform = wlr_output_transform_invert(data->transform);
+	pixman_region32_t square;
+	pixman_region32_init(&square);
+	if (corners & WLR_SCENE_CORNER_TOP_LEFT) {
+		pixman_region32_union_rect(&square, &square, left, top, radius, radius);
+	}
+	if (corners & WLR_SCENE_CORNER_TOP_RIGHT) {
+		pixman_region32_union_rect(&square, &square, right - radius, top, radius, radius);
+	}
+	if (corners & WLR_SCENE_CORNER_BOTTOM_RIGHT) {
+		pixman_region32_union_rect(&square, &square,
+			right - radius, bottom - radius, radius, radius);
+	}
+	if (corners & WLR_SCENE_CORNER_BOTTOM_LEFT) {
+		pixman_region32_union_rect(&square, &square, left, bottom - radius, radius, radius);
+	}
+	wlr_region_transform(&square, &square, transform, data->trans_width, data->trans_height);
+
+	pixman_region32_t touched;
+	pixman_region32_init(&touched);
+	pixman_region32_intersect(&touched, &square, render_region);
+	bool visible = !pixman_region32_empty(&touched);
+	pixman_region32_fini(&touched);
+	if (!visible) {
+		// Nothing is drawn in the corners: most frames of a focused window.
+		pixman_region32_fini(&square);
+		return;
+	}
+
+	mask->active = true;
+	pixman_region32_init(&mask->inner);
+	pixman_region32_subtract(&mask->inner, render_region, &square);
+	pixman_region32_fini(&square);
+	for (int i = 0; i < SCENE_CORNER_LEVELS; i++) {
+		pixman_region32_init(&mask->levels[i]);
+	}
+	if (corners & WLR_SCENE_CORNER_TOP_LEFT) {
+		scene_corner_mask_add(mask, coverage, radius, left, top, false, false);
+	}
+	if (corners & WLR_SCENE_CORNER_TOP_RIGHT) {
+		scene_corner_mask_add(mask, coverage, radius, right, top, true, false);
+	}
+	if (corners & WLR_SCENE_CORNER_BOTTOM_RIGHT) {
+		scene_corner_mask_add(mask, coverage, radius, right, bottom, true, true);
+	}
+	if (corners & WLR_SCENE_CORNER_BOTTOM_LEFT) {
+		scene_corner_mask_add(mask, coverage, radius, left, bottom, false, true);
+	}
+	for (int i = 0; i < SCENE_CORNER_LEVELS; i++) {
+		wlr_region_transform(&mask->levels[i], &mask->levels[i], transform,
+			data->trans_width, data->trans_height);
+		pixman_region32_intersect(&mask->levels[i], &mask->levels[i], render_region);
+	}
+}
+
+static void scene_corner_mask_finish(struct scene_corner_mask *mask) {
+	if (!mask->active) {
+		return;
+	}
+	pixman_region32_fini(&mask->inner);
+	for (int i = 0; i < SCENE_CORNER_LEVELS; i++) {
+		pixman_region32_fini(&mask->levels[i]);
+	}
+}
+
+static void scene_render_rect(struct wlr_render_pass *pass,
+		const struct wlr_render_rect_options *options,
+		const struct scene_corner_mask *mask) {
+	if (!mask->active) {
+		wlr_render_pass_add_rect(pass, options);
+		return;
+	}
+	struct wlr_render_rect_options part = *options;
+	part.clip = &mask->inner;
+	if (!pixman_region32_empty(&mask->inner)) {
+		wlr_render_pass_add_rect(pass, &part);
+	}
+	for (int i = 0; i < SCENE_CORNER_LEVELS; i++) {
+		if (pixman_region32_empty(&mask->levels[i])) {
+			continue;
+		}
+		float alpha = (float)(i + 1) / SCENE_CORNER_LEVELS;
+		part.clip = &mask->levels[i];
+		part.color.r = options->color.r * alpha;
+		part.color.g = options->color.g * alpha;
+		part.color.b = options->color.b * alpha;
+		part.color.a = options->color.a * alpha;
+		part.blend_mode = WLR_RENDER_BLEND_MODE_PREMULTIPLIED;
+		wlr_render_pass_add_rect(pass, &part);
+	}
+}
+
+static void scene_render_texture(struct wlr_render_pass *pass,
+		const struct wlr_render_texture_options *options,
+		const struct scene_corner_mask *mask) {
+	if (!mask->active) {
+		wlr_render_pass_add_texture(pass, options);
+		return;
+	}
