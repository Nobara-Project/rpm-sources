+void wlr_scene_tree_set_corner_clip(struct wlr_scene_tree *tree,
+		const struct wlr_box *box, int radius, uint32_t corners) {
+	radius = box != NULL ? MAX(radius, 0) : 0;
+	struct wlr_box clip = radius > 0 && corners != 0 ? *box : (struct wlr_box){0};
+	if (clip.width <= 0 || clip.height <= 0) {
