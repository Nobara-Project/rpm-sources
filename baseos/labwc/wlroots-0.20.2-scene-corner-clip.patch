+static bool scene_node_corner_clip(const struct wlr_scene_node *node,
+		struct wlr_box *box, int *radius, uint32_t *corners) {
+	int x = node->x, y = node->y;
+	for (const struct wlr_scene_tree *tree = node->parent; tree != NULL;
+			tree = tree->node.parent) {
+		if (tree->corner_clip.radius > 0 && tree->corner_clip.corners != 0) {
+			*box = tree->corner_clip.box;
+			box->x -= x;
+			box->y -= y;
+			*radius = MIN(tree->corner_clip.radius,
+				MIN(box->width, box->height) / 2);
+			*corners = tree->corner_clip.corners;
+			return *radius > 0;
+		}
+		x += tree->node.x;
+		y += tree->node.y;
+	}
+	return false;
+}
