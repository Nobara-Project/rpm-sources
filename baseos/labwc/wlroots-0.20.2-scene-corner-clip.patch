+	if (tree->corner_clip.radius == radius && tree->corner_clip.corners == corners &&
+			wlr_box_equal(&tree->corner_clip.box, &clip)) {
+		return;
+	}
+	tree->corner_clip.box = clip;
+	tree->corner_clip.radius = radius;
+	tree->corner_clip.corners = corners;
+	scene_node_update(&tree->node, NULL);
