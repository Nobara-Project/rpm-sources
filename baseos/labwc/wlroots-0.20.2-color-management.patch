+struct icc_creator {
+	struct wlr_color_manager_v1 *manager;
+	char *data;
+	uint32_t size;
+	bool set, io_failed;
+};
+static void icc_creator_destroy(struct wl_resource *resource) {
+	struct icc_creator *creator = wl_resource_get_user_data(resource);
+	free(creator->data);
+	free(creator);
+}
+static void icc_creator_set_file(struct wl_client *client, struct wl_resource *resource,
+		int32_t fd, uint32_t offset, uint32_t length) {
+	struct icc_creator *creator = wl_resource_get_user_data(resource);
+	struct stat st;
+	int flags = fcntl(fd, F_GETFL);
+	if (creator->set) {
+		wl_resource_post_error(resource, WP_IMAGE_DESCRIPTION_CREATOR_ICC_V1_ERROR_ALREADY_SET,
+			"ICC file already set");
+	} else if (length == 0 || length > 32 * 1024 * 1024) {
+		wl_resource_post_error(resource, WP_IMAGE_DESCRIPTION_CREATOR_ICC_V1_ERROR_BAD_SIZE,
+			"ICC profile size must be between 1 and 32 MiB");
+	} else if (flags < 0 || (flags & O_ACCMODE) == O_WRONLY || fstat(fd, &st)
+			|| !S_ISREG(st.st_mode)) {
+		wl_resource_post_error(resource, WP_IMAGE_DESCRIPTION_CREATOR_ICC_V1_ERROR_BAD_FD,
+			"ICC file must be readable and seekable");
+	} else if ((uint64_t)offset + length > (uint64_t)st.st_size) {
+		wl_resource_post_error(resource, WP_IMAGE_DESCRIPTION_CREATOR_ICC_V1_ERROR_OUT_OF_FILE,
+			"ICC range exceeds file size");
+	} else {
+		creator->set = true;
+		creator->size = length;
+		creator->data = malloc(length);
+		if (!creator->data) {
+			wl_resource_post_no_memory(resource);
+		} else {
+			size_t pos = 0;
+			while (pos < length) {
+				ssize_t n = pread(fd, creator->data + pos, length - pos, (off_t)offset + pos);
+				if (n < 0 && errno == EINTR) {
+					continue;
+				}
+				if (n <= 0) {
+					creator->io_failed = true;
+					break;
+				}
+				pos += n;
+			}
+		}
+	}
+	close(fd);
+}
+static void icc_creator_create(struct wl_client *client, struct wl_resource *resource, uint32_t id) {
+	struct icc_creator *creator = wl_resource_get_user_data(resource);
+	if (!creator->set) {
+		wl_resource_post_error(resource, WP_IMAGE_DESCRIPTION_CREATOR_ICC_V1_ERROR_INCOMPLETE_SET,
+			"ICC profile was not set");
+		return;
+	}
+	struct wlr_color_transform *transform = creator->io_failed ? NULL :
+		wlr_color_transform_init_icc_to_linear(creator->data, creator->size);
+	if (transform) {
+		struct wlr_image_description_v1_data data = {.icc = transform};
+		image_desc_create_ready(creator->manager, resource, id, &data, false);
+		wlr_color_transform_unref(transform);
+	} else {
+		image_desc_create_failed(resource, id, creator->io_failed
+			? WP_IMAGE_DESCRIPTION_V1_CAUSE_OPERATING_SYSTEM : WP_IMAGE_DESCRIPTION_V1_CAUSE_UNSUPPORTED,
+			"Cannot read or convert ICC profile");
+	}
+	wl_resource_destroy(resource);
+}
+static const struct wp_image_description_creator_icc_v1_interface icc_creator_impl = {
+	.set_icc_file = icc_creator_set_file, .create = icc_creator_create,
+};
