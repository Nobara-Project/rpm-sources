+int main(int argc, char **argv) {
+	setbuf(stdout, NULL);
+	wlr_log_init(WLR_ERROR, NULL);
+	if (argc == 2 && strncmp(argv[1], "--", 2)) {
+		cmsHPROFILE profile = make_profile(true);
+		assert(cmsSaveProfileToFile(profile, argv[1]));
+		cmsCloseProfile(profile);
+		return 0;
+	}
