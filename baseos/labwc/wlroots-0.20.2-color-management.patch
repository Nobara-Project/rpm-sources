+#include <wlr/util/log.h>
+#include "render/allocator/shm.h"
+#include "render/color.h"
+
+#define WIDTH 64
+#define HEIGHT 8
+
+static cmsHPROFILE make_profile(bool p3) {
+	cmsHPROFILE srgb = cmsCreate_sRGBProfile();
+	if (!p3) {
+		return srgb;
+	}
+	cmsCIExyY white = {0.3127, 0.3290, 1};
+	cmsCIExyYTRIPLE primaries = {
+		.Red = {0.680, 0.320, 1}, .Green = {0.265, 0.690, 1}, .Blue = {0.150, 0.060, 1},
+	};
+	cmsToneCurve *curves[3] = {
+		cmsReadTag(srgb, cmsSigRedTRCTag), cmsReadTag(srgb, cmsSigGreenTRCTag),
+		cmsReadTag(srgb, cmsSigBlueTRCTag),
+	};
+	cmsHPROFILE profile = cmsCreateRGBProfile(&white, &primaries, curves);
+	cmsCloseProfile(srgb);
+	assert(profile);
+	return profile;
+}
+
+static struct wlr_color_transform *icc_transform(cmsHPROFILE profile, bool input) {
+	cmsUInt32Number size = 0;
+	assert(cmsSaveProfileToMem(profile, NULL, &size));
+	void *data = malloc(size);
+	assert(cmsSaveProfileToMem(profile, data, &size));
+	struct wlr_color_transform *transform = input ? wlr_color_transform_init_icc_to_linear(data, size)
+		: wlr_color_transform_init_linear_to_icc(data, size);
+	free(data);
+	assert(transform);
+	return transform;
+}
+
+static unsigned char pixel_value(int x, int y, int c) {
+	if (y == 0) {
+		return (x * 255) / (WIDTH - 1); // Neutral ramp including dark values.
+	}
+	if (x < 8) {
+		return x & (1 << c) ? 255 : 0; // Cube corners, saturated wide-gamut colors.
+	}
+	return (x * (37 + c * 20) + y * (11 + c * 26)) % 256;
+}
+
+static double encode_pq(double nits) {
+	double p = pow(nits / 10000, 2610.0 / 16384);
+	return pow((3424.0 / 4096 + 2413.0 / 128 * p) / (1 + 2392.0 / 128 * p), 2523.0 / 32);
+}
