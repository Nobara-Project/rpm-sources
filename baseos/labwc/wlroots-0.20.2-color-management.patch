+	float outside[] = {-1, 2, 0.5}, clamped[3];
+	wlr_color_transform_eval(lut, clamped, outside);
+	assert(clamped[0] == 0 && clamped[1] == 1 && clamped[2] == 0.5);
+	struct wlr_color_transform *nested = wlr_color_transform_init_pipeline(&lut, 1);
+	struct wlr_color_transform *steps[] = {nested, lut}, *composed = NULL;
+	assert(color_transform_compose(&composed, steps, 2));
+	wlr_color_transform_eval(composed, clamped, outside);
+	assert(clamped[0] == 0 && clamped[1] == 1 && clamped[2] == 0.5);
+	wlr_color_transform_unref(composed);
+	wlr_color_transform_unref(nested);
