 	struct wlr_xwayland_surface_configure_event *event = data;
 	bool ignore_configure_requests = window_rules_get_property(
 		view, "ignoreConfigureRequest") == LAB_PROP_TRUE;
+
+	if (event->mask & (XCB_CONFIG_WINDOW_X | XCB_CONFIG_WINDOW_Y)) {
+		xwayland_view->fullscreen_request_from_output = 0;
+		/* Unspecified fields come from pending, which is newer than the
+		 * X surface geometry while ConfigureNotify replies are in flight. */
+		struct wlr_box requested = {
+			.x = event->mask & XCB_CONFIG_WINDOW_X ? event->x : view->pending.x,
+			.y = event->mask & XCB_CONFIG_WINDOW_Y ? event->y : view->pending.y,
+			.width = event->mask & XCB_CONFIG_WINDOW_WIDTH ? event->width : view->pending.width,
+			.height = event->mask & XCB_CONFIG_WINDOW_HEIGHT ? event->height : view->pending.height,
+		};
+		if (!ignore_configure_requests && view->fullscreen) {
+			struct output *output = output_for_client_geometry(&requested);
+			if (output && output != view->output) {
+				/* Fullscreen may arrive before Wine's placement request.
+				 * Change the output, but retain compositor fullscreen size. */
+				view_move_to_output(view, output);
+				return;
+			}
+		} else if (!ignore_configure_requests && tiling_is_managed(view)
+				&& view->maximized == VIEW_AXIS_NONE && output_is_usable(view->output)) {
+			/* A game can ask to move before requesting fullscreen. Keep
+			 * that destination without letting a normal window escape its tile. */
