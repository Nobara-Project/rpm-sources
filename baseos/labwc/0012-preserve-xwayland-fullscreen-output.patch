+/* Pick an actual output, not the nearest monitor to an offscreen request. */
+static struct output *
+output_for_client_geometry(const struct wlr_box *box)
+{
+	struct wlr_output *wlr_output = wlr_output_layout_output_at(
+		server.output_layout, box->x + box->width / 2.0,
+		box->y + box->height / 2.0);
+	struct output *output = wlr_output ? output_from_wlr_output(wlr_output) : NULL;
+	return output_is_usable(output) ? output : NULL;
+}
