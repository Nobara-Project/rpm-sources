+    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL
+    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+    DEALINGS IN THE SOFTWARE.
+  </copyright>
+  <interface name="waydock_blur_manager_v1" version="1">
+    <description summary="optional blur radius policy for desktop clients">
+      This extension selects a per-surface blur radius for the standard
+      ext-background-effect-v1 protocol. It does not enable blur or define
+      a blur region by itself. The standard manager's blur capability still
+      determines whether the compositor can apply background blur.
+    </description>
+    <request name="destroy" type="destructor"/>
+    <enum name="error">
+      <entry name="surface_exists" value="0" summary="surface already has a blur radius object"/>
+    </enum>
+    <request name="get_surface">
+      <arg name="id" type="new_id" interface="waydock_blur_surface_v1"/>
+      <arg name="surface" type="object" interface="wl_surface"/>
+    </request>
+  </interface>
+  <interface name="waydock_blur_surface_v1" version="1">
+    <description summary="double-buffered blur radius for a surface">
+      The initial radius is 10 logical surface pixels. State takes effect on
+      wl_surface.commit, including synchronization of subsurfaces. This object
+      may be created before or after the standard background effect object.
+      Without a non-empty standard blur region it has no visual effect.
+    </description>
+    <request name="destroy" type="destructor">
+      <description summary="restore the default radius on the next commit">
+        This request restores radius 10 on the next wl_surface.commit.
+        It does not change the standard background effect object's region.
+      </description>
+    </request>
+    <enum name="error">
+      <entry name="surface_destroyed" value="0" summary="the associated surface has been destroyed"/>
+      <entry name="invalid_radius" value="1" summary="radius exceeds 40 logical pixels"/>
+    </enum>
+    <request name="set_radius">
+      <description summary="set pending radius in logical pixels">
+        Valid values are 0 through 40, inclusive. Zero suppresses blur without
+        changing the standard background effect region. The region and radius
+        are applied together at the next surface commit. Requests after the
+        associated surface has been destroyed raise surface_destroyed.
+      </description>
+      <arg name="radius" type="uint"/>
+    </request>
+  </interface>
+</protocol>
