+#ifndef LABWC_BACKGROUND_BLUR_H
+#define LABWC_BACKGROUND_BLUR_H
+
+/* Opt-in ext-background-effect-v1 blur, never inferred from application IDs. */
+void background_blur_init(void);
+void background_blur_update_capabilities(void);
+void background_blur_finish(void);
+
+#endif
