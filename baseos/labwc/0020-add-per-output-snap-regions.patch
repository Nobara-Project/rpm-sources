+bool regions_snap_in_direction(struct view *view, enum lab_edge edge,
+	bool toggle);
+
+/*
+ * Region offered by edge snapping on an output with a layout: the one
+ * nearest to the cursor. NULL if the output has no layout.
+ */
+struct region *regions_from_edge_cursor(struct output *output);
+
 #endif /* LABWC_REGIONS_H */
