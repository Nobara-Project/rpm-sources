 }
 
+bool
+regions_output_has_layout(struct output *output)
+{
+	if (!output) {
+		return false;
+	}
+	/* An output holds either only its own regions or none of them */
+	struct region *region;
+	wl_list_for_each(region, &output->regions, link) {
+		return region->output_name != NULL;
+	}
+	return false;
+}
+
+static int
+dist_sq(int x1, int y1, int x2, int y2)
+{
+	int64_t dx = (int64_t)x1 - x2;
+	int64_t dy = (int64_t)y1 - y2;
+	int64_t d = dx * dx + dy * dy;
+	return d > INT_MAX ? INT_MAX : (int)d;
+}
+
+/* Position of the region's edge facing the given direction, larger is further */
+static int
+leading_edge(struct region *region, enum lab_edge edge)
+{
+	struct wlr_box *geo = &region->geo;
+	switch (edge) {
+	case LAB_EDGE_LEFT:
+		return -geo->x;
+	case LAB_EDGE_RIGHT:
+		return geo->x + geo->width;
+	case LAB_EDGE_TOP:
+		return -geo->y;
+	case LAB_EDGE_BOTTOM:
+		return geo->y + geo->height;
+	default:
+		return 0;
+	}
+}
+
+/*
+ * Region lying furthest in the given direction; ties go to the region
+ * whose centre is nearest to (x, y).
+ */
+static struct region *
+furthest_region(struct output *output, enum lab_edge edge, int x, int y)
+{
+	struct region *best = NULL;
+	int best_edge = 0;
+	int best_dist = 0;
+	struct region *region;
+	wl_list_for_each(region, &output->regions, link) {
+		int e = leading_edge(region, edge);
+		int d = dist_sq(region->center.x, region->center.y, x, y);
+		if (!best || e > best_edge || (e == best_edge && d < best_dist)) {
+			best = region;
+			best_edge = e;
+			best_dist = d;
+		}
+	}
+	return best;
+}
+
+static bool
+ranges_overlap(int a, int a_len, int b, int b_len)
+{
+	return a < b + b_len && b < a + a_len;
+}
+
+/*
+ * Nearest region whose centre lies beyond the centre of the current
+ * one in the given direction. Regions overlapping the current one on
+ * the other axis are preferred.
+ */
+static struct region *
+next_region(struct region *current, enum lab_edge edge)
+{
+	bool horizontal = edge == LAB_EDGE_LEFT || edge == LAB_EDGE_RIGHT;
+	int sign = (edge == LAB_EDGE_LEFT || edge == LAB_EDGE_TOP) ? -1 : 1;
+	struct wlr_box *cur = &current->geo;
+
+	struct region *best = NULL;
+	bool best_overlap = false;
+	int best_dist = 0;
+	struct region *region;
+	wl_list_for_each(region, &current->output->regions, link) {
+		if (region == current) {
+			continue;
+		}
+		int delta = horizontal
+			? region->center.x - current->center.x
+			: region->center.y - current->center.y;
+		if (delta * sign <= 0) {
+			continue;
+		}
+		struct wlr_box *geo = &region->geo;
+		bool overlap = horizontal
+			? ranges_overlap(geo->y, geo->height, cur->y, cur->height)
+			: ranges_overlap(geo->x, geo->width, cur->x, cur->width);
+		int d = dist_sq(region->center.x, region->center.y,
+			current->center.x, current->center.y);
+		if (!best || (overlap && !best_overlap)
+				|| (overlap == best_overlap && d < best_dist)) {
+			best = region;
+			best_overlap = overlap;
+			best_dist = d;
+		}
+	}
+	return best;
+}
+
+bool
+regions_snap_in_direction(struct view *view, enum lab_edge edge, bool toggle)
+{
+	assert(view);
+	struct output *output = view->output;
+	if (!lab_edge_is_cardinal(edge) || view->fullscreen
+			|| tiling_is_managed(view) || !output_is_usable(output)) {
+		return false;
+	}
+
+	if (!regions_output_has_layout(output)) {
+		/*
+		 * Snapping to the edge a view is already snapped to moves
+		 * it to the adjacent output; if that one has a layout,
+		 * enter it by the region nearest to the shared edge.
+		 */
+		if (toggle || view->tiled != edge
+				|| view->maximized != VIEW_AXIS_NONE) {
+			return false;
+		}
+		struct output *adjacent = output_get_adjacent(output, edge,
+			/* wrap */ false);
+		if (!output_is_usable(adjacent)
+				|| !regions_output_has_layout(adjacent)) {
+			return false;
+		}
+		struct wlr_box box = view->pending;
+		struct region *region = furthest_region(adjacent,
+			lab_edge_invert(edge), box.x + box.width / 2,
+			box.y + box.height / 2);
+		view_set_output(view, adjacent);
+		view_snap_to_region(view, region);
+		return true;
+	}
+
+	struct region *current = view->tiled_region;
+	if (current && (current->output != output
+			|| view->maximized != VIEW_AXIS_NONE)) {
+		current = NULL;
+	}
+
+	if (!current) {
+		struct wlr_box box = view->pending;
+		struct region *region = furthest_region(output, edge,
+			box.x + box.width / 2, box.y + box.height / 2);
+		view_snap_to_region(view, region);
+		return true;
+	}
+
+	struct region *region = next_region(current, edge);
+	if (region) {
+		view_snap_to_region(view, region);
+		return true;
+	}
+
+	if (toggle) {
+		/* Like ToggleSnapToEdge on the edge the view is snapped to */
+		view_set_untiled(view);
+		view_apply_natural_geometry(view);
+		return true;
+	}
+
+	struct output *adjacent = output_get_adjacent(output, edge,
+		/* wrap */ false);
+	if (!output_is_usable(adjacent)) {
+		return true;
+	}
+	view_set_output(view, adjacent);
+	if (regions_output_has_layout(adjacent)) {
+		/* Enter by the region nearest to the shared edge */
+		region = furthest_region(adjacent, lab_edge_invert(edge),
+			current->center.x, current->center.y);
+		view_snap_to_region(view, region);
+	} else {
+		view_snap_to_edge(view, lab_edge_invert(edge),
+			/* across_outputs */ false, /* combine */ false);
+	}
+	return true;
+}
+
+/* Squared distance from a point to a box, 0 inside */
+static int
+dist_to_box_sq(struct wlr_box *box, int x, int y)
+{
+	int dx = 0, dy = 0;
+	if (x < box->x) {
+		dx = box->x - x;
+	} else if (x >= box->x + box->width) {
+		dx = x - (box->x + box->width - 1);
+	}
+	if (y < box->y) {
+		dy = box->y - y;
+	} else if (y >= box->y + box->height) {
+		dy = y - (box->y + box->height - 1);
+	}
+	return dist_sq(dx, dy, 0, 0);
+}
+
+struct region *
+regions_from_edge_cursor(struct output *output)
+{
+	if (!output_is_usable(output) || !regions_output_has_layout(output)) {
+		return NULL;
+	}
+	int x = server.seat.cursor->x;
+	int y = server.seat.cursor->y;
+
+	struct region *best = NULL;
+	int best_box = 0;
+	int best_center = 0;
+	struct region *region;
+	wl_list_for_each(region, &output->regions, link) {
+		int b = dist_to_box_sq(&region->geo, x, y);
+		int c = dist_sq(region->center.x, region->center.y, x, y);
+		if (!best || b < best_box || (b == best_box && c < best_center)) {
+			best = region;
+			best_box = b;
+			best_center = c;
+		}
+	}
+	return best;
+}
+
-- 
