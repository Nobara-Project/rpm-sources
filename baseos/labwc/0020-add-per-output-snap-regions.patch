 #include <assert.h>
 #include <float.h>
+#include <limits.h>
 #include <math.h>
+#include <stdint.h>
 #include <string.h>
 #include <wlr/types/wlr_cursor.h>
 #include <wlr/util/box.h>
@@ -14,6 +16,7 @@
 #include "input/keyboard.h"
 #include "labwc.h"
 #include "output.h"
+#include "tiling.h"
 #include "view.h"
 
 bool
@@ -84,13 +87,33 @@ regions_reconfigure_output(struct output *output)
 		regions_destroy(&server.seat, &output->regions);
 	}
 
-	/* Initialize regions from config */
+	/*
+	 * Initialize regions from config. An output named by at least one
+	 * region gets only its own regions, all others get the regions
+	 * without an output attribute.
