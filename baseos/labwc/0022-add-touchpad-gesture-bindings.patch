diff --git a/src/config/gesturebind.c b/src/config/gesturebind.c
new file mode 100644
index 0000000..0eac04f
--- /dev/null
+++ b/src/config/gesturebind.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "config/gesturebind.h"
+#include <math.h>
+#include <strings.h>
+
+enum gesture_type
+gesture_type_from_str(const char *str)
+{
+	if (!str) {
+		return LAB_GESTURE_TYPE_INVALID;
+	}
+	if (!strcasecmp(str, "swipe")) {
+		return LAB_GESTURE_TYPE_SWIPE;
+	}
+	if (!strcasecmp(str, "pinch")) {
+		return LAB_GESTURE_TYPE_PINCH;
+	}
+	return LAB_GESTURE_TYPE_INVALID;
+}
+
+enum gesture_direction
+gesture_direction_from_str(enum gesture_type type, const char *str)
+{
+	if (!str) {
+		return LAB_GESTURE_DIRECTION_NONE;
+	}
+	if (type == LAB_GESTURE_TYPE_SWIPE) {
+		if (!strcasecmp(str, "left")) {
+			return LAB_GESTURE_DIRECTION_LEFT;
+		} else if (!strcasecmp(str, "right")) {
+			return LAB_GESTURE_DIRECTION_RIGHT;
+		} else if (!strcasecmp(str, "up")) {
+			return LAB_GESTURE_DIRECTION_UP;
+		} else if (!strcasecmp(str, "down")) {
+			return LAB_GESTURE_DIRECTION_DOWN;
+		}
+	} else if (type == LAB_GESTURE_TYPE_PINCH) {
+		if (!strcasecmp(str, "in")) {
+			return LAB_GESTURE_DIRECTION_IN;
+		} else if (!strcasecmp(str, "out")) {
+			return LAB_GESTURE_DIRECTION_OUT;
+		}
+	}
+	return LAB_GESTURE_DIRECTION_NONE;
+}
+
+enum gesture_direction
+gesture_swipe_direction(double dx, double dy)
+{
+	if (!isfinite(dx) || !isfinite(dy)) {
+		return LAB_GESTURE_DIRECTION_NONE;
+	}
+	if (fmax(fabs(dx), fabs(dy)) < LAB_GESTURE_SWIPE_THRESHOLD) {
+		return LAB_GESTURE_DIRECTION_NONE;
+	}
+	if (fabs(dx) >= fabs(dy)) {
+		return dx < 0 ? LAB_GESTURE_DIRECTION_LEFT
+			: LAB_GESTURE_DIRECTION_RIGHT;
+	}
+	return dy < 0 ? LAB_GESTURE_DIRECTION_UP : LAB_GESTURE_DIRECTION_DOWN;
+}
+
+enum gesture_direction
+gesture_pinch_direction(double scale)
+{
+	if (!isfinite(scale) || scale <= 0) {
+		return LAB_GESTURE_DIRECTION_NONE;
+	}
+	if (scale <= LAB_GESTURE_PINCH_IN_SCALE) {
+		return LAB_GESTURE_DIRECTION_IN;
+	}
+	if (scale >= LAB_GESTURE_PINCH_OUT_SCALE) {
+		return LAB_GESTURE_DIRECTION_OUT;
+	}
+	return LAB_GESTURE_DIRECTION_NONE;
+}
