+## TOUCHPAD
+
+Multi-finger touchpad gestures can run actions. A gesture that is bound
+here is handled by the compositor and is not passed on to the client;
+all other gestures are passed on as before.
+
+```
+<touchpad>
+  <gesture type="swipe" fingers="3" direction="left">
+    <action name="GoToDesktop" to="right" />
+  </gesture>
+  <gesture type="pinch" fingers="4" direction="in">
+    <action name="ToggleShowDesktop" />
+  </gesture>
+</touchpad>
+```
+
+*<touchpad><gesture type="" fingers="" direction=""><action>*
+	Run the actions when the gesture is made. All three attributes are
+	required.
+
+	*type* [swipe|pinch]
+
+	*fingers* The number of fingers, 3 to 5 for a swipe and 2 to 5 for
+	a pinch. Two-finger swipes are scrolling and cannot be bound. Once
+	any direction is bound for a type and number of fingers, no gesture
+	of that type and number of fingers is passed on to the client.
+
+	*direction* [left|right|up|down] for a swipe is the direction the
+	fingers move in. [in|out] for a pinch is whether the fingers move
+	together or apart.
+
+	The actions run once per gesture, as soon as the fingers have moved
+	far enough for the direction to be clear, and without waiting for
+	them to be lifted. If the same gesture is defined more than once,
+	the last definition is used. Gestures do nothing while the session
+	is locked.
+
+	A *<touchpad>* section without gestures is allowed and binds
+	nothing.
+
+	The libinput setting *threeFingerDrag* uses three or four fingers
+	for dragging, in which case swipes with that many fingers are not
+	reported and cannot be bound.
+
 ## TOUCH
 
 This section relates to touchscreens and *not* touchpads.
diff --git a/include/config/gesturebind.h b/include/config/gesturebind.h
new file mode 100644
index 0000000..1817548
--- /dev/null
+++ b/include/config/gesturebind.h
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_GESTUREBIND_H
+#define LABWC_GESTUREBIND_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <wayland-util.h>
+
+enum gesture_type {
+	LAB_GESTURE_TYPE_INVALID = 0,
+	LAB_GESTURE_TYPE_SWIPE,
+	LAB_GESTURE_TYPE_PINCH,
+};
+
+enum gesture_direction {
+	LAB_GESTURE_DIRECTION_NONE = 0,
+	LAB_GESTURE_DIRECTION_LEFT,
+	LAB_GESTURE_DIRECTION_RIGHT,
+	LAB_GESTURE_DIRECTION_UP,
+	LAB_GESTURE_DIRECTION_DOWN,
+	LAB_GESTURE_DIRECTION_IN,
+	LAB_GESTURE_DIRECTION_OUT,
+};
+
+/*
+ * Distance the fingers travel, in the unaccelerated pointer units libinput
+ * reports for swipes, before a swipe counts as made. About a centimetre
+ * on most touchpads.
+ */
+#define LAB_GESTURE_SWIPE_THRESHOLD 100.0
+
+/* Relative finger spread at which a pinch counts as made */
+#define LAB_GESTURE_PINCH_IN_SCALE 0.8
+#define LAB_GESTURE_PINCH_OUT_SCALE 1.25
+
+/* <touchpad><gesture type="" fingers="" direction=""> */
+struct gesturebind {
+	enum gesture_type type;
+	uint32_t fingers;
+	enum gesture_direction direction;
+	struct wl_list actions;  /* struct action.link */
+	struct wl_list link;     /* struct rcxml.gesturebinds */
+};
+
+/* Progress of the touchpad gesture that is under way */
+struct gesture_tracker {
+	bool captured;  /* bound, so not passed on to the client */
+	bool fired;     /* actions ran, the rest of the gesture is ignored */
+	uint32_t fingers;
+	double dx, dy;
+};
+
+enum gesture_type gesture_type_from_str(const char *str);
+
+/* Returns LAB_GESTURE_DIRECTION_NONE for a direction the type does not have */
+enum gesture_direction gesture_direction_from_str(enum gesture_type type,
+	const char *str);
+
+/*
+ * The direction of a swipe that moved (dx, dy) in total since it began, or
+ * LAB_GESTURE_DIRECTION_NONE while it is shorter than the threshold. The
+ * longer axis decides.
+ */
+enum gesture_direction gesture_swipe_direction(double dx, double dy);
+
+/*
+ * The direction of a pinch whose fingers are @scale times as far apart as
+ * when it began, or LAB_GESTURE_DIRECTION_NONE while it is undecided.
+ */
+enum gesture_direction gesture_pinch_direction(double scale);
+
+#endif /* LABWC_GESTUREBIND_H */
