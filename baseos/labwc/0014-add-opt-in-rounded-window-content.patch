+void
+ssd_set_corner_clip(struct ssd *ssd, const struct wlr_box *box, int radius,
+		uint32_t corners)
+{
+	if (!ssd || !ssd->border.tree) {
+		return;
+	}
+	struct wlr_box local = {0};
+	if (box) {
+		int lx = 0, ly = 0;
+		wlr_scene_node_coords(&ssd->border.tree->node, &lx, &ly);
+		local = *box;
+		local.x -= lx;
+		local.y -= ly;
+	}
+	wlr_scene_tree_set_corner_clip(ssd->border.tree, box ? &local : NULL, radius, corners);
+}
