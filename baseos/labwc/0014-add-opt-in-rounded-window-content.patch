+void
+view_update_corner_clip(struct view *view)
+{
+	assert(view);
+	if (!view->content_tree) {
+		return;
+	}
+
+	struct wlr_box box = view->current;
+	box.height = view_effective_height(view, /* use_pending */ false);
+	uint32_t corners = WLR_SCENE_CORNER_ALL;
+	int radius = rc.corner_radius;
+	bool rounded = rc.round_window_content && !view->fullscreen && !view->shaded
+		&& view->maximized == VIEW_AXIS_NONE && !view_is_tiled(view)
+		&& !tiling_is_managed(view) && box.width > 0 && box.height > 0;
+
+	if (rounded && view->ssd) {
+		/* The title bar rounds the top; only the bottom needs cutting */
+		struct border margin = ssd_get_margin(view->ssd);
+		box.x -= margin.left;
+		box.width += margin.left + margin.right;
+		box.height += margin.bottom;
+		if (view_titlebar_visible(view)) {
+			corners = WLR_SCENE_CORNER_BOTTOM_LEFT | WLR_SCENE_CORNER_BOTTOM_RIGHT;
+		} else {
+			box.y -= margin.top;
+			box.height += margin.top;
+		}
+	} else if (rounded && view_draws_own_margins(view)) {
+		/*
+		 * Toolkits that draw past their window geometry may also draw an
+		 * outline around it, with corners of the same size. Cut just
+		 * outside that outline: it survives, and frames that left some
+		 * of their corners square (Chromium) still come out round.
+		 */
+		box.x -= 1;
+		box.y -= 1;
+		box.width += 2;
+		box.height += 2;
+		radius += 1;
+	}
+
+	if (!rounded) {
+		wlr_scene_tree_set_corner_clip(view->content_tree, NULL, 0, 0);
+		ssd_set_corner_clip(view->ssd, NULL, 0, 0);
+		return;
+	}
+
+	int lx = 0, ly = 0;
+	wlr_scene_node_coords(&view->content_tree->node, &lx, &ly);
+	struct wlr_box local = box;
+	local.x -= lx;
+	local.y -= ly;
+	wlr_scene_tree_set_corner_clip(view->content_tree, &local, radius, corners);
+	ssd_set_corner_clip(view->ssd, &box, radius, corners);
+}
