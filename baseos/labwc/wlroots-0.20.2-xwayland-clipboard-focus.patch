xwayland: reoffer Wayland selections when X11 gains focus

Wine imports available formats when XFixes reports an owner change.
Its early request is correctly denied while a Wayland client has focus,
but there is no retry when the game later gains focus. Reassert existing
Wayland proxy ownership on that transition, retaining the read focus check
and leaving X11-owned selections and drag-and-drop untouched.

--- a/include/xwayland/selection.h
+++ b/include/xwayland/selection.h
@@ -92,4 +92,6 @@
 	struct wlr_xwm *xwm, xcb_atom_t atom);
 void xwm_selection_finish(struct wlr_xwm_selection *selection);
 
+void xwm_selection_handle_focus(struct wlr_xwm *xwm);
+
 #endif
--- a/xwayland/selection/selection.c
+++ b/xwayland/selection/selection.c
@@ -310,6 +310,29 @@
 	xwm_selection_set_owner(&xwm->primary_selection, source != NULL);
 }
 
+void xwm_selection_handle_focus(struct wlr_xwm *xwm) {
+	if (xwm->seat == NULL || xwm->focus_surface == NULL) {
+		return;
+	}
+
+	/* Wine imports clipboard formats on XFixes owner notifications. The
+	 * initial request may have been denied while a Wayland client had focus,
+	 * leaving Wine with an empty format cache. Reassert our existing ownership
+	 * when Xwayland gains focus so it retries with clipboard access available.
+	 * Keep the focus check on reads and never take ownership from an X client.
+	 */
+	struct wlr_data_source *source = xwm->seat->selection_source;
+	if (source != NULL && !data_source_is_xwayland(source) &&
+			xwm->clipboard_selection.owner == xwm->clipboard_selection.window) {
+		xwm_selection_set_owner(&xwm->clipboard_selection, true);
+	}
+	struct wlr_primary_selection_source *primary = xwm->seat->primary_selection_source;
+	if (primary != NULL && !primary_selection_source_is_xwayland(primary) &&
+			xwm->primary_selection.owner == xwm->primary_selection.window) {
+		xwm_selection_set_owner(&xwm->primary_selection, true);
+	}
+}
+
 static void seat_handle_start_drag(struct wl_listener *listener, void *data) {
 	struct wlr_xwm *xwm = wl_container_of(listener, xwm, seat_start_drag);
 	struct wlr_drag *drag = data;
--- a/xwayland/xwm.c
+++ b/xwayland/xwm.c
@@ -438,6 +438,10 @@
 		return;
 	}
 
+	if (xsurface != NULL && unfocus_surface == NULL) {
