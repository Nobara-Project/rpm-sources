+#!/usr/bin/env python3
+"""Build/run isolated headless pixel regression; never connects to the live display.
+
+Default builds a minimal Pixman wlroots. --build ../../build uses the full private
+Labwc build; --renderer gles2/vulkan exercises its GPU path (requires a render node).
+"""
+from pathlib import Path
+import argparse
+import os
+import shlex
+import subprocess
+
+root = Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--build", type=Path)
+parser.add_argument("--renderer", choices=("pixman", "gles2", "vulkan"), default="pixman")
+parser.add_argument("--compile-only", action="store_true")
+parser.add_argument("--size", default="128x96")
+parser.add_argument("--benchmark", type=int)
+args = parser.parse_args()
+build = args.build.resolve() if args.build else root / "build-pixman"
+if not args.build:
+    subprocess.run(["meson", "setup", str(build), str(root), "-Drenderers=[]", "-Dbackends=[]",
+                    "-Dallocators=[]", "-Dxwayland=disabled", "-Dsession=disabled", "-Dexamples=false",
+                    "-Dcolor-management=disabled", "-Ddefault_library=static"], check=True)
+subprocess.run(["meson", "compile", "-C", str(build), "-j", "4"], check=True)
+env = dict(os.environ, PKG_CONFIG_PATH=str(build / "meson-uninstalled"), WLR_RENDERER=args.renderer)
+width, height = (int(value) for value in args.size.split("x"))
+if args.benchmark:
+    env["BLUR_BENCHMARK"] = str(args.benchmark)
+flags = shlex.split(subprocess.check_output(["pkg-config", "--static", "--cflags", "--libs",
+    "wlroots-0.20"], env=env, text=True))
+subprocess.run(["cc", "-g", "-Wall", "-Wextra", "-DWLR_USE_UNSTABLE", "-DWLR_PRIVATE=",
+    f"-DWIDTH={width}", f"-DHEIGHT={height}", str(root / "tests/background_blur.c"), "-o", str(build / "test-background-blur"),
+    *flags], check=True)
+if not args.compile_only:
+    subprocess.run([str(build / "test-background-blur")], env=env, check=True)
