@@ -0,0 +1,260 @@
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <wlr/backend/headless.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/drm_format_set.h>
+#include <wlr/render/pixman.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/util/log.h>
+#include "render/allocator/shm.h"
+
+#ifndef WIDTH
+#define WIDTH 128
+#endif
+#ifndef HEIGHT
+#define HEIGHT 96
+#endif
+static bool readback = true;
+static struct wlr_color_transform *test_transform;
+static uint32_t pixels[WIDTH * HEIGHT];
+
+static struct wlr_buffer *image(struct wlr_allocator *allocator, int width, int height,
+		bool foreground) {
+	uint64_t modifier = DRM_FORMAT_MOD_LINEAR;
+	struct wlr_drm_format format = {
+		.format = DRM_FORMAT_ARGB8888, .len = 1, .modifiers = &modifier,
+	};
+	struct wlr_buffer *buffer = wlr_allocator_create_buffer(allocator, width, height, &format);
+	assert(buffer);
+	void *data;
+	uint32_t fourcc;
+	size_t stride;
+	assert(wlr_buffer_begin_data_ptr_access(buffer, WLR_BUFFER_DATA_PTR_ACCESS_WRITE,
+		&data, &fourcc, &stride));
+	for (int y = 0; y < height; y++) {
+		uint32_t *row = (uint32_t *)((char *)data + stride * y);
+		for (int x = 0; x < width; x++) {
+			row[x] = foreground ? 0 : (x / 4 % 2 ? 0xffffffff : 0xff000000);
+			if (foreground && x >= 24 && x < 28 && y >= 24 && y < 32) {
+				row[x] = 0xffff0000;
+			}
+		}
+	}
+	wlr_buffer_end_data_ptr_access(buffer);
+	return buffer;
+}
+
+static void render(struct wlr_scene_output *scene_output) {
+	struct wlr_output_state state;
+	wlr_output_state_init(&state);
+	assert(wlr_scene_output_build_state(scene_output, &state,
+		&(struct wlr_scene_output_state_options){ .color_transform = test_transform }));
+	void *data;
+	uint32_t fourcc;
+	size_t stride;
+	if (!readback) {
+		// Benchmark avoids CPU readback until the final frame.
+	} else if (wlr_buffer_begin_data_ptr_access(state.buffer, WLR_BUFFER_DATA_PTR_ACCESS_READ,
+			&data, &fourcc, &stride)) {
+		assert(fourcc == DRM_FORMAT_XRGB8888 || fourcc == DRM_FORMAT_ARGB8888);
+		for (int y = 0; y < HEIGHT; y++) {
+			memcpy(pixels + y * WIDTH, (char *)data + y * stride, WIDTH * 4);
+		}
+		wlr_buffer_end_data_ptr_access(state.buffer);
+	} else {
+		struct wlr_texture *texture = wlr_texture_from_buffer(scene_output->output->renderer,
+			state.buffer);
+		assert(texture);
+		assert(wlr_texture_read_pixels(texture, &(struct wlr_texture_read_pixels_options){
+			.data = pixels, .format = DRM_FORMAT_ARGB8888, .stride = WIDTH * 4,
+		}));
+		wlr_texture_destroy(texture);
+	}
+	assert(wlr_output_commit_state(scene_output->output, &state));
+	wlr_output_state_finish(&state);
+	assert(!wlr_scene_output_needs_frame(scene_output));
+}
+
+static uint32_t rgb(int x, int y) {
+	return pixels[y * WIDTH + x] & 0xffffff;
+}
+
+int main(void) {
+	wlr_log_init(WLR_ERROR, NULL);
+	struct wl_display *display = wl_display_create();
+	assert(display);
+	struct wlr_backend *backend = wlr_headless_backend_create(wl_display_get_event_loop(display));
+	assert(backend);
+	struct wlr_renderer *renderer = getenv("WLR_RENDERER") ?
+		wlr_renderer_autocreate(backend) : wlr_pixman_renderer_create();
+	assert(renderer);
+	struct wlr_allocator *allocator = wlr_allocator_autocreate(backend, renderer);
+	struct wlr_allocator *source_allocator = wlr_shm_allocator_create();
+	assert(renderer && allocator);
+	assert(wlr_scene_background_blur_supported(renderer, allocator));
+	struct wlr_output *output = wlr_headless_add_output(backend, WIDTH, HEIGHT);
+	assert(output && wlr_output_init_render(output, allocator, renderer));
+	assert(wlr_backend_start(backend));
+	struct wlr_output_state initial;
+	wlr_output_state_init(&initial);
+	wlr_output_state_set_enabled(&initial, true);
+	assert(wlr_output_commit_state(output, &initial));
+	wlr_output_state_finish(&initial);
+
+	struct wlr_scene *scene = wlr_scene_create();
+	struct wlr_scene_output *scene_output = wlr_scene_output_create(scene, output);
+	struct wlr_buffer *back = image(source_allocator, WIDTH, HEIGHT, false);
+	struct wlr_scene_buffer *back_node = wlr_scene_buffer_create(&scene->tree, back);
+	struct wlr_buffer *front = image(source_allocator, WIDTH, HEIGHT, true);
+	struct wlr_scene_buffer *front_node = wlr_scene_buffer_create(&scene->tree, front);
+	render(scene_output);
+	assert(rgb(40, 40) == 0x000000 && rgb(44, 40) == 0xffffff);
+	assert(!scene_output->background_blur_active);
+
+	pixman_region32_t region;
+	pixman_region32_init_rect(&region, 16, 16, 96, 64);
+	wlr_scene_buffer_set_background_blur(front_node, &region, 12);
+	// The setter must copy, not borrow, client-owned regions.
+	pixman_region32_clear(&region);
+	render(scene_output);
+	assert(scene_output->background_blur_active);
+	void *scratch = scene_output->background_blur;
+	assert(rgb(40, 40) > 0x202020 && rgb(40, 40) < 0xe0e0e0);
+	assert(rgb(44, 40) > 0x202020 && rgb(44, 40) < 0xe0e0e0);
+	assert(rgb(8, 40) == 0 && rgb(12, 40) == 0xffffff);
+	assert(rgb(24, 24) == 0xff0000 && rgb(27, 31) == 0xff0000);
+	assert(rgb(23, 24) != 0xff0000 && rgb(28, 31) != 0xff0000);
+
+	const char *benchmark = getenv("BLUR_BENCHMARK");
+	if (benchmark) {
+		int frames = atoi(benchmark);
+		assert(frames > 0 && frames <= 1000);
+		pixman_region32_union_rect(&region, &region, 0, 0, WIDTH, HEIGHT);
+		struct timespec start, stop;
+		clock_gettime(CLOCK_MONOTONIC, &start);
+		for (int i = 0; i < frames; i++) {
+			readback = i == frames - 1;
+			wlr_scene_buffer_set_background_blur(front_node, &region, 10 + i % 2);
+			render(scene_output);
+		}
+		clock_gettime(CLOCK_MONOTONIC, &stop);
+		double elapsed = stop.tv_sec - start.tv_sec + (stop.tv_nsec - start.tv_nsec) / 1e9;
+		printf("blur benchmark: %dx%d, %d frames, %.2f ms/frame (final readback synchronized)\n",
+			WIDTH, HEIGHT, frames, elapsed * 1000 / frames);
+		goto cleanup;
+	}
+
+	// Changes to lower content must update the blur, including geometry damage.
+	const float green[] = {0, 1, 0, 1};
+	struct wlr_scene_rect *lower = wlr_scene_rect_create(&scene->tree, WIDTH, HEIGHT, green);
+	wlr_scene_node_place_below(&lower->node, &front_node->node);
+	render(scene_output);
+	assert(rgb(40, 40) == 0x00ff00);
+	assert(scene_output->background_blur == scratch);
+	wlr_scene_node_destroy(&lower->node);
+	render(scene_output);
+	assert(rgb(40, 40) > 0x202020 && rgb(40, 40) < 0xe0e0e0);
+
+	// A fully opaque covering window returns to the stock rendering path.
+	const float blue[] = {0, 0, 1, 1};
+	struct wlr_scene_rect *cover = wlr_scene_rect_create(&scene->tree, WIDTH, HEIGHT, blue);
+	render(scene_output);
+	assert(!scene_output->background_blur_active && rgb(40, 40) == 0x0000ff);
+	assert(scene_output->background_blur == NULL);
+	wlr_scene_node_destroy(&cover->node);
+	render(scene_output);
+	assert(scene_output->background_blur_active);
+
+	// Moving an opted-in surface moves its region, leaving no stale blur.
+	wlr_scene_node_set_position(&front_node->node, 16, 0);
+	render(scene_output);
+	assert(rgb(24, 40) == 0 && rgb(28, 40) == 0xffffff);
+	assert(rgb(48, 40) > 0x202020 && rgb(48, 40) < 0xe0e0e0);
+	assert(rgb(40, 24) == 0xff0000);
+	wlr_scene_buffer_set_background_blur(front_node, NULL, 0);
+	render(scene_output);
+	assert(!scene_output->background_blur_active);
+	assert(rgb(48, 40) == 0 && rgb(52, 40) == 0xffffff);
+	assert(scene_output->background_blur == NULL);
+
+	// Buffer commits behind active blur must damage and repaint the output.
+	wlr_scene_node_set_position(&front_node->node, 0, 0);
+	pixman_region32_union_rect(&region, &region, 0, 0, WIDTH, HEIGHT);
+	wlr_scene_buffer_set_background_blur(front_node, &region, 12);
+	render(scene_output);
+	wlr_scene_buffer_set_buffer(back_node, back);
+	assert(wlr_scene_output_needs_frame(scene_output));
+	render(scene_output);
+
+	// A rotated fractional-scale output clips the effect in physical output
+	// coordinates, while the API remains in logical surface coordinates.
+	if (WIDTH == 128 && HEIGHT == 96) {
+		wlr_scene_buffer_set_background_blur(front_node, NULL, 0);
+		struct wlr_output_state geometry;
+		wlr_output_state_init(&geometry);
+		wlr_output_state_set_scale(&geometry, 1.5f);
+		wlr_output_state_set_transform(&geometry, WL_OUTPUT_TRANSFORM_90);
+		assert(wlr_output_commit_state(output, &geometry));
+		wlr_output_state_finish(&geometry);
+		render(scene_output);
+		uint32_t baseline[WIDTH * HEIGHT];
+		memcpy(baseline, pixels, sizeof(pixels));
+		pixman_region32_clear(&region);
+		pixman_region32_union_rect(&region, &region, 16, 12, 32, 20);
+		wlr_scene_buffer_set_background_blur(front_node, &region, 12);
+		render(scene_output);
+		int changed = 0;
+		for (int y = 0; y < HEIGHT; y++) {
+			for (int x = 0; x < WIDTH; x++) {
+				if (rgb(x, y) != (baseline[y * WIDTH + x] & 0xffffff)) {
+					assert(x >= 18 && x < 48 && y >= 24 && y < 72);
+					changed++;
+				}
+			}
+		}
+		assert(changed > 100);
+		wlr_output_state_init(&geometry);
+		wlr_output_state_set_scale(&geometry, 1.0f);
+		wlr_output_state_set_transform(&geometry, WL_OUTPUT_TRANSFORM_NORMAL);
+		assert(wlr_output_commit_state(output, &geometry));
+		wlr_output_state_finish(&geometry);
+	}
+
+	if (renderer->features.output_color_transform) {
+		// HDR output conversion is applied exactly once. Starting a blur pass
+		// must not alter sharp foreground/outside pixels under a PQ transform.
+		test_transform = wlr_color_transform_init_linear_to_inverse_eotf(
+			WLR_COLOR_TRANSFER_FUNCTION_ST2084_PQ);
+		assert(test_transform);
+		wlr_scene_buffer_set_background_blur(front_node, NULL, 0);
+		render(scene_output);
+		uint32_t sharp_red = rgb(24, 24), sharp_white = rgb(12, 40);
+		pixman_region32_clear(&region);
+		pixman_region32_union_rect(&region, &region, 32, 16, 64, 64);
+		wlr_scene_buffer_set_background_blur(front_node, &region, 12);
+		render(scene_output);
+		assert(rgb(24, 24) == sharp_red && rgb(12, 40) == sharp_white);
+		assert(rgb(40, 40) != 0 && rgb(40, 40) != sharp_white);
+		wlr_color_transform_unref(test_transform);
+		test_transform = NULL;
+		puts("background blur: PQ output conversion preserves sharp foreground and outside pixels");
+	}
+
+cleanup:
+	pixman_region32_fini(&region);
+	wlr_scene_node_destroy(&scene->tree.node);
+	wlr_buffer_drop(back);
+	wlr_buffer_drop(front);
+	wlr_backend_destroy(backend);
+	wlr_allocator_destroy(source_allocator);
+	wlr_allocator_destroy(allocator);
+	wlr_renderer_destroy(renderer);
+	wl_display_destroy(display);
+	puts("background blur: backdrop, foreground, clipping, movement, occlusion, damage, reuse and idle checks passed");
+	return 0;
+}
