@@ -0,0 +1,241 @@
+#include <drm_fourcc.h>
+#include <math.h>
+#include <stdlib.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/color.h>
+#include <wlr/render/drm_format_set.h>
+#include <wlr/render/wlr_texture.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_output.h>
+#include <wlr/util/log.h>
+#include "render/drm_format_set.h"
+#include "render/wlr_renderer.h"
+#include "types/scene_background_blur.h"
+
+#define BLUR_LEVELS 7
+#define BLUR_MEMORY_LIMIT (256u * 1024u * 1024u)
+
+struct blur_target {
+	struct wlr_buffer *buffer;
+	struct wlr_texture *texture;
+};
+
+struct scene_background_blur {
+	struct wlr_scene_output *output;
+	struct wlr_renderer *renderer;
+	struct wlr_allocator *allocator;
+	struct wl_listener renderer_destroy, allocator_destroy;
+	struct wlr_color_transform *linear_transform;
+	struct blur_target targets[BLUR_LEVELS + 1];
+	int width, height;
+	bool ready;
+};
+
+void scene_background_blur_destroy(struct wlr_scene_output *output) {
+	struct scene_background_blur *blur = output->background_blur;
+	if (!blur) {
+		return;
+	}
+	output->background_blur = NULL;
+	output->background_blur_active = false;
+	wl_list_remove(&blur->renderer_destroy.link);
+	wl_list_remove(&blur->allocator_destroy.link);
+	for (size_t i = 0; i <= BLUR_LEVELS; i++) {
+		wlr_texture_destroy(blur->targets[i].texture);
+		if (blur->targets[i].buffer) {
+			wlr_buffer_drop(blur->targets[i].buffer);
+		}
+	}
+	wlr_color_transform_unref(blur->linear_transform);
+	free(blur);
+}
+
+static void handle_renderer_destroy(struct wl_listener *listener, void *data) {
+	struct scene_background_blur *blur = wl_container_of(listener, blur, renderer_destroy);
+	scene_background_blur_destroy(blur->output);
+}
+
+static void handle_allocator_destroy(struct wl_listener *listener, void *data) {
+	struct scene_background_blur *blur = wl_container_of(listener, blur, allocator_destroy);
+	scene_background_blur_destroy(blur->output);
+}
+
+static bool scratch_format(struct wlr_renderer *renderer, struct wlr_allocator *allocator,
+		struct wlr_drm_format *format) {
+	if (!renderer || !allocator) {
+		return false;
+	}
+	uint32_t fourcc = renderer->features.output_color_transform ?
+		DRM_FORMAT_ABGR16161616F : DRM_FORMAT_ARGB8888;
+	const struct wlr_drm_format_set *render_formats = wlr_renderer_get_render_formats(renderer);
+	const struct wlr_drm_format_set *texture_formats =
+		wlr_renderer_get_texture_formats(renderer, allocator->buffer_caps);
+	const struct wlr_drm_format *render_format = render_formats ?
+		wlr_drm_format_set_get(render_formats, fourcc) : NULL;
+	const struct wlr_drm_format *texture_format = texture_formats ?
+		wlr_drm_format_set_get(texture_formats, fourcc) : NULL;
+	return render_format && texture_format &&
+		wlr_drm_format_intersect(format, render_format, texture_format);
+}
+
+bool wlr_scene_background_blur_supported(struct wlr_renderer *renderer,
+		struct wlr_allocator *allocator) {
+	struct wlr_drm_format format = {0};
+	bool supported = scratch_format(renderer, allocator, &format);
+	wlr_drm_format_finish(&format);
+	return supported;
+}
+
+bool scene_background_blur_prepare(struct wlr_scene_output *output, int width, int height) {
+	struct scene_background_blur *blur = output->background_blur;
+	struct wlr_renderer *renderer = output->output->renderer;
+	struct wlr_allocator *allocator = output->output->allocator;
+	if (blur && blur->renderer == renderer && blur->allocator == allocator &&
+			blur->width == width && blur->height == height) {
+		return blur->ready;
+	}
+	scene_background_blur_destroy(output);
+	if (!allocator || width <= 0 || height <= 0) {
+		return false;
+	}
+	blur = calloc(1, sizeof(*blur));
+	if (!blur) {
+		return false;
+	}
+	output->background_blur = blur;
+	blur->output = output;
+	blur->renderer = renderer;
+	blur->allocator = allocator;
+	blur->width = width;
+	blur->height = height;
+	blur->renderer_destroy.notify = handle_renderer_destroy;
+	wl_signal_add(&renderer->events.destroy, &blur->renderer_destroy);
+	blur->allocator_destroy.notify = handle_allocator_destroy;
+	wl_signal_add(&allocator->events.destroy, &blur->allocator_destroy);
+
+	// HDR-capable renderers compose into linear half-float buffers. No tone
+	// mapping or output transform occurs until the final output pass.
+	bool linear = renderer->features.output_color_transform;
+	struct wlr_drm_format format = {0};
+	if (!scratch_format(renderer, allocator, &format)) {
+		wlr_log(WLR_INFO, "Background blur unavailable: no compatible scratch format");
+		return false;
+	}
+	if ((uint64_t)width * height * (linear ? 8 : 4) * 4 / 3 > BLUR_MEMORY_LIMIT) {
+		wlr_log(WLR_INFO, "Background blur scratch buffers exceed memory budget");
+		wlr_drm_format_finish(&format);
+		return false;
+	}
+	if (linear) {
+		blur->linear_transform = wlr_color_transform_init_linear_to_inverse_eotf(
+			WLR_COLOR_TRANSFER_FUNCTION_EXT_LINEAR);
+		if (!blur->linear_transform) {
+			wlr_drm_format_finish(&format);
+			return false;
+		}
+	}
+	for (size_t i = 0; i <= BLUR_LEVELS; i++) {
+		struct blur_target *target = &blur->targets[i];
+		target->buffer = wlr_allocator_create_buffer(allocator, width, height, &format);
+		if (!target->buffer) {
+			break;
+		}
+		target->texture = wlr_texture_from_buffer(renderer, target->buffer);
+		if (!target->texture) {
+			break;
+		}
+		if (i == BLUR_LEVELS) {
+			blur->ready = true;
+		}
+		width = (width + 1) / 2;
+		height = (height + 1) / 2;
+	}
+	wlr_drm_format_finish(&format);
+	if (!blur->ready) {
+		// Cache failure for this output configuration, but release allocations.
+		for (size_t i = 0; i <= BLUR_LEVELS; i++) {
+			wlr_texture_destroy(blur->targets[i].texture);
+			blur->targets[i].texture = NULL;
+			if (blur->targets[i].buffer) {
+				wlr_buffer_drop(blur->targets[i].buffer);
+				blur->targets[i].buffer = NULL;
+			}
+		}
+		wlr_log(WLR_ERROR, "Failed to allocate background blur buffers");
+	}
+	return blur->ready;
+}
+
+struct wlr_render_pass *scene_background_blur_begin(struct scene_background_blur *blur) {
+	return wlr_renderer_begin_buffer_pass(blur->renderer, blur->targets[0].buffer,
+		&(struct wlr_buffer_pass_options){ .color_transform = blur->linear_transform });
+}
+
+static void add_target(struct scene_background_blur *blur, struct wlr_render_pass *pass,
+		struct blur_target *source, int width, int height, const pixman_region32_t *clip,
+		float alpha) {
+	wlr_render_pass_add_texture(pass, &(struct wlr_render_texture_options){
+		.texture = source->texture,
+		.dst_box = { .width = width, .height = height },
+		.clip = clip,
+		.alpha = &alpha,
+		.blend_mode = alpha == 1.0f ? WLR_RENDER_BLEND_MODE_NONE :
+			WLR_RENDER_BLEND_MODE_PREMULTIPLIED,
+		.filter_mode = WLR_SCALE_FILTER_BILINEAR,
+		.transfer_function = blur->linear_transform ?
+			WLR_COLOR_TRANSFER_FUNCTION_EXT_LINEAR : WLR_COLOR_TRANSFER_FUNCTION_SRGB,
+	});
+}
+
+static bool scale_target(struct scene_background_blur *blur, int source, int destination, float alpha) {
+	struct blur_target *target = &blur->targets[destination];
+	struct wlr_render_pass *pass = wlr_renderer_begin_buffer_pass(blur->renderer,
+		target->buffer, &(struct wlr_buffer_pass_options){
+			.color_transform = blur->linear_transform,
+		});
+	if (!pass) {
+		return false;
+	}
+	add_target(blur, pass, &blur->targets[source], target->buffer->width,
+		target->buffer->height, NULL, alpha);
+	return wlr_render_pass_submit(pass);
+}
+
+struct wlr_render_pass *scene_background_blur_apply(struct scene_background_blur *blur,
+		struct wlr_render_pass *pass, const pixman_region32_t *region, float radius) {
+	// Submit the already composed lower scene before sampling it. These passes
+	// use implicit synchronization, including when the final output uses an
+	// explicit timeline. No client foreground is included in its own backdrop.
+	if (!wlr_render_pass_submit(pass)) {
+		return NULL;
+	}
+	radius = fmaxf(1.0f, fminf(1 << BLUR_LEVELS, radius));
+	int levels = fmaxf(1, ceilf(log2f(radius)));
+	if (levels > BLUR_LEVELS) {
+		levels = BLUR_LEVELS;
+	}
+	// Blend the two neighboring pyramid strengths, avoiding abrupt jumps
+	// when the radius crosses a power of two while reusing the same targets.
+	float strength = radius / (1 << (levels - 1)) - 1;
+	for (int i = 1; i <= levels; i++) {
+		if (!scale_target(blur, i - 1, i, 1.0f)) {
+			return NULL;
+		}
+	}
+	for (int i = levels - 1; i >= 1; i--) {
+		if (!scale_target(blur, i + 1, i, i == levels - 1 ? strength : 1.0f)) {
+			return NULL;
+		}
+	}
+	pass = scene_background_blur_begin(blur);
+	if (pass) {
+		add_target(blur, pass, &blur->targets[1], blur->width, blur->height, region,
+			levels == 1 ? strength : 1.0f);
+	}
+	return pass;
+}
+
+void scene_background_blur_finish(struct scene_background_blur *blur,
+		struct wlr_render_pass *output_pass) {
+	add_target(blur, output_pass, &blur->targets[0], blur->width, blur->height, NULL, 1.0f);
+}
