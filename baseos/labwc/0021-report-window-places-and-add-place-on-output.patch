+    /* Too long a reply is dropped: retry once without titles. */
+    for (int titles = 1; titles >= 0; titles--) {
+        free(text); text = NULL; length = 0;
+        FILE *stream = open_memstream(&text, &length);
+        if (!stream) return 0;
+        fprintf(stream, "{\"version\":1,\"ready\":true,\"compositor_pid\":%ld,\"enabled\":%s,\"parking_supported\":true,\"tile_bounds_supported\":true,\"outline_supported\":true,\"outline_enabled\":%s,\"error\":\"%s\",\"windows\":[", (long)getpid(), enabled ? "true" : "false", outline_enabled ? "true" : "false", error);
+        if (!strcmp(request, "windows") && !locked) put_windows(stream, titles);
+        fputs("],\"capture_output_supported\":true,\"capture_output\":", stream);
