 }
+/* PlaceOnOutput. Boxes are view->pending style (client area without server
+ * decorations); x/y are relative to the output's top-left corner, as in the
+ * "place" of the windows reply. The frame is kept inside the usable area. */
+static int clamp_int(int value, int low, int high) { return value > high ? high : value < low ? low : value; }
+void tiling_place_on_output(struct view *v, struct output *o, const struct wlr_box *place, bool maximize) {
+    if (!v || !output_is_usable(o) || view_has_strut_partial(v)) return;
+    struct wlr_box full, usable = output_usable_area_in_layout_coords(o);
+    wlr_output_layout_get_box(server.output_layout, o->wlr_output, &full);
+    if (wlr_box_empty(&usable) || wlr_box_empty(&full)) return;
+    struct record *r = initialized ? record_for(v) : NULL;
+    /* Windows tiling arranges (or will on its next pass) only change output. */
+    bool tiles = initialized && enabled && !special(v) && (r ? !r->floating && !r->scratch : eligible(v));
+    if (tiles && r && v->auto_tiled) {
+        if (v->output != o) { detach(r); view_set_output(v, o); }
+        tiling_schedule(); return;
+    }
+    struct wlr_box before = v->pending;
+    view_set_fullscreen(v, false);
+    view_maximize(v, VIEW_AXIS_NONE);
+    view_set_shade(v, false);
+    if (v->tiled || v->tiled_region || v->tiled_region_evacuate) view_set_untiled(v);
+    int width = place->width > 0 ? place->width : v->pending.width > 0 ? v->pending.width : before.width;
+    int height = place->height > 0 ? place->height : v->pending.height > 0 ? v->pending.height : before.height;
+    struct border margin = ssd_get_margin(v->ssd);
+    int room_w = usable.width - margin.left - margin.right, room_h = usable.height - margin.top - margin.bottom;
+    if (width < 1 || height < 1 || room_w < 1 || room_h < 1) return;
+    width = width < room_w ? width : room_w; height = height < room_h ? height : room_h;
+    struct wlr_box box = {
+        clamp_int(full.x + place->x, usable.x + margin.left, usable.x + usable.width - margin.right - width),
+        clamp_int(full.y + place->y, usable.y + margin.top, usable.y + usable.height - margin.bottom - height),
+        width, height};
+    view_set_output(v, o);
+    view_move_resize(v, box);
+    if (maximize && !tiles) view_maximize(v, VIEW_AXIS_BOTH);
+    tiling_schedule();
+}
+/* Length of the valid UTF-8 sequence at p, 0 when invalid (never reads past a NUL). */
+static size_t utf8_length(const unsigned char *p) {
+    if (p[0] < 0x80) return 1;
+    size_t n; unsigned char low = 0x80, high = 0xbf;
+    if (p[0] >= 0xc2 && p[0] <= 0xdf) n = 2;
+    else if (p[0] >= 0xe0 && p[0] <= 0xef) { n = 3; if (p[0] == 0xe0) low = 0xa0; if (p[0] == 0xed) high = 0x9f; }
+    else if (p[0] >= 0xf0 && p[0] <= 0xf4) { n = 4; if (p[0] == 0xf0) low = 0x90; if (p[0] == 0xf4) high = 0x8f; }
+    else return 0;
+    if (p[1] < low || p[1] > high) return 0;
+    for (size_t i = 2; i < n; i++) if (p[i] < 0x80 || p[i] > 0xbf) return 0;
+    return n;
+}
+/* A JSON string of at most max bytes of UTF-8, cut on a character boundary;
+ * invalid bytes become U+FFFD. */
+static void put_string(FILE *stream, const char *text, size_t max) {
+    const unsigned char *p = (const unsigned char *)(text ? text : "");
+    size_t used = 0;
+    fputc('"', stream);
+    while (*p) {
+        size_t n = utf8_length(p);
+        if (used + (n ? n : 3) > max) break;
+        used += n ? n : 3;
+        if (!n) { fputs("\\ufffd", stream); p++; continue; }
+        if (*p == '"' || *p == '\\') fprintf(stream, "\\%c", *p);
+        else if (*p < 0x20) fprintf(stream, "\\u%04x", *p);
+        else fwrite(p, 1, n, stream);
+        p += n;
+    }
+    fputc('"', stream);
+}
+/* Where the window returns to when restored, if known on its output. */
+static struct wlr_box natural_place(struct view *v, struct record *r) {
+    struct wlr_box box = v->pending, full = {0}, saved = {0}, overlap;
+    if (output_is_usable(v->output)) wlr_output_layout_get_box(server.output_layout, v->output->wlr_output, &full);
+    if (v->auto_tiled && r) saved = r->original;
+    else if (!view_is_floating(v)) saved = v->natural_geometry;
+    if (!wlr_box_empty(&saved) && (wlr_box_empty(&full) || wlr_box_intersection(&overlap, &saved, &full))) box = saved;
+    box.x -= full.x; box.y -= full.y;
+    return box;
+}
+static void put_windows(FILE *stream, bool titles) {
+    struct view *v; bool first = true;
+    wl_list_for_each(v, &server.views, link) {
+        if (!v->mapped && !v->minimized) continue;
+        struct record *r = record_for(v);
+        struct wlr_box area = output_is_usable(v->output) ? output_usable_area_in_layout_coords(v->output) : (struct wlr_box){0};
+        bool outlined = r && r->outline && r->outline->node.enabled && v->scene_tree->node.enabled;
+        fprintf(stream, "%s{\"id\":%lu,\"active\":%s,\"tiled\":%s,\"visible\":%s,\"output\":%lu,\"x\":%d,\"y\":%d,\"width\":%d,\"height\":%d,\"fullscreen\":%s,\"minimized\":%s,\"outlined\":%s,\"parked\":%s,\"current\":{\"x\":%d,\"y\":%d,\"width\":%d,\"height\":%d},\"workarea\":{\"x\":%d,\"y\":%d,\"width\":%d,\"height\":%d}",
+            first ? "" : ",", (unsigned long)v->creation_id, server.active_view == v ? "true" : "false",
+            v->auto_tiled ? "true" : "false", v->scene_tree->node.enabled ? "true" : "false",
+            (unsigned long)(v->output ? v->output->id_bit : 0), v->pending.x, v->pending.y, v->pending.width, v->pending.height,
+            v->fullscreen ? "true" : "false", v->minimized ? "true" : "false", outlined ? "true" : "false", r && r->parked_order ? "true" : "false",
+            v->current.x, v->current.y, v->current.width, v->current.height,
+            area.x, area.y, area.width, area.height); first = false;
+        struct wlr_box place = natural_place(v, r);
+        fputs(",\"app_id\":", stream); put_string(stream, v->app_id, 128);
+        fputs(",\"title\":", stream); put_string(stream, titles ? v->title : "", 96);
+        fprintf(stream, ",\"type_normal\":%s,\"output_name\":", v->impl->contains_window_type && v->impl->contains_window_type(v, LAB_WINDOW_TYPE_NORMAL) ? "true" : "false");
+        put_string(stream, output_is_usable(v->output) ? v->output->wlr_output->name : "", 128);
+        fprintf(stream, ",\"maximized\":%s,\"place\":{\"x\":%d,\"y\":%d,\"width\":%d,\"height\":%d}}",
+            v->maximized == VIEW_AXIS_BOTH ? "true" : "false", place.x, place.y, place.width, place.height);
+    }
+}
 static int control(int fd, uint32_t mask, void *data) {
     (void)mask; (void)data;
     struct sockaddr_un peer;
@@ -881,42 +980,32 @@ static int control(int fd, uint32_t mask, void *data) {
     else if (!strncmp(request, "action ", 7)) tiling_action(NULL, request + 7);
