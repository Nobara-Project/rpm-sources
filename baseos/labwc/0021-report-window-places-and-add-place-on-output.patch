diff --git a/src/tiling.c b/src/tiling.c
index cea4ab4..c8a1cea 100644
--- a/src/tiling.c
+++ b/src/tiling.c
@@ -838,6 +838,105 @@ bool tiling_drag_finish(struct view *v) {
     }
