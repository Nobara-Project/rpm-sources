 			MAX(width - bg_offset * 2, 0), theme->titlebar_height);
+		wlr_scene_rect_set_size(subtree->highlight,
+			MAX(width - bg_offset * 2, 0), 1);
 
 		x = theme->window_titlebar_padding_width;
 		struct ssd_button *button;
