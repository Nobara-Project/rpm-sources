+/*
+ * Drop-shadows for client-side decorated windows.
+ *
+ * These views have no ssd, so the shadow lives in its own subtree at the
+ * bottom of the view's scene tree, whose origin is the window geometry.
+ * All four corners use the bottom corner buffer: its fully erased inner
+ * square never shows through a translucent client-drawn titlebar.
+ */
+struct csd_shadow {
+	struct wlr_scene_tree *tree;
+	struct ssd_shadow_subtree subtrees[2]; /* indexed by ssd_active_state */
+	bool active;
+};
+
+static bool
+csd_shadow_wanted(struct view *view)
+{
+	if (!rc.shadows_enabled || view->ssd_mode != LAB_SSD_MODE_NONE
+			|| view->fullscreen || view->maximized == VIEW_AXIS_BOTH
+			|| !view->scene_tree || view->current.width <= 0
+			|| view->current.height <= 0) {
+		return false;
+	}
+	if (view_is_tiled(view)) {
+		struct theme *theme = rc.theme;
+		return rc.shadows_on_tiled
+			&& rc.gap >= theme->window[SSD_ACTIVE].shadow_size
+			&& rc.gap >= theme->window[SSD_INACTIVE].shadow_size;
+	}
+	return true;
+}
+
+static struct csd_shadow *
+csd_shadow_create(struct view *view)
+{
+	struct theme *theme = rc.theme;
+	struct csd_shadow *shadow = znew(*shadow);
+	shadow->tree = lab_wlr_scene_tree_create(view->scene_tree);
+	wlr_scene_node_lower_to_bottom(&shadow->tree->node);
+	shadow->active = view == server.active_view;
+
+	enum ssd_active_state active;
+	FOR_EACH_ACTIVE_STATE(active) {
+		if (theme->window[active].shadow_size == 0) {
+			continue;
+		}
+		struct ssd_shadow_subtree *subtree = &shadow->subtrees[active];
+		subtree->tree = lab_wlr_scene_tree_create(shadow->tree);
+		struct wlr_scene_tree *parent = subtree->tree;
+		struct wlr_buffer *corner =
+			&theme->window[active].shadow_corner_bottom->base;
+		struct wlr_buffer *edge = &theme->window[active].shadow_edge->base;
+
+		subtree->bottom_right = make_shadow(view, parent, corner,
+			WL_OUTPUT_TRANSFORM_NORMAL);
+		subtree->bottom_left = make_shadow(view, parent, corner,
+			WL_OUTPUT_TRANSFORM_FLIPPED);
+		subtree->top_left = make_shadow(view, parent, corner,
+			WL_OUTPUT_TRANSFORM_180);
+		subtree->top_right = make_shadow(view, parent, corner,
+			WL_OUTPUT_TRANSFORM_FLIPPED_180);
+		subtree->right = make_shadow(view, parent, edge,
+			WL_OUTPUT_TRANSFORM_NORMAL);
+		subtree->bottom = make_shadow(view, parent, edge,
+			WL_OUTPUT_TRANSFORM_90);
+		subtree->left = make_shadow(view, parent, edge,
+			WL_OUTPUT_TRANSFORM_180);
+		subtree->top = make_shadow(view, parent, edge,
+			WL_OUTPUT_TRANSFORM_270);
+	}
+	return shadow;
+}
+
+void
+csd_shadow_update(struct view *view)
+{
+	assert(view);
+	if (!csd_shadow_wanted(view)) {
+		if (view->csd_shadow) {
+			wlr_scene_node_set_enabled(
+				&view->csd_shadow->tree->node, false);
+		}
+		return;
+	}
+	if (!view->csd_shadow) {
+		view->csd_shadow = csd_shadow_create(view);
+	}
+	struct csd_shadow *shadow = view->csd_shadow;
+	wlr_scene_node_set_enabled(&shadow->tree->node, true);
+	int height = view_effective_height(view, false);
+
+	enum ssd_active_state active;
+	FOR_EACH_ACTIVE_STATE(active) {
+		struct ssd_shadow_subtree *subtree = &shadow->subtrees[active];
+		if (!subtree->tree) {
+			continue;
+		}
+		wlr_scene_node_set_enabled(&subtree->tree->node,
+			(active == SSD_ACTIVE) == shadow->active);
+		set_subtree_geometry(subtree, active, view->current.width,
+			height, 0);
+	}
+}
+
+void
+csd_shadow_set_active(struct view *view, bool active)
+{
+	assert(view);
+	if (!view->csd_shadow) {
+		return;
+	}
+	view->csd_shadow->active = active;
+	csd_shadow_update(view);
+}
+
+void
+csd_shadow_destroy(struct view *view)
+{
+	assert(view);
+	if (!view->csd_shadow) {
+		return;
+	}
+	wlr_scene_node_destroy(&view->csd_shadow->tree->node);
+	zfree(view->csd_shadow);
+}
