+/*
+ * Lay out one active-state shadow around a width x height window whose top
+ * edge is titlebar_height above the subtree's parent origin.
+ */
+static void
+set_subtree_geometry(struct ssd_shadow_subtree *subtree,
+		enum ssd_active_state active, int width, int height,
+		int titlebar_height)
+{
+	struct theme *theme = rc.theme;
+	int visible_shadow_width = theme->window[active].shadow_size;
+	/* inset in actual pixels, as a proportion of shadow width */
+	int inset = SSD_SHADOW_INSET * (double)visible_shadow_width;
+	/*
+	 * Total size of corner buffers including inset and visible portion.
+	 * The buffers are square so width == height.
+	 */
+	int corner_size =
+		theme->window[active].shadow_corner_top->logical_height;
+	int offset_y = MIN(theme->window[active].shadow_offset_y,
+		visible_shadow_width);
+
+	/*
+	 * A light source above the window casts its shadow downwards: lay the
+	 * shadow out for the window with its top edge offset_y lower. The
+	 * bottom stays on the real bottom edge, so it never leaves a gap, and
+	 * the top and upper sides show less shadow than the bottom.
+	 */
+	offset_y = MIN(offset_y, MAX(height - 1, 0));
+	wlr_scene_node_set_position(&subtree->tree->node, 0, offset_y);
+	set_shadow_parts_geometry(subtree, width, height - offset_y,
+		titlebar_height, corner_size, inset, visible_shadow_width);
+}
