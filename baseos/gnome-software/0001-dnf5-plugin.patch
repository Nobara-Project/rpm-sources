+ */
+
+/*
+ * SECTION: dnf5 plugin.
+ *
+ * Talks to dnf5 to manage packages through dnf.
+ */
+
+#include <config.h>
+
+#include <glib/gi18n-lib.h>
+#include <gnome-software.h>
+
+#include "gs-app-private.h"
