dontChroot: false
timeout: 36000
verbose: false
script:
    - command: "/bin/kernel-install add $(uname -r) /lib/modules/$(uname -r)/vmlinuz"
      timeout: 3600
    - command: "/usr/sbin/grub2-mkconfig -o /boot/grub2/grub.cfg"
      timeout: 3600
    - command: "/usr/bin/dracut -f"
      timeout: 3600
    - "echo \"search --no-floppy --fs-uuid --set=dev $(cat /etc/fstab | grep boot | grep -v efi | cut -d \" \" -f 1 | cut -d \"=\" -f 2)\" > /boot/efi/EFI/fedora/grub.cfg"
    - "echo \"set prefix=($$dev)/grub2\" >> /boot/efi/EFI/fedora/grub.cfg"
    - "echo \"export $$prefix\" >> /boot/efi/EFI/fedora/grub.cfg"
    - "echo \"configfile $$prefix/grub.cfg\" >> /boot/efi/EFI/fedora/grub.cfg"
    - "echo 'Exec=steam steam://unlockh264' >> /usr/share/applications/steam.desktop"
    - "echo 'yes' > /etc/nobara/newinstall"
    - "authselect enable-feature with-fingerprint"
    - "mv /etc/resolv.conf /etc/resolv.conf.bak"
    - "echo 'nameserver 127.0.0.53' > /etc/resolv.conf"
    - "echo 'options edns0 trust-ad' >> /etc/resolv.conf"
    - "echo 'search Home' >> /etc/resolv.conf"
    - >
      bash -ce '
        if [ -n "${gs[nobara.update]}" ]; then
          nobara-sync cli
        fi
        if [ -n "${gs[nobara.codecs]}" ]; then
          nobara-sync install-codecs
        fi
        if [ -n "${gs[nobara.codecsrepo]}" ]; then
          dnf config-manager setopt nobara-pikaos-additional.enabled=1
          sed -i "s/enabled=0/enabled=1/g" /etc/yum.repos.d/nobara-pikaos-additional.repo
        fi
      '
    - "rm /etc/resolv.conf"
    - "mv /etc/resolv.conf.bak /etc/resolv.conf"
    - command: "sed -i 's/^Session=.*/Session=gamescope-session-steam.desktop/g' /etc/plasmalogin.conf"
      timeout: 3600
    - command: "sed -i '/Session=gamescope-session-steam.desktop/a\\Relogin=true' /etc/plasmalogin.conf"
      timeout: 3600
    - command: "sed -i '/Relogin=true/a\\User=nobara-user' /etc/plasmalogin.conf"
      timeout: 3600
    - command: "useradd -m -d /home/nobara-user -G wheel,users -s /bin/bash nobara-user"
      timeout: 3600
    - command: "echo \"nobara-user\" | tee /etc/nopasswdusers"
      timeout: 3600
    - command: "authselect create-profile passwordless-user -b local --symlink-meta --symlink-pam"
      timeout: 3600
    - command: "sed -i '/^auth/ i auth        [success=done default=ignore] pam_succeed_if.so user = nobara-user' /etc/authselect/custom/passwordless-user/system-auth /etc/authselect/custom/passwordless-user/password-auth"
      timeout: 3600
    - command: "authselect select custom/passwordless-user --force"
      timeout: 3600
    - command: "authselect apply-changes"
      timeout: 3600
    - command: "mkdir -p /etc/systemd/system/getty@tty1.service.d"
      timeout: 3600
    - command: "echo '[Service]' > /etc/systemd/system/getty@tty1.service.d/override.conf"
      timeout: 3600
    - command: "echo 'ExecStart=-/sbin/agetty --autologin nobara-user --noclear %I $$TERM' >> /etc/systemd/system/getty@tty1.service.d/override.conf"
      timeout: 3600
    - command: "sed '$!N; /^\\(.*\\)\\n\\1$/!P; D' /etc/plasmalogin.conf > /etc/plasmalogin.conf.new && mv /etc/plasmalogin.conf.new /etc/plasmalogin.conf"
      timeout: 3600
    - command: "sed -i \"s/GRUB_TIMEOUT='5'/GRUB_TIMEOUT='0'/g\" /etc/default/grub"
      timeout: 3600
    - command: "echo \"GRUB_TIMEOUT_STYLE='hidden'\" >> /etc/default/grub"
      timeout: 3600
    - command: "echo \"GRUB_HIDDEN_TIMEOUT='0'\" >> /etc/default/grub"
      timeout: 3600
    - command: "echo \"GRUB_HIDDEN_TIMEOUT_QUIET='true'\" >> /etc/default/grub"
      timeout: 3600
    - command: "echo \"GRUB_CMDLINE_LINUX='console=tty1 rd.systemd.gpt_auto=no log_buf_len=4M amd_iommu=off amdgpu.lockup_timeout=5000,10000,10000,5000 amdgpu.gttsize=8128 amdgpu.sched_hw_submission=4 ttm.pages_min=2097152audit=0 fsck.mode=auto fsck.repair=preen loglevel=3 plymouth.ignore-serial-consoles fbcon=vc:4-6 fbcon=rotate:3'\" >> /etc/default/grub"
      timeout: 3600
    - command: "/usr/sbin/grub2-mkconfig -o /boot/grub2/grub.cfg"
      timeout: 3600
    - command: "/usr/bin/plymouth-set-default-theme steamos"
      timeout: 3600
    - command: "/usr/bin/dracut --regenerate-all --force"
      timeout: 3600
    - command: "rpm -e --nodeps steamdeck-dsp"
      timeout: 3600
    - command: "rpm -e --nodeps steamdeck-firmware"
      timeout: 3600
    - command: "rpm -e --nodeps jupiter-hw-support"
      timeout: 3600
    - command: "rpm -e --nodeps jupiter-fan-control"
      timeout: 3600
    - command: "rm -Rf /etc/xdg/autostart/orientation-check.desktop /usr/bin/orientation-check"
      timeout: 3600
    - command: "mv /usr/lib/udev/rules.d/99-steamos-automount.rules.bak /usr/lib/udev/rules.d/99-steamos-automount.rules"
      timeout: 3600
    - command: "rm -Rf /home/liveuser"
      timeout: 3600
