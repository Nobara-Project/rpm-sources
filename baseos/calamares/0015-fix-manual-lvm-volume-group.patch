+// Insert/remove single rows instead of resetting the model: a reset makes every
+// combo box sharing this model jump to row 0, which pages treat as the user
+// picking another device (reverting manual partitioning edits).
 void
 DeviceModel::addDevice( Device* device )
 {
-    beginResetModel();
-    m_devices << device;
-    sortDevices( m_devices );
-    endResetModel();
+    const auto position = std::upper_bound( m_devices.cbegin(),
+                                            m_devices.cend(),
+                                            device,
+                                            []( const Device* dev1, const Device* dev2 )
+                                            { return dev1->deviceNode() < dev2->deviceNode(); } );
+    const int row = static_cast< int >( position - m_devices.cbegin() );
+    beginInsertRows( QModelIndex(), row, row );
+    m_devices.insert( row, device );
+    endInsertRows();
 }
 
 void
 DeviceModel::removeDevice( Device* device )
 {
-    beginResetModel();
-    m_devices.removeAll( device );
-    sortDevices( m_devices );
-    endResetModel();
+    const int row = static_cast< int >( m_devices.indexOf( device ) );
+    if ( row < 0 )
+    {
+        return;
+    }
+    beginRemoveRows( QModelIndex(), row, row );
+    m_devices.removeAt( row );
+    endRemoveRows();
 }
