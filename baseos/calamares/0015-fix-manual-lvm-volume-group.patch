+void
+adjustLvmFreeExtents( Device* device, qint64 delta )
+{
+    if ( device && device->type() == Device::Type::LVM_Device )
+    {
+        const auto* lvm = static_cast< const LvmDevice* >( device );
+        lvm->setFreePE( lvm->freePE() + delta );
+    }
+}
+
 }  // namespace KPMHelpers
