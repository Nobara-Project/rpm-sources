 static bool isOnlineNow()
 {
     return QProcess::execute("ping", { "-c1", "-W1", "1.1.1.1" }) == 0;
 }
 
+static bool hasNvidiaGpu()
+{
+    const QDir pciDevices( QStringLiteral( "/sys/bus/pci/devices" ) );
+    const auto devices = pciDevices.entryInfoList( QDir::Dirs | QDir::NoDotAndDotDot );
+
+    for ( const auto& device : devices )
+    {
+        QFile vendorFile( device.filePath() + QStringLiteral( "/vendor" ) );
+        QFile classFile( device.filePath() + QStringLiteral( "/class" ) );
+        if ( !vendorFile.open( QIODevice::ReadOnly ) || !classFile.open( QIODevice::ReadOnly ) )
+        {
+            continue;
+        }
+
+        const QByteArray vendor = vendorFile.readAll().trimmed();
+        const QByteArray deviceClass = classFile.readAll().trimmed();
+        if ( vendor.compare( "0x10de", Qt::CaseInsensitive ) == 0 && deviceClass.startsWith( "0x03" ) )
+        {
+            return true;
+        }
+    }
+
+    return false;
+}
