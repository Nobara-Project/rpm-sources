diff --git a/src/modules/partition/gui/ChoicePage.cpp b/src/modules/partition/gui/ChoicePage.cpp
index eb4bbc8..1428333 100644
--- a/src/modules/partition/gui/ChoicePage.cpp
+++ b/src/modules/partition/gui/ChoicePage.cpp
@@ -1670,11 +1670,22 @@ ChoicePage::updateChoiceButtonsTr()
 {
     if ( m_somethingElseButton )
     {
-        m_somethingElseButton->setText( tr( "<strong>Manual partitioning</strong><br/>"
-                                            "You can create or resize partitions yourself.<br/>"
-                                            "Having a GPT partition table and <strong>fat32 512Mb /boot partition "
-                                            "is a must for UEFI installs</strong>,<br/>"
-                                            "either use an existing without formatting or create one." ) );
+        QString text = tr( "<strong>Manual partitioning</strong><br/>"
+                           "You can create or resize partitions yourself." );
+        // m_isEfi is not set yet when the page is first translated.
+        if ( PartUtils::isEfiSystem() )
+        {
+            // Describe the configured EFI system partition; it is not /boot.
+            const QString mountPoint
+                = Calamares::JobQueue::instance()->globalStorage()->value( "efiSystemPartition" ).toString();
+            text += QStringLiteral( "<br/>" )
+                + tr( "UEFI installs need a GPT partition table and a <strong>fat32 EFI system partition "
+                      "of %1 MiB mounted at %2</strong>.<br/>"
+                      "Use an existing one without formatting, or create one." )
+                      .arg( PartUtils::efiFilesystemRecommendedSize() / ( 1024 * 1024 ) )
+                      .arg( mountPoint.isEmpty() ? QStringLiteral( "/boot/efi" ) : mountPoint );
+        }
+        m_somethingElseButton->setText( text );
     }
 }
 
