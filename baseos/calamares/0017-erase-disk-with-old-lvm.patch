+/** @brief Whether the LVM PV @p partition of @p disk keeps the disk from being erased
+ *
+ * KPMcore reports every PV that belongs to a volume group as mounted, so any
+ * disk with an earlier LVM install looked in use and "Erase disk" was hidden.
+ * The PV only stands in the way when one of its volume group's logical
+ * volumes is mounted, or when the volume group also has PVs on another disk:
+ * erasing this one would destroy the data there too. An inactive volume
+ * group is deactivated and wiped by the partitioning jobs.
+ */
+static bool
+lvmPVInUse( const DeviceModel* model, const Device* disk, const Partition* partition )
+{
+    for ( int row = 0; row < model->rowCount(); ++row )
+    {
+        auto* vg = dynamic_cast< LvmDevice* >( model->deviceForIndex( model->index( row ) ) );
+        if ( !vg || !vg->physicalVolumes().contains( partition ) )
+        {
+            continue;
+        }
+        for ( const Partition* pv : vg->physicalVolumes() )
+        {
+            if ( pv->devicePath() != disk->deviceNode() )
+            {
+                cDebug() << Logger::SubEntry << "volume group" << vg->name() << "also uses" << pv->partitionPath();
+                return true;
+            }
+        }
+        for ( auto it = PartitionIterator::begin( vg ); it != PartitionIterator::end( vg ); ++it )
+        {
+            if ( ( *it )->isMounted() )
+            {
+                cDebug() << Logger::SubEntry << "volume group" << vg->name() << "has mounted" << ( *it )->partitionPath();
+                return true;
+            }
+        }
+        return false;
+    }
+    // Not part of a volume group KPMcore could set up, nothing of it is mounted
+    return false;
+}
