+/** @brief Release and wipe what the old partitions of @p diskNode held
+ *
+ * A new partition table replaces every partition, but sfdisk only wipes the
+ * signatures at the start of the disk. A new partition at the offset of an
+ * old one, as when reinstalling with the same layout, still carries the old
+ * LVM PV label: pvcreate then refuses it as part of the old volume group, and
+ * an active volume group or open LUKS mapping keeps the disk busy.
+ * ClearMountsJob only deactivates volume groups whose PV path names the disk,
+ * which misses PVs inside LUKS.
+ *
+ * Returns an empty string, or what could not be released.
+ */
+static QString
+releaseOldContents( const QString& diskNode )
+{
+    using std::chrono::seconds;
+    auto run = []( const QStringList& args ) { return Calamares::System::runCommand( args, seconds( 60 ) ); };
+
+    const auto lsblk = run( { "lsblk", "-nrpo", "NAME,TYPE", diskNode } );
+    if ( lsblk.getExitCode() != 0 )
+    {
+        return QStringLiteral( "lsblk %1: %2" ).arg( diskNode, lsblk.getOutput() );
+    }
+    QStringList partitions, mappings, volumeGroups;
+    for ( const QString& line : lsblk.getOutput().split( '\n', Qt::SkipEmptyParts ) )
+    {
+        const QStringList fields = line.simplified().split( ' ' );
+        if ( fields.count() != 2 )
+        {
+            continue;
+        }
+        const QString& node = fields.at( 0 );
+        const QString& type = fields.at( 1 );
+        if ( type == "part" )
+        {
+            partitions << node;
+        }
+        else if ( type == "crypt" )
+        {
+            mappings << node;
+        }
+        else if ( type == "lvm" )
+        {
+            const auto vg = run( { "lvm", "lvs", "--noheadings", "-o", "vg_name", node } );
+            if ( vg.getExitCode() == 0 && !vg.getOutput().trimmed().isEmpty() )
+            {
+                volumeGroups << vg.getOutput().trimmed();
+            }
+        }
+    }
+    volumeGroups.removeDuplicates();
+    mappings.removeDuplicates();
+    partitions.removeDuplicates();
+
+    QStringList failed;
+    for ( const QString& vg : std::as_const( volumeGroups ) )
+    {
+        cDebug() << Logger::SubEntry << "deactivating volume group" << vg;
+        if ( run( { "lvm", "vgchange", "-an", vg } ).getExitCode() != 0 )
+        {
+            failed << QStringLiteral( "volume group %1" ).arg( vg );
+        }
+    }
+    // lsblk lists parents first, so close nested mappings first
+    for ( auto it = mappings.crbegin(); it != mappings.crend(); ++it )
+    {
+        cDebug() << Logger::SubEntry << "closing" << *it;
+        if ( run( { "cryptsetup", "close", *it } ).getExitCode() != 0 )
+        {
+            failed << *it;
+        }
+    }
+    if ( !failed.isEmpty() )
+    {
+        return failed.join( ", " );
+    }
+    for ( const QString& partition : std::as_const( partitions ) )
+    {
+        cDebug() << Logger::SubEntry << "wiping signatures on" << partition;
+        if ( run( { "wipefs", "--all", partition } ).getExitCode() != 0 )
+        {
+            failed << partition;
+        }
+    }
+    run( { "udevadm", "settle" } );
+    return failed.join( ", " );
+}
