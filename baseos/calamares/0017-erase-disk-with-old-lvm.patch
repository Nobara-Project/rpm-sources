+/** @brief Disks first, then volume groups, each by device node
+ *
+ * A volume group's node is /dev/<vg name>, so an earlier LVM install
+ * (/dev/nobara_...) sorted before /dev/nvme* and /dev/sd* and became the
+ * device the installer selects by default.
+ */
+static bool
+deviceLess( const Device* dev1, const Device* dev2 )
+{
+    const bool vg1 = dev1->type() == Device::Type::LVM_Device;
+    const bool vg2 = dev2->type() == Device::Type::LVM_Device;
+    if ( vg1 != vg2 )
+    {
+        return vg2;
+    }
+    return dev1->deviceNode() < dev2->deviceNode();
+}
