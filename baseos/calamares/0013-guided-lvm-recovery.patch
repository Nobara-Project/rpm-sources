@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace NobaraLvm
+{
+constexpr std::uint64_t MiB = 1024ULL * 1024;
+constexpr std::uint64_t GiB = 1024ULL * MiB;
+constexpr std::uint64_t extent = 4 * MiB;
+constexpr std::uint64_t up( std::uint64_t n ) { return ( n + extent - 1 ) / extent * extent; }
+constexpr std::uint64_t down( std::uint64_t n ) { return n / extent * extent; }
+struct Layout { std::uint64_t root = 0, home = 0, reserve = 0, swap = 0; bool valid = false; };
+inline Layout plan( std::uint64_t pvBytes, std::uint64_t swapBytes, std::uint64_t requiredBytes )
+{
+    Layout p;
+    // Covers LUKS2 header, PV metadata, alignment and a little spare VG space.
+    constexpr auto overhead = 64 * MiB;
+    p.swap = up( swapBytes );
+    if ( pvBytes <= overhead + p.swap ) return p;
+    const auto available = down( pvBytes - overhead - p.swap );
+    const auto minimum = up( std::max( 16 * GiB, requiredBytes * 3 / 2 ) );
+    p.root = down( std::min( 96 * GiB, available * 45 / 100 ) );
+    p.reserve = up( p.root * 105 / 100 + 8 * MiB );
+    if ( p.root < minimum || available < p.root + p.reserve + 4 * GiB ) return p;
+    p.home = available - p.root - p.reserve;
+    p.valid = true;
+    return p;
+}
+}
