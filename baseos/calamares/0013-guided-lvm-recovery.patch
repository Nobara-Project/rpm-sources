+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Provision only the NEW PV from Nobara's erase-disk plan.
+
+KPMcore owns disk partitioning and LUKS setup. This job runs before mount and
+exports real filesystem UUIDs/devices for mount, fstab and bootloader jobs.
+Never adopts an existing VG or formats a device based on a guessed disk name.
+"""
+from decimal import Decimal
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import stat
+import subprocess
+import uuid
+
+import libcalamares
+
+EXTENT = 4 * 1024**2
+GIB = 1024**3
+
+
+def output(args):
+    return subprocess.run(args, check=True, text=True, capture_output=True, env=dict(os.environ, LC_ALL="C")).stdout.strip()
+
+
+def report(kind, fields, device):
+    return json.loads(output(["lvm", kind + "s", "--reportformat", "json", "--units", "b", "--nosuffix", "-o", fields, device]))["report"][0][kind]
+
+
+def valid_plan(plan):
+    if set(plan) != {"rootBytes", "homeBytes", "reserveBytes", "swapBytes"}:
+        raise RuntimeError("The LVM layout is incomplete; return to the partition page.")
+    if any(type(n) is not int or n < 0 or n % EXTENT for n in plan.values()):
+        raise RuntimeError("Invalid LVM volume sizes.")
+    needed = (plan["rootBytes"] * 105 // 100 + 8 * 1024**2 + EXTENT - 1) // EXTENT * EXTENT
+    if plan["rootBytes"] < 16 * GIB or plan["homeBytes"] < 4 * GIB or plan["reserveBytes"] < needed:
+        raise RuntimeError("Insufficient system, home or rollback capacity.")
+
+
+def create():
+    gs = libcalamares.globalstorage
+    fs = gs.value("nobaraLvmFileSystem")
+    if not fs:
+        return
+    if fs not in {"ext4", "xfs"} or gs.value("nobaraLvmCreated"):
+        raise RuntimeError("Invalid or already executed LVM installation plan.")
+    if gs.value("nobaraLvmError"):
+        raise RuntimeError("The selected disk cannot hold this LVM layout.")
+    plan = gs.value("nobaraLvmPlan")
+    valid_plan(plan)
+    for program in ("lvm", "blkid", "udevadm", "mkfs." + fs, "mkswap", "lvmdevices"):
+        if not shutil.which(program):
+            raise RuntimeError("Missing LVM installation tool: " + program)
+    if fs == "ext4" and not shutil.which("tune2fs"):
+        raise RuntimeError("Missing ext4 feature verification tool: tune2fs")
+    partitions = gs.value("partitions")
+    roots = [p for p in partitions if p.get("mountPoint") == "/"]
+    if len(roots) != 1 or not roots[0].get("claimed"):
+        raise RuntimeError("The erase-disk plan did not create exactly one new root PV.")
+    root = roots[0]
+    mapper = root.get("luksMapperName")
+    if mapper and not re.fullmatch(r"[A-Za-z0-9_+.-]+", mapper):
+        raise RuntimeError("Invalid encrypted PV mapping.")
+    pv = "/dev/mapper/" + mapper if mapper else root["device"]
+    if not pv.startswith("/dev/") or not stat.S_ISBLK(os.stat(pv).st_mode):
+        raise RuntimeError("The new PV is not a block device.")
+    if output(["blkid", "-s", "TYPE", "-o", "value", pv]) != "LVM2_member":
+        raise RuntimeError("The partition job did not create the expected LVM PV.")
+    records = report("pv", "pv_name,pv_uuid,vg_name,pv_size", pv)
+    if len(records) != 1 or records[0]["vg_name"].strip():
+        raise RuntimeError("Refusing to use a PV that already belongs to a volume group.")
+    if os.path.realpath(records[0]["pv_name"].strip()) != os.path.realpath(pv):
+        raise RuntimeError("The PV device does not match the erase-disk plan.")
+    if int(Decimal(records[0]["pv_size"].strip())) < sum(plan.values()) + EXTENT:
+        raise RuntimeError("The actual PV is smaller than the reviewed layout.")
+    # A random name avoids colliding with any other installed system's VG.
+    vg = "nobara_" + uuid.uuid4().hex[:12]
+    output(["lvm", "vgcreate", "--physicalextentsize", "4M", "--devices", pv, vg, pv])
+    free = report("vg", "vg_free", vg)
+    if len(free) != 1 or int(Decimal(free[0]["vg_free"].strip())) < sum(plan.values()):
+        raise RuntimeError("The volume group cannot hold the reviewed layout.")
+    for name, key in (("root", "rootBytes"), ("home", "homeBytes"), ("swap", "swapBytes"), ("nobara_reserve", "reserveBytes")):
+        if not plan[key]:
+            continue
+        command = ["lvm", "lvcreate", "--yes", "--devices", pv, "--size", str(plan[key]) + "B", "--name", name]
+        if name == "nobara_reserve":
+            command += ["--permission", "r", "--zero", "n", "--wipesignatures", "n", "--addtag", "nobara.rollback.reserve"]
+        output(command + [vg])
+    output(["udevadm", "settle"])
+    new = []
+    for name, mount, fstype in (("root", "/", fs), ("home", "/home", fs), ("swap", "", "linuxswap")):
+        if name == "swap" and not plan["swapBytes"]:
+            continue
+        device = "/dev/" + vg + "/" + name
+        if name == "swap":
+            output(["mkswap", "-L", "swap", device])
+        else:
+            command = ["mkfs." + fs, "-L", "nobara_" + name]
+            if fs == "ext4":
+                command += ["-O", "metadata_csum"]
+            output(command + [device])
+            if fs == "ext4":
+                features = re.search(r"(?m)^Filesystem features:\s*(.*)$", output(["tune2fs", "-l", device]))
+                if not features or "metadata_csum" not in features[1].split():
+                    raise RuntimeError("The new ext4 volume is missing metadata checksums.")
+        fsuuid = output(["blkid", "-s", "UUID", "-o", "value", device])
+        if not re.fullmatch(r"[0-9a-fA-F-]{36}", fsuuid):
+            raise RuntimeError("Cannot identify the newly created filesystem.")
+        # Do not copy luksMapperName: mount would mount the PV instead of LV.
+        new.append(dict(device=device, mountPoint=mount, fs=fstype, fsName=fstype,
+                        uuid=fsuuid, claimed=True, features={}, partlabel="", partuuid="", parttype="", partattrs=0))
+    container = dict(root, mountPoint="")
+    container.pop("luksPassphrase", None)
+    gs.insert("partitions", [p for p in partitions if p is not root] + [container] + new)
+    filesystems = gs.value("filesystem_use") or {}
+    filesystems[fs] = 2
+    gs.insert("filesystem_use", filesystems)
+    params = ["rd.lvm.lv=" + vg + "/root"]
+    if plan["swapBytes"]:
+        params.append("rd.lvm.lv=" + vg + "/swap")
+    if mapper:
+        luks_uuid = root.get("luksUuid", "")
+        if not re.fullmatch(r"[0-9a-fA-F-]{36}", luks_uuid):
+            raise RuntimeError("The encrypted PV UUID is missing.")
+        params.append("rd.luks.uuid=" + luks_uuid)
+        params.append("rd.luks.options=" + luks_uuid + "=discard,x-initrd.attach")
+    gs.insert("nobaraLvmKernelParams", params)
+    gs.insert("nobaraLvmCreated", dict(vg=vg, pv=pv, fs=fs, encrypted=bool(mapper), **plan))
+    os.sync()
+
+
+def configure():
+    gs = libcalamares.globalstorage
+    lvm = bool(gs.value("nobaraLvmFileSystem"))
+    if not lvm and not gs.value("nobaraGuidedStorage"):
+        return
+    created = gs.value("nobaraLvmCreated")
+    if lvm and not created:
+        raise RuntimeError("The LVM volumes have not been created.")
+    root = Path(gs.value("rootMountPoint"))
+    if not root.is_absolute() or root == Path("/") or not root.is_mount():
+        raise RuntimeError("The installed target is not mounted.")
+    if lvm:
+        # The ISO may carry a device inventory from its build machine. Generate
+        # a target-specific inventory while /dev and the encrypted PV are open.
+        inventory = root / "etc/lvm/devices/system.devices"
+        inventory.unlink(missing_ok=True)
+        if libcalamares.utils.target_env_call(["lvmdevices", "--adddev", created["pv"]]) != 0:
+            raise RuntimeError("Could not configure the target LVM device inventory.")
+        conf = root / "etc/dracut.conf.d/90-nobara-lvm.conf"
+        conf.parent.mkdir(parents=True, exist_ok=True)
+        params = " ".join(gs.value("nobaraLvmKernelParams"))
+        conf.write_text('add_dracutmodules+=" lvm crypt systemd-cryptsetup "\nadd_drivers+=" dm_snapshot "\n'
+                        'kernel_cmdline+=" ' + params + ' "\n')
+        # Weekly fstrim batches discards. No synchronous discard mount option is
+        # needed; HDDs without discard support are skipped by the packaged unit.
+        if not (root / "usr/lib/systemd/system/fstrim.timer").is_file():
+            raise RuntimeError("The installed system is missing fstrim.timer.")
+        output(["systemctl", "--root=" + str(root), "enable", "fstrim.timer"])
+        if created["encrypted"]:
+            outer = next(p for p in gs.value("partitions") if p.get("luksMapperName")
+                         and "/dev/mapper/" + p["luksMapperName"] == created["pv"])
+            table = root / "etc/crypttab"
+            lines = table.read_text().splitlines()
+            matching = [i for i, line in enumerate(lines) if line.split() and line.split()[0] == outer["luksMapperName"]]
+            if len(matching) != 1:
+                raise RuntimeError("The encrypted LVM container is missing from crypttab.")
+            # The unencrypted boot partition must never contain an unlock key.
+            lines[matching[0]] = outer["luksMapperName"] + " UUID=" + outer["luksUuid"] + " none luks,discard,x-initrd.attach"
+            table.write_text("\n".join(lines) + "\n")
+    # Block an offline update before RPM writes if recovery becomes unavailable.
+    policy = root / "etc/nobara-updater/offline.json"
+    policy.parent.mkdir(parents=True, exist_ok=True)
+    settings = json.loads(policy.read_text()) if policy.exists() else {}
+    settings["require_offline_recovery"] = True
+    policy.write_text(json.dumps(settings, indent=2) + "\n")
+    (policy.parent / "storage.json").write_text(json.dumps(created or {"fs": "btrfs"}, indent=2) + "\n")
+    defaults = root / "etc/default/grub"
+    text = defaults.read_text() if defaults.exists() else ""
+    text = re.sub(r"(?m)^\s*GRUB_DEFAULT=.*\n?", "", text)
+    defaults.write_text(text.rstrip() + "\nGRUB_DEFAULT=saved\n")
+    os.sync()
+
+
+def pretty_name():
+    return "Configure automatic system recovery" if libcalamares.job.configuration.get("phase") == "configure" else "Create LVM system, home and rollback storage"
+
+
+def run():
+    try:
+        phase = libcalamares.job.configuration.get("phase", "create")
+        if phase == "create":
+            create()
+        elif phase == "configure":
+            configure()
+        else:
+            raise RuntimeError("Unknown LVM installation phase.")
+    except (OSError, ValueError, KeyError, RuntimeError, subprocess.CalledProcessError) as error:
+        # Passphrases never enter subprocess arguments or our persisted state.
+        return ("Unable to configure automatic rollback", str(error))
+    return None
