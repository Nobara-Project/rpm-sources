+ShellProcessJob::prettyStatusMessage() const
+{
+    const int currentCommand = m_currentCommand.load( std::memory_order_acquire );
+    if ( currentCommand < 0 || static_cast< std::size_t >( currentCommand ) >= m_commands.size() )
