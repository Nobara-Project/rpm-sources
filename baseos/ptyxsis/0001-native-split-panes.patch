diff --git a/src/ptyxis-pane.c b/src/ptyxis-pane.c
new file mode 100644
index 0000000..a7de98f
--- /dev/null
+++ b/src/ptyxis-pane.c
@@ -0,0 +1,444 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "config.h"
+#include <math.h>
+
+#include "ptyxis-pane.h"
+
+/* A page owns a binary tree of GtkPaned nodes. Leaves are independent
+ * terminal sessions; reparenting them must never restart their processes.
+ */
+struct _PtyxisPane
+{
+  GtkWidget parent_instance;
+  GtkWidget *tree;
+  GtkWidget *active;
+};
+
+G_DEFINE_FINAL_TYPE (PtyxisPane, ptyxis_pane, GTK_TYPE_WIDGET)
+
+enum { PROP_0, PROP_ACTIVE, N_PROPS };
+static GParamSpec *properties[N_PROPS];
+
+static void
+collect_children (GtkWidget *node,
+                  GPtrArray *children)
+{
+  if (GTK_IS_PANED (node))
+    {
+      collect_children (gtk_paned_get_start_child (GTK_PANED (node)), children);
+      collect_children (gtk_paned_get_end_child (GTK_PANED (node)), children);
+    }
+  else if (node != NULL)
+    g_ptr_array_add (children, g_object_ref (node));
+}
+
+GPtrArray *
+ptyxis_pane_list_children (PtyxisPane *self)
+{
+  GPtrArray *children = g_ptr_array_new_with_free_func (g_object_unref);
+  collect_children (self->tree, children);
+  return children;
+}
+
+void
+ptyxis_pane_set_active (PtyxisPane *self,
+                        GtkWidget  *child)
+{
+  g_return_if_fail (PTYXIS_IS_PANE (self));
+  g_return_if_fail (child != NULL && gtk_widget_is_ancestor (child, GTK_WIDGET (self)));
+
+  if (self->active == child)
+    return;
+
+  if (self->active != NULL)
+    gtk_widget_remove_css_class (self->active, "active-pane");
+  self->active = child;
+  gtk_widget_add_css_class (child, "active-pane");
+  g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_ACTIVE]);
+}
+
+GtkWidget *
+ptyxis_pane_get_active (PtyxisPane *self)
+{
+  g_return_val_if_fail (PTYXIS_IS_PANE (self), NULL);
+  return self->active;
+}
+
+static void
+focus_enter (GtkEventControllerFocus *controller,
+             gpointer                 user_data)
+{
+  GtkWidget *child = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (controller));
+  GtkWidget *pane = gtk_widget_get_ancestor (child, PTYXIS_TYPE_PANE);
+
+  if (pane != NULL)
+    ptyxis_pane_set_active (PTYXIS_PANE (pane), child);
+}
+
+static void
+watch_child (GtkWidget *child)
+{
+  GtkEventController *controller;
+
+  if (g_object_get_data (G_OBJECT (child), "ptyxis-pane-focus") != NULL)
+    return;
+
+  controller = gtk_event_controller_focus_new ();
+  g_signal_connect (controller, "enter", G_CALLBACK (focus_enter), NULL);
+  gtk_widget_add_controller (child, controller);
+  g_object_set_data (G_OBJECT (child), "ptyxis-pane-focus", controller);
+}
+
+static void
+ptyxis_pane_dispose (GObject *object)
+{
+  PtyxisPane *self = PTYXIS_PANE (object);
+  self->active = NULL;
+  g_clear_pointer (&self->tree, gtk_widget_unparent);
+  G_OBJECT_CLASS (ptyxis_pane_parent_class)->dispose (object);
+}
+
+static void
+ptyxis_pane_get_property (GObject *object, guint prop_id,
+                          GValue *value, GParamSpec *pspec)
+{
+  if (prop_id == PROP_ACTIVE)
+    g_value_set_object (value, PTYXIS_PANE (object)->active);
+  else
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+}
+
+static gboolean
+ptyxis_pane_grab_focus (GtkWidget *widget)
+{
+  GtkWidget *active = PTYXIS_PANE (widget)->active;
+  return active != NULL && gtk_widget_grab_focus (active);
+}
+
+static void
+ptyxis_pane_class_init (PtyxisPaneClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->dispose = ptyxis_pane_dispose;
+  object_class->get_property = ptyxis_pane_get_property;
+  widget_class->grab_focus = ptyxis_pane_grab_focus;
+  gtk_widget_class_set_layout_manager_type (widget_class, GTK_TYPE_BIN_LAYOUT);
+  gtk_widget_class_set_css_name (widget_class, "ptyxispane");
+  properties[PROP_ACTIVE] = g_param_spec_object ("active", NULL, NULL,
+                                                GTK_TYPE_WIDGET,
+                                                G_PARAM_READABLE | G_PARAM_STATIC_STRINGS);
+  g_object_class_install_properties (object_class, N_PROPS, properties);
+}
+
+static void
+ptyxis_pane_init (PtyxisPane *self)
+{
+  gtk_widget_set_hexpand (GTK_WIDGET (self), TRUE);
+  gtk_widget_set_vexpand (GTK_WIDGET (self), TRUE);
+}
+
+PtyxisPane *
+ptyxis_pane_new (GtkWidget *child)
+{
+  PtyxisPane *self = g_object_new (PTYXIS_TYPE_PANE, NULL);
+  self->tree = child;
+  watch_child (child);
+  gtk_widget_set_parent (child, GTK_WIDGET (self));
+  ptyxis_pane_set_active (self, child);
+  return self;
+}
+
+static gboolean
+set_initial_position (GtkWidget *widget, GdkFrameClock *clock, gpointer data)
+{
+  GtkOrientation orientation = gtk_orientable_get_orientation (GTK_ORIENTABLE (widget));
+  int size = orientation == GTK_ORIENTATION_HORIZONTAL
+           ? gtk_widget_get_width (widget) : gtk_widget_get_height (widget);
+  double *ratio = g_object_get_data (G_OBJECT (widget), "ptyxis-initial-ratio");
+
+  if (size <= 1)
+    return G_SOURCE_CONTINUE;
+
+  gtk_paned_set_position (GTK_PANED (widget), size * *ratio);
+  g_object_set_data (G_OBJECT (widget), "ptyxis-initial-ratio", NULL);
+  return G_SOURCE_REMOVE;
+}
+
+static GtkWidget *
+new_split (GtkOrientation orientation, double ratio)
+{
+  GtkWidget *split = gtk_paned_new (orientation);
+  double *initial_ratio = g_new (double, 1);
+
+  *initial_ratio = ratio;
+  g_object_set_data_full (G_OBJECT (split), "ptyxis-initial-ratio", initial_ratio, g_free);
+  gtk_paned_set_wide_handle (GTK_PANED (split), TRUE);
+  gtk_paned_set_resize_start_child (GTK_PANED (split), TRUE);
+  gtk_paned_set_resize_end_child (GTK_PANED (split), TRUE);
+  gtk_paned_set_shrink_start_child (GTK_PANED (split), FALSE);
+  gtk_paned_set_shrink_end_child (GTK_PANED (split), FALSE);
+  gtk_widget_add_tick_callback (split, set_initial_position, NULL, NULL);
+  return split;
+}
+
+/* Caller holds references across detach, including to the parent when
+ * replacing a split with its surviving subtree.
+ */
+static void
+replace_child (PtyxisPane *self, GtkWidget *parent,
+               GtkWidget *old_child, GtkWidget *new_child)
+{
+  if (parent == GTK_WIDGET (self))
+    {
+      gtk_widget_unparent (old_child);
+      self->tree = new_child;
+      if (new_child != NULL)
+        gtk_widget_set_parent (new_child, parent);
+    }
+  else if (gtk_paned_get_start_child (GTK_PANED (parent)) == old_child)
+    gtk_paned_set_start_child (GTK_PANED (parent), new_child);
+  else
+    gtk_paned_set_end_child (GTK_PANED (parent), new_child);
+}
+
+/* GtkPaned remembers focused descendants. Clear the root's focus before
+ * detaching a focused subtree so it cannot traverse a half-rebuilt tree.
+ */
+static gboolean
+clear_subtree_focus (GtkWidget *subtree)
+{
+  GtkRoot *root = gtk_widget_get_root (subtree);
+  GtkWidget *focus = root ? gtk_root_get_focus (root) : NULL;
+  if (focus != NULL && (focus == subtree || gtk_widget_is_ancestor (focus, subtree)))
+    {
+      gtk_root_set_focus (root, NULL);
+      return TRUE;
+    }
+  return FALSE;
+}
+
+void
+ptyxis_pane_split (PtyxisPane *self, GtkWidget *child,
+                   GtkWidget *new_child, GtkOrientation orientation)
+{
+  GtkWidget *parent;
+  GtkWidget *split;
+
+  g_return_if_fail (gtk_widget_is_ancestor (child, GTK_WIDGET (self)));
+  g_return_if_fail (gtk_widget_get_parent (new_child) == NULL);
+  parent = gtk_widget_get_parent (child);
+  split = new_split (orientation, .5);
+
+  clear_subtree_focus (child);
+  g_object_ref (child);
+  replace_child (self, parent, child, split);
+  gtk_paned_set_start_child (GTK_PANED (split), child);
+  gtk_paned_set_end_child (GTK_PANED (split), new_child);
+  g_object_unref (child);
+  watch_child (new_child);
+  gtk_widget_add_css_class (GTK_WIDGET (self), "split");
+  ptyxis_pane_set_active (self, new_child);
+}
+
+gboolean
+ptyxis_pane_remove (PtyxisPane *self, GtkWidget *child)
+{
+  g_autoptr(GtkWidget) parent = NULL;
+  g_autoptr(GtkWidget) sibling = NULL;
+  g_autoptr(GPtrArray) children = NULL;
+  GtkWidget *grandparent;
+  gboolean was_active;
+  gboolean restore_focus;
+
+  g_return_val_if_fail (gtk_widget_is_ancestor (child, GTK_WIDGET (self)), FALSE);
+  if (self->tree == child)
+    return FALSE;
+
+  parent = g_object_ref (gtk_widget_get_parent (child));
+  grandparent = gtk_widget_get_parent (parent);
+  restore_focus = clear_subtree_focus (parent);
+  sibling = g_object_ref (gtk_paned_get_start_child (GTK_PANED (parent)) == child
+                        ? gtk_paned_get_end_child (GTK_PANED (parent))
+                        : gtk_paned_get_start_child (GTK_PANED (parent)));
+  was_active = self->active == child;
+  if (was_active)
+    {
+      gtk_widget_remove_css_class (child, "active-pane");
+      self->active = NULL;
+    }
+  gtk_paned_set_start_child (GTK_PANED (parent), NULL);
+  gtk_paned_set_end_child (GTK_PANED (parent), NULL);
+  replace_child (self, grandparent, parent, sibling);
+  children = ptyxis_pane_list_children (self);
+  if (was_active)
+    {
+      g_autoptr(GPtrArray) survivors = g_ptr_array_new_with_free_func (g_object_unref);
+      collect_children (sibling, survivors);
+      ptyxis_pane_set_active (self, g_ptr_array_index (survivors, 0));
+    }
+  if (children->len == 1)
+    gtk_widget_remove_css_class (GTK_WIDGET (self), "split");
+  if (restore_focus)
+    gtk_widget_grab_focus (self->active);
+  return TRUE;
+}
+
+void
+ptyxis_pane_focus_next (PtyxisPane *self, int step)
+{
+  g_autoptr(GPtrArray) children = ptyxis_pane_list_children (self);
+  guint index;
+  if (g_ptr_array_find (children, self->active, &index))
+    {
+      int next = ((int)index + step + (int)children->len) % (int)children->len;
+      ptyxis_pane_set_active (self, g_ptr_array_index (children, next));
+      gtk_widget_grab_focus (self->active);
+    }
+}
+
+void
+ptyxis_pane_focus_direction (PtyxisPane *self, GtkDirectionType direction)
+{
+  g_autoptr(GPtrArray) children = ptyxis_pane_list_children (self);
+  graphene_rect_t from;
+  GtkWidget *best = NULL;
+  double best_score = G_MAXDOUBLE;
+  gboolean horizontal = direction == GTK_DIR_LEFT || direction == GTK_DIR_RIGHT;
+
+  if (self->active == NULL ||
+      !gtk_widget_compute_bounds (self->active, GTK_WIDGET (self), &from))
+    return;
+  for (guint i = 0; i < children->len; i++)
+    {
+      GtkWidget *child = g_ptr_array_index (children, i);
+      graphene_rect_t to;
+      double dx, dy, primary, secondary, score;
+      if (child == self->active || !gtk_widget_compute_bounds (child, GTK_WIDGET (self), &to))
+        continue;
+      dx = to.origin.x + to.size.width / 2 - from.origin.x - from.size.width / 2;
+      dy = to.origin.y + to.size.height / 2 - from.origin.y - from.size.height / 2;
+      primary = horizontal ? dx : dy;
+      if (direction == GTK_DIR_LEFT || direction == GTK_DIR_UP)
+        primary = -primary;
+      if (primary <= 0)
+        continue;
+      secondary = horizontal ? fabs (dy) : fabs (dx);
+      score = primary + secondary * 4;
+      if (score < best_score)
+        {
+          best = child;
+          best_score = score;
+        }
+    }
+  if (best != NULL)
+    {
+      ptyxis_pane_set_active (self, best);
+      gtk_widget_grab_focus (best);
+    }
+}
+
+static GVariant *
+save_node (GtkWidget *node, guint *index)
+{
+  GVariantBuilder builder;
+  g_variant_builder_init (&builder, G_VARIANT_TYPE_VARDICT);
+  if (GTK_IS_PANED (node))
+    {
+      GtkOrientation orientation = gtk_orientable_get_orientation (GTK_ORIENTABLE (node));
+      double *initial = g_object_get_data (G_OBJECT (node), "ptyxis-initial-ratio");
+      int size = orientation == GTK_ORIENTATION_HORIZONTAL
+               ? gtk_widget_get_width (node) : gtk_widget_get_height (node);
+      double ratio = initial ? *initial : size > 0 ? (double)gtk_paned_get_position (GTK_PANED (node)) / size : .5;
+      g_variant_builder_add (&builder, "{sv}", "orientation", g_variant_new_uint32 (orientation));
+      g_variant_builder_add (&builder, "{sv}", "ratio", g_variant_new_double (CLAMP (ratio, .001, .999)));
+      g_variant_builder_add (&builder, "{sv}", "first", save_node (gtk_paned_get_start_child (GTK_PANED (node)), index));
+      g_variant_builder_add (&builder, "{sv}", "second", save_node (gtk_paned_get_end_child (GTK_PANED (node)), index));
+    }
+  else
+    g_variant_builder_add (&builder, "{sv}", "index", g_variant_new_uint32 ((*index)++));
+  return g_variant_builder_end (&builder);
+}
+
+GVariant *
+ptyxis_pane_save_layout (PtyxisPane *self)
+{
+  g_autoptr(GPtrArray) children = ptyxis_pane_list_children (self);
+  guint active = 0, index = 0;
+  g_ptr_array_find (children, self->active, &active);
+  return g_variant_ref_sink (g_variant_new ("(u@a{sv})", active, save_node (self->tree, &index)));
+}
+
+/* Validate the entire tree before reparenting any children. */
+static gboolean
+validate_node (GVariant *node, guint count, gboolean *seen, guint depth)
+{
+  g_autoptr(GVariant) first = NULL;
+  g_autoptr(GVariant) second = NULL;
+  guint index, orientation;
+  double ratio;
+  if (depth > 64)
+    return FALSE;
+  if (g_variant_lookup (node, "index", "u", &index))
+    {
+      if (index >= count || seen[index])
+        return FALSE;
+      seen[index] = TRUE;
+      return TRUE;
+    }
+  first = g_variant_lookup_value (node, "first", G_VARIANT_TYPE_VARDICT);
+  second = g_variant_lookup_value (node, "second", G_VARIANT_TYPE_VARDICT);
+  return first && second &&
+         g_variant_lookup (node, "orientation", "u", &orientation) && orientation <= GTK_ORIENTATION_VERTICAL &&
+         g_variant_lookup (node, "ratio", "d", &ratio) && isfinite (ratio) && ratio > 0 && ratio < 1 &&
+         validate_node (first, count, seen, depth + 1) && validate_node (second, count, seen, depth + 1);
+}
+
+static GtkWidget *
+restore_node (GVariant *node, GPtrArray *children)
+{
+  g_autoptr(GVariant) first = NULL;
+  g_autoptr(GVariant) second = NULL;
+  guint index, orientation;
+  double ratio;
+  GtkWidget *split;
+  if (g_variant_lookup (node, "index", "u", &index))
+    {
+      GtkWidget *child = g_ptr_array_index (children, index);
+      watch_child (child);
+      return child;
+    }
+  g_variant_lookup (node, "orientation", "u", &orientation);
+  g_variant_lookup (node, "ratio", "d", &ratio);
+  first = g_variant_lookup_value (node, "first", G_VARIANT_TYPE_VARDICT);
+  second = g_variant_lookup_value (node, "second", G_VARIANT_TYPE_VARDICT);
+  split = new_split (orientation, ratio);
+  gtk_paned_set_start_child (GTK_PANED (split), restore_node (first, children));
+  gtk_paned_set_end_child (GTK_PANED (split), restore_node (second, children));
+  return split;
+}
+
+PtyxisPane *
+ptyxis_pane_restore (GPtrArray *children, GVariant *layout)
+{
+  g_autoptr(GVariant) tree = NULL;
+  g_autofree gboolean *seen = g_new0 (gboolean, children->len);
+  PtyxisPane *self;
+  guint active;
+  if (!g_variant_is_of_type (layout, G_VARIANT_TYPE ("(ua{sv})")))
+    return NULL;
+  g_variant_get (layout, "(u@a{sv})", &active, &tree);
+  if (active >= children->len || !validate_node (tree, children->len, seen, 0))
+    return NULL;
+  for (guint i = 0; i < children->len; i++)
+    if (!seen[i] || gtk_widget_get_parent (g_ptr_array_index (children, i)) != NULL)
+      return NULL;
+  self = g_object_new (PTYXIS_TYPE_PANE, NULL);
+  self->tree = restore_node (tree, children);
+  gtk_widget_set_parent (self->tree, GTK_WIDGET (self));
+  ptyxis_pane_set_active (self, g_ptr_array_index (children, active));
+  if (children->len > 1)
+    gtk_widget_add_css_class (GTK_WIDGET (self), "split");
+  return self;
+}
