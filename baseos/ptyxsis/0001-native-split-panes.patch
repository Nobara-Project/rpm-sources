diff --git a/testsuite/test-splits.c b/testsuite/test-splits.c
new file mode 100644
index 0000000..904b0ac
--- /dev/null
+++ b/testsuite/test-splits.c
@@ -0,0 +1,346 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "config.h"
+#include <adwaita.h>
+#include <sys/resource.h>
+#ifdef GDK_WINDOWING_X11
+#include <gdk/x11/gdkx.h>
+#endif
+#include "ptyxis-application.h"
+#include "ptyxis-pane.h"
+#include "ptyxis-preferences-window.h"
+#include "ptyxis-session.h"
+#include "ptyxis-window.h"
+
+gint64
+ptyxis_application_get_default_rlimit_nofile (void)
+{
+  struct rlimit limit;
+  return getrlimit (RLIMIT_NOFILE, &limit) == 0 ? limit.rlim_cur : 1024;
+}
+
+static void
+spin (guint milliseconds)
+{
+  gint64 until = g_get_monotonic_time () + milliseconds * 1000;
+  do
+    {
+      while (g_main_context_iteration (NULL, FALSE));
+      g_usleep (1000);
+    }
+  while (g_get_monotonic_time () < until);
+}
+
+static void
+assert_count (PtyxisPane *pane, guint count)
+{
+  g_autoptr(GPtrArray) children = ptyxis_pane_list_children (pane);
+  g_assert_cmpuint (children->len, ==, count);
+}
+
+static PtyxisPane *
+active_pane (PtyxisWindow *window)
+{
+  return PTYXIS_PANE (gtk_widget_get_ancestor (GTK_WIDGET (ptyxis_window_get_active_tab (window)), PTYXIS_TYPE_PANE));
+}
+
+static void
+layout_tree (void)
+{
+  GtkWidget *a = gtk_entry_new (), *b = gtk_entry_new ();
+  GtkWidget *c = gtk_entry_new (), *d = gtk_entry_new ();
+  g_autoptr(PtyxisPane) pane = g_object_ref_sink (ptyxis_pane_new (a));
+  g_autoptr(PtyxisPane) restored = NULL;
+  g_autoptr(GPtrArray) replacements = g_ptr_array_new_with_free_func (g_object_unref);
+  g_autoptr(GVariant) layout = NULL;
+  g_autoptr(GVariant) again = NULL;
+
+  ptyxis_pane_split (pane, a, b, GTK_ORIENTATION_HORIZONTAL);
+  ptyxis_pane_split (pane, a, c, GTK_ORIENTATION_VERTICAL);
+  ptyxis_pane_split (pane, b, d, GTK_ORIENTATION_VERTICAL);
+  assert_count (pane, 4);
+  g_assert_true (ptyxis_pane_get_active (pane) == d);
+  layout = ptyxis_pane_save_layout (pane);
+  for (guint i = 0; i < 4; i++)
+    g_ptr_array_add (replacements, g_object_ref_sink (gtk_entry_new ()));
+  restored = g_object_ref_sink (ptyxis_pane_restore (replacements, layout));
+  again = ptyxis_pane_save_layout (restored);
+  g_assert_true (g_variant_equal (layout, again));
+  g_assert_true (ptyxis_pane_get_active (restored) == g_ptr_array_index (replacements, 3));
+
+  /* Remove both sides of nested nodes, including an inactive pane. */
+  g_assert_true (ptyxis_pane_remove (pane, a));
+  g_assert_true (ptyxis_pane_get_active (pane) == d);
+  g_assert_true (ptyxis_pane_remove (pane, d));
+  g_assert_true (ptyxis_pane_get_active (pane) == b);
+  g_assert_true (ptyxis_pane_remove (pane, c));
+  assert_count (pane, 1);
+  g_assert_false (ptyxis_pane_remove (pane, b));
+  g_assert_true (gtk_widget_get_first_child (GTK_WIDGET (pane)) == b);
+}
+
+static void
+invalid_layout (void)
+{
+  const char *cases[] = {
+    "(uint32 0, {'index': <uint32 3>})",
+    "(uint32 0, {'orientation': <uint32 0>, 'ratio': <0.5>, 'first': <{'index': <uint32 0>}>, 'second': <{'index': <uint32 0>}>})",
+    "(uint32 0, {'orientation': <uint32 9>, 'ratio': <0.5>, 'first': <{'index': <uint32 0>}>, 'second': <{'index': <uint32 1>}>})",
+    "(uint32 2, {'index': <uint32 0>})",
+    "(uint32 0, {'index': <uint32 0>})",
+    "(uint32 0, {'orientation': <uint32 0>, 'ratio': <1.5>})",
+  };
+  g_autoptr(GPtrArray) children = g_ptr_array_new_with_free_func (g_object_unref);
+  g_ptr_array_add (children, g_object_ref_sink (gtk_entry_new ()));
+  g_ptr_array_add (children, g_object_ref_sink (gtk_entry_new ()));
+  for (guint i = 0; i < G_N_ELEMENTS (cases); i++)
+    {
+      g_autoptr(GVariant) layout = g_variant_parse (G_VARIANT_TYPE ("(ua{sv})"), cases[i], NULL, NULL, NULL);
+      g_assert_nonnull (layout);
+      g_assert_null (ptyxis_pane_restore (children, layout));
+      g_assert_null (gtk_widget_get_parent (g_ptr_array_index (children, 0)));
+      g_assert_null (gtk_widget_get_parent (g_ptr_array_index (children, 1)));
+    }
+}
+
+static void
+wait_running (PtyxisTab *tab)
+{
+  for (guint i = 0; i < 500 && ptyxis_tab_get_process (tab) == NULL; i++)
+    spin (10);
+  g_assert_nonnull (ptyxis_tab_get_process (tab));
+}
+
+static void
+send_command (PtyxisTab *tab, const char *command)
+{
+  vte_terminal_feed_child (VTE_TERMINAL (ptyxis_tab_get_terminal (tab)), command, -1);
+}
+
+static void
+assert_focus (PtyxisWindow *window, PtyxisTab *tab)
+{
+  GtkWidget *terminal = GTK_WIDGET (ptyxis_tab_get_terminal (tab));
+  g_assert_true (ptyxis_window_get_active_tab (window) == tab);
+  g_assert_true (gtk_window_get_focus (GTK_WINDOW (window)) == terminal);
+}
+
+static gboolean
+send_shortcut (PtyxisWindow *window, const char *key)
+{
+#ifdef GDK_WINDOWING_X11
+  g_autofree char *xdotool = g_find_program_in_path ("xdotool");
+  GdkSurface *surface = gtk_native_get_surface (GTK_NATIVE (window));
+  if (xdotool != NULL && GDK_IS_X11_SURFACE (surface))
+    {
+      g_autofree char *id = g_strdup_printf ("%lu", gdk_x11_surface_get_xid (surface));
+      const char *argv[] = {xdotool, "windowfocus", "--sync", id, "key", "--clearmodifiers", key, NULL};
+      g_autoptr(GError) error = NULL;
+      int status;
+      g_assert_true (g_spawn_sync (NULL, (char **)argv, NULL, G_SPAWN_DEFAULT, NULL, NULL, NULL, NULL, &status, &error));
+      g_assert_true (g_spawn_check_wait_status (status, &error));
+      spin (150);
+      return TRUE;
+    }
+#endif
+  return FALSE;
+}
+
+static void
+save_screenshot (PtyxisWindow *window)
+{
+  g_autoptr(GdkPaintable) paintable = gtk_widget_paintable_new (GTK_WIDGET (window));
+  GtkSnapshot *snapshot = gtk_snapshot_new ();
+  GskRenderNode *node;
+  g_autoptr(GdkTexture) texture = NULL;
+  int width = gtk_widget_get_width (GTK_WIDGET (window));
+  int height = gtk_widget_get_height (GTK_WIDGET (window));
+  spin (100);
+  gdk_paintable_snapshot (paintable, snapshot, width, height);
+  node = gtk_snapshot_free_to_node (snapshot);
+  g_assert_nonnull (node);
+  texture = gsk_renderer_render_texture (gtk_native_get_renderer (GTK_NATIVE (window)), node, NULL);
+  g_assert_true (gdk_texture_save_to_png (texture, "test-splits.png"));
+  gsk_render_node_unref (node);
+}
+
+static void
+integration (void)
+{
+  g_autoptr(PtyxisApplication) app = ptyxis_application_new ("org.gnome.Ptyxis.Splits.Test", G_APPLICATION_NON_UNIQUE);
+  g_autoptr(GError) error = NULL;
+  g_autoptr(PtyxisProfile) profile = NULL;
+  g_autoptr(GVariant) state = NULL;
+  PtyxisSettings *settings;
+  PtyxisWindow *window;
+  PtyxisPane *pane;
+  PtyxisTab *a, *b, *c;
+  g_autoptr(PtyxisIpcProcess) original_process = NULL;
+  g_autofree char *cwd = NULL;
+
+  g_assert_true (g_application_register (G_APPLICATION (app), NULL, &error));
+  g_assert_no_error (error);
+  settings = ptyxis_application_get_settings (app);
+  ptyxis_settings_set_prompt_on_close (settings, FALSE);
+  ptyxis_settings_set_restore_session (settings, TRUE);
+  profile = ptyxis_application_dup_default_profile (app);
+  ptyxis_profile_set_use_custom_command (profile, TRUE);
+  ptyxis_profile_set_custom_command (profile, "/bin/sh");
+  ptyxis_profile_set_exit_action (profile, PTYXIS_EXIT_ACTION_CLOSE);
+
+  window = ptyxis_window_new_for_profile (profile);
+  gtk_window_set_default_size (GTK_WINDOW (window), 1000, 720);
+  gtk_window_present (GTK_WINDOW (window));
+  a = ptyxis_window_get_active_tab (window);
+  wait_running (a);
+  original_process = g_object_ref (ptyxis_tab_get_process (a));
+  send_command (a, "cd /tmp; printf '\\033]7;file://localhost/tmp\\007'; printf 'LEFT PANE\\n'\n");
+  spin (300);
+  if (!send_shortcut (window, "ctrl+shift+e"))
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (window), "win.split-right", NULL));
+  b = ptyxis_window_get_active_tab (window);
+  g_assert_true (b != a);
+  wait_running (b);
+  spin (300);
+  cwd = ptyxis_tab_query_working_directory_from_agent (b);
+  g_assert_nonnull (cwd);
+  g_assert_true (g_str_has_suffix (cwd, "/tmp"));
+  g_assert_true (ptyxis_tab_get_profile (b) == profile);
+  g_assert_true (ptyxis_tab_get_process (a) == original_process);
+  if (!send_shortcut (window, "ctrl+shift+o"))
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (window), "win.split-down", NULL));
+  c = ptyxis_window_get_active_tab (window);
+  wait_running (c);
+  send_command (b, "printf 'TOP RIGHT PANE\\n'\n");
+  send_command (c, "printf 'BOTTOM RIGHT PANE\\n'\n");
+  pane = active_pane (window);
+  assert_count (pane, 3);
+  spin (500);
+  g_assert_cmpint (gtk_widget_get_width (GTK_WIDGET (a)), >, 100);
+  g_assert_cmpint (gtk_widget_get_height (GTK_WIDGET (c)), >, 100);
+  assert_focus (window, c);
+  gtk_widget_activate_action (GTK_WIDGET (window), "win.pane-up", NULL);
+  assert_focus (window, b);
+  gtk_widget_activate_action (GTK_WIDGET (window), "win.pane-left", NULL);
+  assert_focus (window, a);
+  ptyxis_tab_grab_focus (c);
+  assert_focus (window, c);
+  ptyxis_tab_set_title_prefix (c, "bottom");
+  gtk_widget_activate_action (GTK_WIDGET (window), "win.pane-next", NULL);
+  assert_focus (window, a);
+  gtk_widget_activate_action (GTK_WIDGET (window), "win.pane-previous", NULL);
+  assert_focus (window, c);
+  gtk_paned_set_position (GTK_PANED (gtk_widget_get_first_child (GTK_WIDGET (pane))), 380);
+  ptyxis_tab_set_zoom (b, PTYXIS_ZOOM_LEVEL_PLUS_1);
+  spin (200);
+  save_screenshot (window);
+
+  /* Save and restore includes all panes, their focused leaf, and ratios. */
+  state = ptyxis_session_save (app);
+  g_assert_true (ptyxis_session_restore (app, state));
+  {
+    const GList *windows = gtk_application_get_windows (GTK_APPLICATION (app));
+    PtyxisWindow *restored = windows->data == window ? windows->next->data : windows->data;
+    PtyxisPane *restored_pane = active_pane (restored);
+    g_autoptr(GVariant) layout = ptyxis_pane_save_layout (pane);
+    g_autoptr(GVariant) restored_layout = ptyxis_pane_save_layout (restored_pane);
+    assert_count (restored_pane, 3);
+    g_assert_true (g_variant_equal (layout, restored_layout));
+    g_assert_cmpstr (ptyxis_tab_get_title_prefix (ptyxis_window_get_active_tab (restored)), ==, "bottom");
+    spin (500);
+    {
+      g_autoptr(GPtrArray) restored_children = ptyxis_pane_list_children (restored_pane);
+      g_autofree char *restored_cwd = ptyxis_tab_query_working_directory_from_agent (g_ptr_array_index (restored_children, 1));
+      GtkPaned *divider = GTK_PANED (gtk_widget_get_first_child (GTK_WIDGET (restored_pane)));
+      g_assert_cmpint (ABS (gtk_paned_get_position (divider) - 380), <, 5);
+      g_assert_cmpstr (restored_cwd, ==, "/tmp");
+      g_assert_cmpint (ptyxis_tab_get_zoom (g_ptr_array_index (restored_children, 1)), ==, PTYXIS_ZOOM_LEVEL_PLUS_1);
+    }
+    gtk_window_destroy (GTK_WINDOW (restored));
+  }
+
+  /* Confirming a tab close must account for a busy inactive pane. */
+  send_command (b, "sleep 20\n");
+  spin (150);
+  ptyxis_window_set_active_tab (window, a);
+  ptyxis_settings_set_prompt_on_close (settings, TRUE);
+  gtk_widget_activate_action (GTK_WIDGET (window), "page.close", NULL);
+  spin (100);
+  {
+    AdwDialog *dialog = adw_application_window_get_visible_dialog (ADW_APPLICATION_WINDOW (window));
+    g_assert_true (ADW_IS_ALERT_DIALOG (dialog));
+    adw_dialog_close (dialog);
+    spin (100);
+    assert_count (pane, 3);
+    g_assert_true (ptyxis_tab_is_running (b, NULL));
+  }
+  send_command (b, "\003");
+  spin (100);
+  ptyxis_settings_set_prompt_on_close (settings, FALSE);
+
+  /* Shell exit collapses only that pane; the original shell survives. */
+  send_command (c, "exit\n");
+  for (guint i = 0; i < 300; i++)
+    {
+      g_autoptr(GPtrArray) children = ptyxis_pane_list_children (pane);
+      if (children->len == 2)
+        break;
+      spin (10);
+    }
+  assert_count (pane, 2);
+  g_assert_true (ptyxis_tab_get_process (a) == original_process);
+
+  /* Closing and undoing a whole tab retains its complete layout. */
+  gtk_widget_activate_action (GTK_WIDGET (window), "win.new-tab", "(ss)", "", "");
+  ptyxis_window_set_active_tab (window, a);
+  gtk_widget_activate_action (GTK_WIDGET (window), "page.close", NULL);
+  spin (100);
+  gtk_widget_activate_action (GTK_WIDGET (window), "win.undo-close-tab", NULL);
+  pane = active_pane (window);
+  assert_count (pane, 2);
+  g_assert_true (ptyxis_tab_get_process (a) == original_process);
+
+  /* Detaching carries both panes, including an inactive terminal. */
+  gtk_widget_activate_action (GTK_WIDGET (window), "page.detach", NULL);
+  {
+    PtyxisWindow *detached = PTYXIS_WINDOW (gtk_widget_get_ancestor (GTK_WIDGET (a), PTYXIS_TYPE_WINDOW));
+    g_assert_true (detached != window);
+    assert_count (active_pane (detached), 2);
+    ptyxis_tab_grab_focus (b);
+    assert_focus (detached, b);
+    gtk_widget_activate_action (GTK_WIDGET (detached), "win.close-pane", NULL);
+    assert_count (active_pane (detached), 1);
+    g_assert_true (ptyxis_tab_get_process (a) == original_process);
+    gtk_window_destroy (GTK_WINDOW (detached));
+  }
+  {
+    GtkWindow *preferences = GTK_WINDOW (g_object_new (PTYXIS_TYPE_PREFERENCES_WINDOW, "application", app, NULL));
+    gtk_window_present (preferences);
+    spin (100);
+    gtk_window_destroy (preferences);
+  }
+  gtk_window_destroy (GTK_WINDOW (window));
+  spin (200);
+  {
+    g_autoptr(GVariant) legacy = g_variant_parse (G_VARIANT_TYPE_VARDICT,
+      "{'version': <uint32 1>, 'windows': <[{'tabs': <[{'cwd': <'file:///tmp'>, 'active': <true>, 'pinned': <true>}]>}]>}",
+      NULL, NULL, NULL);
+    PtyxisWindow *restored;
+    g_assert_true (ptyxis_session_restore (app, legacy));
+    restored = gtk_application_get_windows (GTK_APPLICATION (app))->data;
+    assert_count (active_pane (restored), 1);
+    g_assert_true (adw_tab_page_get_pinned (ptyxis_tab_get_page (ptyxis_window_get_active_tab (restored))));
+    gtk_window_destroy (GTK_WINDOW (restored));
+    spin (100);
+  }
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  adw_init ();
+  g_test_add_func ("/splits/tree-roundtrip-and-collapse", layout_tree);
+  g_test_add_func ("/splits/invalid-layout", invalid_layout);
+  g_test_add_func ("/splits/integration", integration);
+  return g_test_run ();
+}
