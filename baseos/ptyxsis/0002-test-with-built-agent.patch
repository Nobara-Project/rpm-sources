diff --git a/src/ptyxis-client.c b/src/ptyxis-client.c
--- a/src/ptyxis-client.c
+++ b/src/ptyxis-client.c
@@ -244,6 +244,16 @@
 static char *
 find_ptyxis_agent_path (gboolean in_sandbox)
 {
+  /* Integration tests use the freshly built helper without installing it.
+   * The application does not initialize GLib's test framework.
+   */
+  if (g_test_initialized ())
+    {
+      const char *test_agent = g_getenv ("PTYXIS_TEST_AGENT");
+      if (test_agent != NULL && g_path_is_absolute (test_agent))
+        return g_strdup (test_agent);
+    }
+
   if (!in_sandbox &&
       ptyxis_get_process_kind () == PTYXIS_PROCESS_KIND_FLATPAK)
     {
