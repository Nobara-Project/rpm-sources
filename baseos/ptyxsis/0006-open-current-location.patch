+static void
+open_location_action (GtkWidget  *widget,
+                      const char *action_name,
+                      GVariant   *param)
+{
+  PtyxisTerminal *self = PTYXIS_TERMINAL (widget);
+  PtyxisTab *tab = PTYXIS_TAB (gtk_widget_get_ancestor (widget, PTYXIS_TYPE_TAB));
+  g_autofree char *uri = NULL;
+
+  if (tab == NULL)
+    return;
+
+  /* Use this pane's shell-reported location, just like splitting a pane.
+   * Shells without OSC 7 support fall back to the agent's process cwd.
+   */
+  uri = ptyxis_terminal_dup_current_directory_uri (self);
+  if (ptyxis_str_empty0 (uri))
+    {
+      g_autofree char *path = ptyxis_tab_query_working_directory_from_agent (tab);
+      g_clear_pointer (&uri, g_free);
+      if (path != NULL && g_path_is_absolute (path))
+        uri = g_filename_to_uri (path, NULL, NULL);
+    }
+
+  if (ptyxis_str_empty0 (uri))
+    {
+      ptyxis_terminal_toast (self, 3, _("The current location is not available"));
+      return;
+    }
+
+  /* Reuse the default-handler/portal path and its container URI translation.
+   * Never interpolate terminal paths into a shell command.
+   */
+  ptyxis_tab_open_uri (tab, uri);
 }
 
