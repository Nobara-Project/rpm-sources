+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "config.h"
+#include <adwaita.h>
+#include <math.h>
+#include <sys/resource.h>
+#include "ptyxis-wallpaper.h"
+#include "ptyxis-settings.h"
+#include "ptyxis-preferences-window.h"
+
+gint64 ptyxis_application_get_default_rlimit_nofile (void) { return 1024; }
+
+static double luminance (const GdkRGBA *c)
+{
+  double v[3] = {c->red,c->green,c->blue};
+  for(int i=0;i<3;i++)v[i]=v[i]<=.04045?v[i]/12.92:pow((v[i]+.055)/1.055,2.4);
+  return v[0]*.2126+v[1]*.7152+v[2]*.0722;
+}
+static double contrast (const GdkRGBA *a, const GdkRGBA *b)
+{ double x=luminance(a),y=luminance(b);return (MAX(x,y)+.05)/(MIN(x,y)+.05); }
+
+static void palette_contrast (void)
+{
+  for (int r=0;r<=255;r+=51)for(int g=0;g<=255;g+=51)for(int b=0;b<=255;b+=51)
+    {
+      GdkRGBA color={r/255.,g/255.,b/255.,1};
+      g_autoptr(PtyxisPalette) p=ptyxis_palette_new_wallpaper(&color);
+      g_assert_true(ptyxis_palette_has_light(p));g_assert_true(ptyxis_palette_has_dark(p));
+      for(int dark=0;dark<2;dark++){
+        const PtyxisPaletteFace *face=ptyxis_palette_get_face(p,dark);
+        g_assert_cmpfloat(contrast(&face->foreground,&face->background),>=,4.5);
+        g_assert_cmpfloat(contrast(&face->cursor_bg,&face->background),>=,4.5);
+      }
+    }
+}
+
+static char *make_image (const char *name, guint32 rgba)
+{
+  g_autoptr(GdkPixbuf) p=gdk_pixbuf_new(GDK_COLORSPACE_RGB,TRUE,8,32,32);
+  char *path=g_build_filename(g_get_user_data_dir(),name,NULL);
+  g_mkdir_with_parents(g_get_user_data_dir(),0700);
+  gdk_pixbuf_fill(p,rgba);
+  g_assert_true(gdk_pixbuf_save(p,path,"png",NULL,NULL));return path;
+}
+
+static void sample_image (void)
+{
+  GdkRGBA color;
+  g_autoptr(GError) error=NULL;
+  g_autofree char *red=make_image("red.png",0xc04020ff);
+  g_autofree char *clear=make_image("clear.png",0x00000000);
+  g_assert_true(ptyxis_wallpaper_sample(red,&color,&error));
+  g_assert_cmpfloat_with_epsilon(color.red,192./255.,.001);
+  g_assert_false(ptyxis_wallpaper_sample(clear,&color,&error));g_clear_error(&error);
+  g_assert_false(ptyxis_wallpaper_sample("/does-not-exist",&color,&error));g_clear_error(&error);
+  g_assert_false(ptyxis_wallpaper_sample("/dev/zero",&color,&error));
+}
+
+static gboolean done;
+static gboolean succeeded;
+static void applied (GObject *source,GAsyncResult *result,gpointer data)
+{
+  g_autoptr(GError) error=NULL;
+  succeeded=ptyxis_wallpaper_refresh_finish(result,&error);done=TRUE;
+}
+static void wait_applied (void)
+{
+  gint64 until=g_get_monotonic_time()+5000000;
+  while(!done && g_get_monotonic_time()<until){
+    while(g_main_context_iteration(NULL,FALSE)) {}
+    g_usleep(1000);
+  }
+  g_assert_true(done);
+}
+static void match_round_trip (void)
+{
+  g_autoptr(PtyxisApplication) app=ptyxis_application_new("org.gnome.Ptyxis.Wallpaper.Test",G_APPLICATION_NON_UNIQUE);
+  g_autoptr(GError) error=NULL;
+  g_assert_true(g_application_register(G_APPLICATION(app),NULL,&error));
+  GSettings *settings=ptyxis_settings_get_settings(ptyxis_application_get_settings(app));
+  g_autoptr(PtyxisProfile) profile=ptyxis_application_dup_default_profile(app);
+  g_autofree char *old=ptyxis_profile_dup_palette_id(profile);
+  GdkMonitor *monitor=g_list_model_get_item(gdk_display_get_monitors(gdk_display_get_default()),0);
+  const char *connector=gdk_monitor_get_connector(monitor);
+  g_assert_nonnull(connector);
+  g_autofree char *image=make_image("current.png",0xc04020ff);
+  g_autofree char *dir=g_build_filename(g_get_user_config_dir(),"wayshell",NULL);
+  g_autofree char *config=g_build_filename(dir,"wallpapers.json",NULL);
+  g_mkdir_with_parents(dir,0700);
+  g_autofree char *json=g_strdup_printf("{\"%s\":{\"file_path\":\"%s\"}}",connector,image);
+  g_assert_true(g_file_set_contents(config,json,-1,&error));
+  g_settings_set_boolean(settings,"match-wallpaper",TRUE);
+  done=FALSE;ptyxis_wallpaper_refresh(NULL,applied,NULL);wait_applied();g_assert_true(succeeded);
+  g_autoptr(PtyxisPalette) p=ptyxis_profile_dup_palette(profile);
+  g_assert_cmpstr(ptyxis_palette_get_id(p),==,"wallpaper");
+  g_assert_cmpfloat_with_epsilon(ptyxis_palette_get_face(p,TRUE)->background.red,192./255.*.35,.002);
+  /* Apply must refresh an existing palette, even though its ID is unchanged. */
+  g_autofree char *replaced=make_image("current.png",0x2060c0ff);
+  done=FALSE;ptyxis_wallpaper_refresh(NULL,applied,NULL);wait_applied();g_assert_true(succeeded);
+  g_clear_object(&p);p=ptyxis_profile_dup_palette(profile);
+  g_assert_cmpfloat_with_epsilon(ptyxis_palette_get_face(p,TRUE)->background.blue,192./255.*.35,.002);
+  /* A failed refresh retains the previous successful colors. */
+  g_assert_true(g_file_set_contents(image,"broken",-1,&error));
+  done=FALSE;ptyxis_wallpaper_refresh(NULL,applied,NULL);wait_applied();g_assert_false(succeeded);
+  g_autoptr(PtyxisPalette) retained=ptyxis_profile_dup_palette(profile);
+  g_assert_true(retained==p);
+  /* Template and bindings are real, and the existing profile choice survives. */
+  GtkWidget *prefs=g_object_new(PTYXIS_TYPE_PREFERENCES_WINDOW,NULL);
+  g_object_ref_sink(prefs);
+  gtk_window_destroy(GTK_WINDOW(prefs));g_object_unref(prefs);
+  g_settings_set_boolean(settings,"match-wallpaper",FALSE);
+  g_clear_object(&p);p=ptyxis_profile_dup_palette(profile);
+  g_assert_cmpstr(ptyxis_palette_get_id(p),==,old);
+  g_autofree char *unchanged=ptyxis_profile_dup_palette_id(profile);
+  g_assert_cmpstr(old,==,unchanged);
+  g_object_unref(monitor);
+}
+static void startup_refresh (void)
+{
+  g_autoptr(GdkMonitor) monitor = g_list_model_get_item (gdk_display_get_monitors (gdk_display_get_default ()), 0);
+  g_autofree char *image = make_image ("startup.png", 0x309060ff);
+  g_autofree char *dir = g_build_filename (g_get_user_config_dir (), "wayshell", NULL);
+  g_autofree char *path = g_build_filename (dir, "wallpapers.json", NULL);
+  g_autofree char *json = g_strdup_printf ("{\"%s\":{\"file_path\":\"%s\"}}", gdk_monitor_get_connector (monitor), image);
+  g_mkdir_with_parents (dir, 0700);
+  g_assert_true (g_file_set_contents (path, json, -1, NULL));
+  g_autoptr(GSettings) saved = g_settings_new (APP_SCHEMA_ID);
+  g_settings_set_string (saved, "wallpaper-color", "#112233");
+  g_settings_set_boolean (saved, "match-wallpaper", TRUE);
+  g_autoptr(PtyxisApplication) app = ptyxis_application_new ("org.gnome.Ptyxis.Wallpaper.Startup", G_APPLICATION_NON_UNIQUE);
+  g_assert_true (g_application_register (G_APPLICATION (app), NULL, NULL));
+  gint64 deadline = g_get_monotonic_time () + 5000000;
+  while (g_get_monotonic_time () < deadline)
+    {
+      g_autofree char *color = g_settings_get_string (saved, "wallpaper-color");
+      if (!g_str_equal (color, "#112233")) break;
+      while (g_main_context_iteration (NULL, FALSE)) {}
+      g_usleep (1000);
+    }
+  g_autoptr(PtyxisProfile) profile = ptyxis_application_dup_default_profile (app);
+  g_autoptr(PtyxisPalette) palette = ptyxis_profile_dup_palette (profile);
+  g_assert_cmpstr (ptyxis_palette_get_id (palette), ==, "wallpaper");
+  g_assert_cmpfloat_with_epsilon (ptyxis_palette_get_face (palette, TRUE)->background.green, 144./255.*.35, .002);
+}
+int main(int argc,char **argv)
+{
+  g_test_init(&argc,&argv,NULL);adw_init();
+  g_test_add_func("/wallpaper/contrast",palette_contrast);
+  g_test_add_func("/wallpaper/sample",sample_image);
+  g_test_add_func("/wallpaper/apply-and-restore",match_round_trip);
+  g_test_add_func("/wallpaper/startup-refresh",startup_refresh);
+  return g_test_run();
+}
