+/* Build paired light/dark faces without modifying any saved profile palette. */
+static double
+wallpaper_luminance (const GdkRGBA *c)
+{
+  double v[3] = {c->red, c->green, c->blue};
+  for (int i = 0; i < 3; i++)
+    v[i] = v[i] <= .04045 ? v[i]/12.92 : pow ((v[i]+.055)/1.055, 2.4);
+  return v[0]*.2126 + v[1]*.7152 + v[2]*.0722;
+}
+
+PtyxisPalette *
+ptyxis_palette_new_wallpaper (const GdkRGBA *color)
+{
+  g_autoptr(PtyxisPalette) base = ptyxis_palette_lookup ("gnome");
+  PtyxisPalette *self = g_object_new (PTYXIS_TYPE_PALETTE, NULL);
+  self->allocated = g_memdup2 (base->palette, sizeof *self->allocated);
+  self->palette = self->allocated;
+  self->allocated->id = "wallpaper";
+  self->allocated->name = g_intern_string (_("Wallpaper"));
+  self->has_dark = self->has_light = TRUE;
+  for (int dark = 0; dark < 2; dark++)
+    {
+      PtyxisPaletteFace *face = &self->allocated->faces[dark];
+      double strength = dark ? .35 : .18;
+      face->background = (GdkRGBA){
+        (dark ? 0 : 250./255.)*(1-strength)+color->red*strength,
+        (dark ? 0 : 250./255.)*(1-strength)+color->green*strength,
+        (dark ? 0 : 252./255.)*(1-strength)+color->blue*strength, 1};
+      gdk_rgba_parse (&face->foreground, dark ? "#eeeeee" : "#23262d");
+      face->titlebar_background = face->background;
+      face->titlebar_foreground = face->foreground;
+      double bg = wallpaper_luminance (&face->background);
+      GdkRGBA accent = *color;
+      for (int step = 0; step <= 100; step++)
+        {
+          double a = step/100., target = dark ? 1 : 0;
+          accent = (GdkRGBA){color->red*(1-a)+target*a,
+                            color->green*(1-a)+target*a,
+                            color->blue*(1-a)+target*a, 1};
+          double luminance = wallpaper_luminance (&accent);
+          if ((MAX (bg,luminance)+.05)/(MIN (bg,luminance)+.05) >= 4.5) break;
+        }
+      face->cursor_bg = accent;
+      face->cursor_fg = face->background;
+      face->indexed[4] = face->indexed[12] = accent;
+    }
+  return self;
+}
