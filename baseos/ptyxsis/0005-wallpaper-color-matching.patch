+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "config.h"
+#include <math.h>
+#include <sys/stat.h>
+#include <glib/gi18n.h>
+#include <json-glib/json-glib.h>
+#include "ptyxis-wallpaper.h"
+#include "ptyxis-settings.h"
+
+static GSettings *settings;
+static PtyxisPalette *palette;
+static guint generation;
+
+typedef struct {
+  char **connectors;
+  char *fallback_uri;
+  guint generation;
+} Request;
+
+static void
+request_free (Request *request)
+{
+  g_strfreev (request->connectors);
+  g_free (request->fallback_uri);
+  g_free (request);
+}
+
+/* Match Wayshell/Waydock's bounded, saturation-weighted dominant color. */
+gboolean
+ptyxis_wallpaper_sample (const char *path, GdkRGBA *color, GError **error)
+{
+  struct stat st;
+  int width, height;
+  double buckets[512][4] = {{0}};
+  double best = -1;
+  int winner = -1;
+  g_autoptr(GdkPixbuf) image = NULL;
+
+  if (stat (path, &st) != 0 || !S_ISREG (st.st_mode) || st.st_size > 64 * 1024 * 1024 ||
+      !gdk_pixbuf_get_file_info (path, &width, &height) || width <= 0 || height <= 0 ||
+      (guint64)width * height > 100000000)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           _("The wallpaper is missing, too large, or not a supported image."));
+      return FALSE;
+    }
+  image = gdk_pixbuf_new_from_file_at_scale (path, 64, 64, TRUE, error);
+  if (!image) return FALSE;
+  const guchar *pixels = gdk_pixbuf_read_pixels (image);
+  int stride = gdk_pixbuf_get_rowstride (image);
+  int channels = gdk_pixbuf_get_n_channels (image);
+  for (int y = 0; y < gdk_pixbuf_get_height (image); y++)
+    for (int x = 0; x < gdk_pixbuf_get_width (image); x++)
+      {
+        const guchar *p = pixels + y * stride + x * channels;
+        double alpha = channels == 4 ? p[3] / 255. : 1.;
+        if (alpha < .1) continue;
+        double *b = buckets[(p[0]/32)*64 + (p[1]/32)*8 + p[2]/32];
+        b[0] += alpha;
+        for (int c = 0; c < 3; c++) b[c+1] += p[c] * alpha;
+      }
+  for (int i = 0; i < 512; i++)
+    {
+      double *b = buckets[i];
+      if (b[0] == 0) continue;
+      double max = MAX (b[1], MAX (b[2], b[3])) / b[0] / 255.;
+      double min = MIN (b[1], MIN (b[2], b[3])) / b[0] / 255.;
+      double score = b[0] * (.25 + (max > 0 ? (max-min)/max : 0)) * (.35 + max);
+      if (score > best) { best = score; winner = i; }
+    }
+  if (winner < 0)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA, _("The wallpaper has no visible colors."));
+      return FALSE;
+    }
+  double *b = buckets[winner];
+  *color = (GdkRGBA){b[1]/b[0]/255., b[2]/b[0]/255., b[3]/b[0]/255., 1};
+  return TRUE;
+}
+
+static const char *
+string_member (JsonObject *object, const char *name)
+{
+  JsonNode *node = json_object_get_member (object, name);
+  return node && JSON_NODE_HOLDS_VALUE (node) && json_node_get_value_type (node) == G_TYPE_STRING
+    ? json_node_get_string (node) : NULL;
+}
+
+static gboolean
+read_wallpaper (Request *request, GdkRGBA *color, GError **error)
+{
+  g_autofree char *config = g_build_filename (g_get_user_config_dir (), "wayshell", "wallpapers.json", NULL);
+  g_autoptr(JsonParser) parser = json_parser_new ();
+  struct stat st;
+  if (stat (config, &st) == 0 && S_ISREG (st.st_mode) && st.st_size <= 65536 &&
+      json_parser_load_from_file (parser, config, NULL) &&
+      JSON_NODE_HOLDS_OBJECT (json_parser_get_root (parser)))
+    {
+      JsonObject *root = json_node_get_object (json_parser_get_root (parser));
+      for (guint i = 0; request->connectors[i]; i++)
+        {
+          JsonNode *node = json_object_get_member (root, request->connectors[i]);
+          if (!node || !JSON_NODE_HOLDS_OBJECT (node)) continue;
+          JsonObject *monitor = json_node_get_object (node);
+          const char *path = string_member (monitor, "file_path");
+          const char *solid = string_member (monitor, "color");
+          if (path && *path) return ptyxis_wallpaper_sample (path, color, error);
+          if (solid && gdk_rgba_parse (color, solid)) return TRUE;
+        }
+    }
+  if (request->fallback_uri && *request->fallback_uri)
+    {
+      g_autoptr(GFile) file = g_file_new_for_uri (request->fallback_uri);
+      const char *path = g_file_peek_path (file);
+      if (path) return ptyxis_wallpaper_sample (path, color, error);
+    }
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                       _("No wallpaper was found for this display. Choose an image in desktop wallpaper settings."));
+  return FALSE;
+}
+
+static void
+sample_worker (GTask *task, gpointer source, gpointer task_data, GCancellable *cancellable)
+{
+  g_autoptr(GError) error = NULL;
+  GdkRGBA *color = g_new0 (GdkRGBA, 1);
+  if (read_wallpaper (task_data, color, &error))
+    g_task_return_pointer (task, color, g_free);
+  else
+    { g_free (color); g_task_return_error (task, g_steal_pointer (&error)); }
+}
+
+static void
+notify_profiles (void)
+{
+  g_autoptr(GListModel) profiles = ptyxis_application_list_profiles (PTYXIS_APPLICATION_DEFAULT);
+  for (guint i = 0; i < g_list_model_get_n_items (profiles); i++)
+    {
+      g_autoptr(GObject) profile = g_list_model_get_item (profiles, i);
+      g_object_notify (profile, "palette");
+    }
+}
+
+static void
+sample_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr(GTask) completion = data;
+  g_autoptr(GError) error = NULL;
+  g_autofree GdkRGBA *color = g_task_propagate_pointer (G_TASK (result), &error);
+  Request *request = g_task_get_task_data (G_TASK (result));
+  if (!color)
+    g_task_return_error (completion, g_steal_pointer (&error));
+  else
+    {
+      if (request->generation == generation)
+        {
+          g_autoptr(PtyxisPalette) next = ptyxis_palette_new_wallpaper (color);
+          g_set_object (&palette, next);
+          g_settings_set_string (settings, "wallpaper-monitor", request->connectors[0] ?: "");
+          g_autofree char *saved = gdk_rgba_to_string (color);
+          g_settings_set_string (settings, "wallpaper-color", saved);
+          notify_profiles ();
+        }
+      g_task_return_boolean (completion, TRUE);
+    }
+  g_application_release (G_APPLICATION (source));
+}
+
+void
+ptyxis_wallpaper_refresh (GtkWindow *window, GAsyncReadyCallback callback, gpointer data)
+{
+  PtyxisApplication *app = PTYXIS_APPLICATION_DEFAULT;
+  g_autoptr(GTask) task = g_task_new (app, NULL, sample_done, g_task_new (app, NULL, callback, data));
+  Request *request = g_new0 (Request, 1);
+  g_autoptr(GPtrArray) connectors = g_ptr_array_new_with_free_func (g_free);
+  GdkDisplay *display = gdk_display_get_default ();
+  GListModel *monitors = gdk_display_get_monitors (display);
+  GdkSurface *surface = window ? gtk_native_get_surface (GTK_NATIVE (window)) : NULL;
+  GdkMonitor *monitor = surface ? gdk_display_get_monitor_at_surface (display, surface) : NULL;
+  const char *connector = monitor ? gdk_monitor_get_connector (monitor) : NULL;
+  g_autofree char *saved = g_settings_get_string (settings, "wallpaper-monitor");
+  if (connector) g_ptr_array_add (connectors, g_strdup (connector));
+  for (guint i = 0; i < g_list_model_get_n_items (monitors); i++)
+    {
+      g_autoptr(GdkMonitor) m = g_list_model_get_item (monitors, i);
+      const char *name = gdk_monitor_get_connector (m);
+      if (!name) continue;
+      if (!connector && g_str_equal (name, saved)) g_ptr_array_insert (connectors, 0, g_strdup (name));
+      else g_ptr_array_add (connectors, g_strdup (name));
+    }
+  g_ptr_array_add (connectors, NULL);
+  request->connectors = (char **)g_ptr_array_free (g_steal_pointer (&connectors), FALSE);
+  request->generation = ++generation;
+  GSettingsSchemaSource *schemas = g_settings_schema_source_get_default ();
+  g_autoptr(GSettingsSchema) schema = g_settings_schema_source_lookup (schemas, "org.gnome.desktop.background", TRUE);
+  if (schema)
+    {
+      g_autoptr(GSettings) background = g_settings_new_full (schema, NULL, NULL);
+      gboolean dark = adw_style_manager_get_dark (adw_style_manager_get_default ());
+      const char *key = dark && g_settings_schema_has_key (schema, "picture-uri-dark") ? "picture-uri-dark" : "picture-uri";
+      if (g_settings_schema_has_key (schema, key)) request->fallback_uri = g_settings_get_string (background, key);
+    }
+  g_task_set_task_data (task, request, (GDestroyNotify)request_free);
+  g_application_hold (G_APPLICATION (app));
+  g_task_run_in_thread (task, sample_worker);
+}
+
+gboolean
+ptyxis_wallpaper_refresh_finish (GAsyncResult *result, GError **error)
+{
+  return g_task_propagate_boolean (G_TASK (result), error);
+}
+
+PtyxisPalette *
+ptyxis_wallpaper_dup_palette (void)
+{
+  return settings && palette && g_settings_get_boolean (settings, "match-wallpaper")
+    ? g_object_ref (palette) : NULL;
+}
+
+static void
+auto_done (GObject *source, GAsyncResult *result, gpointer data)
+{
+  g_autoptr(GError) error = NULL;
+  if (!ptyxis_wallpaper_refresh_finish (result, &error))
+    g_debug ("Wallpaper palette: %s", error->message);
+}
+
+static void
+match_changed (void)
+{
+  notify_profiles ();
+  if (g_settings_get_boolean (settings, "match-wallpaper"))
+    ptyxis_wallpaper_refresh (gtk_application_get_active_window (GTK_APPLICATION (PTYXIS_APPLICATION_DEFAULT)), auto_done, NULL);
+}
+
+void
+ptyxis_wallpaper_init (PtyxisApplication *app)
+{
+  GdkRGBA color;
+  settings = g_object_ref (ptyxis_settings_get_settings (ptyxis_application_get_settings (app)));
+  g_autofree char *saved = g_settings_get_string (settings, "wallpaper-color");
+  if (gdk_rgba_parse (&color, saved)) palette = ptyxis_palette_new_wallpaper (&color);
+  g_signal_connect (settings, "changed::match-wallpaper", G_CALLBACK (match_changed), NULL);
+  match_changed ();
+}
