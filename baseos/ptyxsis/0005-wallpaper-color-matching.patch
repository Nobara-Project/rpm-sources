+  objects: ptyxis_executable.extract_objects(ptyxis_sources + ptyxis_agent_ipc),
+  dependencies: ptyxis_deps,
+  include_directories: ptyxis_include_directories,
+  c_args: testsuite_c_args,
+)
+test('test-wallpaper', wallpaper_tests, args: ['-s', '/wallpaper/startup-refresh'], env: split_env, timeout: 30, is_parallel: false)
+test('test-wallpaper-startup', wallpaper_tests, args: ['-p', '/wallpaper/startup-refresh'], env: split_env, timeout: 30, is_parallel: false)
