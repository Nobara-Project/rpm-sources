diff --git a/src/ptyxis-application.c b/src/ptyxis-application.c
--- a/src/ptyxis-application.c
+++ b/src/ptyxis-application.c
@@ -875,6 +875,42 @@
 }
 
 static void
+set_window_rounded_corners (GtkWindow *window,
+                            gboolean   rounded)
+{
+  if (rounded)
+    gtk_widget_remove_css_class (GTK_WIDGET (window), "square-corners");
+  else
+    gtk_widget_add_css_class (GTK_WIDGET (window), "square-corners");
+}
+
+static void
+ptyxis_application_rounded_corners_changed_cb (GSettings         *settings,
+                                               const char        *key,
+                                               PtyxisApplication *self)
+{
+  gboolean rounded = g_settings_get_boolean (settings, PTYXIS_SETTING_KEY_ROUNDED_CORNERS);
+
+  for (const GList *iter = gtk_application_get_windows (GTK_APPLICATION (self));
+       iter != NULL;
+       iter = iter->next)
+    set_window_rounded_corners (iter->data, rounded);
+}
+
+static void
+ptyxis_application_window_added (GtkApplication *application,
+                                 GtkWindow      *window)
+{
+  PtyxisApplication *self = PTYXIS_APPLICATION (application);
+  GSettings *settings = ptyxis_settings_get_settings (self->settings);
+
+  GTK_APPLICATION_CLASS (ptyxis_application_parent_class)->window_added (application, window);
+
+  set_window_rounded_corners (window,
+                             g_settings_get_boolean (settings, PTYXIS_SETTING_KEY_ROUNDED_CORNERS));
+}
+
+static void
 ptyxis_application_startup (GApplication *application)
 {
   static const char *patterns[] = { "org.gnome.*", NULL };
