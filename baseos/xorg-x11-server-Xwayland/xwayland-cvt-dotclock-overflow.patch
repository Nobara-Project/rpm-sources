From da906596bd307e62bcb4aa68e24ec778d1471048 Mon Sep 17 00:00:00 2001
From: Chris Sawczuk <chris@sawcz.uk>
Date: Fri, 16 Oct 2026 19:39:40 +0100
Subject: [PATCH] xwayland: Avoid RandR dotClock overflow for high pixel clock
 modes

xRRModeInfo.dotClock is a 32-bit value in Hz. With standard CVT blanking,
5120x2160@240 needs ~4.34 GHz, which wraps to ~41.5 MHz, so X11 clients
compute a ~2.3 Hz refresh rate and throttle (e.g. Chromium/CEF).

Fall back to CVT reduced blanking when the clock would not fit, and reject
the mode if it still overflows.

Signed-off-by: Chris Sawczuk <chris@sawcz.uk>
---
 hw/xwayland/xwayland-cvt.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/hw/xwayland/xwayland-cvt.c b/hw/xwayland/xwayland-cvt.c
index 80c67e9..4cb9e79 100644
--- a/hw/xwayland/xwayland-cvt.c
+++ b/hw/xwayland/xwayland-cvt.c
@@ -23,6 +23,7 @@
 
 #include <xwayland-config.h>
 
+#include <stdint.h>
 #include <string.h>
 #include <randrstr.h>
 #include <libxcvt/libxcvt.h>
@@ -42,6 +43,27 @@ xwayland_modeinfo_from_cvt(xRRModeInfo *modeinfo,
     if (!libxcvt_mode_info)
         return FALSE;
 
+    /* xRRModeInfo.dotClock is a CARD32 in Hz, so standard CVT blanking
+     * overflows it for large high-refresh modes (e.g. 5120x2160@240 needs
+     * ~4.34 GHz), and clients compute a bogus refresh rate from the wrapped
+     * value. Fall back to reduced blanking, which keeps the same refresh
+     * rate with a much lower pixel clock.
+     */
+    if (!reduced && libxcvt_mode_info->dot_clock * 1000.0 > UINT32_MAX) {
+        struct libxcvt_mode_info *rb_mode_info =
+            libxcvt_gen_mode_info(hdisplay, vdisplay, vrefresh, TRUE, interlaced);
+
+        if (rb_mode_info) {
+            free(libxcvt_mode_info);
+            libxcvt_mode_info = rb_mode_info;
+        }
+    }
+
+    if (libxcvt_mode_info->dot_clock * 1000.0 > UINT32_MAX) {
+        free(libxcvt_mode_info);
+        return FALSE;
+    }
+
     modeinfo->width      = libxcvt_mode_info->hdisplay;
     modeinfo->height     = libxcvt_mode_info->vdisplay;
     modeinfo->dotClock   = libxcvt_mode_info->dot_clock * 1000.0;
-- 
