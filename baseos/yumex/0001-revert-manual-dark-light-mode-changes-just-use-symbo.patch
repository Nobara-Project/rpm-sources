---
 data/dk.yumex.Yumex.gschema.xml.in            |   4 --
 data/gfx/dark_panel.png                       | Bin 24130 -> 0 bytes
 data/gfx/light_panel.png                      | Bin 21498 -> 0 bytes
 .../apps/yumex-update-dark-symbolic.svg       |  39 ------------------
 .../scalable/apps/yumex-update-symbolic.svg   |  39 ------------------
 data/icons/meson.build                        |   9 ----
 data/ui/preferences.blp                       |  13 ------
 docs/customize.md                             |  12 ------
 yumex.spec                                    |   1 -
 yumex/service/data.py                         |  15 ++-----
 yumex/ui/preferences.py                       |   4 --
 yumex/yumex_updater                           |   2 +-
 12 files changed, 4 insertions(+), 134 deletions(-)
 delete mode 100644 data/gfx/dark_panel.png
 delete mode 100644 data/gfx/light_panel.png
 delete mode 100644 data/icons/hicolor/scalable/apps/yumex-update-dark-symbolic.svg
 delete mode 100644 data/icons/hicolor/scalable/apps/yumex-update-symbolic.svg
 delete mode 100644 docs/customize.md

diff --git a/data/dk.yumex.Yumex.gschema.xml.in b/data/dk.yumex.Yumex.gschema.xml.in
index e0d8541..06ac4db 100644
--- a/data/dk.yumex.Yumex.gschema.xml.in
+++ b/data/dk.yumex.Yumex.gschema.xml.in
@@ -77,9 +77,5 @@
 			<default>true</default>
 			<summary>Send notification on updates</summary>
 		</key>
-		<key name="upd-dark-icon" type="b">
-			<default>false</default>
-			<summary>Use a dark updaer icon</summary>
-		</key>
 	</schema>
 </schemalist>
